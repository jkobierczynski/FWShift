{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FwlabNetworkFirewall",
      "Effect": "Allow",
      "Action": "network-firewall:*",
      "Resource": [
        "arn:aws:network-firewall:*:*:firewall/fwlab*",
        "arn:aws:network-firewall:*:*:firewall-policy/fwlab*",
        "arn:aws:network-firewall:*:*:stateful-rulegroup/fwlab*",
        "arn:aws:network-firewall:*:*:stateless-rulegroup/fwlab*"
      ]
    },
    {
      "Sid": "FwlabNetworkFirewallLists",
      "Effect": "Allow",
      "Action": [
        "network-firewall:ListFirewalls",
        "network-firewall:ListFirewallPolicies",
        "network-firewall:ListRuleGroups",
        "network-firewall:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "FwlabNetworkFirewallLogDeliveries",
      "Effect": "Allow",
      "Action": [
        "logs:ListLogDeliveries",
        "logs:GetLogDelivery",
        "logs:DeleteLogDelivery"
      ],
      "Resource": "*"
    },
    {
      "Sid": "FwlabNetworkFirewallServiceRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/network-firewall.amazonaws.com/*",
      "Condition": { "StringEquals": { "iam:AWSServiceName": "network-firewall.amazonaws.com" } }
    }
  ]
}
