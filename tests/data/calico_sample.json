{
  "kind": "NetworkPolicyList",
  "apiVersion": "projectcalico.org/v3",
  "items": [
    {
      "apiVersion": "projectcalico.org/v3",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "web-calico",
        "namespace": "shop"
      },
      "spec": {
        "order": 100,
        "selector": "app == 'web'",
        "types": [
          "Ingress",
          "Egress"
        ],
        "ingress": [
          {
            "action": "Allow",
            "protocol": "TCP",
            "source": {
              "selector": "role == 'partner'"
            },
            "destination": {
              "ports": [
                "http"
              ]
            }
          },
          {
            "action": "Deny",
            "source": {
              "nets": [
                "10.0.0.0/8"
              ],
              "notNets": [
                "10.244.0.0/16"
              ]
            }
          },
          {
            "action": "Allow",
            "protocol": "TCP",
            "source": {
              "nets": [
                "10.0.0.0/8"
              ]
            },
            "destination": {
              "ports": [
                "8000:8100"
              ],
              "notPorts": [
                8050
              ]
            }
          },
          {
            "action": "Allow",
            "notProtocol": "TCP",
            "source": {
              "namespaceSelector": "team == 'ops'"
            }
          },
          {
            "action": "Allow",
            "protocol": "TCP",
            "source": {
              "serviceAccounts": {
                "names": [
                  "web"
                ]
              }
            },
            "destination": {
              "ports": [
                8080
              ]
            },
            "http": {
              "methods": [
                "GET"
              ]
            }
          }
        ],
        "egress": [
          {
            "action": "Allow",
            "protocol": "TCP",
            "destination": {
              "selector": "app == 'cart'",
              "ports": [
                50051
              ]
            }
          },
          {
            "action": "Allow",
            "ipVersion": 6,
            "destination": {
              "nets": [
                "2001:db8:ffff::/48"
              ]
            }
          },
          {
            "action": "Deny"
          }
        ]
      }
    },
    {
      "apiVersion": "projectcalico.org/v3",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "api-calico",
        "namespace": "payments"
      },
      "spec": {
        "selector": "app == 'payments-api'",
        "ingress": [
          {
            "action": "Allow",
            "protocol": "TCP",
            "source": {
              "namespaceSelector": "global()",
              "selector": "feed == 'partners'"
            },
            "destination": {
              "ports": [
                8443
              ]
            }
          },
          {
            "action": "Allow",
            "protocol": "TCP",
            "source": {
              "notSelector": "app == 'debug'"
            },
            "destination": {
              "ports": [
                8443
              ]
            }
          }
        ]
      }
    }
  ]
}
