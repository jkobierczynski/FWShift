  {
    PROTO = "tcp"
    FROM_IP = "192.168.10.0/24"
    FROM_PORT = "any"
    IN_IP = "0.0.0.0/0"
    IN_PORT = {
      rowref = "MAI0000000201"
    }
    TARGET_REF = "ACCEPT"
    COMMENT = "web out"
    LOG = "no"
  }
  {
    PROTO = "tcp"
    FROM_IP = "192.168.20.0/24"
    FROM_PORT = "any"
    IN_IP = "192.168.10.0/24"
    IN_PORT = "102"
    TARGET_REF = "ACCEPT"
    COMMENT = "engineering VLAN 20 to the S7 PLCs"
    LOG = "no"
  }
}
