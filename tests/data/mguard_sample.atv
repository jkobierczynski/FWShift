    PROTO = "tcp"
    SRC_IP = "0.0.0.0/0"
    SRC_PORT = "any"
    IN_IP = "%extern"
    IN_PORT = "8443"
    OUT_IP = "192.168.10.30"
    OUT_PORT = "443"
    COMMENT = "remote HMI"
    LOG = "yes"
  }
  {
    PROTO = "udp"
    SRC_IP = {
      rowref = "MAI0000000103"
    }
    SRC_PORT = "any"
    IN_IP = "203.0.113.3"
    IN_PORT = "47808"
    OUT_IP = "172.16.30.20"
    OUT_PORT = "47808"
    COMMENT = "BACnet gateway in the DMZ"
    LOG = "no"
  }
}
FW_1TO1_NAT = {
  {
    LOCAL_NET = "192.168.10.48"
    REMOTE_NET = "203.0.113.8"
    MASK = "29"
    ENABLE_ARP = "yes"
    COMMENT = "HMI subnet published"
  }
}
FW_NAT = {
  {
    EXT_IF = "ext1"
    IN_IP = "192.168.10.0/24"
    COMMENT = "LAN out to the WAN"
  }
  {
    EXT_IF = "int"
    IN_IP = "172.16.30.0/24"
    COMMENT = "DMZ hosts reach the LAN as the mGuard"
  }
}
USERFW_ENABLE = "yes"
USERFW_TEMPLATE = {
  {
    TEMPLATE_ENABLED = "yes"
    TEMPLATE_NAME = "service technicians"
    TEMPLATE_COMMENT = ""
    TEMPLATE_TIMEOUT = "28800"
    TEMPLATE_TOUT_TYPE = "static"
    TEMPLATE_SRC_IP = "%authorized_ip"
    TEMPLATE_RULE = {
      {
        PROTO = "tcp"
        SRC_PORT = "any"
        DST_IP = "192.168.10.0/24"
        DST_PORT = "3389"
        COMMENT = "remote desktop"
        LOG = "yes"
      }
    }
  }
}
VPN_CONNECTION = {
  {
    { rid = "MAI0000000401" }
    NAME = "control-centre"
