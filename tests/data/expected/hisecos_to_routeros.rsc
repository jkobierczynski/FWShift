# disabled in the source: "rule-70" from port1_1 to any; source 203.0.113.0/24; destination 10.30.0.20; service esp; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-port1_1 src-address=203.0.113.0/24 dst-address=10.30.0.20 protocol=ipsec-esp action=accept comment="rule-70" disabled=yes
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-port1_1 action=reject log=yes log-prefix="rule-90" comment="rule-90"
