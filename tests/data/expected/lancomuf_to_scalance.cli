configure terminal
firewall
service name FWS_internet.http proto tcp src all dst port 80
service name FWS_internet.https proto tcp src all dst port 443
service name FWS_tcp_53 proto tcp src all dst port 53
service name FWS_udp_53 proto udp src all dst port 53
proto name FWS_standard.ping num 1
service name FWS_standard.ssh proto tcp src all dst port 22
service name FWS_remote.rdp proto tcp src all dst port 3389
service name FWS_Modbus-TCP proto tcp src all dst port 502
service name FWS_OPC-UA proto tcp src all dst range 4840 - 4843
service name FWS_internet.smtp proto tcp src all dst port 25
proto name FWS_GRE-Tunnel num 47
service name FWS_udp_500 proto udp src all dst port 500
service name FWS_udp_4500 proto udp src all dst port 4500
proto name FWS_proto_50 num 50
ipv4rule from eth1 to WAN srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_internet.http log info prior 1
ipv4rule from eth1 to WAN srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_internet.https log info prior 1
ipv4rule from eth1 to WAN srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_tcp_53 log no prior 2
ipv4rule from eth1 to WAN srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_udp_53 log no prior 2
ipv4rule from eth1 to WAN srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_standard.ping log no prior 2
ipv4rule from WAN to eth2 srcip 0.0.0.0/0 dstip 172.16.20.10 action acc service FWS_internet.https log no prior 2
ipv4rule from eth1 to eth2 srcip 192.168.10.200-192.168.10.220 dstip 172.16.20.10 action acc service FWS_standard.ssh log no prior 2
ipv4rule from eth1 to eth2 srcip 192.168.10.200-192.168.10.220 dstip 172.16.20.25 action acc service FWS_standard.ssh log no prior 2
ipv4rule from eth1 to eth2 srcip 192.168.10.200-192.168.10.220 dstip 172.16.20.10 action acc service FWS_remote.rdp log no prior 2
ipv4rule from eth1 to eth2 srcip 192.168.10.200-192.168.10.220 dstip 172.16.20.25 action acc service FWS_remote.rdp log no prior 2
ipv4rule from eth2 to eth1 srcip 172.16.20.10 dstip 192.168.10.200-192.168.10.220 action acc service FWS_remote.rdp log no prior 2
ipv4rule from eth2 to eth1 srcip 172.16.20.25 dstip 192.168.10.200-192.168.10.220 action acc service FWS_remote.rdp log no prior 2
ipv4rule from eth1 to eth3 srcip 192.168.10.5 dstip 10.30.0.0/24 action acc service FWS_Modbus-TCP log info prior 3
ipv4rule from eth1 to eth2 srcip 192.168.10.0/24 dstip 172.16.20.25 action acc service FWS_internet.smtp log no prior 4
ipv4rule from eth2 to WAN srcip 172.16.20.0/24 dstip 0.0.0.0/0 action acc service FWS_GRE-Tunnel log no prior 4
ipv4rule from eth1 to eth2 srcip 192.168.10.0/24 dstip 172.16.20.0/24 action acc service FWS_internet.http log no prior 4
ipv4rule from eth1 to eth2 srcip 192.168.10.0/24 dstip 172.16.20.0/24 action acc service FWS_internet.https log no prior 4
ipv4rule from eth2 to eth1 srcip 172.16.20.0/24 dstip 192.168.10.0/24 action acc service FWS_internet.http log no prior 4
ipv4rule from eth2 to eth1 srcip 172.16.20.0/24 dstip 192.168.10.0/24 action acc service FWS_internet.https log no prior 4
ipv4rule from eth2 to eth1 srcip 172.16.20.0/24 dstip 192.168.10.0/24 action acc service FWS_udp_500 log info prior 5
ipv4rule from eth2 to eth1 srcip 172.16.20.0/24 dstip 192.168.10.0/24 action acc service FWS_udp_4500 log info prior 5
ipv4rule from eth2 to eth1 srcip 172.16.20.0/24 dstip 192.168.10.0/24 action acc service FWS_proto_50 log info prior 5
ipv4rule from WAN to eth1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from WAN to eth2 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from WAN to eth3 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from WAN to eth4 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth1 to WAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth1 to eth2 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth1 to eth3 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth1 to eth4 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth2 to WAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth2 to eth1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth2 to eth3 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth2 to eth4 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth3 to WAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth3 to eth1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth3 to eth2 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth3 to eth4 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth4 to WAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth4 to eth1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth4 to eth2 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
ipv4rule from eth4 to eth3 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 6
exit
end
