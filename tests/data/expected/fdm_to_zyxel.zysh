# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
address-object FWS_iot-net 10.41.0.0/24
address-object FWS_office-lan 10.40.0.0/24
service-object FWS_HTTP tcp eq 80
service-object FWS_HTTPS tcp eq 443
object-group service FWS_web
 service-object FWS_HTTP
 service-object FWS_HTTPS
exit
service-object FWS_DNS_over_UDP udp eq 53
object-group service FWS_Inside_Outside_web_svc
 object-group FWS_web
 service-object FWS_DNS_over_UDP
exit
address-object FWS_nothing 0.0.0.0
service-object FWS_nas-web tcp eq 5001
address-object FWS_nas 10.40.0.10
service-object FWS_rdp tcp eq 3389
service-object FWS_echo-request icmp 8
service-object FWS_gre protocol 47
object-group service FWS_Head_office_v6_svc
 service-object FWS_rdp
 service-object FWS_echo-request
 service-object FWS_gre
exit
address-object FWS_printers 10.40.0.200-10.40.0.220
object-group address FWS_office-devices
 address-object FWS_nas
 address-object FWS_printers
exit
service-object FWS_udp-src-53-dst-1024-_dst udp range 1024 65535
service-object FWS_noservice protocol 255
address-object FWS_any-ipv4 0.0.0.0/0
zone FWS_outside_zone
exit
zone FWS_inside_zone
exit
zone FWS_iot
exit
secure-policy insert 1
 name FWS_Block_IoT_to_office
 no activate
 from FWS_inside_zone
 to FWS_inside_zone
 sourceip FWS_iot-net
 destinationip FWS_office-lan
 action deny
 log
 activate
exit
secure-policy insert 2
 name FWS_Inside_Outside_web
 no activate
 from FWS_inside_zone
 to FWS_outside_zone
 sourceip FWS_office-lan
 service FWS_Inside_Outside_web_svc
 action allow
 log
 activate
exit
