ip virtual-server FWS_NAS_published interface outside original-ip 192.0.2.2 map-to 10.40.0.10 map-type port protocol tcp original-port 8443 mapped-port 5001
ip virtual-server FWS_nas_static interface outside original-ip 192.0.2.10 map-to 10.40.0.10 map-type any nat-1-1-map
policy insert 1
 deactivate
 description "FWShift InsideOutsideNatRule"
 interface inside
 source FWS_any-ipv4
 destination any
 service any
 next-hop auto
 snat outgoing-interface
 no deactivate
exit
policy insert 2
 deactivate
 description "FWShift IoT_out"
 interface iot
 source FWS_iot-net
 destination any
 service any
 next-hop auto
 snat outgoing-interface
exit
exit
# Put the interfaces in their zones (this changes traffic at once):
#   zone FWS_outside_zone / interface outside
#   zone FWS_inside_zone / interface inside
#   zone FWS_iot / interface iot
# Written inactive:
#   IoT_telemetry: host name object vendor-cloud: the form of an address object of a host name is not in the documentation FWShift could read
#   Head_office_v6: the sources and the destinations have no IP version in common: the rule matches nothing
#   Staff_streaming: not converted: an application condition
#   Guests_by_time: schedule 'office-hours' is not converted; the rule would apply at all times; service port-unreachable: source ports, an ICMP code, SCTP ports or protocol 0, which a service object cannot say
