# Generated by FWShift - review the conversion report before loading this.
# A script for /import on RouterOS 6 or 7: /import file-name=FILE verbose=yes
# Nothing in it changes traffic until the disabled jump rules at its end are enabled (in Safe Mode).
:if ([:len [/ip firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
:if ([:len [/ipv6 firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
/interface list add name=fws-in comment="fwshift"
/interface list member add list=fws-in interface="ethernet1" comment="fwshift"
/interface list add name=fws-out comment="fwshift"
/interface list member add list=fws-out interface="ethernet0" comment="fwshift"
/interface list add name=fws-lab comment="fwshift"
/interface list member add list=fws-lab interface="ethernet3" comment="fwshift"
/ip firewall address-list add list=fws-admins address="10.10.0.50"
/ip firewall address-list add list=fws-admins address="10.10.0.60"
/ip firewall address-list add list=fws-firewall_all address="203.0.113.2"
/ip firewall address-list add list=fws-firewall_all address="10.10.0.254"
/ip firewall address-list add list=fws-firewall_all address="10.20.0.254"
/ip firewall address-list add list=fws-firewall_all address="10.30.0.254"
/ip firewall address-list add list=fws-Network_internals address="10.10.0.0/24"
/ip firewall address-list add list=fws-Network_internals address="10.20.0.0/24"
/ip firewall address-list add list=fws-Network_internals address="10.30.0.0/24"
/ip firewall address-list add list=fws-dmz_servers address="10.20.0.10"
/ip firewall address-list add list=fws-dmz_servers address="10.20.0.25"
/ip firewall address-list add list=fws-r13-dst address="updates.example.com"
/ip firewall address-list add list=fws-r15-dst address="www.example.org"
/ipv6 firewall address-list add list=fws-r13-dst address="updates.example.com"
/ipv6 firewall address-list add list=fws-r15-dst address="www.example.org"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward src-address=192.0.2.128/25 action=drop comment="global 1"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-in src-address-list=fws-admins dst-address-list=fws-firewall_all protocol=tcp dst-port=22,443 action=accept comment="local 1"
/ip firewall filter add chain=fwshift-forward src-address-list=fws-Network_internals dst-address-list=fws-firewall_all protocol=icmp action=accept comment="local 2"
/ip firewall filter add chain=fwshift-forward dst-address=198.51.100.0/24 action=drop comment="local 3"
/ip firewall filter add chain=fwshift-forward src-address-list=fws-Network_internals dst-address-list=!fws-Network_internals protocol=tcp dst-port=80,443,8080-8090 action=accept log=yes log-prefix="local 4" comment="local 4"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-in src-address=10.10.0.0/24 protocol=udp dst-port=53 action=accept comment="local 5"
/ip firewall filter add chain=fwshift-forward src-address-list=fws-Network_internals protocol=tcp dst-port=113 action=reject reject-with=tcp-reset comment="local 6"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-out dst-address=203.0.113.3 protocol=tcp dst-port=80,443 action=accept log=yes log-prefix="local 8" comment="local 8"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-out dst-address-list=fws-dmz_servers protocol=tcp dst-port=25 action=accept comment="local 9"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lab src-address=10.30.0.0/24 protocol=tcp dst-port=5000-5010 action=accept comment="local 10"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lab src-address=10.30.0.0/24 protocol=udp dst-port=5000-5010 action=accept comment="local 10"
# FWSHIFT disabled, see the report: "local 11" from any to any; source lan; destination dmz_servers; service web_ports; action allow
/ip firewall filter add chain=fwshift-forward src-address=10.30.0.0/24 protocol=200 action=accept comment="local 12"
/ip firewall filter add chain=fwshift-forward src-address=!10.10.0.0/24 dst-address-list=fws-r13-dst protocol=tcp dst-port=443 action=accept comment="local 13"
/ipv6 firewall filter add chain=fwshift-forward dst-address-list=fws-r13-dst protocol=tcp dst-port=443 action=accept comment="local 13"
/ipv6 firewall filter add chain=fwshift-forward src-address=2001:db8:10::/64 action=accept comment="local 14"
/ip firewall filter add chain=fwshift-forward src-address=10.10.0.0/24 dst-address-list=fws-r15-dst protocol=tcp dst-port=80,8080-8090 action=accept comment="local 15"
/ip firewall filter add chain=fwshift-forward action=drop comment="local 16"
/ipv6 firewall filter add chain=fwshift-forward action=drop comment="local 16"
/ip firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ipv6 firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
