/ip firewall address-list add list=fws-Servers address="172.16.20.25"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-WAN src-address=192.168.10.0/24 protocol=tcp dst-port=80 action=accept comment="LAN to Internet - internet.http"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-WAN src-address=192.168.10.0/24 protocol=tcp dst-port=443 action=accept comment="LAN to Internet - internet.https"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-WAN src-address=192.168.10.0/24 protocol=tcp dst-port=53 action=accept comment="LAN to Internet - standard.dns"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-WAN src-address=192.168.10.0/24 protocol=udp dst-port=53 action=accept comment="LAN to Internet - standard.dns"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-WAN src-address=192.168.10.0/24 protocol=icmp action=accept comment="LAN to Internet - standard.ping"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-WAN out-interface-list=fws-eth2 dst-address=172.16.20.10 protocol=tcp dst-port=443 action=accept comment="Internet to Webserver - internet.https"
