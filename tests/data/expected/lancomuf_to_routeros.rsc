/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-WAN src-address=192.168.10.0/24 protocol=tcp dst-port=80 action=masquerade comment="LAN to Internet - internet.http (NAT)"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-WAN src-address=192.168.10.0/24 protocol=tcp dst-port=443 action=masquerade comment="LAN to Internet - internet.https (NAT)"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-WAN src-address=192.168.10.0/24 protocol=tcp dst-port=53 action=masquerade comment="LAN to Internet - standard.dns (NAT)"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-WAN src-address=192.168.10.0/24 protocol=udp dst-port=53 action=masquerade comment="LAN to Internet - standard.dns (NAT)"
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=srcnat action=jump jump-target=fwshift-srcnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
