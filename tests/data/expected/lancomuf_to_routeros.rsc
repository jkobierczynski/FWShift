/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth2 out-interface-list=fws-eth1 src-address-list=fws-Servers dst-address=192.168.10.200-192.168.10.220 protocol=tcp dst-port=3389 action=accept comment="Servers to Admin-PCs - remote.rdp"
