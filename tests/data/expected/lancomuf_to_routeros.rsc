/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth3 out-interface-list=fws-eth3 src-address=10.30.0.5 dst-address=10.30.0.0/24 protocol=tcp dst-port=502 action=accept comment="Jump-Hosts to OT-Cell - Modbus-TCP (eth3 to eth3)"
