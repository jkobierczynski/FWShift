/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth2 out-interface-list=fws-eth1 src-address=172.16.20.0/24 dst-address=192.168.10.0/24 protocol=tcp dst-port=80,443 action=accept comment="DMZ to LAN - Web"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth2 out-interface-list=fws-eth1 src-address=172.16.20.0/24 dst-address=192.168.10.0/24 protocol=udp dst-port=500,4500 action=accept comment="DMZ to LAN - vpn.ipsec"
