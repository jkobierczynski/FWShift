# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
address-object FWS_global_bad 192.0.2.128/25
service-object FWS_ssh tcp eq 22
service-object FWS_https tcp eq 443
object-group service FWS_local_1_svc
 service-object FWS_ssh
 service-object FWS_https
exit
address-object FWS_admin_ws 10.10.0.50
address-object FWS_10_10_0_60 10.10.0.60
object-group address FWS_dual_ws
 address-object FWS_10_10_0_60
exit
object-group address FWS_admins
 address-object FWS_admin_ws
 object-group FWS_dual_ws
exit
address-object FWS_Firewall_out 203.0.113.2
address-object FWS_Firewall_in 10.10.0.254
address-object FWS_Firewall_dmz1 10.20.0.254
address-object FWS_Firewall_lab 10.30.0.254
object-group address FWS_firewall_all
 address-object FWS_Firewall_out
 address-object FWS_Firewall_in
 address-object FWS_Firewall_dmz1
 address-object FWS_Firewall_lab
exit
service-object FWS__rule__ipproto-icmp protocol 1
address-object FWS_Network_in 10.10.0.0/24
address-object FWS_Network_dmz1 10.20.0.0/24
address-object FWS_Network_lab 10.30.0.0/24
object-group address FWS_Network_internals
 address-object FWS_Network_in
 address-object FWS_Network_dmz1
 address-object FWS_Network_lab
exit
address-object FWS_blocked 198.51.100.0/24
service-object FWS_http tcp eq 80
service-object FWS_web_alt tcp range 8080 8090
object-group service FWS_web_ports
 service-object FWS_http
 service-object FWS_https
 service-object FWS_web_alt
exit
address-object FWS_not_Network_internals_1 0.0.0.0-10.9.255.255
address-object FWS_not_Network_internals_2 10.10.1.0-10.19.255.255
address-object FWS_not_Network_internals_3 10.20.1.0-10.29.255.255
address-object FWS_not_Network_internals_4 10.30.1.0-255.255.255.255
object-group address FWS_not_Network_internals
 address-object FWS_not_Network_internals_1
 address-object FWS_not_Network_internals_2
 address-object FWS_not_Network_internals_3
 address-object FWS_not_Network_internals_4
exit
service-object FWS__rule__dns_udp-udp udp eq 53
service-object FWS_ident tcp eq 113
object-group service FWS_local_8_svc
 service-object FWS_http
 service-object FWS_https
exit
address-object FWS_web_pub 203.0.113.3
service-object FWS_smtp tcp eq 25
address-object FWS_web_srv 10.20.0.10
address-object FWS_mail_srv 10.20.0.25
object-group address FWS_dmz_servers
 address-object FWS_web_srv
 address-object FWS_mail_srv
exit
service-object FWS_tcp_5000_5010 tcp range 5000 5010
service-object FWS_udp_5000_5010 udp range 5000 5010
object-group service FWS_lab_tools
 service-object FWS_tcp_5000_5010
 service-object FWS_udp_5000_5010
exit
service-object FWS__rule__ipproto-proto_200 protocol 200
address-object FWS_not_lan_2 10.10.1.0-255.255.255.255
object-group address FWS_not_lan
 address-object FWS_not_Network_internals_1
 address-object FWS_not_lan_2
exit
address-object FWS_nothing 0.0.0.0
address6-object FWS_nothing6 ::
address6-object FWS_lan6 2001:db8:10::/64
object-group service FWS_local_15_svc
 service-object FWS_http
 service-object FWS_web_alt
exit
zone FWS_out
exit
zone FWS_in
exit
zone FWS_dmz1
exit
zone FWS_lab
exit
zone FWS_labbridge
exit
secure-policy insert 1
 name FWS_global_1
 no activate
 description "blocked company-wide"
 sourceip FWS_global_bad
 action deny
 log
 activate
exit
secure-policy insert 2
 name FWS_local_1
 no activate
 description "admin access"
 from FWS_in
 sourceip FWS_admins
 destinationip FWS_firewall_all
 service FWS_local_1_svc
 action allow
 log
 activate
exit
secure-policy insert 3
 name FWS_local_2
 no activate
 description "ping the firewall"
 sourceip FWS_Network_internals
 destinationip FWS_firewall_all
 service FWS__rule__ipproto-icmp
 action allow
 log
 activate
exit
secure-policy insert 4
 name FWS_local_3
 no activate
 description "known bad"
