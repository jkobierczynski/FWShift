configure terminal
address-object ipv4 "Quarantine" host 192.0.0.8 zone LAN
address-object ipv4 "n 10.10.0.0_16" network 10.10.0.0 255.255.0.0 zone LAN
address-object ipv4 "n 10.10.200.0_24" network 10.10.200.0 255.255.255.0 zone LAN
address-object ipv4 "h 10.20.0.10" host 10.20.0.10 zone LAN
address-object ipv4 "h 10.20.0.11" host 10.20.0.11 zone LAN
address-object ipv4 "n 10.20.1.0_24" network 10.20.1.0 255.255.255.0 zone LAN
address-object ipv4 "n 10.20.2.0_24" network 10.20.2.0 255.255.255.0 zone LAN
address-object ipv6 "n 2001:db8:20:2::_64" network 2001:db8:20:2:: /64 zone LAN
address-object ipv4 "r 10.10.5.10-10.10.5.20" range 10.10.5.10 10.10.5.20 zone LAN
address-object ipv4 "n 10.30.1.0_24" network 10.30.1.0 255.255.255.0 zone LAN
address-group ipv4 "LAN"
    address-object ipv4 "n 10.10.0.0_16"
    exit
address-group ipv4 "Guests"
    address-object ipv4 "n 10.10.200.0_24"
    exit
address-group ipv4 "DMZ"
    address-object ipv4 "h 10.20.0.10"
    address-object ipv4 "h 10.20.0.11"
    address-object ipv4 "n 10.20.1.0_24"
    exit
address-group ipv4 "Web servers"
    address-object ipv4 "h 10.20.0.10"
    address-object ipv4 "h 10.20.0.11"
    exit
address-group ipv4 "App servers"
    address-object ipv4 "n 10.20.1.0_24"
    exit
address-group ipv4 "DB servers"
    address-object ipv4 "n 10.20.2.0_24"
    exit
address-group ipv6 "DB servers v6"
    address-object ipv6 "n 2001:db8:20:2::_64"
    exit
address-group ipv4 "Admins"
    address-object ipv4 "r 10.10.5.10-10.10.5.20"
    exit
address-group ipv4 "OT cell"
    address-object ipv4 "n 10.30.1.0_24"
    exit
service-object "DNS" TCP 53 53
service-object "DNS-UDP" UDP 53 53
service-object "NTP.services" UDP 123 123
service-object "SSH 2" TCP 22 22
service-object "HTTPS 2" TCP 443 443
service-object "app-8443" TCP 8443 8443
service-object "MySQL" TCP 3306 3306
service-object "Modbus" TCP 502 502
service-object "FTP 2" TCP 21 21
service-group "Web all"
    service-object "HTTPS 2"
    service-object "app-8443"
    exit
service-group "svc DNS to resolvers"
    service-object "DNS"
    service-object "DNS-UDP"
    exit
commit
exit
