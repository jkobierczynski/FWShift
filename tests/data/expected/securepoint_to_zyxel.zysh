# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
service-object FWS_http tcp eq 80
service-object FWS_https tcp eq 443
service-object FWS_domain-udp udp eq 53
service-object FWS_icmp-echo-req icmp 8
service-object FWS_ftp tcp eq 21
object-group service FWS_default-internet
 service-object FWS_http
 service-object FWS_https
 service-object FWS_domain-udp
 service-object FWS_icmp-echo-req
 service-object FWS_ftp
exit
address-object FWS_internal-network 192.168.10.0/24
object-group service FWS_web
 service-object FWS_http
 service-object FWS_https
exit
address6-object FWS_lan6 2001:db8:10::/64
address-object FWS_partner-net 10.20.0.0/16
address-object FWS_nothing 0.0.0.0
address-object FWS_admin-pc 192.168.10.50
service-object FWS_ntp-client_dst udp eq 123
service-object FWS_icmpv6-echo icmpv6 128
address-object FWS_webserver 172.16.20.10
address-object FWS_external-interface 203.0.113.2
object-group address FWS_rule-18_dst
 address-object FWS_webserver
 address-object FWS_external-interface
exit
service-object FWS_extern-https tcp eq 8443
service-object FWS_smtp tcp eq 25
address-object FWS_public-mail 203.0.113.5
service-object FWS_ssh tcp eq 22
address-object FWS_mailserver 172.16.20.25
object-group address FWS_servers
 address-object FWS_webserver
 address-object FWS_mailserver
exit
address-object FWS_dmz1-network 172.16.20.0/24
service-object FWS_app-ports tcp range 8000 8010
service-object FWS_gre protocol 47
address-object FWS_printers 192.168.10.200-192.168.10.220
address-object FWS_internet 0.0.0.0/0
zone FWS_external
exit
zone FWS_internal
exit
zone FWS_dmz1
exit
zone FWS_vpn-ipsec
exit
secure-policy insert 1
 name FWS_rule-1
 no activate
 description "LAN to the internet"
 from FWS_internal
 to FWS_external
 sourceip FWS_internal-network
 service FWS_default-internet
 action allow
 log
 activate
exit
