configure terminal
firewall
service name FWS_tcp_80 proto tcp src all dst port 80
service name FWS_tcp_443 proto tcp src all dst port 443
service name FWS_tcp_8080-8081 proto tcp src all dst range 8080 - 8081
service name FWS_udp_53 proto udp src all dst port 53
service name FWS_tcp_53 proto tcp src all dst port 53
service name FWS_SSH proto tcp src all dst port 22
service name FWS_SMTP proto tcp src all dst port 25
service name FWS_hi-src proto tcp src range 1024 - 2000 dst port 9000
proto name FWS_esp num 50
icmp name FWS_echo-only type 8 code 0 ver ipv4
ipv4rule from Trust to Untrust srcip 10.10.0.0/16 dstip 0.0.0.0/0 action acc service FWS_tcp_80 log info prior 1
ipv4rule from Trust to Untrust srcip 10.10.0.0/16 dstip 0.0.0.0/0 action acc service FWS_tcp_443 log info prior 1
