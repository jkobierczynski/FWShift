firewallnat
src-nat srcint Trust dstint Untrust type ipv4 srcip 10.10.0.0/16 dstip 0.0.0.0/0 transip auto
netmap source srcint DMZ dstint Untrust type ipv4 srcip 10.20.0.10 dstip 0.0.0.0/0 transip 203.0.113.10
netmap destination srcint Untrust dstint DMZ type ipv4 srcip 0.0.0.0/0 dstip 203.0.113.10 transip 10.20.0.10
netmap source srcint Servers dstint Untrust type ipv4 srcip 10.30.0.24/29 dstip 0.0.0.0/0 transip 203.0.113.24/29
netmap destination srcint Untrust dstint Servers type ipv4 srcip 0.0.0.0/0 dstip 203.0.113.24/29 transip 10.30.0.24/29
napt srcint Untrust proto tcp type ipv4 dstip 203.0.113.20 transip 10.20.0.20 dstport 80 transport 80
napt srcint Untrust proto tcp type ipv4 dstip 203.0.113.20 transip 10.20.0.21 dstport 8443 transport 443
src-nat srcint Trust dstint Untrust type ipv4 srcip 0.0.0.0/0 dstip 0.0.0.0/0 transip auto
