output "fwshift_networks" {
  description = "Each network security group, with the networks of the subnets to associate it with"
  value = {
    "FWShift" = {
      id       = azurerm_network_security_group.nsg_FWShift.id
      networks = []
    }
  }
}

# Not written:
#   Allow-Web-Out: the rule is for zone trust, untrust, and a security rule names no zone: give the networks behind it with --zone-network
#   Allow-DNS: the rule is for zone trust, dmz, untrust, and a security rule names no zone: give the networks behind it with --zone-network
#   Inbound-Web: the rule is for zone untrust, dmz, and a security rule names no zone: give the networks behind it with --zone-network
#   Inbound-Mail: the rule is for zone untrust, dmz, and a security rule names no zone: give the networks behind it with --zone-network
#   Admin-SSH: source user match example\netadmins is not converted; the rule is for zone trust, dmz, and a security rule names no zone: give the networks behind it with --zone-network
#   Engineering to PLCs: the rule is for zone trust, ot, and a security rule names no zone: give the networks behind it with --zone-network
#   Block-Torrents: no port mapping for application(s) bittorrent; supply one with --app-map
#   Block-Region: references 'KP': not defined in the input
#   App-Server-Ports: the rule is for zone trust, dmz, and a security rule names no zone: give the networks behind it with --zone-network
#   Tagged-Servers-Updates: references 'tagged-servers': dynamic address group, members are not known statically; host name object updates.example.com: a security rule names addresses; the rule is for zone dmz, untrust, and a security rule names no zone: give the networks behind it with --zone-network
#   Not-From-Guests: the rule is for zone trust, dmz, and a security rule names no zone: give the networks behind it with --zone-network
