set address any-ipv4 ip-netmask 0.0.0.0/0
set address any-ipv6 ip-netmask ::/0
set address IPv4-Private-10.0.0.0-8 ip-netmask 10.0.0.0/8
set address lan-net ip-netmask 10.10.0.0/24
set address lan-net description "Office LAN"
set address dmz-net ip-netmask 10.20.0.0/24
set address ot-net ip-netmask 10.30.0.0/24
set address ot-net description "Production cell"
set address partner-net ip-netmask 198.51.100.0/24
set address branch-v6 ip-netmask 2001:db8:10::/48
set address web-srv ip-netmask 10.20.0.10/32
set address web-srv-pub ip-netmask 203.0.113.10/32
set address mail-srv ip-netmask 10.20.0.25/32
set address mail-srv-pub ip-netmask 203.0.113.25/32
set address admin-pcs ip-range 10.10.0.100-10.10.0.120
set address nat-pool ip-range 203.0.113.100-203.0.113.110
set address updates fqdn updates.example.com
set address outside-interface ip-netmask 203.0.113.2/32
set address outside-interface description "address of interface outside when the configuration was read"
set address h-10.20.0.30 ip-netmask 10.20.0.30
set address-group servers static [ web-srv mail-srv h-10.20.0.30 ]
set address-group internal static [ lan-net dmz-net servers ]
set address-group internal description "Everything behind the firewall"
set service HTTP protocol tcp port 80
set service HTTPS protocol tcp port 443
set service SSH protocol tcp port 22
set service DNS_over_UDP protocol udp port 53
set service DNS_over_TCP protocol tcp port 53
set service NTP-UDP protocol udp port 123
set service web-alt protocol tcp port 8080-8081
