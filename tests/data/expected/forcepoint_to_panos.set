set tag "Branch template"
set tag Inbound
set tag Outbound
set address "x__ Management Servers" ip-netmask 0.0.0.0/32
set address "x__ Management Servers" description "FWSHIFT PLACEHOLDER, matches nothing: an alias, whose value is set per engine, and the input holds no engine"
set address "x__ Local Cluster" ip-netmask 0.0.0.0/32
set address "x__ Local Cluster" description "FWSHIFT PLACEHOLDER, matches nothing: an alias, whose value is set per engine, and the input holds no engine"
set address dns-01 ip-netmask 192.168.10.53/32
set address net-dmz ip-netmask 192.168.10.0/24
set address "net-lan _in rules_" ip-range 10.1.0.1-10.1.255.254
set address admins ip-range 10.1.5.10-10.1.5.20
set address pub-web ip-netmask 203.0.113.10/32
set address updates.example.com fqdn updates.example.com
set address cdn.example.com fqdn cdn.example.com
set address net-lan ip-netmask 10.1.0.0/16
set address isp-gw ip-netmask 198.51.100.1/32
set address net-lan-v6 ip-netmask 2001:db8:20::/64
set address web-01-v6 ip-netmask 2001:db8:10::10/128
set address h-192.168.10.10 ip-netmask 192.168.10.10
set address h-192.168.10.11 ip-netmask 192.168.10.11
set address-group web-01 static [ h-192.168.10.10 h-192.168.10.11 ]
set address-group grp-web static [ web-01 net-dmz ]
set address-group "updates.example.com _names_" static [ updates.example.com cdn.example.com ]
set address-group "updates.example.com _names_" description "the names of domain name updates.example.com"
set address n-172.16.30.0_24 ip-netmask 172.16.30.0/24
set address n-2001_db8_30___64 ip-netmask 2001:db8:30::/64
set address-group net-guest static [ n-172.16.30.0_24 n-2001_db8_30___64 ]
set address-group grp-inside static [ net-lan net-guest ]
set address-group grp-inside description "networks behind the branch firewall"
set address r-10.1.0.0-10.1.5.9 ip-range 10.1.0.0-10.1.5.9
set address r-10.1.5.21-10.1.255.255 ip-range 10.1.5.21-10.1.255.255
set address-group "lan without admins" static [ r-10.1.0.0-10.1.5.9 r-10.1.5.21-10.1.255.255 ]
set address-group "lan without admins" description "(the addresses of the expression)"
set address h-192.168.10.25 ip-netmask 192.168.10.25
set address h-2001_db8_10__25 ip-netmask 2001:db8:10::25
set address-group mail-01 static [ h-192.168.10.25 h-2001_db8_10__25 ]
set address-group mail-01 description "dual stack"
set address-group "mail-01 IPv4" static h-192.168.10.25
set address-group "mail-01 IPv4" description "the IPv4 addresses of mail-01"
