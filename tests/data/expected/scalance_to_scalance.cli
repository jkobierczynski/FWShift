configure terminal
firewall
service name FWS_SYSLOG proto udp src all dst port 514
service name FWS_S7COMM proto tcp src all dst port 102
service name FWS_OPC-UA proto tcp src all dst port 4840
service name FWS_MODBUS proto tcp src all dst port 502
icmp name FWS_PING type 8 code 0 ver ipv4
service name FWS_HTTPS proto tcp src all dst port 443
service name FWS_HIGHPORTS proto tcp src range 1024 - 65535 dst range 8000 - 8100
proto name FWS_GRE num 47
icmp name FWS_UNREACH type 3 code 4 ver ipv4
icmp name FWS_PING6 type 128 code 0 ver ipv6
ipv4rule from vlan 1 to vlan 2 srcip 192.168.10.0/24 dstip 198.51.100.200 action acc service FWS_SYSLOG log no prior 1
ipv4rule from vlan 2 to vlan 1 srcip 198.51.100.0/24 dstip 192.168.10.0/24 action drop service FWS_S7COMM log info prior 2
ipv4rule from vlan 2 to vlan 1 srcip 198.51.100.10 dstip 192.168.10.20 action acc service FWS_OPC-UA log info prior 3
ipv4rule from vlan 2 to vlan 1 srcip 198.51.100.40-198.51.100.49 dstip 192.168.10.30 action acc service FWS_MODBUS log no prior 4
ipv4rule from vlan 1 to vlan 2 srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_PING log no prior 4
ipv4rule from vlan 2 to vlan 3 srcip 0.0.0.0/0 dstip 192.168.30.10 action acc service FWS_HTTPS log info prior 5
ipv4rule from vlan 2 to vlan 3 srcip 0.0.0.0/0 dstip 192.168.30.64/30 action acc service FWS_HIGHPORTS log no prior 6
ipv4rule from vlan 3 to vlan 1 srcip 192.168.30.0/24 dstip 192.168.10.0/24 action rej log info prior 7
ipv4rule from vlan 1 to vlan 3 srcip 192.168.10.0/24 dstip 192.168.30.0/24 action acc service FWS_GRE log no prior 8
ipv4rule from ipsecALL to vlan 1 srcip 10.30.0.0/16 dstip 192.168.10.0/24 action acc service FWS_S7COMM log info prior 9
ipv4rule from vlan 3 to vlan 2 srcip 192.168.30.0/24 dstip 0.0.0.0/0 action acc service FWS_UNREACH log no prior 10
ipv6rule from vlan 2 to vlan 1 srcip 2001:db8:2::/64 dstip 2001:db8:1::10 action acc service FWS_OPC-UA log info prior 11
ipv6rule from vlan 1 to vlan 2 srcip 2001:db8:1::/64 dstip ::/0 action acc service FWS_PING6 log no prior 12
ipv4rule from vlan 1 to vlan 2 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 13
ipv6rule from vlan 1 to vlan 2 srcip ::/0 dstip ::/0 action drop log no prior 13
ipv4rule from vlan 1 to vlan 3 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 13
ipv6rule from vlan 1 to vlan 3 srcip ::/0 dstip ::/0 action drop log no prior 13
ipv4rule from vlan 1 to ipsecALL srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 13
ipv6rule from vlan 1 to ipsecALL srcip ::/0 dstip ::/0 action drop log no prior 13
ipv4rule from vlan 2 to vlan 1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 13
ipv6rule from vlan 2 to vlan 1 srcip ::/0 dstip ::/0 action drop log no prior 13
ipv4rule from vlan 2 to vlan 3 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 13
ipv6rule from vlan 2 to vlan 3 srcip ::/0 dstip ::/0 action drop log no prior 13
ipv4rule from vlan 2 to ipsecALL srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 13
ipv6rule from vlan 2 to ipsecALL srcip ::/0 dstip ::/0 action drop log no prior 13
ipv4rule from vlan 3 to vlan 1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 13
ipv6rule from vlan 3 to vlan 1 srcip ::/0 dstip ::/0 action drop log no prior 13
ipv4rule from vlan 3 to vlan 2 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 13
ipv6rule from vlan 3 to vlan 2 srcip ::/0 dstip ::/0 action drop log no prior 13
ipv4rule from vlan 3 to ipsecALL srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 13
ipv6rule from vlan 3 to ipsecALL srcip ::/0 dstip ::/0 action drop log no prior 13
ipv4rule from ipsecALL to vlan 1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 13
ipv6rule from ipsecALL to vlan 1 srcip ::/0 dstip ::/0 action drop log no prior 13
ipv4rule from ipsecALL to vlan 2 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 13
ipv6rule from ipsecALL to vlan 2 srcip ::/0 dstip ::/0 action drop log no prior 13
ipv4rule from ipsecALL to vlan 3 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 13
ipv6rule from ipsecALL to vlan 3 srcip ::/0 dstip ::/0 action drop log no prior 13
exit
firewallnat
napt srcint vlan 2 proto tcp type ipv4 dstip 198.51.100.2 transip 192.168.30.10 dstport 8443 transport 443
napt srcint vlan 2 proto udp type ipv4 dstip 198.51.100.5 transip 192.168.10.20 dstport 4840 transport 4840
netmap destination srcint vlan 2 dstint vlan 3 type ipv4 srcip 0.0.0.0/0 dstip 198.51.100.64/30 transip 192.168.30.64/30
src-nat srcint vlan 1 dstint vlan 2 type ipv4 srcip 192.168.10.0/24 dstip 0.0.0.0/0 transip 198.51.100.3
masquerading vlan 2
exit
end
