configure terminal
address-object ipv4 "lan-net" network 10.10.0.0 255.255.0.0 zone ExternalZone
address-object ipv4 "dmz-net" network 10.20.0.0 255.255.255.0 zone ExternalZone
address-object ipv4 "dns-1" host 192.0.2.53 zone ExternalZone
address-object ipv4 "admin-range" range 10.10.5.10 10.10.5.20 zone ExternalZone
address-object ipv4 "web-1" host 10.20.0.10 zone ExternalZone
address-object ipv4 "web-1_valid_address" host 203.0.113.10 zone ExternalZone
address-object ipv4 "mail-1" host 10.20.0.25 zone ExternalZone
address-object ipv4 "guest-net" network 10.10.200.0 255.255.255.0 zone ExternalZone
address-object ipv4 "netadmins" host 192.0.0.8 zone ExternalZone
address-object ipv4 "plc-net" network 10.30.1.0 255.255.255.0 zone ExternalZone
address-object fqdn "x.updates.example.com" domain "updates.example.com" zone ExternalZone
address-object ipv4 "lan-without-guests" host 192.0.0.8 zone ExternalZone
address-object ipv6 "lan6-net" network 2001:db8:10:: /48 zone ExternalZone
address-object ipv4 "gw-edge" host 198.51.100.1 zone ExternalZone
address-object ipv4 "mail-public" host 203.0.113.25 zone ExternalZone
address-object ipv4 "nat-out" host 198.51.100.20 zone ExternalZone
address-object ipv4 "h 192.0.2.54" host 192.0.2.54 zone ExternalZone
address-object ipv6 "h 2001:db8:53::54" host 2001:db8:53::54 zone ExternalZone
address-object ipv4 "r 0.0.0.0-192.0.2.52" range 0.0.0.0 192.0.2.52 zone ExternalZone
address-object ipv4 "r 192.0.2.55-255.255.255.255" range 192.0.2.55 255.255.255.255 zone ExternalZone
address-group ipv4 "dns-2"
    address-object ipv4 "h 192.0.2.54"
    exit
address-group ipv6 "dns-2 v6"
    address-object ipv6 "h 2001:db8:53::54"
    exit
address-group ipv4 "dns-servers"
    address-object ipv4 "dns-1"
    address-object ipv4 "h 192.0.2.54"
    exit
address-group ipv6 "dns-servers v6"
    address-object ipv6 "h 2001:db8:53::54"
    exit
address-group ipv4 "dmz-servers"
    address-object ipv4 "web-1"
    address-object ipv4 "web-1_valid_address"
    address-object ipv4 "mail-1"
    exit
address-group ipv4 "src DNS"
    address-object ipv4 "lan-net"
    address-object ipv4 "dmz-net"
    exit
address-group ipv4 "dst Guests stay out"
    address-object ipv4 "r 0.0.0.0-192.0.2.52"
    address-object ipv4 "r 192.0.2.55-255.255.255.255"
    exit
address-group ipv4 "dst Public web"
    address-object ipv4 "web-1"
    address-object ipv4 "web-1_valid_address"
    exit
service-object "domain-udp" UDP 53 53
service-object "domain-tcp" TCP 53 53
service-object "ssh 2" TCP 22 22
service-object "http 2" TCP 80 80
service-object "https 2" TCP 443 443
service-object "tcp-high" TCP 9000 9010
service-object "smtp" TCP 25 25
service-object "ident" TCP 113 113
service-object "tcp-2525" TCP 2525 2525
service-object "tcp 25" TCP 25 25
service-group "app-ports"
    service-object "https 2"
    service-object "tcp-high"
    exit
service-group "svc DNS"
    service-object "domain-udp"
    service-object "domain-tcp"
    exit
service-group "svc Web out"
    service-object "http 2"
    service-object "https 2"
    exit
service-group "svc PLC access"
    service-object "https 2"
    service-object "ssh 2"
    exit
service-group "svc PLC access (plc-operators)"
    service-object "https 2"
    service-object "ssh 2"
    exit
service-group "svc PLC access (vendor-support)"
    service-object "https 2"
    service-object "ssh 2"
    exit
nat-policy inbound any outbound any source name "web-1" translated-source name "web-1_valid_address" destination any translated-destination original service any translated-service original
    name "nat-1"
    comment "automatic NAT rule"
    exit
nat-policy inbound any outbound any source any translated-source original destination name "web-1_valid_address" translated-destination name "web-1" service any translated-service original
    name "nat-2"
    comment "automatic NAT rule"
    exit
nat-policy inbound any outbound any source name "plc-net" translated-source original destination name "plc-net" translated-destination original service any translated-service original
    name "nat-3"
    comment "automatic NAT rule"
    exit
nat-policy inbound any outbound any source name "lan-net" translated-source original destination name "dmz-net" translated-destination original service any translated-service original
    name "nat-5"
    comment "No NAT towards the DMZ"
    exit
nat-policy inbound any outbound any source any translated-source original destination name "mail-public" translated-destination name "mail-1" service name "tcp-2525" translated-service name "tcp 25"
    name "nat-6"
    comment "Mail on an alternative port"
    exit
nat-policy inbound any outbound any source name "dmz-net" translated-source name "nat-out" destination any translated-destination original service any translated-service original
    name "nat-7"
    comment "nat-7"
    exit
nat-policy inbound any outbound any source name "guest-net" translated-source name "nat-out" destination any translated-destination original service any translated-service original
    name "nat-9"
    comment "nat-9"
    no enable
    exit
