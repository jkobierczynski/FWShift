# Generated by FWShift: AWS EC2 security groups for one VPC (hashicorp/aws), as Terraform configuration.
# Read the report first: what is not written is listed there.
#
#   terraform init
#   terraform plan -var vpc_id=vpc-...      shows what would be created
#   terraform apply -var vpc_id=vpc-...     creates the groups and their rules
#
# The groups are created WITHOUT members: nothing changes for any traffic until they are attached. Attach each
# group to the network interfaces whose private addresses are listed above it (# attach ...): an interface gets
# every group whose list holds one of its addresses, and then no other groups. A group of the same name in the
# VPC makes the apply fail; nothing that exists is changed. Terraform takes away the outbound rule AWS gives a
# new group: a group allows outbound what its egress rules below allow, and nothing else.

terraform {
  required_version = ">= 1.3"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0"
    }
  }
}

variable "vpc_id" {
  description = "The VPC to create the security groups in (vpc-...)"
  type        = string
}

# attach fwshift-addresses-ipv6: ::-2001:db8:f:ffff:ffff:ffff:ffff:ffff 2001:db8:10:1::-2001:db8:98:ffff:ffff:ffff:ffff:ffff 2001:db8:9a::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
resource "aws_security_group" "g1" {
  name        = "fwshift-addresses-ipv6"
  description = "FWShift: for the interfaces of ::-2001:db8:f:ffff:ffff:ffff:ffff:ffff 2001:db8:10:1::-2001:db8:98:ffff:ffff:ffff:ffff:ffff 2001:db8:9a::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

# attach fwshift-lan6-ipv6: 2001:db8:10::/64
resource "aws_security_group" "g2" {
  name        = "fwshift-lan6-ipv6"
  description = "FWShift: for the interfaces of 2001:db8:10::/64"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

# attach fwshift-partners-ipv6-ipv6: 2001:db8:99::/48
resource "aws_security_group" "g3" {
  name        = "fwshift-partners-ipv6-ipv6"
  description = "FWShift: for the interfaces of 2001:db8:99::/48"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

# attach fwshift-no-rules: 0.0.0.0/0
resource "aws_security_group" "g4" {
  name        = "fwshift-no-rules"
  description = "FWShift: for the interfaces of 0.0.0.0/0"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

resource "aws_vpc_security_group_ingress_rule" "g1_in_1" {
  security_group_id = aws_security_group.g1.id
  ip_protocol       = "icmpv6"
  from_port         = 128
  to_port           = -1
  cidr_ipv6         = "::/0"
  description       = "FWShift: ICMPv6 echo"
}

resource "aws_vpc_security_group_egress_rule" "g1_out_1" {
  security_group_id = aws_security_group.g1.id
  ip_protocol       = "icmpv6"
  from_port         = 128
  to_port           = -1
  cidr_ipv6         = "::/0"
  description       = "FWShift: ICMPv6 echo"
}

resource "aws_vpc_security_group_ingress_rule" "g2_in_1" {
  security_group_id = aws_security_group.g2.id
  ip_protocol       = "tcp"
  from_port         = 443
  to_port           = 443
  cidr_ipv6         = "2001:db8:99::/48"
  description       = "FWShift: the partners reach the web servers of the LAN by HTTPS and nothing else"
}

resource "aws_vpc_security_group_ingress_rule" "g2_in_2" {
  security_group_id = aws_security_group.g2.id
  ip_protocol       = "icmpv6"
  from_port         = 128
  to_port           = -1
  cidr_ipv6         = "::/0"
  description       = "FWShift: ICMPv6 echo"
}

resource "aws_vpc_security_group_egress_rule" "g2_out_1" {
  security_group_id = aws_security_group.g2.id
  ip_protocol       = "icmpv6"
  from_port         = 128
  to_port           = -1
  cidr_ipv6         = "::/0"
  description       = "FWShift: ICMPv6 echo"
}

resource "aws_vpc_security_group_ingress_rule" "g3_in_1" {
  security_group_id = aws_security_group.g3.id
  ip_protocol       = "icmpv6"
  from_port         = 128
  to_port           = -1
  cidr_ipv6         = "::/0"
  description       = "FWShift: ICMPv6 echo"
}

resource "aws_vpc_security_group_egress_rule" "g3_out_1" {
  security_group_id = aws_security_group.g3.id
  ip_protocol       = "tcp"
  from_port         = 443
  to_port           = 443
  cidr_ipv6         = "2001:db8:10::/64"
  description       = "FWShift: the partners reach the web servers of the LAN by HTTPS and nothing else"
}

resource "aws_vpc_security_group_egress_rule" "g3_out_2" {
  security_group_id = aws_security_group.g3.id
  ip_protocol       = "icmpv6"
  from_port         = 128
  to_port           = -1
  cidr_ipv6         = "::/0"
  description       = "FWShift: ICMPv6 echo"
}

output "fwshift_attach" {
  description = "Each security group, with the private addresses of the network interfaces to attach it to"
  value = {
    "fwshift-addresses-ipv6" = {
      id        = aws_security_group.g1.id
      addresses = ["::-2001:db8:f:ffff:ffff:ffff:ffff:ffff", "2001:db8:10:1::-2001:db8:98:ffff:ffff:ffff:ffff:ffff", "2001:db8:9a::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff"]
    }
    "fwshift-lan6-ipv6" = {
      id        = aws_security_group.g2.id
      addresses = ["2001:db8:10::/64"]
    }
    "fwshift-partners-ipv6-ipv6" = {
      id        = aws_security_group.g3.id
      addresses = ["2001:db8:99::/48"]
    }
    "fwshift-no-rules" = {
      id        = aws_security_group.g4.id
      addresses = ["0.0.0.0/0"]
    }
  }
}

