# Generated by FWShift - review the conversion report before loading this.
# FORWARD chain and nat table for iptables-restore.
# It does not contain INPUT or OUTPUT: load it with --noflush, or merge it into your ruleset.
*filter
:FORWARD ACCEPT [0:0]
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
-A FORWARD -i pppoe0 -o eth1 -s 192.168.10.0/24 -d 192.168.1.30/32 -p tcp -m tcp --dport 32400 -m comment --comment "no media from the guests" -j REJECT
-A FORWARD -i pppoe0 -d 192.168.1.30/32 -p tcp -m tcp --dport 32400 -m conntrack --ctstate NEW -m comment --comment "plex to the media box" -j ACCEPT
-A FORWARD -i pppoe0 -d 192.168.1.20/32 -p icmp -m icmp --icmp-type 8 -m conntrack --ctstate NEW -m comment --comment "ping the nas" -j ACCEPT
-A FORWARD -i pppoe0 -d 192.168.1.21/32 -p icmp -m icmp --icmp-type 8 -m conntrack --ctstate NEW -m comment --comment "ping the nas" -j ACCEPT
# disabled in the source: "old rule" from pppoe0 to any; source any; destination 192.168.1.40; service tcp-any; action allow
-A FORWARD -i pppoe0 -d 192.168.1.25/32 -p tcp -m tcp --dport 25 -m conntrack --ctstate NEW -m comment --comment "syn to the mail server" -j ACCEPT
# FWSHIFT disabled, see the report: "no media from the guests-2" from pppoe0 to eth1; source 192.168.10.0/24; destination any; service tcp-8096-8097,32400+udp-8096-8097,32400; action deny
# FWSHIFT disabled, see the report: "sessions of the voip box" from pppoe0 to any; source 0.0.0.0/0; destination any; service any; action allow
-A FORWARD -i pppoe0 -m comment --comment "forward-5.default" -j DROP
-A FORWARD -i eth1.10 -d 192.168.1.0/25 -m comment --comment "no way into the LAN" -j DROP
-A FORWARD -i eth1.10 -d 10.8.0.0/24 -m comment --comment "no way into the LAN" -j DROP
-A FORWARD -i eth1.10 -p tcp -m multiport --dports 0:52,54:79,81:442,444:65535 -m comment --comment "only web and dns out" -j DROP
-A FORWARD -i eth1.10 -p udp -m multiport --dports 0:52,54:79,81:442,444:65535 -m comment --comment "only web and dns out" -j DROP
-A FORWARD -o eth1 -s 192.168.10.0/24 -p tcp -m multiport --dports 8096:8097,32400 -m comment --comment "no media from the guests-3" -j REJECT
-A FORWARD -o eth1 -s 192.168.10.0/24 -p udp -m multiport --dports 8096:8097,32400 -m comment --comment "no media from the guests-3" -j REJECT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i pppoe0 -p tcp -m tcp --dport 32400 -m comment --comment "plex from outside" -j DNAT --to-destination 192.168.1.30
-A PREROUTING -i pppoe0 -d 198.51.100.7/32 -p tcp -m tcp --dport 8443 -m comment --comment "web on 8443 to the nas" -j DNAT --to-destination 192.168.1.20:443
-A POSTROUTING -o pppoe0 -s 192.168.1.20/32 -m comment --comment "nas leaves as its own address" -j SNAT --to-source 198.51.100.7
-A POSTROUTING -o pppoe0 -m comment --comment "masquerade for WAN" -j MASQUERADE
COMMIT
