configure terminal
address-object ipv4 "Web-Server.1.alm" host 10.20.0.10 zone DMZ
address-object ipv4 "Mail-Server.1.alm" host 10.20.0.25 zone DMZ
address-object ipv4 "Admins.1.alm" range 10.10.5.10 10.10.5.20 zone Trusted
address-object ipv4 "Bad-Nets.1.alm" network 203.0.113.0 255.255.255.128 zone DMZ
address-object ipv4 "Bad-Nets.2.alm" host 192.0.2.66 zone DMZ
address-object fqdn "Update-Site.1.alm updates.exampl" domain "updates.example.com" zone DMZ
address-object ipv4 "Web-Public.1.snat" host 198.51.100.10 zone External
address-object ipv4 "Web-Public.2.snat" host 10.20.0.10 zone DMZ
address-object ipv4 "Mail-Public.1.snat" host 198.51.100.11 zone External
address-object ipv4 "Mail-Public.2.snat" host 10.20.0.25 zone DMZ
address-object ipv4 "h 198.51.100.2" host 198.51.100.2 zone DMZ
address-object ipv4 "h 10.10.0.1" host 10.10.0.1 zone DMZ
address-object ipv4 "h 10.20.0.1" host 10.20.0.1 zone DMZ
address-object ipv4 "h 10.30.0.1" host 10.30.0.1 zone DMZ
address-object ipv4 "h 10.40.0.1" host 10.40.0.1 zone DMZ
address-group ipv4 "Update-Site.1.alm"
    address-object fqdn "Update-Site.1.alm updates.exampl"
    exit
address-group ipv6 "Update-Site.1.alm v6"
    address-object fqdn "Update-Site.1.alm updates.exampl"
    exit
address-group ipv4 "Firebox"
    address-object ipv4 "h 198.51.100.2"
    address-object ipv4 "h 10.10.0.1"
    address-object ipv4 "h 10.20.0.1"
    address-object ipv4 "h 10.30.0.1"
    address-object ipv4 "h 10.40.0.1"
    exit
address-group ipv4 "dst Block Bad"
    address-object ipv4 "Bad-Nets.1.alm"
    address-object ipv4 "Bad-Nets.2.alm"
    exit
service-object "SSH 2" TCP 22 22
service-object "Web Out tcp 80" TCP 80 80
service-object "Web Out tcp 443" TCP 443 443
service-object "Web Out tcp 8000-8010" TCP 8000 8010
service-group "Web Out"
    service-object "Web Out tcp 80"
    service-object "Web Out tcp 443"
    service-object "Web Out tcp 8000-8010"
    exit
service-object "HTTPS 2" TCP 443 443
service-object "SMTP" TCP 25 25
service-object "Staff Only" TCP 3389 3389
service-object "DNS tcp 53" TCP 53 53
service-object "DNS udp 53" UDP 53 53
service-group "DNS"
    service-object "DNS tcp 53"
    service-object "DNS udp 53"
    exit
service-object "tcp 2525" TCP 2525 2525
nat-policy inbound any outbound any source any translated-source original destination name "Web-Public.1.snat" translated-destination name "Web-Public.2.snat" service name "HTTPS 2" translated-service original
    name "Web-Public (Web In)"
    comment "static NAT action Web-Public of"
    exit
nat-policy inbound any outbound any source any translated-source original destination name "Mail-Public.1.snat" translated-destination name "Mail-Public.2.snat" service name "SMTP" translated-service name "tcp 2525"
    name "Mail-Public (Mail In)"
    comment "static NAT action Mail-Public of"
    exit
