{
  "apiVersion": "projectcalico.org/v3",
  "kind": "GlobalNetworkPolicy",
  "metadata": {
    "name": "fwshift",
    "annotations": {
      "fwshift/generated": "FWShift - review the conversion report before applying this",
      "fwshift/not-written": "Allow DNS to resolvers (not written, see the report); Block malicious IPs and domains (not written, see the report); Office 365 One Click Rule (disabled in the source); Partner app (not written, see the report); Branch web (not written, see the report); Engineers to SaaS (not written, see the report); No embargoed countries (not written, see the report); Printers syslog (not written, see the report); Infra out (disabled in the source); Evaluate apps (not written, see the report); Ranked web (not written, see the report); Ghent and corporate (not written, see the report); Web for all (not written, see the report); Guest ICMP (not written, see the report)"
    }
  },
  "spec": {
    "tier": "default",
    "order": 100,
    "selector": "fwshift/policy == 'fwshift'",
    "types": [
      "Ingress",
      "Egress"
    ],
    "ingress": [
      {
        "action": "Deny",
        "protocol": "TCP",
        "destination": {
          "ports": [
            22
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Block SSH out"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": 47,
        "metadata": {
          "annotations": {
            "fwshift/rule": "Block GRE and ESP"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": 50,
        "metadata": {
          "annotations": {
            "fwshift/rule": "Block GRE and ESP"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "Default Firewall Filtering Rule"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
        }
      }
    ],
    "egress": [
      {
        "action": "Deny",
        "protocol": "TCP",
        "destination": {
          "ports": [
            22
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Block SSH out"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": 47,
        "metadata": {
          "annotations": {
            "fwshift/rule": "Block GRE and ESP"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": 50,
        "metadata": {
          "annotations": {
            "fwshift/rule": "Block GRE and ESP"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "Default Firewall Filtering Rule"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
        }
      }
    ]
  }
}
