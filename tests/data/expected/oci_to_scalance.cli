configure terminal
firewall
service name FWS_svc-tcp5432 proto tcp src range 0 - 1023 dst port 5432
service name FWS_tcp_1-65535_from_0-21 proto tcp src range 0 - 21 dst range 1 - 65535
service name FWS_tcp_1-65535_from_23-65535 proto tcp src range 23 - 65535 dst range 1 - 65535
icmp name FWS_icmp-8 type 8 code 0 ver ipv4
service name FWS_tcp-5432 proto tcp src all dst port 5432
service name FWS_tcp-22 proto tcp src all dst port 22
icmp name FWS_icmp-3-4 type 3 code 4 ver ipv4
icmp name FWS_icmp_3_0 type 3 code 0 ver ipv4
icmp name FWS_icmp_3_1 type 3 code 1 ver ipv4
icmp name FWS_icmp_3_2 type 3 code 2 ver ipv4
icmp name FWS_icmp_3_3 type 3 code 3 ver ipv4
icmp name FWS_icmp_3_5 type 3 code 5 ver ipv4
icmp name FWS_icmp_3_6 type 3 code 6 ver ipv4
icmp name FWS_icmp_3_7 type 3 code 7 ver ipv4
icmp name FWS_icmp_3_8 type 3 code 8 ver ipv4
icmp name FWS_icmp_3_9 type 3 code 9 ver ipv4
icmp name FWS_icmp_3_10 type 3 code 10 ver ipv4
icmp name FWS_icmp_3_11 type 3 code 11 ver ipv4
icmp name FWS_icmp_3_12 type 3 code 12 ver ipv4
icmp name FWS_icmp_3_13 type 3 code 13 ver ipv4
icmp name FWS_icmp_3_14 type 3 code 14 ver ipv4
icmp name FWS_icmp_3_15 type 3 code 15 ver ipv4
icmp name FWS_icmpv6-2-0 type 2 code 0 ver ipv6
service name FWS_tcp-443 proto tcp src all dst port 443
service name FWS_tcp-80 proto tcp src all dst port 80
service name FWS_tcp-8080 proto tcp src all dst port 8080
proto name FWS_ip-47 num 47
service name FWS_tcp-1-65535 proto tcp src all dst range 1 - 65535
icmp name FWS_icmpv6-128 type 128 code 0 ver ipv6
service name FWS_tcp-8080-8443 proto tcp src all dst range 8080 - 8443
service name FWS_tcp-7000-7001 proto tcp src all dst range 7000 - 7001
service name FWS_udp-123-from-123 proto udp src port 123 dst port 123
exit
end
