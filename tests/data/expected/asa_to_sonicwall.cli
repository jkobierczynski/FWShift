configure terminal
address-object ipv4 "web-srv" host 10.20.0.10 zone dmz
address-object ipv4 "mail-srv" host 10.20.0.25 zone dmz
address-object ipv4 "inside-net" network 10.10.0.0 255.255.0.0 zone inside
address-object ipv6 "inside-v6" network 2001:db8:10:: /64 zone inside
address-object ipv4 "admin-range" range 10.10.5.10 10.10.5.20 zone inside
address-object fqdn "updates" domain "updates.example.com" zone outside
address-object ipv4 "web-public" host 203.0.113.10 zone outside
address-object ipv4 "branch-net" network 10.99.0.0 255.255.0.0 zone outside
address-object ipv4 "guest-pool" range 203.0.113.100 203.0.113.110 zone outside
address-object ipv4 "FWSHIFT-ROUTED-1" range 0.0.0.0 192.168.0.255 zone inside
address-object ipv4 "FWSHIFT-ROUTED-2" range 192.168.2.0 255.255.255.255 zone outside
address-object ipv4 "h 10.20.0.50" host 10.20.0.50 zone dmz
address-object ipv4 "n 10.40.0.0_16" network 10.40.0.0 255.255.0.0 zone dmz
address-object ipv4 "h 203.0.113.25" host 203.0.113.25 zone dmz
address-object ipv4 "n 0.0.0.0_1" network 0.0.0.0 128.0.0.0 zone dmz
address-object ipv4 "n 128.0.0.0_1" network 128.0.0.0 128.0.0.0 zone dmz
address-object ipv6 "n ::_1" network :: /1 zone dmz
address-object ipv6 "n 8000::_1" network 8000:: /1 zone dmz
address-group ipv4 "dmz-servers"
    address-object ipv4 "web-srv"
    address-object ipv4 "mail-srv"
    address-object ipv4 "h 10.20.0.50"
    exit
address-group ipv4 "internal"
    address-object ipv4 "inside-net"
    address-object ipv4 "n 10.40.0.0_16"
    address-object ipv4 "web-srv"
    address-object ipv4 "mail-srv"
    address-object ipv4 "h 10.20.0.50"
    exit
address-group ipv4 "FWSHIFT-ROUTED"
    address-object ipv4 "FWSHIFT-ROUTED-1"
    address-object ipv4 "FWSHIFT-ROUTED-2"
    exit
address-group ipv4 "dst outside_access_in-1"
    address-object ipv4 "web-srv"
    address-object ipv4 "web-public"
    exit
address-group ipv4 "dst outside_access_in-2"
    address-object ipv4 "mail-srv"
    address-object ipv4 "h 203.0.113.25"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
address-group ipv4 "dst inside_access_in-3"
    address-group ipv4 "dmz-servers"
    address-object ipv4 "h 203.0.113.25"
    exit
service-object "app-8443" TCP 8443 8443
service-object "mail-services-inline tcp 25" TCP 25 25
service-object "mail-services-inline tcp 587" TCP 587 587
service-group "mail-services-inline"
    service-object "mail-services-inline tcp 25"
    service-object "mail-services-inline tcp 587"
    exit
service-object "dns-ntp tcp 53" TCP 53 53
service-object "dns-ntp udp 53" UDP 53 53
service-object "dns-ntp udp 123" UDP 123 123
service-group "dns-ntp"
    service-object "dns-ntp tcp 53"
    service-object "dns-ntp udp 53"
    service-object "dns-ntp udp 123"
    exit
service-object "tcp-8080" TCP 8080 8080
service-object "web-ports tcp 80" TCP 80 80
service-object "web-ports tcp 443" TCP 443 443
service-object "web-ports tcp 8000-8010" TCP 8000 8010
service-group "web-ports"
    service-object "web-ports tcp 80"
    service-object "web-ports tcp 443"
    service-object "web-ports tcp 8000-8010"
    exit
service-object "tcp-22" TCP 22 22
service-object "tcp-443" TCP 443 443
service-object "tcp-udp-5060 tcp 5060" TCP 5060 5060
service-object "tcp-udp-5060 udp 5060" UDP 5060 5060
service-group "tcp-udp-5060"
    service-object "tcp-udp-5060 tcp 5060"
    service-object "tcp-udp-5060 udp 5060"
    exit
service-object "tcp-3389" TCP 3389 3389
service-object "tcp-23" TCP 23 23
service-object "udp-53" UDP 53 53
service-object "tcp-80" TCP 80 80
service-object "tcp 8080" TCP 8080 8080
service-group "mail-services"
    service-object "app-8443"
    service-group "mail-services-inline"
    exit
nat-policy ipv4 inbound any outbound any source name "inside-net" translated-source original destination name "branch-net" translated-destination original service any translated-service original
    name "nat-1"
    comment "VPN to the branch"
    priority manual 1
    exit
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "web-public" translated-destination name "web-srv" service name "tcp-80" translated-service name "tcp 8080"
    name "nat-2"
    comment "nat-2"
    priority manual 2
    exit
nat-policy ipv4 inbound any outbound any source name "mail-srv" translated-source name "h 203.0.113.25" destination any translated-destination original service any translated-service original
    name "nat-mail-srv"
    comment "nat-mail-srv"
    priority manual 3
    exit
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "h 203.0.113.25" translated-destination name "mail-srv" service any translated-service original
    name "nat-mail-srv in"
    comment "inbound of nat-mail-srv"
    priority manual 4
    exit
nat-policy ipv4 inbound any outbound any source any translated-source name "guest-pool" destination any translated-destination original service any translated-service original
    name "nat-after-auto-1"
    comment "nat-after-auto-1"
    priority manual 5
    exit
