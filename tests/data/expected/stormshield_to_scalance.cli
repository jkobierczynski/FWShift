configure terminal
firewall
service name FWS_ssh proto tcp src all dst port 22
service name FWS_https proto tcp src all dst port 443
proto name FWS__rule__ipproto-icmp num 1
service name FWS_tcp_80 proto tcp src all dst port 80
service name FWS_tcp_8080-8090 proto tcp src all dst range 8080 - 8090
service name FWS__rule__dns_udp-udp proto udp src all dst port 53
service name FWS_ident proto tcp src all dst port 113
service name FWS_smtp proto tcp src all dst port 25
service name FWS_tcp_5000-5010 proto tcp src all dst range 5000 - 5010
service name FWS_udp_5000-5010 proto udp src all dst range 5000 - 5010
proto name FWS__rule__ipproto-proto_200 num 200
