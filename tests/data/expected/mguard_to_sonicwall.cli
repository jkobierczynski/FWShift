address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
service-object "tcp-8443" TCP 8443 8443
service-object "udp-47808" UDP 47808 47808
service-object "tcp-502" TCP 502 502
service-object "tcp-web tcp 80" TCP 80 80
service-object "tcp-web tcp 443" TCP 443 443
