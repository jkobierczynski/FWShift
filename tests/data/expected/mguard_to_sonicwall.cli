service-object "tcp-102" TCP 102 102
service-object "tcp-1433" TCP 1433 1433
service-object "tcp 443" TCP 443 443
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "mguard-extern" translated-destination name "h 192.168.10.30" service name "tcp-8443" translated-service name "tcp 443"
    name "portforward-1"
    comment "remote HMI"
    priority manual 1
    exit
nat-policy ipv4 inbound any outbound any source group "vendor_vpn" translated-source original destination name "h 203.0.113.3" translated-destination name "h 172.16.30.20" service name "udp-47808" translated-service original
    name "portforward-2"
    comment "BACnet gateway in the DMZ"
    priority manual 2
    exit
