  security_rule {
    name                       = "OT-no-internet-out"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "0.0.0.0/0"
    destination_address_prefix = "*"
    description                = "OT no internet"
  }

  security_rule {
    name                       = "OT-no-internet-out-2"
    priority                   = 110
    direction                  = "Outbound"
    access                     = "Deny"
    protocol                   = "Esp"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "0.0.0.0/0"
    destination_address_prefix = "*"
