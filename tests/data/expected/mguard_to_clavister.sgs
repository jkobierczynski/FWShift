add Address IP4Address fws_mguard-extern Address=203.0.113.2 Comments="the external address of the mGuard"
add Service ServiceTCPUDP fws_tcp-8443 Type=TCP DestinationPorts=8443
add Address IP4Address fws_198.51.100.64_27 Address=198.51.100.64/27
add Address IP4Address fws_203.0.113.3 Address=203.0.113.3
add Service ServiceTCPUDP fws_udp-47808 Type=UDP DestinationPorts=47808
