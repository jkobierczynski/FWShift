# Generated by FWShift - review the conversion report before loading this.
# A script for /import on RouterOS 6 or 7: /import file-name=FILE verbose=yes
# Nothing in it changes traffic until the disabled jump rules at its end are enabled (in Safe Mode).
:if ([:len [/ip firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
:if ([:len [/ipv6 firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
/interface list add name=fws-External comment="fwshift"
/interface list member add list=fws-External interface="External" comment="fwshift"
/interface list add name=fws-Trusted comment="fwshift"
/interface list member add list=fws-Trusted interface="Trusted" comment="fwshift"
/interface list add name=fws-Guests comment="fwshift"
/interface list member add list=fws-Guests interface="Guests" comment="fwshift"
/interface list add name=fws-DMZ comment="fwshift"
/interface list member add list=fws-DMZ interface="DMZ" comment="fwshift"
/interface list add name=fws-Lab comment="fwshift"
/interface list member add list=fws-Lab interface="Lab" comment="fwshift"
/ip firewall address-list add list=fws-r1-dst address="203.0.113.0/25"
/ip firewall address-list add list=fws-r1-dst address="192.0.2.66"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-Trusted dst-address-list=fws-r1-dst action=reject comment="Block Bad"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-Guests dst-address-list=fws-r1-dst action=reject comment="Block Bad"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-Trusted out-interface-list=fws-External src-address=10.10.5.10-10.10.5.20 protocol=tcp dst-port=22 action=accept comment="Admin SSH"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-Trusted out-interface-list=fws-External protocol=tcp dst-port=80,443,8000-8010 action=accept comment="Web Out"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-Guests out-interface-list=fws-External protocol=tcp dst-port=80,443,8000-8010 action=accept comment="Web Out"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-DMZ out-interface-list=fws-External protocol=tcp dst-port=80,443,8000-8010 action=accept comment="Web Out"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-Trusted out-interface-list=fws-External protocol=tcp dst-port=80,443,8000-8010 action=accept comment="Web Out"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-Guests out-interface-list=fws-External protocol=tcp dst-port=80,443,8000-8010 action=accept comment="Web Out"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-DMZ out-interface-list=fws-External protocol=tcp dst-port=80,443,8000-8010 action=accept comment="Web Out"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-External dst-address=10.20.0.10 protocol=tcp dst-port=443 action=accept comment="Web In"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-External dst-address=10.20.0.25 protocol=tcp dst-port=2525 action=accept comment="Mail In"
# FWSHIFT disabled, see the report: "DMZ Updates" from DMZ to any; source any; destination Update-Site.1.alm; service HTTPS; action allow
# disabled in the source: "Guests Out" from Guests to External; source any; destination any; service DNS; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-Guests out-interface-list=fws-External protocol=tcp dst-port=53 action=accept comment="Guests Out" disabled=yes
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-Guests out-interface-list=fws-External protocol=udp dst-port=53 action=accept comment="Guests Out" disabled=yes
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-Guests out-interface-list=fws-External protocol=tcp dst-port=53 action=accept comment="Guests Out" disabled=yes
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-Guests out-interface-list=fws-External protocol=udp dst-port=53 action=accept comment="Guests Out" disabled=yes
# FWSHIFT disabled, see the report: "Staff Only" from Trusted to any; source any; destination Web-Server.1.alm; service Staff Only; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-Trusted protocol=icmp icmp-options=8:0-255 action=accept comment="Ping"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-Guests protocol=icmp icmp-options=8:0-255 action=accept comment="Ping"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-Lab out-interface-list=fws-External protocol=gre action=accept comment="Lab Tunnel"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-Lab out-interface-list=fws-External protocol=gre action=accept comment="Lab Tunnel"
/ip firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ipv6 firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-External dst-address=198.51.100.10 protocol=tcp dst-port=443 action=dst-nat to-addresses=10.20.0.10 comment="Web-Public (Web In)"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-External dst-address=198.51.100.11 protocol=tcp dst-port=25 action=dst-nat to-addresses=10.20.0.25 to-ports=2525 comment="Mail-Public (Mail In)"
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=dstnat action=jump jump-target=fwshift-dstnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
