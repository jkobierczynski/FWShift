address-object ipv4 "r 192.0.2.67-198.51.99.255" range 192.0.2.67 198.51.99.255 zone DMZ
address-object ipv4 "r 198.51.101.0-255.255.255.255" range 198.51.101.0 255.255.255.255 zone DMZ
address-object ipv4 "n 10.30.0.24_29" network 10.30.0.24 255.255.255.248 zone DMZ
address-object ipv4 "h 10.20.0.20" host 10.20.0.20 zone DMZ
address-object ipv4 "h 10.20.0.21" host 10.20.0.21 zone DMZ
address-group ipv4 "blocked"
    address-object ipv4 "bad-host"
    address-object ipv4 "partner-net"
    exit
address-group ipv4 "dmz-servers"
    address-object ipv4 "web1"
    address-object ipv4 "mail1"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
address-group ipv4 "src policy-7"
    address-object ipv4 "r 0.0.0.0-192.0.2.65"
    address-object ipv4 "r 192.0.2.67-198.51.99.255"
    address-object ipv4 "r 198.51.101.0-255.255.255.255"
    exit
address-group ipv4 "dst policy-8"
    address-object ipv4 "db-net"
    address-object ipv4 "app1"
    exit
service-object "HTTP 2" TCP 80 80
service-object "HTTPS 2" TCP 443 443
service-object "tcp-8080" TCP 8080 8081
service-object "dns-split udp 53" UDP 53 53
service-object "dns-split tcp 53" TCP 53 53
service-group "dns-split"
    service-object "dns-split udp 53"
    service-object "dns-split tcp 53"
    exit
service-object "SSH 2" TCP 22 22
service-object "SMTP" TCP 25 25
service-object "tcp-80" TCP 80 80
service-object "tcp-8443" TCP 8443 8443
service-object "tcp 2525" TCP 2525 2525
service-object "tcp 443" TCP 443 443
service-group "web"
    service-object "HTTP 2"
    service-object "HTTPS 2"
    service-object "tcp-8080"
    exit
service-group "svc lan-out"
    service-group "web"
    service-group "dns-split"
    exit
service-group "svc web-in"
    service-object "HTTP 2"
    service-object "HTTPS 2"
    exit
nat-policy ipv4 inbound any outbound any source name "lan" translated-source name "DIP(4)" destination any translated-destination original service group "web" translated-service original
    name "nat-lan-out"
    comment "policy-based NAT of lan-out"
    priority manual 1
    exit
nat-policy ipv4 inbound any outbound any source name "lan" translated-source name "DIP(4)" destination any translated-destination original service group "dns-split" translated-service original
    name "nat-lan-out-2"
