configure terminal
firewall
service name FWS_tcp-443 proto tcp src all dst port 443
service name FWS_tcp-2222 proto tcp src all dst port 2222
service name FWS_tcp-23 proto tcp src all dst port 23
service name FWS_tcp_53 proto tcp src all dst port 53
service name FWS_udp_53 proto udp src all dst port 53
service name FWS_tcp-22 proto tcp src all dst port 22
service name FWS_tcp-1433 proto tcp src all dst port 1433
proto name FWS_icmp num 1
service name FWS_udp-123 proto udp src all dst port 123
service name FWS_tcp_8000-8080 proto tcp src all dst range 8000 - 8080
service name FWS_tcp_9000 proto tcp src all dst port 9000
service name FWS_tcp_80 proto tcp src all dst port 80
exit
end
