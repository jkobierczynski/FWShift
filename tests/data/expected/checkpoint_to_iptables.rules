-A FORWARD -s 10.20.0.0/24 -d 192.0.2.54/32 -p udp -m udp --dport 53 -m conntrack --ctstate NEW -m comment --comment "DNS" -j ACCEPT
-A FORWARD -s 10.20.0.0/24 -d 192.0.2.54/32 -p tcp -m tcp --dport 53 -m conntrack --ctstate NEW -m comment --comment "DNS" -j ACCEPT
-A FORWARD -m iprange --src-range 10.10.5.10-10.10.5.20 -d 10.20.0.10/32 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "rule-2" -j ACCEPT
-A FORWARD -m iprange --src-range 10.10.5.10-10.10.5.20 -d 203.0.113.10/32 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "rule-2" -j ACCEPT
-A FORWARD -m iprange --src-range 10.10.5.10-10.10.5.20 -d 10.20.0.25/32 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "rule-2" -j ACCEPT
-A FORWARD -i InternalZone -o ExternalZone -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -m comment --comment "Web out" -j ACCEPT
-A FORWARD -m comment --comment "Guests stay out" -j FWS1
-A FWS1 -s 10.10.200.0/24 -j FWS1-1
-A FWS1-1 -d 192.0.2.53/32 -j RETURN
-A FWS1-1 -d 192.0.2.54/32 -j RETURN
-A FWS1-1 -j DROP
