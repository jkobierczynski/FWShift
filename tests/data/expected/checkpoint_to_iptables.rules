-A FORWARD -d 10.20.0.10/32 -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -m comment --comment "Public web" -j ACCEPT
-A FORWARD -d 10.20.0.10/32 -p tcp -m multiport --dports 443,9000:9010 -m conntrack --ctstate NEW -m comment --comment "DMZ access / Web in" -j ACCEPT
-A FORWARD -d 10.20.0.25/32 -p tcp -m tcp --dport 25 -m conntrack --ctstate NEW -m comment --comment "DMZ access / Mail in" -j ACCEPT
