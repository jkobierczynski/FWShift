configure terminal
firewall
service name FWS_tcp-all-from-22 proto tcp src port 22 dst all
icmp name FWS_icmp6-128 type 128 code 0 ver ipv6
service name FWS_tcp-22 proto tcp src all dst port 22
service name FWS_tcp-873 proto tcp src all dst port 873
service name FWS_tcp-all-from-873 proto tcp src port 873 dst all
service name FWS_tcp-all proto tcp src all dst all
service name FWS_tcp-443 proto tcp src all dst port 443
service name FWS_tcp-80 proto tcp src all dst port 80
service name FWS_tcp-3389 proto tcp src all dst port 3389
icmp name FWS_icmp_8_0 type 8 code 0 ver ipv4
service name FWS_udp-53 proto udp src all dst port 53
service name FWS_tcp_5432_from_1024-65535 proto tcp src range 1024 - 65535 dst port 5432
service name FWS_tcp_6432_from_1024-65535 proto tcp src range 1024 - 65535 dst port 6432
service name FWS_tcp_8443 proto tcp src all dst port 8443
service name FWS_tcp_53 proto tcp src all dst port 53
service name FWS_tcp_1-21 proto tcp src all dst range 1 - 21
service name FWS_tcp_23-1023 proto tcp src all dst range 23 - 1023
proto name FWS_ip-47 num 47
service name FWS_udp-161 proto udp src all dst port 161
service name FWS_tcp-1024-65535 proto tcp src all dst range 1024 - 65535
service name FWS_tcp-all-from-443 proto tcp src port 443 dst all
service name FWS_tcp-all-from-3389 proto tcp src port 3389 dst all
exit
end
