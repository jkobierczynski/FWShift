{
  "apiVersion": "projectcalico.org/v3",
  "kind": "GlobalNetworkPolicy",
  "metadata": {
    "name": "fwshift",
    "annotations": {
      "fwshift/generated": "FWShift - review the conversion report before applying this",
      "fwshift/not-written": "Inside_Outside_web (not written, see the report); IoT_telemetry (not written, see the report); NAS_from_Internet (not written, see the report); Head_office_v6 (not written, see the report); DNS_answers (not written, see the report); Staff_streaming (not written, see the report); Guests_by_time (not written, see the report)"
    }
  },
  "spec": {
    "tier": "default",
    "order": 100,
    "selector": "fwshift/policy == 'fwshift'",
    "types": [
      "Ingress",
      "Egress"
    ],
    "ingress": [
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "10.41.0.0/24"
          ]
        },
        "destination": {
          "nets": [
            "10.40.0.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Block_IoT_to_office"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
        }
      }
    ],
    "egress": [
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "10.41.0.0/24"
          ]
        },
        "destination": {
          "nets": [
            "10.40.0.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Block_IoT_to_office"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
        }
      }
    ]
  }
}
