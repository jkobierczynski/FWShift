CONFIG FILTER RULE INSERT type=filter index=9 state=on action=block ipproto=icmp srctarget=any srcif=nsg-db dsttarget=any dstif=nsg-db comment="nsg-db:DenyAllOutBound to nsg-db"
CONFIG FILTER ACTIVATE
CONFIG SLOT UPDATE type=filter slot=9 name=FWShift comment="written by FWShift"
