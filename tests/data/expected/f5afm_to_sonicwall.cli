address-object ipv6 "n 8000::_1" network 8000:: /1 zone dmz
address-group ipv4 "blocklist"
    address-object ipv4 "n 198.51.100.0_24"
    address-object ipv4 "r 203.0.113.200-203.0.113.220"
    exit
address-group ipv4 "admins"
    address-object ipv4 "n 10.10.5.0_24"
    address-object ipv4 "h 10.10.6.10"
    exit
address-group ipv6 "admins v6"
    address-object ipv6 "n 2001:db8:10:5::_64"
    exit
address-group ipv4 "web_servers"
    address-object ipv4 "h 203.0.113.10"
    exit
address-group ipv6 "web_servers v6"
    address-object ipv6 "h 2001:db8:203::10"
    exit
address-group ipv4 "inside"
    address-object ipv4 "n 10.10.0.0_16"
    address-object ipv4 "n 10.10.5.0_24"
    address-object ipv4 "h 10.10.6.10"
    exit
address-group ipv6 "inside v6"
    address-object ipv6 "n 2001:db8:10:5::_64"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
service-object "udp-53" UDP 53 53
service-object "web_ports tcp 80" TCP 80 80
service-object "web_ports tcp 443" TCP 443 443
service-group "web_ports"
    service-object "web_ports tcp 80"
    service-object "web_ports tcp 443"
    exit
service-object "tcp-443" TCP 443 443
service-object "tcp-80" TCP 80 80
service-object "tcp-8080" TCP 8080 8080
service-object "tcp-23" TCP 23 23
service-object "tcp-21" TCP 21 21
service-object "tcp-22" TCP 22 22
service-object "mgmt_ports tcp 22" TCP 22 22
service-object "mgmt_ports tcp 80" TCP 80 80
service-object "mgmt_ports tcp 443" TCP 443 443
service-object "mgmt_ports tcp 8443" TCP 8443 8443
service-group "mgmt_ports"
    service-object "mgmt_ports tcp 22"
    service-object "mgmt_ports tcp 80"
    service-object "mgmt_ports tcp 443"
    service-object "mgmt_ports tcp 8443"
    exit
