    priority manual 4
    exit
access-rule ipv4 from vlan1 to vlan2 action allow source address name "n 192.168.10.0_24" service any destination address any
    name "ipv4rule 5"
    priority manual 5
    no enable
    exit
access-rule ipv4 from vlan2 to vlan3 action allow source address any service name "HTTPS 2" destination address group "dst ipv4rule 6"
    name "ipv4rule 6"
    priority manual 6
    exit
