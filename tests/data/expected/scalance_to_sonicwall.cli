address-object ipv4 "h 198.51.100.77" host 198.51.100.77 zone ipsecALL
address-object ipv4 "h 192.168.10.60" host 192.168.10.60 zone ipsecALL
address-object ipv6 "n 2001:db8:2::_64" network 2001:db8:2:: /64 zone ipsecALL
address-object ipv6 "h 2001:db8:1::10" host 2001:db8:1::10 zone ipsecALL
address-object ipv6 "n 2001:db8:1::_64" network 2001:db8:1:: /64 zone ipsecALL
address-object ipv4 "n 0.0.0.0_1" network 0.0.0.0 128.0.0.0 zone ipsecALL
address-object ipv4 "n 128.0.0.0_1" network 128.0.0.0 128.0.0.0 zone ipsecALL
address-object ipv6 "n ::_1" network :: /1 zone ipsecALL
address-object ipv6 "n 8000::_1" network 8000:: /1 zone ipsecALL
address-object ipv4 "h 198.51.100.5" host 198.51.100.5 zone ipsecALL
address-object ipv4 "h 198.51.100.3" host 198.51.100.3 zone ipsecALL
address-group ipv4 "dst ipv4rule 6"
    address-object ipv4 "h 192.168.30.10"
    address-object ipv4 "h 198.51.100.2"
    exit
address-group ipv4 "dst ipv4rule 7"
    address-object ipv4 "n 192.168.30.64_30"
    address-object ipv4 "n 198.51.100.64_30"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
service-object "OPC-UA" TCP 4840 4840
service-object "S7COMM" TCP 102 102
service-object "MODBUS" TCP 502 502
service-object "SYSLOG 2" UDP 514 514
service-object "HTTPS 2" TCP 443 443
service-object "tcp-8443" TCP 8443 8443
service-object "udp-4840" UDP 4840 4840
service-object "tcp 443" TCP 443 443
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "h 198.51.100.2" translated-destination name "h 192.168.30.10" service name "tcp-8443" translated-service name "tcp 443"
    name "napt 1"
    comment "napt srcint vlan 2 proto tcp typ"
    priority manual 1
    exit
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "h 198.51.100.5" translated-destination name "h 192.168.10.20" service name "udp-4840" translated-service original
    name "napt 2"
    comment "napt srcint vlan 2 proto udp typ"
    priority manual 2
    exit
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "n 198.51.100.64_30" translated-destination name "n 192.168.30.64_30" service any translated-service original
    name "netmap destination 1"
    comment "netmap destination srcint vlan 2"
    priority manual 3
    exit
nat-policy ipv4 inbound any outbound any source name "n 192.168.10.0_24" translated-source name "h 198.51.100.3" destination any translated-destination original service any translated-service original
    name "src-nat 1"
    comment "src-nat srcint vlan 1 dstint vla"
    priority manual 4
    exit
access-rule ipv4 from vlan1 to vlan2 action allow source address name "n 192.168.10.0_24" service name "SYSLOG 2" destination address name "h 198.51.100.200"
    name "ipv4rule 4"
    priority manual 1
    exit
access-rule ipv4 from vlan2 to vlan1 action discard source address name "n 198.51.100.0_24" service name "S7COMM" destination address name "n 192.168.10.0_24"
    name "ipv4rule 2"
    priority manual 2
    exit
access-rule ipv4 from vlan2 to vlan1 action allow source address name "h 198.51.100.10" service name "OPC-UA" destination address name "h 192.168.10.20"
    name "ipv4rule 1"
