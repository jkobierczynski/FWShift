/ip firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-trust action=accept comment="intra"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-trust action=accept comment="intra"
