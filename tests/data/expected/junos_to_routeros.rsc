/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-untrust dst-address=203.0.113.10 protocol=tcp dst-port=80 action=dst-nat to-addresses=10.20.0.80 to-ports=8080 comment="from-internet dnat-web"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-untrust dst-address=203.0.113.10 protocol=udp dst-port=80 action=dst-nat to-addresses=10.20.0.80 to-ports=8080 comment="from-internet dnat-web"
/ip firewall nat add chain=fwshift-srcnat src-address=10.20.0.25 action=src-nat to-addresses=203.0.113.25 comment="inbound static-mail (outbound)"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-untrust src-address=10.10.0.0/16 action=masquerade comment="trust-out snat-lan"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-untrust src-address=10.20.0.0/24 action=src-nat to-addresses=203.0.113.50-203.0.113.59 comment="dmz-out snat-dmz"
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=dstnat action=jump jump-target=fwshift-dstnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
/ip firewall nat add chain=srcnat action=jump jump-target=fwshift-srcnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
