/ip firewall address-list add list=fws-r3-dst address="updates.example.com"
/ip firewall address-list add list=fws-servers address="10.20.0.80"
/ip firewall address-list add list=fws-servers address="10.20.0.25"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-untrust dst-address-list=fws-watched action=drop log=yes log-prefix="block-bad" comment="block-bad"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-untrust dst-address=2001:db8:10::/48 action=drop log=yes log-prefix="block-bad" comment="block-bad"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-untrust src-address=10.10.0.0/16 protocol=tcp dst-port=80,443,8080-8081 action=accept comment="web-out"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-untrust src-address=10.10.0.0/16 dst-address-list=fws-r3-dst protocol=tcp dst-port=443 action=accept comment="updates"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-untrust protocol=icmp icmp-options=8:0-255 action=accept comment="ping-out"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-untrust out-interface-list=fws-dmz dst-address=10.20.0.80 protocol=tcp dst-port=8080-8081 action=accept comment="web-in"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-untrust out-interface-list=fws-dmz dst-address=10.20.0.25 protocol=tcp dst-port=25,587,465 action=accept comment="mail-in"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-dmz src-address=10.10.5.10-10.10.5.20 dst-address=10.20.0.0/24 protocol=tcp dst-port=22 action=accept comment="admin"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-dmz src-address-list=!fws-servers dst-address=10.20.0.64/26 protocol=gre action=accept comment="not-servers"
# disabled in the source: "dmz-out" from dmz to untrust; source dmz-net (dmz-book); destination any; service junos-dns-udp,app-ntp; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-dmz out-interface-list=fws-untrust src-address=10.20.0.0/24 protocol=udp dst-port=53,123 action=accept comment="dmz-out" disabled=yes
# FWSHIFT disabled, see the report: "guest-web" from guest to untrust; source any; destination 0.0.0.0/0; service junos-http; action allow
