configure terminal
firewall
service name FWS_HTTPS proto tcp src all dst port 443
service name FWS_tcp_8443 proto tcp src all dst port 8443
service name FWS_tcp_1433 proto tcp src all dst port 1433
service name FWS_udp_5000-5010 proto udp src all dst range 5000 - 5010
service name FWS_tcp_53 proto tcp src all dst port 53
service name FWS_udp_53 proto udp src all dst port 53
