add Address IP4Address fws_lan-net Address=10.10.0.0/24 Comments="Office LAN"
add Address IP4Address fws_partner-net Address=198.51.100.0/24
add Address IP4Address fws_web-srv-pub Address=203.0.113.10
add Address IP4Address fws_outside-interface Address=203.0.113.2 Comments="address of interface outside when the configuration was read"
add Service ServiceTCPUDP fws_http-8443 Type=TCP DestinationPorts=8443
add Address IP4Address fws_mail-srv Address=10.20.0.25
add Address IP4Address fws_dmz-net Address=10.20.0.0/24
add Address IP4Address fws_web-srv Address=10.20.0.10
add Address IP4Address fws_10.20.0.30 Address=10.20.0.30
add Address IP4Address fws_mail-srv-pub Address=203.0.113.25
add Service ServiceTCPUDP fws_backup Type=TCP DestinationPorts=10000
add Address IP4Address fws_IPv4-Private-10.0.0.0-8 Address=10.0.0.0/8
add Service ServiceIPProto fws_gre IPProto=47
add Service ServiceIPProto fws_ipinip IPProto=4
add Service ServiceIPProto fws_proto-41 IPProto=41
add Service ServiceTCPUDP fws_udp-3544 Type=UDP DestinationPorts=3544
add Address IP4Address fws_ot-net Address=10.30.0.0/24 Comments="Production cell"
add Service ServiceTCPUDP fws_web_1 Type=TCP DestinationPorts=8080-8081
add Service ServiceTCPUDP fws_web_2 Type=TCP DestinationPorts=443
add Service ServiceTCPUDP fws_web_3 Type=TCP DestinationPorts=80
add Service ServiceTCPUDP fws_DNS_over_UDP Type=UDP DestinationPorts=53
add Service ServiceTCPUDP fws_DNS_over_TCP Type=TCP DestinationPorts=53
add Service ServiceTCPUDP fws_NTP-UDP Type=UDP DestinationPorts=123
add Service ServiceTCPUDP fws_HTTPS Type=TCP DestinationPorts=443
add Service ServiceTCPUDP fws_HTTP Type=TCP DestinationPorts=80
add Service ServiceTCPUDP fws_smtp Type=TCP DestinationPorts=25
add Address IP4Address fws_admin-pcs Address=10.10.0.100-10.10.0.120
add Service ServiceTCPUDP fws_mgmt_1 Type=TCP DestinationPorts=22
add Service ServiceICMP fws_mgmt_2 MessageTypes=Specific EchoRequest=Yes
add Service ServiceTCPUDP fws_tcp-3389 Type=TCP DestinationPorts=3389
add Service ServiceIPProto fws_ipsec-esp IPProto=50
add Service ServiceTCPUDP fws_tcp-8443 Type=TCP DestinationPorts=8443
add Address IP4Address fws_10.10.0.200-10.10.0.250 Address=10.10.0.200-10.10.0.250
add Service ServiceTCPUDP fws_tcp-21 Type=TCP DestinationPorts=21
add Address IP4Address fws_10.20.0.53 Address=10.20.0.53
add Service ServiceTCPUDP fws_udp-src-53-dst-1024-65535 Type=UDP DestinationPorts=1024-65535 SourcePorts=53
add Address IP6Address fws_branch-v6 Address=2001:db8:10::/48
add Address IP6Address fws_2001_db8_20__10 Address=2001:db8:20::10
add Service ServiceICMPv6 fws_echo6 MessageTypes=Specific EchoRequest=Yes
add Service ServiceICMP fws_echo MessageTypes=Specific EchoRequest=Yes
add Address IP4Address fws_nothing Address=0.0.0.0
add InterfaceGroup fws_zones Members=outside,inside,dmz
add Address IP4Group fws_servers Members=fws_web-srv,fws_mail-srv,fws_10.20.0.30
add Address IP4Group fws_internal Members=fws_lan-net,fws_dmz-net,fws_servers
add Address IP4Group fws_pre-backup_dst Members=fws_mail-srv,fws_mail-srv-pub
add Address IP4Group fws_pre-partner-gre_dst Members=fws_web-srv,fws_web-srv-pub
add Service ServiceGroup fws_prefilter-default-block-tunnels_svc Members=fws_gre,fws_ipinip,fws_proto-41,fws_udp-3544
add Service ServiceGroup fws_web_grp Members=fws_web_1,fws_web_2,fws_web_3
add Service ServiceGroup fws_LAN_DNS_and_NTP_svc Members=fws_DNS_over_UDP,fws_DNS_over_TCP,fws_NTP-UDP
add Address IP4Group fws_Inbound_web_dst Members=fws_web-srv,fws_web-srv-pub
add Service ServiceGroup fws_Inbound_web_svc Members=fws_HTTP,fws_HTTPS
add Address IP4Group fws_Inbound_mail_dst Members=fws_mail-srv,fws_mail-srv-pub
add Address IP4Group fws_Admin_access_dst Members=fws_servers,fws_mail-srv-pub
add Service ServiceGroup fws_mgmt_grp Members=fws_mgmt_1,fws_mgmt_2
add Address IP4Group fws_Helpdesk_RDP_dst Members=fws_servers,fws_mail-srv-pub
add Address IP4Group fws_Partner_service_dst Members=fws_web-srv,fws_web-srv-pub
add Service ServiceGroup fws_Partner_service_svc Members=fws_ipsec-esp,fws_tcp-8443
add Service ServiceGroup fws_Uncategorised_web_svc Members=fws_HTTP,fws_HTTPS
add Service ServiceGroup fws_Branch_IPv6_svc Members=fws_HTTPS,fws_echo6
add InterfaceGroup fws_if_dmz_inside Members=inside,dmz
add IPRuleSet fws_rules Comments="Written by FWShift"
add IPRuleSet fws_snat Comments="Written by FWShift"
add IPRuleSet fws_d_nat-2 Comments="Written by FWShift"
add IPRuleSet fws_d_nat-3 Comments="Written by FWShift"
cc IPRuleSet fws_snat
add IPRule Index=1 Name=fws_nat-1 Action=Allow SourceInterface=inside SourceNetwork=fws_lan-net DestinationInterface=outside DestinationNetwork=fws_partner-net Service=all_services LogEnabled=No Comments="No NAT towards the partner"
add IPRule Index=2 Name=fws_nat-mail-srv_sat Action=SAT SourceInterface=dmz SourceNetwork=fws_mail-srv DestinationInterface=outside DestinationNetwork=all-nets Service=all_services SATTranslate=SourceIP SATTranslateToIP=fws_mail-srv-pub LogEnabled=No
add IPRule Index=3 Name=fws_nat-mail-srv Action=Allow SourceInterface=dmz SourceNetwork=fws_mail-srv DestinationInterface=outside DestinationNetwork=all-nets Service=all_services LogEnabled=No
add IPRule Index=4 Name=fws_nat-dmz-net Action=NAT SourceInterface=dmz SourceNetwork=fws_dmz-net DestinationInterface=outside DestinationNetwork=all-nets Service=all_services LogEnabled=No
add IPRule Index=5 Name=fws_nat-after-auto-1 Action=NAT SourceInterface=fws_zones SourceNetwork=fws_internal DestinationInterface=outside DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="Whatever else leaves"
add IPRule Index=6 Name=fws_snat_allow Action=Allow SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
add IPRule Index=7 Name=fws_snat_allow_v6 Action=Allow SourceInterface=any SourceNetwork=all-nets6 DestinationInterface=any DestinationNetwork=all-nets6 Service=all_services LogEnabled=No
cc
cc IPRuleSet fws_d_nat-2
add IPRule Index=1 Name=fws_nat-2_pre-spoofed Action=Drop SourceInterface=outside SourceNetwork=fws_IPv4-Private-10.0.0.0-8 DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=Yes
add IPRule Index=2 Name=fws_nat-2_pre-partner-gre Action=Allow SourceInterface=outside SourceNetwork=fws_partner-net DestinationInterface=any DestinationNetwork=fws_pre-partner-gre_dst Service=fws_gre LogEnabled=No
add IPRule Index=3 Name=fws_nat-2_prefilter-default-block-tunnels Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=fws_prefilter-default-block-tunnels_svc LogEnabled=No Comments="Default action of the prefilter policy: block tunnel traffic."
add IPRule Index=4 Name=fws_nat-2_Inbound_web Action=Allow SourceInterface=outside SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_Inbound_web_dst Service=fws_Inbound_web_svc LogEnabled=Yes
add IPRule Index=5 Name=fws_nat-2_Partner_service Action=Allow SourceInterface=outside SourceNetwork=fws_partner-net DestinationInterface=any DestinationNetwork=fws_Partner_service_dst Service=fws_Partner_service_svc LogEnabled=Yes
add IPRule Index=6 Name=fws_nat-2_default Action=Drop SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
cc
cc IPRuleSet fws_d_nat-3
add IPRule Index=1 Name=fws_nat-3_pre-spoofed Action=Drop SourceInterface=outside SourceNetwork=fws_IPv4-Private-10.0.0.0-8 DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=Yes
add IPRule Index=2 Name=fws_nat-3_default Action=Drop SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
cc
cc IPRuleSet fws_rules
add IPRule Index=1 Name=fws_nat-2_sat Action=SAT SourceInterface=outside SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_web-srv-pub Service=all_services SATTranslate=DestinationIP SATTranslateToIP=fws_web-srv LogEnabled=No Comments="Web server"
add IPRule Index=2 Name=fws_nat-3_sat Action=SAT SourceInterface=outside SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_outside-interface Service=fws_http-8443 SATTranslate=DestinationIP SATTranslateToIP=fws_web-srv SATTranslateToPort=8080 LogEnabled=No Comments="Test site on the interface address"
add GotoRule Index=3 Name=fws_nat-2_goto SourceInterface=outside SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_web-srv-pub Service=all_services RuleSet=fws_d_nat-2 LogEnabled=No
add GotoRule Index=4 Name=fws_nat-3_goto SourceInterface=outside SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_outside-interface Service=fws_http-8443 RuleSet=fws_d_nat-3 LogEnabled=No
add IPRule Index=5 Name=fws_pre-backup Action=Allow SourceInterface=inside SourceNetwork=fws_lan-net DestinationInterface=dmz DestinationNetwork=fws_pre-backup_dst Service=fws_backup LogEnabled=No
add IPRule Index=6 Name=fws_pre-spoofed Action=Drop SourceInterface=outside SourceNetwork=fws_IPv4-Private-10.0.0.0-8 DestinationInterface=fws_zones DestinationNetwork=all-nets Service=all_services LogEnabled=Yes
add IPRule Index=7 Name=fws_pre-partner-gre Action=Allow SourceInterface=outside SourceNetwork=fws_partner-net DestinationInterface=dmz DestinationNetwork=fws_pre-partner-gre_dst Service=fws_gre LogEnabled=No
add GotoRule Index=8 Name=fws_pre-partner-gre-reverse SourceInterface=dmz SourceNetwork=fws_web-srv DestinationInterface=outside DestinationNetwork=fws_partner-net Service=fws_gre RuleSet=fws_snat LogEnabled=No
add IPRule Index=9 Name=fws_prefilter-default-block-tunnels Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=all-nets Service=fws_prefilter-default-block-tunnels_svc LogEnabled=No Comments="Default action of the prefilter policy: block tunnel traffic."
add IPRule Index=10 Name=fws_prefilter-default-block-tunnels_v6 Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets6 DestinationInterface=fws_zones DestinationNetwork=all-nets6 Service=fws_prefilter-default-block-tunnels_svc LogEnabled=No Comments="Default action of the prefilter policy: block tunnel traffic."
add IPRule Index=11 Name=fws_Block_OT_outbound Action=Drop SourceInterface=inside SourceNetwork=fws_ot-net DestinationInterface=outside DestinationNetwork=all-nets Service=all_services LogEnabled=Yes Comments="No production cell talks to the Internet"
add GotoRule Index=12 Name=fws_LAN_web SourceInterface=inside SourceNetwork=fws_lan-net DestinationInterface=outside DestinationNetwork=all-nets Service=fws_web_grp RuleSet=fws_snat LogEnabled=Yes
add GotoRule Index=13 Name=fws_LAN_DNS_and_NTP SourceInterface=inside SourceNetwork=fws_lan-net DestinationInterface=outside DestinationNetwork=all-nets Service=fws_LAN_DNS_and_NTP_svc RuleSet=fws_snat LogEnabled=No
add IPRule Index=14 Name=fws_Updates Action=Allow SourceInterface=any SourceNetwork=fws_nothing DestinationInterface=any DestinationNetwork=fws_nothing Service=all_services LogEnabled=Yes
set IPRule 14 -disable
add IPRule Index=15 Name=fws_Inbound_web Action=Allow SourceInterface=outside SourceNetwork=all-nets DestinationInterface=dmz DestinationNetwork=fws_Inbound_web_dst Service=fws_Inbound_web_svc LogEnabled=Yes
add IPRule Index=16 Name=fws_Inbound_mail Action=Allow SourceInterface=outside SourceNetwork=all-nets DestinationInterface=dmz DestinationNetwork=fws_Inbound_mail_dst Service=fws_smtp LogEnabled=Yes
add IPRule Index=17 Name=fws_Admin_access Action=Allow SourceInterface=inside SourceNetwork=fws_admin-pcs DestinationInterface=dmz DestinationNetwork=fws_Admin_access_dst Service=fws_mgmt_grp LogEnabled=Yes
add IPRule Index=18 Name=fws_Helpdesk_RDP Action=Allow SourceInterface=inside SourceNetwork=all-nets DestinationInterface=dmz DestinationNetwork=fws_Helpdesk_RDP_dst Service=fws_tcp-3389 LogEnabled=Yes
set IPRule 18 -disable
add IPRule Index=19 Name=fws_Staff_social_media Action=Drop SourceInterface=inside SourceNetwork=all-nets DestinationInterface=outside DestinationNetwork=all-nets Service=all_services LogEnabled=Yes
set IPRule 19 -disable
add IPRule Index=20 Name=fws_Staff_social_media_v6 Action=Drop SourceInterface=inside SourceNetwork=all-nets6 DestinationInterface=outside DestinationNetwork=all-nets6 Service=all_services LogEnabled=Yes
set IPRule 20 -disable
add IPRule Index=21 Name=fws_Partner_service Action=Allow SourceInterface=outside SourceNetwork=fws_partner-net DestinationInterface=dmz DestinationNetwork=fws_Partner_service_dst Service=fws_Partner_service_svc LogEnabled=Yes
add IPRule Index=22 Name=fws_Uncategorised_web Action=Drop SourceInterface=inside SourceNetwork=fws_10.10.0.200-10.10.0.250 DestinationInterface=outside DestinationNetwork=all-nets Service=fws_Uncategorised_web_svc LogEnabled=Yes
add IPRule Index=23 Name=fws_Old_FTP Action=Allow SourceInterface=inside SourceNetwork=all-nets DestinationInterface=outside DestinationNetwork=all-nets Service=fws_tcp-21 LogEnabled=Yes
set IPRule 23 -disable
add IPRule Index=24 Name=fws_Old_FTP_v6 Action=Allow SourceInterface=inside SourceNetwork=all-nets6 DestinationInterface=outside DestinationNetwork=all-nets6 Service=fws_tcp-21 LogEnabled=Yes
set IPRule 24 -disable
add IPRule Index=25 Name=fws_DNS_answers_to_resolver Action=Allow SourceInterface=outside SourceNetwork=all-nets DestinationInterface=dmz DestinationNetwork=fws_10.20.0.53 Service=fws_udp-src-53-dst-1024-65535 LogEnabled=No
add IPRule Index=26 Name=fws_Branch_IPv6 Action=Allow SourceInterface=outside SourceNetwork=fws_branch-v6 DestinationInterface=dmz DestinationNetwork=fws_2001_db8_20__10 Service=fws_Branch_IPv6_svc LogEnabled=Yes
add GotoRule Index=27 Name=fws_Ping_out SourceInterface=fws_if_dmz_inside SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=all-nets Service=fws_echo RuleSet=fws_snat LogEnabled=No
add IPRule Index=28 Name=fws_Ping_out_v6 Action=Allow SourceInterface=fws_if_dmz_inside SourceNetwork=all-nets6 DestinationInterface=fws_zones DestinationNetwork=all-nets6 Service=fws_echo LogEnabled=No
add IPRule Index=29 Name=fws_Reset_the_rest_from_inside Action=Reject SourceInterface=inside SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=all-nets Service=all_services LogEnabled=Yes
add IPRule Index=30 Name=fws_Reset_the_rest_from_inside_v6 Action=Reject SourceInterface=inside SourceNetwork=all-nets6 DestinationInterface=fws_zones DestinationNetwork=all-nets6 Service=all_services LogEnabled=Yes
add IPRule Index=31 Name=fws_default Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=all-nets Service=all_services LogEnabled=No
add IPRule Index=32 Name=fws_default_v6 Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets6 DestinationInterface=fws_zones DestinationNetwork=all-nets6 Service=all_services LogEnabled=No
add ReturnRule Index=33 Name=fws_return SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
add ReturnRule Index=34 Name=fws_return_v6 SourceInterface=any SourceNetwork=all-nets6 DestinationInterface=any DestinationNetwork=all-nets6 Service=all_services LogEnabled=No
cc
cc IPRuleSet main
add GotoRule Index=1 Name=fws_goto SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services RuleSet=fws_rules LogEnabled=No
add GotoRule Index=2 Name=fws_goto_v6 SourceInterface=fws_zones SourceNetwork=all-nets6 DestinationInterface=any DestinationNetwork=all-nets6 Service=all_services RuleSet=fws_rules LogEnabled=No
cc
