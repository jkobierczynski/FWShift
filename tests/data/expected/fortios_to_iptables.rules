# FORWARD chain and nat table for iptables-restore.
# It does not contain INPUT or OUTPUT: load it with --noflush, or merge it into your ruleset.
*filter
:FORWARD DROP [0:0]
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
-A FORWARD -i lan -o wan1 -s 10.10.0.0/15 -p tcp -m multiport --dports 80,443,53 -m conntrack --ctstate NEW -m comment --comment "LAN to Internet" -j ACCEPT
-A FORWARD -i lan -o wan1 -s 10.10.0.0/15 -p udp -m udp --dport 53 -m conntrack --ctstate NEW -m comment --comment "LAN to Internet" -j ACCEPT
-A FORWARD -i lan -o wan1 -p tcp -m tcp --dport 53 -m conntrack --ctstate NEW -m comment --comment "LAN basics" -j ACCEPT
-A FORWARD -i lan -o wan1 -p udp -m udp --dport 53 -m conntrack --ctstate NEW -m comment --comment "LAN basics" -j ACCEPT
-A FORWARD -i lan -o wan1 -p icmp -m icmp --icmp-type 8 -m conntrack --ctstate NEW -m comment --comment "LAN basics" -j ACCEPT
-A FORWARD -i wan1 -o dmz -d 10.20.0.10/32 -p tcp -m multiport --dports 8080,8443,9000:9010 -m conntrack --ctstate NEW -m comment --comment "Inbound web" -j ACCEPT
-A FORWARD -i wan1 -o dmz -d 10.20.0.25/32 -p tcp -m tcp --dport 25 -m conntrack --ctstate NEW -m comment --comment "Inbound mail" -j ACCEPT
# FWSHIFT disabled, see the report: "Admins to DMZ" from lan to dmz; source admin-range; destination dmz-servers; service SSH; action allow
