-A FORWARD -i dmz -o wan1 -s 10.20.0.10/32 -d updates.example.com -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -m comment --comment "DMZ out via pool" -j ACCEPT
-A FORWARD -i dmz -o wan1 -s 10.20.0.25/32 -d updates.example.com -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -m comment --comment "DMZ out via pool" -j ACCEPT
-A FORWARD -i lan -o ot -s 10.10.7.15/32 -d 10.30.1.0/24 -p tcp -m tcp --dport 502 -m conntrack --ctstate NEW -m comment --comment "SCADA to PLCs" -j ACCEPT
-A FORWARD -i ot -o wan1 -m comment --comment "OT no internet" -j DROP
-A FORWARD -i lan -o wan1 -s 10.10.0.0/15 -d 10.99.0.0/16 -p udp -m udp --dport 514 -m udp --sport 1024:65535 -m conntrack --ctstate NEW -m comment --comment "Partner tunnel" -j ACCEPT
-A FORWARD -i lan -o wan1 -s 10.10.0.0/15 -d 10.99.0.0/16 -p 47 -m conntrack --ctstate NEW -m comment --comment "Partner tunnel" -j ACCEPT
# FWSHIFT disabled, see the report: "policy-12" from lan to dmz; source lan-net; destination web-1; service HTTP; action allow
# disabled in the source: "Not web" from dmz to wan1; source web-1; destination any; service not Web Access; action allow
-A FORWARD -i lan -o dmz -m iprange --src-range 10.10.5.10-10.10.5.20 -d 10.20.0.10/32 -p icmp -m icmp --icmp-type 13 -m conntrack --ctstate NEW -m comment --comment "Timestamp probes" -j ACCEPT
-A FORWARD -i lan -o dmz -m iprange --src-range 10.10.5.10-10.10.5.20 -d 10.20.0.25/32 -p icmp -m icmp --icmp-type 13 -m conntrack --ctstate NEW -m comment --comment "Timestamp probes" -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i wan1 -d 203.0.113.10/32 -p tcp -m tcp --dport 443 -m comment --comment "vip-web" -j DNAT --to-destination 10.20.0.10:8443
-A PREROUTING -i wan1 -d 203.0.113.25/32 -m comment --comment "vip-mail" -j DNAT --to-destination 10.20.0.25
-A POSTROUTING -o wan1 -s 10.10.0.0/15 -m comment --comment "snat-1" -j MASQUERADE
-A POSTROUTING -o wan1 -m comment --comment "snat-2" -j MASQUERADE
COMMIT
