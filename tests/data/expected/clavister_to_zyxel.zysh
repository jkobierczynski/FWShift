# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
service-object FWS_noservice protocol 255
service-object FWS_tcp_80 tcp eq 80
service-object FWS_tcp_443 tcp eq 443
object-group service FWS_http-all
 service-object FWS_tcp_80
 service-object FWS_tcp_443
exit
address-object FWS_wan_ip 203.0.113.10
service-object FWS_smtp-in tcp eq 25
address-object FWS_198_51_100_0_24 198.51.100.0/24
service-object FWS_tcp_8080_8090 tcp range 8080 8090
object-group service FWS_web-ports
 service-object FWS_tcp_80
 service-object FWS_tcp_443
 service-object FWS_tcp_8080_8090
exit
address-object FWS_pub_pool 203.0.113.20/30
service-object FWS_tcp_53 tcp eq 53
service-object FWS_udp_53 udp eq 53
object-group service FWS_dns-all
 service-object FWS_tcp_53
 service-object FWS_udp_53
exit
address-object FWS_guest_net 10.30.0.0/24
address-object FWS_dmz_net 172.16.20.0/24
service-object FWS_ssh tcp eq 22
object-group service FWS_mgmt
 service-object FWS_ssh
 service-object FWS_tcp_443
exit
address-object FWS_admin_hosts_1 192.168.10.5
address-object FWS_admin_hosts_2 192.168.10.6
address-object FWS_admin_hosts_3 192.168.10.32/28
object-group address FWS_admin_hosts
 address-object FWS_admin_hosts_1
 address-object FWS_admin_hosts_2
 address-object FWS_admin_hosts_3
exit
address-object FWS_web_srv 172.16.20.80
address-object FWS_mail_srv 172.16.20.25
object-group address FWS_servers
 address-object FWS_web_srv
 address-object FWS_mail_srv
exit
address-object FWS_lan_net 192.168.10.0/24
address-object FWS_nothing 0.0.0.0
service-object FWS_syslog_dst udp eq 514
address-object FWS_192_168_10_50_32 192.168.10.50
service-object FWS_gre protocol 47
address-object FWS_172_16_20_9_32 172.16.20.9
address-object FWS_198_51_100_7_32 198.51.100.7
service-object FWS_ftp-alg tcp eq 21
address6-object FWS_lan_net6 2001:db8:10::/64
address6-object FWS_v6_web 2001:db8:20::80
service-object FWS_echo6 icmpv6 128
address-object FWS_wan_ip2 203.0.113.12
address-object FWS_0_0_0_0_0 0.0.0.0/0
address-object FWS_203_0_113_11_32 203.0.113.11
zone FWS_lan
exit
zone FWS_dmz
exit
zone FWS_wan
exit
zone FWS_guest
exit
secure-policy insert 1
