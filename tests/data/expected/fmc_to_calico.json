{
  "apiVersion": "projectcalico.org/v3",
  "kind": "GlobalNetworkPolicy",
  "metadata": {
    "name": "fwshift",
    "annotations": {
      "fwshift/generated": "FWShift - review the conversion report before applying this",
      "fwshift/not-written": "pre-backup (not written, see the report); pre-partner-gre (not written, see the report); pre-partner-gre-reverse (not written, see the report); LAN web (not written, see the report); LAN DNS and NTP (not written, see the report); Updates (not written, see the report); Inbound web (not written, see the report); Inbound mail (not written, see the report); Admin access (not written, see the report); Helpdesk RDP (not written, see the report); Staff social media (not written, see the report); Partner service (not written, see the report); Old FTP (disabled in the source); DNS answers to resolver (not written, see the report); Branch IPv6 (not written, see the report); Ping out (not written, see the report)"
    }
  },
  "spec": {
    "tier": "default",
    "order": 100,
    "selector": "fwshift/policy == 'fwshift'",
    "types": [
      "Ingress",
      "Egress"
    ],
    "ingress": [
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "10.0.0.0/8"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "pre-spoofed"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": 47,
        "metadata": {
          "annotations": {
            "fwshift/rule": "prefilter-default-block-tunnels"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": 4,
        "metadata": {
          "annotations": {
            "fwshift/rule": "prefilter-default-block-tunnels"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": 41,
        "metadata": {
          "annotations": {
            "fwshift/rule": "prefilter-default-block-tunnels"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": "UDP",
        "destination": {
          "ports": [
            3544
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "prefilter-default-block-tunnels"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "10.30.0.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Block OT outbound"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "protocol": "TCP",
        "source": {
          "nets": [
            "10.10.0.200/29",
            "10.10.0.208/28",
            "10.10.0.224/28",
            "10.10.0.240/29",
            "10.10.0.248/31",
            "10.10.0.250/32"
          ]
        },
        "destination": {
          "ports": [
            80
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Uncategorised web"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "protocol": "TCP",
        "source": {
          "nets": [
            "10.10.0.200/29",
            "10.10.0.208/28",
            "10.10.0.224/28",
            "10.10.0.240/29",
            "10.10.0.248/31",
            "10.10.0.250/32"
          ]
        },
        "destination": {
          "ports": [
            443
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Uncategorised web"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "Reset the rest from inside"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
        }
      }
    ],
    "egress": [
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "10.0.0.0/8"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "pre-spoofed"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": 47,
        "metadata": {
          "annotations": {
            "fwshift/rule": "prefilter-default-block-tunnels"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": 4,
        "metadata": {
          "annotations": {
            "fwshift/rule": "prefilter-default-block-tunnels"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": 41,
        "metadata": {
          "annotations": {
            "fwshift/rule": "prefilter-default-block-tunnels"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": "UDP",
        "destination": {
          "ports": [
            3544
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "prefilter-default-block-tunnels"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "10.30.0.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Block OT outbound"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "protocol": "TCP",
        "source": {
          "nets": [
            "10.10.0.200/29",
            "10.10.0.208/28",
            "10.10.0.224/28",
            "10.10.0.240/29",
            "10.10.0.248/31",
            "10.10.0.250/32"
          ]
        },
        "destination": {
          "ports": [
            80
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Uncategorised web"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "protocol": "TCP",
        "source": {
          "nets": [
            "10.10.0.200/29",
            "10.10.0.208/28",
            "10.10.0.224/28",
            "10.10.0.240/29",
            "10.10.0.248/31",
            "10.10.0.250/32"
          ]
        },
        "destination": {
          "ports": [
            443
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Uncategorised web"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "Reset the rest from inside"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
        }
      }
    ]
  }
}
