set tag "Company rules"
set tag Administration
set tag Outbound
set tag "Published servers"
set tag "Lab and users"
set address Network_out ip-netmask 203.0.113.0/29
set address Firewall_out ip-netmask 203.0.113.2
set address Network_in ip-netmask 10.10.0.0/24
set address Firewall_in ip-netmask 10.10.0.254
set address Network_dmz1 ip-netmask 10.20.0.0/24
set address Firewall_dmz1 ip-netmask 10.20.0.254
set address Network_lab ip-netmask 10.30.0.0/24
set address Firewall_lab ip-netmask 10.30.0.254
set address Network_labbridge ip-netmask 10.30.0.0/24
set address Firewall_labbridge ip-netmask 10.30.0.254
set address web_srv ip-netmask 10.20.0.10
set address web_srv description "web server"
set address mail_srv ip-netmask 10.20.0.25
set address web_pub ip-netmask 203.0.113.3
set address web_pub description "public address of the web server"
set address admin_ws ip-netmask 10.10.0.50
set address dhcp_pool ip-range 10.10.0.100-10.10.0.199
set address updates.example.com fqdn updates.example.com
set address lan ip-netmask 10.10.0.0/24
set address lan6 ip-netmask 2001:db8:10::/64
set address lab_net ip-netmask 10.30.0.0/24
set address blocked ip-netmask 198.51.100.0/24
set address www.example.org fqdn www.example.org
set address global_bad ip-netmask 192.0.2.128/25
set address h-10.10.0.60 ip-netmask 10.10.0.60
set address h-2001_db8_10__60 ip-netmask 2001:db8:10::60
set address-group dual_ws static [ h-10.10.0.60 h-2001_db8_10__60 ]
set address-group dual_ws description "dual stack"
set address-group dmz_servers static [ web_srv mail_srv ]
set address-group admins static [ admin_ws dual_ws ]
set address-group firewall_all static [ Firewall_out Firewall_in Firewall_dmz1 Firewall_lab Firewall_labbridge ]
set address-group Network_internals static [ Network_in Network_dmz1 Network_lab Network_labbridge ]
set address r-0.0.0.0-10.9.255.255 ip-range 0.0.0.0-10.9.255.255
set address r-10.10.1.0-10.19.255.255 ip-range 10.10.1.0-10.19.255.255
set address r-10.20.1.0-10.29.255.255 ip-range 10.20.1.0-10.29.255.255
set address r-10.30.1.0-255.255.255.255 ip-range 10.30.1.0-255.255.255.255
set address n-___0 ip-netmask ::/0
set address-group Internet static [ r-0.0.0.0-10.9.255.255 r-10.10.1.0-10.19.255.255 r-10.20.1.0-10.29.255.255 r-10.30.1.0-255.255.255.255 n-___0 ]
set service http protocol tcp port 80
set service https protocol tcp port 443
set service ssh protocol tcp port 22
set service dns_udp protocol udp port 53
set service smtp protocol tcp port 25
set service ident protocol tcp port 113
set service web_alt protocol tcp port 8080-8090
set service syslog protocol udp port 514
set service lab_tools-tcp protocol tcp port 5000-5010
set service lab_tools-udp protocol udp port 5000-5010
set service-group lab_tools members [ lab_tools-tcp lab_tools-udp ]
set service "x_rule_ dns_udp-udp" protocol udp port 53
set service-group web_ports members [ http https web_alt ]
