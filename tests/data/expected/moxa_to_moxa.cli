! Generated by FWShift: CLI commands for the Layer 3 policy and NAT of a Moxa industrial secure router
! (EDR-810, EDR-G902/G903, TN-4900 with the classic router firmware). Paste them into the console after
! logging in; read the report first, what is not written is listed there. Nothing is deleted or saved.
! The policies are numbered from 1 on: firewall N changes a policy that exists at N, so on a router
! with policies give --policy-id-start one above the last index that show firewall lists.
configure
firewall 1
 src-ip single 0.0.0.0
 action accept
 protocol tcp
 dst-ip single 172.16.40.5
 dst-port single 502
 interface lan wan1
 src-ip range 192.168.127.10 192.168.127.20
exit
firewall 2
 src-ip single 0.0.0.0
 action drop
 protocol tcp
 dst-ip all
 dst-port single 23
 interface wan1 lan
 src-ip all
exit
firewall 3
 src-ip single 0.0.0.0
 action accept
 protocol tcp
 dst-ip single 192.168.127.50
 dst-port single 443
 interface wan1 lan
 src-ip range 198.51.100.0 198.51.100.255
exit
firewall 4
 src-ip single 0.0.0.0
 action accept
 protocol udp
 dst-ip all
 src-port range 1024 65535
 dst-port range 20000 20010
 interface lan wan2
 src-ip single 192.168.127.30
exit
firewall 5
 src-ip single 0.0.0.0
 action accept
 protocol icmp
 dst-ip all
 interface lan all
 src-ip all
exit
firewall 6
 src-ip single 0.0.0.0
 action accept
 protocol all
 dst-ip all
 interface wan2 lan
exit
firewall 6 disable
firewall 7
 src-ip single 0.0.0.0
 action accept
 protocol all
 dst-ip all
 interface lan wan1
exit
firewall 7 disable
firewall 8
 src-ip single 0.0.0.0
 action accept
 protocol tcp
 dst-ip range 192.168.127.60 192.168.127.69
 dst-port range 8080 8090
 interface wan2 lan
exit
firewall 8 disable
firewall 9
 src-ip single 0.0.0.0
 action drop
 protocol all
 dst-ip all
 interface lan all
 src-ip range 192.168.127.200 192.168.127.250
exit
firewall 10
 src-ip single 0.0.0.0
 action accept
 protocol tcp
 dst-ip single 192.168.127.60
 dst-port single 22
 interface wan2 lan
 src-ip all
exit
ip nat static tcp inside lan 192.168.127.50 443 outside wan 1 8443
ip nat static inside lan 192.168.127.60 outside wan 2 198.51.100.60
ip nat dynamic inside lan 192.168.127.1 192.168.127.199 outside wan 1
exit
