address-group ipv4 "BLOCKLIST"
    address-object ipv4 "n 198.51.100.0_24"
    address-object ipv4 "n 203.0.113.128_25"
    exit
address-group ipv4 "INSIDE-NETS"
    address-object ipv4 "n 192.168.10.0_24"
    address-object ipv4 "n 192.168.20.0_24"
    exit
address-group ipv4 "WEB-SERVERS"
    address-object ipv4 "h 192.168.30.10"
    address-object ipv4 "r 192.168.30.11-192.168.30.12"
    exit
address-group ipv4 "UPDATES"
    address-object fqdn "updates.example.com"
    address-object fqdn "mirror.example.org"
    exit
address-group ipv6 "DMZ6"
    address-object ipv6 "n 2001:db8:30::_64"
    exit
address-group ipv4 "src spoofed inside sources"
    address-object ipv4 "r 0.0.0.0-192.168.9.255"
    address-object ipv4 "r 192.168.11.0-192.168.19.255"
    address-object ipv4 "r 192.168.21.0-255.255.255.255"
    exit
address-group ipv4 "dst forward-30"
    address-object ipv4 "n 192.168.30.0_24"
    address-object ipv4 "https to web1 destination"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv4 "dst web servers"
    address-group ipv4 "WEB-SERVERS"
    address-object ipv4 "https to web1 destination"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
