# Generated by FWShift - review the conversion report before loading this.
# A script for /import on RouterOS 6 or 7: /import file-name=FILE verbose=yes
# Nothing in it changes traffic until the disabled jump rules at its end are enabled (in Safe Mode).
:if ([:len [/ip firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
:if ([:len [/ipv6 firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
/interface list add name=fws-outside_zone comment="fwshift"
/interface list member add list=fws-outside_zone interface="outside" comment="fwshift"
/interface list add name=fws-inside_zone comment="fwshift"
/interface list member add list=fws-inside_zone interface="inside" comment="fwshift"
/ip firewall address-list add list=fws-r3-dst address="telemetry.example.net"
/ip firewall address-list add list=fws-office-devices address="10.40.0.10"
/ip firewall address-list add list=fws-office-devices address="10.40.0.200-10.40.0.220"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-inside_zone out-interface-list=fws-inside_zone src-address=10.41.0.0/24 dst-address=10.40.0.0/24 action=drop log=yes log-prefix="Block_IoT_to_office" comment="Block_IoT_to_office"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-inside_zone out-interface-list=fws-outside_zone src-address=10.40.0.0/24 protocol=tcp dst-port=80,443 action=accept comment="Inside_Outside_web"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-inside_zone out-interface-list=fws-outside_zone src-address=10.40.0.0/24 protocol=udp dst-port=53 action=accept comment="Inside_Outside_web"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-inside_zone out-interface-list=fws-outside_zone src-address=10.41.0.0/24 dst-address-list=fws-r3-dst protocol=tcp dst-port=443 action=accept comment="IoT_telemetry"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-outside_zone out-interface-list=fws-inside_zone dst-address=10.40.0.10 protocol=tcp dst-port=5001 action=accept comment="NAS_from_Internet"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-outside_zone out-interface-list=fws-inside_zone protocol=udp dst-port=1024-65535 src-port=53 action=accept comment="DNS_answers"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-outside_zone out-interface-list=fws-inside_zone protocol=udp dst-port=1024-65535 src-port=53 action=accept comment="DNS_answers"
# FWSHIFT disabled, see the report: "Staff_streaming" from inside_zone to outside_zone; source any; destination any; service any; action drop
# FWSHIFT disabled, see the report: "Guests_by_time" from inside_zone to outside_zone; source printers; destination any; service port-unreachable; action allow
/ip firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ipv6 firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-outside_zone dst-address=192.0.2.2 protocol=tcp dst-port=8443 action=dst-nat to-addresses=10.40.0.10 to-ports=5001 comment="NAS_published"
/ip firewall nat add chain=fwshift-dstnat dst-address=192.0.2.10 action=dst-nat to-addresses=10.40.0.10 comment="nas_static"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-outside_zone src-address=10.40.0.10 action=src-nat to-addresses=192.0.2.10 comment="nas_static"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-outside_zone action=masquerade comment="InsideOutsideNatRule"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-outside_zone src-address=10.41.0.0/24 action=masquerade comment="IoT_out" disabled=yes
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=dstnat action=jump jump-target=fwshift-dstnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
/ip firewall nat add chain=srcnat action=jump jump-target=fwshift-srcnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
