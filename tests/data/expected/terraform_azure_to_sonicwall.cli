    address-object ipv4 "h 168.63.129.16"
    exit
address-group ipv4 "asg-app"
    address-object ipv4 "n 10.40.2.4_31"
    exit
address-group ipv4 "asg-web"
    address-object ipv4 "h 10.40.1.4"
    exit
address-group ipv4 "src nsg-web:block-doc"
    address-object ipv4 "n 198.51.100.0_24"
    address-object ipv4 "n 203.0.113.0_24"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
address-group ipv4 "src nsg-web:to-app+nsg-web:block"
    address-object ipv4 "n 198.51.100.0_24"
    address-object ipv4 "n 203.0.113.0_24"
    exit
address-group ipv4 "src nsg-web:AllowVnetOutBound+ns"
    address-object ipv4 "n 198.51.100.0_24"
    address-object ipv4 "n 203.0.113.0_24"
    exit
address-group ipv4 "src nsg-app:AllowVnetOutBound+ns"
    address-object ipv4 "n 198.51.100.0_24"
    address-object ipv4 "n 203.0.113.0_24"
    exit
address-group ipv4 "src nsg-db:AllowVnetOutBound+nsg"
    address-object ipv4 "n 198.51.100.0_24"
    address-object ipv4 "n 203.0.113.0_24"
    exit
