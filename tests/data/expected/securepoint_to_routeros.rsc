/ip firewall filter add chain=fwshift-forward in-interface-list=fws-vpn-ipsec out-interface-list=fws-dmz1 src-address=10.20.0.0/16 dst-address-list=fws-servers protocol=tcp dst-port=22 action=accept comment="rule-7-2"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-dmz1 out-interface-list=fws-external src-address=172.16.20.0/24 action=accept comment="rule-8"
