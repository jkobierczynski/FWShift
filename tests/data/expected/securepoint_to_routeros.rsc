/ip firewall filter add chain=fwshift-forward in-interface-list=fws-internal out-interface-list=fws-external src-address=192.168.10.0/24 protocol=udp dst-port=53 action=accept comment="rule-1"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-internal out-interface-list=fws-external src-address=192.168.10.0/24 protocol=icmp icmp-options=8:0-255 action=accept comment="rule-1"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-internal out-interface-list=fws-external src-address=2001:db8:10::/64 protocol=tcp dst-port=80,443 action=accept comment="rule-4"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-vpn-ipsec out-interface-list=fws-internal src-address=10.20.0.0/16 dst-address=192.168.10.0/24 action=accept comment="rule-10"
