access-rule ipv4 from untrust to untrust action deny source address group "FWSHIFT all IPv4" service any destination address any
    name "FWSHIFT untrust to untrust"
    priority manual 45
    exit
access-rule ipv6 from trust to untrust action discard source address any service any destination address group "watched v6"
    name "block-bad 2"
    exit
access-rule ipv6 from guest to untrust action allow source address group "FWSHIFT all IPv6" service any destination address any
    name "guest-ping 2"
    no enable
    exit
access-rule ipv6 from trust to trust action allow source address group "FWSHIFT all IPv6" service any destination address any
    name "intra 2"
    exit
access-rule ipv6 from trust to untrust action allow source address any service name "app-ntp" destination address any
    name "global-ntp 2"
    no enable
    exit
access-rule ipv6 from dmz to dmz action deny source address group "FWSHIFT all IPv6" service any destination address any
    name "FWSHIFT dmz to dmz v6"
    exit
access-rule ipv6 from dmz to guest action deny source address group "FWSHIFT all IPv6" service any destination address any
    name "FWSHIFT dmz to guest v6"
    exit
