    name "FWSHIFT dmz to untrust"
    priority manual 33
    exit
access-rule ipv4 from guest to dmz action deny source address group "FWSHIFT all IPv4" service any destination address any
    name "FWSHIFT guest to dmz"
    priority manual 34
    exit
access-rule ipv4 from guest to guest action deny source address group "FWSHIFT all IPv4" service any destination address any
    name "FWSHIFT guest to guest"
    priority manual 35
    exit
access-rule ipv4 from guest to trust action deny source address group "FWSHIFT all IPv4" service any destination address any
    name "FWSHIFT guest to trust"
    priority manual 36
    exit
access-rule ipv4 from guest to untrust action deny source address group "FWSHIFT all IPv4" service any destination address any
    name "FWSHIFT guest to untrust"
    priority manual 37
    exit
access-rule ipv4 from trust to dmz action deny source address group "FWSHIFT all IPv4" service any destination address any
    name "FWSHIFT trust to dmz"
    priority manual 38
    exit
access-rule ipv4 from trust to guest action deny source address group "FWSHIFT all IPv4" service any destination address any
    name "FWSHIFT trust to guest"
    priority manual 39
    exit
access-rule ipv4 from trust to trust action deny source address group "FWSHIFT all IPv4" service any destination address any
    name "FWSHIFT trust to trust"
    priority manual 40
    exit
access-rule ipv4 from trust to untrust action deny source address group "FWSHIFT all IPv4" service any destination address any
    name "FWSHIFT trust to untrust"
    priority manual 41
    exit
access-rule ipv4 from untrust to dmz action deny source address group "FWSHIFT all IPv4" service any destination address any
    name "FWSHIFT untrust to dmz"
    priority manual 42
    exit
access-rule ipv4 from untrust to guest action deny source address group "FWSHIFT all IPv4" service any destination address any
    name "FWSHIFT untrust to guest"
    priority manual 43
