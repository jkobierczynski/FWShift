set tag Infrastructure
set tag Outbound
set tag Inbound
set address lan-net ip-netmask 10.10.0.0/16
set address dmz-net ip-netmask 10.20.0.0/24
set address dns-1 ip-netmask 192.0.2.53/32
set address admin-range ip-range 10.10.5.10-10.10.5.20
set address web-1 ip-netmask 10.20.0.10/32
set address web-1 description "Web server in the DMZ"
set address web-1_valid_address ip-netmask 203.0.113.10/32
set address web-1_valid_address description "address automatic NAT gives web-1"
set address mail-1 ip-netmask 10.20.0.25/32
set address guest-net ip-netmask 10.10.200.0/24
set address netadmins ip-netmask 0.0.0.0/32
set address netadmins description "FWSHIFT PLACEHOLDER, matches nothing: access role whose networks and users are not in the export (add the output of 'show access-roles details-level full')"
set address plc-net ip-netmask 10.30.1.0/24
set address x.updates.example.com fqdn updates.example.com
set address lan-without-guests ip-netmask 0.0.0.0/32
set address lan-without-guests description "FWSHIFT PLACEHOLDER, matches nothing: object of type 'group-with-exclusion'"
set address lan6-net ip-netmask 2001:db8:10::/48
set address gw-edge ip-netmask 198.51.100.1/32
set address mail-public ip-netmask 203.0.113.25/32
set address nat-out ip-netmask 198.51.100.20/32
set address h-192.0.2.54 ip-netmask 192.0.2.54
set address h-2001_db8_53__54 ip-netmask 2001:db8:53::54
set address-group dns-2 static [ h-192.0.2.54 h-2001_db8_53__54 ]
set address-group dns-servers static [ dns-1 dns-2 ]
set address-group dmz-servers static [ web-1 web-1_valid_address mail-1 ]
set address-group dmz-servers description "Everything in the DMZ"
set service domain-udp protocol udp port 53
set service domain-tcp protocol tcp port 53
set service ssh protocol tcp port 22
set service http protocol tcp port 80
set service https protocol tcp port 443
