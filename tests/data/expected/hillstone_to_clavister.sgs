add IPRule Index=2 Name=fws_dnatrule_2_default Action=Drop SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
cc
cc IPRuleSet fws_rules
add IPRule Index=1 Name=fws_dnatrule_1_sat Action=SAT SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_pub-web Service=fws_HTTP SATTranslate=DestinationIP SATTranslateToIP=fws_web-srv SATTranslateToPort=8080 LogEnabled=No Comments="dnatrule id 1 from Any to pub-web service HTTP trans-to web-srv port 8080"
add IPRule Index=2 Name=fws_dnatrule_2_sat Action=SAT SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_203.0.113.11 Service=all_services SATTranslate=DestinationIP SATTranslateToIP=fws_10.20.0.25 LogEnabled=No Comments="dnatrule id 2 from address-book Any to ip 203.0.113.11 service Any trans-to ip 10.20.0.25"
add GotoRule Index=3 Name=fws_dnatrule_1_goto SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_pub-web Service=fws_HTTP RuleSet=fws_d_dnatrule_1 LogEnabled=No
add GotoRule Index=4 Name=fws_dnatrule_2_goto SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_203.0.113.11 Service=all_services RuleSet=fws_d_dnatrule_2 LogEnabled=No
