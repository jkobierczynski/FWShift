add IPRule Index=2 Name=fws_dnatrule_1_default Action=Drop SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
cc
cc IPRuleSet fws_d_dnatrule_2
