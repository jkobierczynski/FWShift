cc IPRuleSet fws_snat
add IPRule Index=1 Name=fws_snatrule_1 Action=Allow SourceInterface=fws_zones SourceNetwork=fws_inside-net DestinationInterface=any DestinationNetwork=fws_partners Service=all_services LogEnabled=No Comments="snatrule id 1 from inside-net to partners service Any no-trans"
add IPRule Index=2 Name=fws_snatrule_2 Action=NAT SourceInterface=fws_zones SourceNetwork=fws_inside-net DestinationInterface=ethernet0_0 DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="snatrule id 2 from inside-net to Any service Any eif ethernet0/0 trans-to eif-ip mode dynamicport"
add IPRule Index=3 Name=fws_snatrule_4_sat Action=SAT SourceInterface=fws_zones SourceNetwork=fws_web-srv DestinationInterface=any DestinationNetwork=all-nets Service=all_services SATTranslate=SourceIP SATTranslateToIP=fws_203.0.113.12 LogEnabled=No
set IPRule 3 -disable
add IPRule Index=4 Name=fws_snatrule_4 Action=Allow SourceInterface=fws_zones SourceNetwork=fws_web-srv DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="snatrule id 4 from web-srv to Any service Any trans-to ip 203.0.113.12 mode static disable"
set IPRule 4 -disable
add IPRule Index=5 Name=fws_snat_allow Action=Allow SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
add IPRule Index=6 Name=fws_snat_allow_v6 Action=Allow SourceInterface=any SourceNetwork=all-nets6 DestinationInterface=any DestinationNetwork=all-nets6 Service=all_services LogEnabled=No
cc
cc IPRuleSet fws_d_dnatrule_1
