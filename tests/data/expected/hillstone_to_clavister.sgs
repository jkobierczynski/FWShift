add GotoRule Index=6 Name=fws_inside-to-web SourceInterface=ethernet0_1 SourceNetwork=fws_inside-net DestinationInterface=ethernet0_0 DestinationNetwork=all-nets Service=fws_inside-to-web_svc RuleSet=fws_snat LogEnabled=Yes
add GotoRule Index=7 Name=fws_publish-web SourceInterface=ethernet0_0 SourceNetwork=all-nets DestinationInterface=ethernet0_2 DestinationNetwork=fws_pub-web Service=fws_HTTP RuleSet=fws_snat LogEnabled=No Comments="web server published by dnatrule 1"
