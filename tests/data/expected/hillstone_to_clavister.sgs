set IPRule 13 -disable
add IPRule Index=14 Name=fws_v6-out Action=Allow SourceInterface=ethernet0_1 SourceNetwork=fws_v6-inside DestinationInterface=ethernet0_0 DestinationNetwork=all-nets6 Service=fws_v6-out_svc LogEnabled=No
add GotoRule Index=15 Name=fws_tunnels-to-partners SourceInterface=fws_if_ethernet0_2_ethernet0_3 SourceNetwork=all-nets DestinationInterface=ethernet0_0 DestinationNetwork=fws_partners Service=fws_gre-tunnel RuleSet=fws_snat LogEnabled=No
add IPRule Index=16 Name=fws_to-branch-vpn Action=Allow SourceInterface=ethernet0_1 SourceNetwork=fws_inside-net DestinationInterface=ethernet0_0 DestinationNetwork=all-nets Service=all_services LogEnabled=No
set IPRule 16 -disable
add IPRule Index=17 Name=fws_contractors-out Action=Allow SourceInterface=any SourceNetwork=fws_nothing DestinationInterface=any DestinationNetwork=fws_nothing Service=all_services LogEnabled=No
set IPRule 17 -disable
add GotoRule Index=18 Name=fws_rule_13 SourceInterface=ethernet0_1 SourceNetwork=fws_inside-net DestinationInterface=ethernet0_3 DestinationNetwork=all-nets Service=all_services RuleSet=fws_snat LogEnabled=No
add IPRule Index=19 Name=fws_default Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=all-nets Service=all_services LogEnabled=No
add IPRule Index=20 Name=fws_default_v6 Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets6 DestinationInterface=fws_zones DestinationNetwork=all-nets6 Service=all_services LogEnabled=No
add ReturnRule Index=21 Name=fws_return SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
