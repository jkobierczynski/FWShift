/interface list member add list=fws-Domain interface="Domain" comment="fwshift"
/interface list add name=fws-Private comment="fwshift"
/interface list member add list=fws-Private interface="Private" comment="fwshift"
/interface list add name=fws-Public comment="fwshift"
/interface list member add list=fws-Public interface="Public" comment="fwshift"
