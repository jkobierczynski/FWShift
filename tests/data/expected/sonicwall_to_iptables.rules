# FORWARD chain and nat table for iptables-restore.
# It does not contain INPUT or OUTPUT: load it with --noflush, or merge it into your ruleset.
*filter
:FORWARD DROP [0:0]
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
-A FORWARD -i LAN -o WAN -d 203.0.113.0/25 -m comment --comment "LAN to WAN #1" -j REJECT
-A FORWARD -i LAN -o WAN -d 192.0.2.66/32 -m comment --comment "LAN to WAN #1" -j REJECT
-A FORWARD -i LAN -o WAN -m iprange --src-range 10.10.5.10-10.10.5.20 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "Admins out by SSH" -j ACCEPT
-A FORWARD -i LAN -o WAN -p tcp -m multiport --dports 80,443,8443 -m conntrack --ctstate NEW -m comment --comment "LAN to WAN #3" -j ACCEPT
# disabled in the source: "LAN to WAN #4" from LAN to WAN; source 0.0.0.0/0; destination 0.0.0.0/0; service GRE Tunnel; action allow
-A FORWARD -i LAN -o WAN -m conntrack --ctstate NEW -m comment --comment "LAN to WAN #5" -j ACCEPT
-A FORWARD -i WAN -o DMZ -d 10.20.0.10/32 -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -m comment --comment "Web server from the internet" -j ACCEPT
-A FORWARD -i WAN -o DMZ -s 192.0.2.128/26 -d 10.20.0.25/32 -p tcp -m tcp --dport 25 -m conntrack --ctstate NEW -m comment --comment "Mail from partners" -j ACCEPT
-A FORWARD -i WAN -o DMZ -s 203.0.113.0/25 -d 10.20.0.25/32 -p tcp -m tcp --dport 25 -m conntrack --ctstate NEW -m comment --comment "Mail from partners" -j ACCEPT
-A FORWARD -i WAN -o DMZ -s 192.0.2.66/32 -d 10.20.0.25/32 -p tcp -m tcp --dport 25 -m conntrack --ctstate NEW -m comment --comment "Mail from partners" -j ACCEPT
-A FORWARD -i WAN -o DMZ -m comment --comment "WAN to DMZ #3" -j REJECT
-A FORWARD -i WAN -o LAN -m comment --comment "WAN to LAN #1" -j REJECT
-A FORWARD -i DMZ -o Servers -s 10.20.0.10/32 -d 10.30.0.5/32 -p udp -m udp --dport 16384:16484 -m conntrack --ctstate NEW -m comment --comment "Web server to the database" -j ACCEPT
# FWSHIFT disabled, see the report: "Mail server pings the LAN" from DMZ to LAN; source Mail Server; destination 0.0.0.0/0; service Echo Object; action allow
# FWSHIFT disabled, see the report: "Administrators to the DMZ" from LAN to DMZ; source 0.0.0.0/0; destination 0.0.0.0/0; service any; action allow
# FWSHIFT disabled, see the report: "Updates in working hours" from Servers to WAN; source 0.0.0.0/0; destination Update Site; service HTTPS; action allow
-A FORWARD -i LAN -o DMZ -m conntrack --ctstate NEW -m comment --comment "default LAN to DMZ" -j ACCEPT
-A FORWARD -i DMZ -o WAN -m conntrack --ctstate NEW -m comment --comment "default DMZ to WAN" -j ACCEPT
-A FORWARD -i Servers -o WAN -m conntrack --ctstate NEW -m comment --comment "default Servers to WAN" -j ACCEPT
-A FORWARD -i Servers -o DMZ -m conntrack --ctstate NEW -m comment --comment "default Servers to DMZ" -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i WAN -d 198.51.100.10/32 -p tcp -m tcp --dport 443 -m comment --comment "Web server" -j DNAT --to-destination 10.20.0.10
-A PREROUTING -i WAN -d 198.51.100.11/32 -p tcp -m tcp --dport 2525 -m comment --comment "Mail on another port" -j DNAT --to-destination 10.20.0.25:25
-A PREROUTING -i WAN -d 198.51.100.32/28 -m comment --comment "Servers one to one (reflexive)" -j DNAT --to-destination 10.30.0.0-10.30.0.15
-A POSTROUTING -o WAN -s 10.10.0.0/16 -m comment --comment "Default NAT" -j MASQUERADE
-A POSTROUTING -o WAN -s 10.30.0.0/28 -m comment --comment "Servers one to one" -j SNAT --to-source 198.51.100.32-198.51.100.47
# disabled in the source: -A POSTROUTING -o WAN -m iprange --src-range 10.10.5.10-10.10.5.20 -m comment --comment "Old admin NAT" -j SNAT --to-source 198.51.100.10
