    address-object ipv4 "n 10.10.0.0_16"
    address-object ipv4 "r 10.30.0.1-10.30.0.99"
    exit
service-object "UDP_ANY" UDP 1 65535
service-object "TCP_ANY" TCP 1 65535
service-object "DNS tcp 53" TCP 53 53
service-object "DNS udp 53" UDP 53 53
service-group "DNS"
    service-object "DNS tcp 53"
    service-object "DNS udp 53"
    exit
service-object "HTTP 2" TCP 80 80
service-object "HTTPS 2" TCP 443 443
service-object "App-8443 tcp 8443" TCP 8443 8443
service-object "App-8443 tcp 8000-8010" TCP 8000 8010
service-group "App-8443"
    service-object "App-8443 tcp 8443"
    service-object "App-8443 tcp 8000-8010"
    exit
service-object "NTP 2" UDP 123 123
service-object "SSH 2" TCP 22 22
service-group "Web"
    service-object "HTTP 2"
    service-object "HTTPS 2"
    exit
service-group "svc Evaluate apps"
    service-object "TCP_ANY"
    service-object "UDP_ANY"
    exit
