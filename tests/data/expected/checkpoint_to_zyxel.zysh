# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
service-object FWS_domain-udp udp eq 53
service-object FWS_domain-tcp tcp eq 53
object-group service FWS_DNS_svc
 service-object FWS_domain-udp
 service-object FWS_domain-tcp
exit
address-object FWS_lan-net 10.10.0.0/16
address-object FWS_dmz-net 10.20.0.0/24
object-group address FWS_DNS_src
 address-object FWS_lan-net
 address-object FWS_dmz-net
exit
address-object FWS_dns-1 192.0.2.53
address-object FWS_192_0_2_54 192.0.2.54
object-group address FWS_dns-2
 address-object FWS_192_0_2_54
exit
object-group address FWS_dns-servers
 address-object FWS_dns-1
 object-group FWS_dns-2
exit
service-object FWS_ssh tcp eq 22
address-object FWS_admin-range 10.10.5.10-10.10.5.20
address-object FWS_web-1 10.20.0.10
address-object FWS_web-1_valid_address 203.0.113.10
address-object FWS_mail-1 10.20.0.25
object-group address FWS_dmz-servers
 address-object FWS_web-1
 address-object FWS_web-1_valid_address
 address-object FWS_mail-1
exit
service-object FWS_http tcp eq 80
service-object FWS_https tcp eq 443
object-group service FWS_Web_out_svc
 service-object FWS_http
 service-object FWS_https
exit
address-object FWS_guest-net 10.10.200.0/24
address-object FWS_not_dns-servers_1 0.0.0.0-192.0.2.52
address-object FWS_not_dns-servers_2 192.0.2.55-255.255.255.255
object-group address FWS_not_dns-servers
 address-object FWS_not_dns-servers_1
 address-object FWS_not_dns-servers_2
exit
service-object FWS_noservice protocol 255
address-object FWS_plc-net 10.30.1.0/24
address-object FWS_nothing 0.0.0.0
object-group service FWS_PLC_access_svc
 service-object FWS_https
 service-object FWS_ssh
exit
service-object FWS_syslog-from-high_dst udp eq 514
address6-object FWS_lan6-net 2001:db8:10::/48
object-group address FWS_Public_web_dst
 address-object FWS_web-1
 address-object FWS_web-1_valid_address
exit
service-object FWS_tcp-high tcp range 9000 9010
object-group service FWS_app-ports
 service-object FWS_https
 service-object FWS_tcp-high
exit
service-object FWS_smtp tcp eq 25
service-object FWS_echo-request icmp 8
service-object FWS_gre protocol 47
address-object FWS_gw-edge 198.51.100.1
service-object FWS_ident tcp eq 113
address-object FWS_nat-out 198.51.100.20
zone FWS_InternalZone
exit
zone FWS_ExternalZone
exit
secure-policy insert 1
 name FWS_DNS
 no activate
 description "Name resolution"
 sourceip FWS_DNS_src
 destinationip FWS_dns-servers
 service FWS_DNS_svc
 action allow
 log
 activate
exit
secure-policy insert 2
 name FWS_rule-2
 no activate
 sourceip FWS_admin-range
 destinationip FWS_dmz-servers
 service FWS_ssh
 action allow
 log
 activate
exit
secure-policy insert 3
 name FWS_Web_out_1
 no activate
 from FWS_InternalZone
 to FWS_ExternalZone
 service FWS_Web_out_svc
 action allow
 log
 activate
exit
secure-policy6 insert 1
 name FWS_Web_out_2
 no activate
 from FWS_InternalZone
 to FWS_ExternalZone
 service FWS_Web_out_svc
 action allow
 log
 activate
exit
secure-policy insert 4
