output "fwshift_networks" {
  description = "Each network security group, with the networks of the subnets to associate it with"
  value = {
    "FWShift" = {
      id       = azurerm_network_security_group.nsg_FWShift.id
      networks = []
    }
  }
}

# Not written:
#   Admin SSH: the rule is for zone Trusted, External, and a security rule names no zone: give the networks behind it with --zone-network
#   Web Out: the rule is for zone Trusted, Guests, DMZ, External, and a security rule names no zone: give the networks behind it with --zone-network
#   Web In: the rule is for zone External, and a security rule names no zone: give the networks behind it with --zone-network
#   Mail In: the rule is for zone External, and a security rule names no zone: give the networks behind it with --zone-network
#   DMZ Updates: schedule 'Business Hours' is not converted; the rule would apply at all times; host name object Update-Site.1.alm updates.example.com: a security rule names addresses; the rule is for zone DMZ, and a security rule names no zone: give the networks behind it with --zone-network
#   Guests Out: disabled in the source
#   Staff Only: source user match Staff is not converted; the rule is for zone Trusted, and a security rule names no zone: give the networks behind it with --zone-network
#   Ping: the rule is for zone Trusted, Guests, and a security rule names no zone: give the networks behind it with --zone-network
#   Lab Tunnel: the rule is for zone Lab, External, and a security rule names no zone: give the networks behind it with --zone-network
