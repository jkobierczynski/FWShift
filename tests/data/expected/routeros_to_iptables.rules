# Generated by FWShift - review the conversion report before loading this.
# FORWARD chain and nat table for iptables-restore.
# It does not contain INPUT or OUTPUT: load it with --noflush, or merge it into your ruleset.
*filter
:FORWARD ACCEPT [0:0]
:FWS1 - [0:0]
:FWS1-1 - [0:0]
:FWS2 - [0:0]
:FWS2-1 - [0:0]
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
# FWSHIFT disabled, see the report: "defconf: accept in ipsec policy" from any to any; source 0.0.0.0/0; destination any; service any; action allow
# FWSHIFT disabled, see the report: "banned scanners" from any to any; source 0.0.0.0/0; destination any; service any; action drop
-A FORWARD -o DMZ -m iprange --src-range 192.168.10.50-192.168.10.59 -d 172.16.20.10/32 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "ssh from the admins" -j ACCEPT
-A FORWARD -o DMZ -m iprange --src-range 192.168.10.50-192.168.10.59 -d 172.16.20.11/32 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "ssh from the admins" -j ACCEPT
-A FORWARD -o DMZ -m iprange --src-range 192.168.10.50-192.168.10.59 -d 172.16.20.10/32 -p tcp -m multiport --dports 80,443,8000:8080 -m conntrack --ctstate NEW -m comment --comment "web for everyone" -j ACCEPT
-A FORWARD -o DMZ -m iprange --src-range 192.168.10.50-192.168.10.59 -d 172.16.20.11/32 -p tcp -m multiport --dports 80,443,8000:8080 -m conntrack --ctstate NEW -m comment --comment "web for everyone" -j ACCEPT
-A FORWARD -o DMZ -m iprange ! --src-range 192.168.10.50-192.168.10.59 -d 172.16.20.10/32 -p tcp -m multiport --dports 80,443,8000:8080 -m conntrack --ctstate NEW -m comment --comment "web for everyone-2" -j ACCEPT
-A FORWARD -o DMZ -m iprange ! --src-range 192.168.10.50-192.168.10.59 -d 172.16.20.11/32 -p tcp -m multiport --dports 80,443,8000:8080 -m conntrack --ctstate NEW -m comment --comment "web for everyone-2" -j ACCEPT
-A FORWARD -o DMZ -m iprange --src-range 192.168.10.50-192.168.10.59 -p icmp -m icmp --icmp-type 8/0 -m conntrack --ctstate NEW -m comment --comment "ping 'echo' only" -j ACCEPT
-A FORWARD -o DMZ -m iprange ! --src-range 192.168.10.50-192.168.10.59 -p icmp -m icmp --icmp-type 8/0 -m conntrack --ctstate NEW -m comment --comment "ping 'echo' only-2" -j ACCEPT
# disabled in the source: "old partner access" from any to DMZ; source partners; destination any; service not tcp-any; action allow
# disabled in the source: "old partner access-2" from any to DMZ; source partners; destination any; service tcp-0-21,23-65535; action allow
-A FORWARD -o DMZ -m comment --comment "nothing but TCP" -j FWS1
-A FWS1 -m iprange --src-range 192.168.10.50-192.168.10.59 -j FWS1-1
-A FWS1-1 -p tcp -j RETURN
-A FWS1-1 -j REJECT
-A FORWARD -o DMZ -m comment --comment "nothing but TCP-2" -j FWS2
-A FWS2 -m iprange --src-range 192.168.10.50-192.168.10.59 -j RETURN
-A FWS2 -j FWS2-1
-A FWS2-1 -p tcp -j RETURN
-A FWS2-1 -j REJECT
# FWSHIFT disabled, see the report: "rest of the DMZ" from any to DMZ; source admins; destination not 172.16.20.0/25; service any; action drop
# FWSHIFT disabled, see the report: "rest of the DMZ-2" from any to DMZ; source 0.0.0.0-192.168.10.49,192.168.10.60-255.255.255.255; destination not 172.16.20.0/25; service not tcp-any; action drop
# FWSHIFT disabled, see the report: "rest of the DMZ-3" from any to DMZ; source 0.0.0.0-192.168.10.49,192.168.10.60-255.255.255.255; destination not 172.16.20.0/25; service tcp-0-21,23-65535; action drop
-A FORWARD -i LAN -d updates.example.com -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -m comment --comment "LAN to the package mirrors" -j ACCEPT
-A FORWARD -i LAN -d 192.0.2.80/32 -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -m comment --comment "LAN to the package mirrors" -j ACCEPT
-A FORWARD -i GUEST -p tcp -m multiport --dports 80,443 -m comment --comment "no other web from guests" -j REJECT --reject-with tcp-reset
-A FORWARD -i GUEST -o WAN -p udp -m udp --dport 53 -m conntrack --ctstate NEW -m comment --comment "guest DNS, either port" -j ACCEPT
-A FORWARD -i GUEST -o WAN -p udp -m udp --sport 53 -m conntrack --ctstate NEW -m comment --comment "guest DNS, either port-2" -j ACCEPT
-A FORWARD -i GUEST -o WAN -m conntrack --ctstate NEW -m comment --comment "guests to the internet" -j ACCEPT
# FWSHIFT disabled, see the report: "office hours for staff" from LAN to WAN; source 192.168.10.0/25; destination any; service any; action allow
-A FORWARD -i GUEST -m comment --comment "no guests elsewhere" -j DROP
-A FORWARD -i WAN -d 203.0.113.3/32 -p tcp -m tcp --dport 8443 -m conntrack --ctstate NEW -m comment --comment "defconf: drop all from WAN not DSTNATed (allows publish web)" -j ACCEPT
-A FORWARD -i WAN -d 203.0.113.4/32 -p tcp -m tcp --dport 25 -m conntrack --ctstate NEW -m comment --comment "defconf: drop all from WAN not DSTNATed (allows publish mail)" -j ACCEPT
-A FORWARD -i WAN -m comment --comment "defconf: drop all from WAN not DSTNATed" -j DROP
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i WAN -d 203.0.113.3/32 -p tcp -m tcp --dport 8443 -m comment --comment "publish web" -j DNAT --to-destination 172.16.20.10:443
-A PREROUTING -i WAN -d 203.0.113.4/32 -p tcp -m tcp --dport 25 -m comment --comment "publish mail" -j DNAT --to-destination 172.16.20.11
-A POSTROUTING -o WAN -m comment --comment "defconf: masquerade" -j MASQUERADE
COMMIT
