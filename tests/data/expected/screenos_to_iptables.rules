*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -d 203.0.113.10 -m comment --comment "mip-203.0.113.10 inbound" -j DNAT --to-destination 10.20.0.10
-A PREROUTING -d 203.0.113.24-203.0.113.31 -m comment --comment "mip-203.0.113.24 inbound" -j DNAT --to-destination 10.30.0.24-10.30.0.31
