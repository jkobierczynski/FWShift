-A FORWARD -i DMZ -o Servers -s 10.20.0.10/32 -d 10.30.0.24/32 -p tcp -m tcp --dport 9000 -m tcp --sport 1024:2000 -m conntrack --ctstate NEW -m comment --comment "policy-8" -j ACCEPT
