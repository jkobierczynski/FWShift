-A POSTROUTING -o Untrust -s 10.10.0.0/16 -m comment --comment "nat-policy-3" -j MASQUERADE
-A POSTROUTING -o Untrust -s 10.20.0.10/32 -m comment --comment "mip-203.0.113.10" -j SNAT --to-source 203.0.113.10
-A POSTROUTING -o Untrust -s 10.30.0.24/29 -m comment --comment "mip-203.0.113.24" -j SNAT --to-source 203.0.113.24-203.0.113.31
-A POSTROUTING -o Untrust -m comment --comment "nat-mode-Trust" -j MASQUERADE
COMMIT
