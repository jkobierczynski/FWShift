set address Monitoring ip-range 198.51.100.10-198.51.100.20
set address Internet ip-netmask 0.0.0.0/0
set address Internet description "every address behind the Internet connections WAN"
set address-group Servers static [ Webserver Mailserver ]
set address h-192.168.10.5 ip-netmask 192.168.10.5
set address h-10.30.0.5 ip-netmask 10.30.0.5
