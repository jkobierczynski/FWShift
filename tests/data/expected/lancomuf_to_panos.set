set address Webserver ip-netmask 172.16.20.10
set address Webserver description "public web server"
set address Mailserver ip-netmask 172.16.20.25
set address HMI ip-netmask 10.30.0.50
set address Printer ip-netmask 0.0.0.0/32
set address Printer description "FWSHIFT PLACEHOLDER, matches nothing: a host that names no interface"
set address LAN ip-netmask 192.168.10.0/24
set address DMZ ip-netmask 172.16.20.0/24
set address OT-Cell ip-netmask 10.30.0.0/24
