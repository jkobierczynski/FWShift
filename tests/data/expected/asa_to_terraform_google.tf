resource "google_compute_network_firewall_policy_rule" "r1300" {
  project         = var.project
  firewall_policy = google_compute_network_firewall_policy.policy.name
  priority        = 1300
  direction       = "INGRESS"
  action          = "deny"
  description     = "fwshift-default-deny"
  match {
    src_ip_ranges  = ["::/0"]
    dest_ip_ranges = ["::/0"]
    layer4_configs {
      ip_protocol = "all"
    }
  }
}

