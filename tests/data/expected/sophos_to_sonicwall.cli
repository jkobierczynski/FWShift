configure terminal
address-object ipv4 "lan-net" network 10.10.0.0 255.254.0.0 zone LAN
address-object ipv4 "web-1" host 10.20.0.10 zone DMZ
address-object ipv4 "mail-1" host 10.20.0.25 zone DMZ
address-object ipv4 "web-public" host 198.51.100.10 zone DMZ
address-object ipv4 "mail-public" host 198.51.100.25 zone DMZ
address-object ipv4 "admin-range" range 10.10.5.10 10.10.5.20 zone LAN
address-object ipv4 "partner-net" network 10.99.0.0 255.255.0.0 zone LAN
address-object ipv4 "scada-server" host 10.10.7.15 zone LAN
address-object ipv4 "plc-net" network 10.30.1.0 255.255.255.0 zone OT
address-object ipv6 "lan6-net" network 2001:db8:10:: /48 zone LAN
address-object fqdn "updates.example.com" domain "updates.example.com" zone WAN
address-object fqdn "mirror.example.net" domain "mirror.example.net" zone WAN
address-object ipv4 "any-example-org" host 192.0.0.8 zone LAN
address-object ipv4 "Blocked countries" host 192.0.0.8 zone WAN
address-object ipv4 "h 10.10.0.53" host 10.10.0.53 zone LAN
address-object ipv4 "h 10.11.0.53" host 10.11.0.53 zone LAN
address-object ipv4 "r 0.0.0.0-10.20.0.24" range 0.0.0.0 10.20.0.24 zone LAN
address-object ipv4 "r 10.20.0.26-255.255.255.255" range 10.20.0.26 255.255.255.255 zone LAN
address-object ipv4 "r 10.10.0.0-10.10.5.9" range 10.10.0.0 10.10.5.9 zone LAN
address-object ipv4 "r 10.10.5.21-10.11.255.255" range 10.10.5.21 10.11.255.255 zone LAN
address-object ipv4 "n 0.0.0.0_1" network 0.0.0.0 128.0.0.0 zone LAN
address-object ipv4 "n 128.0.0.0_1" network 128.0.0.0 128.0.0.0 zone LAN
address-object ipv6 "n ::_1" network :: /1 zone LAN
address-object ipv6 "n 8000::_1" network 8000:: /1 zone LAN
address-group ipv4 "dns-servers"
    address-object ipv4 "h 10.10.0.53"
    address-object ipv4 "h 10.11.0.53"
    exit
address-group ipv4 "dmz-servers"
    address-object ipv4 "web-1"
    address-object ipv4 "mail-1"
    exit
address-group ipv4 "update-sites"
    address-object fqdn "mirror.example.net"
    address-object fqdn "updates.example.com"
    exit
address-group ipv6 "update-sites v6"
    address-object fqdn "mirror.example.net"
    address-object fqdn "updates.example.com"
    exit
address-group ipv4 "dst LAN to DMZ web not mail"
    address-object ipv4 "r 0.0.0.0-10.20.0.24"
    address-object ipv4 "r 10.20.0.26-255.255.255.255"
    exit
address-group ipv4 "src LAN SSH out-2"
    address-object ipv4 "r 10.10.0.0-10.10.5.9"
    address-object ipv4 "r 10.10.5.21-10.11.255.255"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
service-object "HTTP 2" TCP 80 80
service-object "HTTPS 2" TCP 443 443
service-object "DNS tcp 53" TCP 53 53
service-object "DNS udp 53" UDP 53 53
service-group "DNS"
    service-object "DNS tcp 53"
    service-object "DNS udp 53"
    exit
service-object "SMTP" TCP 25 25
service-object "smtp-alt" TCP 2525 2525
service-object "SSH 2" TCP 22 22
service-object "MODBUS" TCP 502 502
service-object "app-ports tcp 8080" TCP 8080 8080
service-object "app-ports tcp 8443" TCP 8443 8443
service-object "app-ports tcp 9000-9010" TCP 9000 9010
service-group "app-ports"
    service-object "app-ports tcp 8080"
    service-object "app-ports tcp 8443"
    service-object "app-ports tcp 9000-9010"
    exit
service-object "tcp 25" TCP 25 25
service-group "Web Access"
    service-object "HTTP 2"
    service-object "HTTPS 2"
    exit
service-group "basic-net"
    service-group "DNS"
    service-object "Ping"
    exit
service-group "NAT of LAN to Internet web servi"
    service-group "Web Access"
    service-group "DNS"
    exit
service-group "svc LAN to Internet web"
    service-group "Web Access"
    service-group "DNS"
    exit
service-group "svc Admins to DMZ"
    service-object "SSH 2"
    service-object "Ping"
    exit
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "web-public" translated-destination name "web-1" service name "HTTPS 2" translated-service original
    name "Publish web"
    comment "Publish web"
    priority manual 1
    exit
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "mail-public" translated-destination name "mail-1" service name "smtp-alt" translated-service name "tcp 25"
    name "Publish mail"
    comment "Port 2525 outside, 25 on the ser"
    priority manual 2
    exit
nat-policy ipv4 inbound any outbound any source name "mail-1" translated-source name "mail-public" destination any translated-destination original service any translated-service original
    name "Mail server out"
    comment "Mail server out"
    priority manual 3
    exit
nat-policy ipv4 inbound any outbound any source name "lan-net" translated-source original destination name "partner-net" translated-destination original service any translated-service original
    name "No NAT to partner"
    comment "Reached through a tunnel"
    priority manual 4
    exit
access-rule ipv4 from WAN to DMZ action discard source address name "Blocked countries" service any destination address any
    name "Block countries"
    priority manual 1
    no enable
    exit
