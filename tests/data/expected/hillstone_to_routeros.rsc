/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lab out-interface-list=fws-untrust src-address=10.30.0.100-10.30.0.150 dst-address-list=fws-r7-dst protocol=tcp dst-port=443 action=accept comment="lab-updates" disabled=yes
