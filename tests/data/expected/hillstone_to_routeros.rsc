/ipv6 firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ip firewall nat add chain=fwshift-dstnat dst-address=203.0.113.10 protocol=tcp dst-port=80 action=dst-nat to-addresses=10.20.0.10 to-ports=8080 comment="dnatrule 1"
/ip firewall nat add chain=fwshift-dstnat dst-address=203.0.113.11 action=dst-nat to-addresses=10.20.0.25 comment="dnatrule 2"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-untrust src-address=10.10.0.0/24 action=masquerade comment="snatrule 2"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-untrust src-address=10.30.0.100-10.30.0.150 action=src-nat to-addresses=203.0.113.20-203.0.113.21 comment="snatrule 3"
/ip firewall nat add chain=fwshift-srcnat src-address=10.20.0.10 action=src-nat to-addresses=203.0.113.12 comment="snatrule 4" disabled=yes
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=dstnat action=jump jump-target=fwshift-dstnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
/ip firewall nat add chain=srcnat action=jump jump-target=fwshift-srcnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
