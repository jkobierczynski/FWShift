/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-trust protocol=icmp icmp-options=8:0-255 action=accept comment="inside-ping"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-untrust src-address=10.10.0.0/24 protocol=tcp dst-port=80,443,8080,53 action=accept comment="inside-to-web"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-untrust src-address=10.10.0.0/24 protocol=udp dst-port=53 action=accept comment="inside-to-web"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-untrust out-interface-list=fws-dmz dst-address=10.20.0.10 protocol=tcp dst-port=8080 action=accept comment="publish-web"
# FWSHIFT disabled, see the report: "block-country" from trust to untrust; source 0.0.0.0/0; destination blocked-country; service any; action deny
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lab out-interface-list=fws-trust action=reject comment="lab-to-inside"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-dmz src-address-list=fws-inside-no-printers dst-address-list=fws-servers protocol=tcp dst-port=80,443,8080,22 action=accept comment="inside-to-servers"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-trust out-interface-list=fws-dmz src-address-list=fws-inside-no-printers dst-address-list=fws-servers protocol=icmp icmp-options=8:0 action=accept comment="inside-to-servers"
