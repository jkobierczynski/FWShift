configure terminal
firewall
service name FWS_tcp_53 proto tcp src all dst port 53
service name FWS_udp_53 proto udp src all dst port 53
service name FWS_SSH proto tcp src all dst port 22
service name FWS_tcp_8443 proto tcp src all dst port 8443
service name FWS_tcp_8000-8010 proto tcp src all dst range 8000 - 8010
service name FWS_tcp_80 proto tcp src all dst port 80
service name FWS_tcp_443 proto tcp src all dst port 443
service name FWS_Syslog-From-Highport proto udp src range 1024 - 65535 dst port 514
proto name FWS_GRE_PROTOCOL num 47
proto name FWS_ESP_PROTOCOL num 50
service name FWS_TCP_ANY proto tcp src all dst all
service name FWS_UDP_ANY proto udp src all dst all
proto name FWS_ICMP_ANY num 1
