address-object ipv4 "h 203.0.113.4" host 203.0.113.4 zone LAN
address-group ipv4 "admins"
    address-object ipv4 "r 192.168.10.50-192.168.10.59"
    exit
address-group ipv4 "dmz-web"
    address-object ipv4 "h 172.16.20.10"
    address-object ipv4 "h 172.16.20.11"
    exit
address-group ipv4 "partners"
    address-object ipv4 "n 198.51.100.0_24"
    exit
