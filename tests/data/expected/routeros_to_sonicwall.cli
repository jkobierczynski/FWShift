service-object "tcp-22" TCP 22 22
service-object "tcp-80,443,8000-8080 tcp 80" TCP 80 80
service-object "tcp-80,443,8000-8080 tcp 443" TCP 443 443
service-object "tcp-80,443,8000-8080 tcp 8000-80" TCP 8000 8080
service-group "tcp-80,443,8000-8080"
    service-object "tcp-80,443,8000-8080 tcp 80"
    service-object "tcp-80,443,8000-8080 tcp 443"
    service-object "tcp-80,443,8000-8080 tcp 8000-80"
    exit
service-object "tcp-any" TCP 1 65535
service-object "tcp-0-21,23-65535 tcp 1-21" TCP 1 21
service-object "tcp-0-21,23-65535 tcp 23-65535" TCP 23 65535
service-group "tcp-0-21,23-65535"
