    service-object "tcp-80,443 tcp 443"
    exit
service-object "udp-53" UDP 53 53
service-object "tcp-8443" TCP 8443 8443
service-object "tcp-25" TCP 25 25
service-object "tcp-443" TCP 443 443
service-object "tcp 443" TCP 443 443
nat-policy inbound any outbound any source any translated-source original destination name "h 203.0.113.3" translated-destination name "h 172.16.20.10" service name "tcp-8443" translated-service name "tcp 443"
    name "publish web"
    comment "publish web"
    exit
nat-policy inbound any outbound any source any translated-source original destination name "h 203.0.113.4" translated-destination name "h 172.16.20.11" service name "tcp-25" translated-service original
    name "publish mail"
    comment "publish mail"
    exit
