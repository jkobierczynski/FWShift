address-object ipv4 "h 192.0.2.80" host 192.0.2.80 zone LAN
address-object ipv6 "n 2001:db8:99::_48" network 2001:db8:99:: /48 zone LAN
address-object ipv6 "n 2001:db8:10::_64" network 2001:db8:10:: /64 zone LAN
address-object ipv4 "h 203.0.113.3" host 203.0.113.3 zone LAN
