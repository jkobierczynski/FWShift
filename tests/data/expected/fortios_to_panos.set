set address lan-net ip-netmask 10.10.0.0/15
set address lan-net description "Office \"LAN\" networks"
set address web-1 ip-netmask 10.20.0.10/32
set address mail-1 ip-netmask 10.20.0.25/32
set address admin-range ip-range 10.10.5.10-10.10.5.20
set address updates.example.com fqdn updates.example.com
set address geo-blocked ip-netmask 0.0.0.0/32
set address geo-blocked description "FWSHIFT PLACEHOLDER, matches nothing: FortiOS address type 'geography'"
set address 10.99.0.0_16 ip-netmask 10.99.0.0/16
set address scada-server ip-netmask 10.10.7.15/32
set address plc-net ip-netmask 10.30.1.0/24
set address lan6-net ip-netmask 2001:db8:10::/48
set address vip-web ip-netmask 203.0.113.10/32
set address vip-mail ip-netmask 203.0.113.25/32
set address dmz-pool ip-range 198.51.100.20-198.51.100.23
set address dmz-pool description "FortiOS IP pool dmz-pool"
set address-group dmz-servers static [ web-1 mail-1 ]
set address-group internal-all static [ lan-net dmz-servers ]
set address-group internal-all description "Nested group"
set service HTTP protocol tcp port 80
set service HTTPS protocol tcp port 443
set service DNS-tcp protocol tcp port 53
set service DNS-udp protocol udp port 53
set service-group DNS members [ DNS-tcp DNS-udp ]
set service SMTP protocol tcp port 25
set service SSH protocol tcp port 22
set service MODBUS protocol tcp port 502
set service app-ports protocol tcp port 8080,8443,9000-9010
set service app-ports description "Application server"
set service syslog-from-high protocol udp port 514
set service syslog-from-high protocol udp source-port 1024-65535
set service vip-web-port protocol tcp port 443
set service vip-web-port description "external port of VIP vip-web"
set service-group "Web Access" members [ HTTP HTTPS ]
set service-group basic-net members DNS
