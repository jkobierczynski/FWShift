configure terminal
firewall
service name FWS_DNS proto tcp src all dst port 53
service name FWS_DNS-UDP proto udp src all dst port 53
service name FWS_NTP.services proto udp src all dst port 123
service name FWS_SSH proto tcp src all dst port 22
service name FWS_tcp_443 proto tcp src all dst port 443
service name FWS_tcp_8443 proto tcp src all dst port 8443
service name FWS_MySQL proto tcp src all dst port 3306
service name FWS_Modbus proto tcp src all dst port 502
service name FWS_FTP proto tcp src all dst port 21
proto name FWS_proto_1 num 1
proto name FWS_proto_58 num 58
exit
end
