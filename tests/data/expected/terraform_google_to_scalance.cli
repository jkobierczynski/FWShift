configure terminal
firewall
service name FWS_tcp_443 proto tcp src all dst port 443
service name FWS_tcp_8443-8444 proto tcp src all dst range 8443 - 8444
service name FWS_tcp-25 proto tcp src all dst port 25
service name FWS_tcp_8080 proto tcp src all dst port 8080
proto name FWS_proto_1 num 1
service name FWS_tcp-5432 proto tcp src all dst port 5432
service name FWS_tcp-22 proto tcp src all dst port 22
proto name FWS_proto_58 num 58
service name FWS_tcp-9100 proto tcp src all dst port 9100
service name FWS_tcp-80 proto tcp src all dst port 80
service name FWS_udp_53 proto udp src all dst port 53
service name FWS_tcp_53 proto tcp src all dst port 53
exit
end
