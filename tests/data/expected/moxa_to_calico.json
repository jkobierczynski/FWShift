        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "firewall 2"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "192.168.127.200/29",
            "192.168.127.208/28",
            "192.168.127.224/28",
            "192.168.127.240/29",
            "192.168.127.248/31",
            "192.168.127.250/32"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "firewall 9"
          }
        }
      },
      {
        "action": "Allow",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
