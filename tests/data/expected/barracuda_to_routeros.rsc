# Generated by FWShift - review the conversion report before loading this.
# A script for /import on RouterOS 6 or 7: /import file-name=FILE verbose=yes
# Nothing in it changes traffic until the disabled jump rules at its end are enabled (in Safe Mode).
:if ([:len [/ip firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
:if ([:len [/ipv6 firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
/interface list add name=fws-port2 comment="fwshift"
/interface list member add list=fws-port2 interface="port2" comment="fwshift"
/interface list add name=fws-port1 comment="fwshift"
/interface list member add list=fws-port1 interface="port1" comment="fwshift"
/ip firewall address-list add list=fws-Admin-Hosts__port2_ address="10.10.5.10"
/ip firewall address-list add list=fws-Admin-Hosts__port2_ address="10.10.5.11"
/ip firewall address-list add list=fws-Server-Group address="10.20.0.80"
/ip firewall address-list add list=fws-Server-Group address="10.20.0.25"
/ip firewall address-list add list=fws-Updates__IPv4_ address="updates.example.com"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward src-address=198.51.100.0/24 action=drop comment="BLOCK-BAD"
/ipv6 firewall filter add chain=fwshift-forward src-address=2001:db8:bad::/48 action=drop comment="BLOCK-BAD-V6"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-port2 src-address-list=fws-Admin-Hosts__port2_ dst-address=10.20.0.16-10.20.0.255 protocol=tcp dst-port=22 action=accept comment="ADMIN-SSH (port2)"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-port1 src-address=192.0.2.50 dst-address=10.20.0.16-10.20.0.255 protocol=tcp dst-port=22 action=accept comment="ADMIN-SSH (port1)"
/ip firewall filter add chain=fwshift-forward src-address=10.10.0.0/16 protocol=tcp dst-port=80,443 action=accept comment="LAN-2-INTERNET"
# FWSHIFT disabled, see the report: "WEB-IN" from any to any; source 0.0.0.0/0; destination Public-Web; service HTTP+S; action allow
/ip firewall filter add chain=fwshift-forward src-address=10.20.0.16-10.20.0.255 dst-address=10.10.0.0/16 protocol=tcp dst-port=80,443,8080 action=accept comment="SERVER-SYNC"
/ip firewall filter add chain=fwshift-forward src-address=10.10.0.0/16 dst-address=10.20.0.16-10.20.0.255 protocol=tcp dst-port=80,443,8080 action=accept comment="SERVER-SYNC (back)"
# disabled in the source: "DNS-OUT" from any to any; source Server-Group; destination 0.0.0.0/0; service DNS; action allow
/ip firewall filter add chain=fwshift-forward src-address-list=fws-Server-Group protocol=tcp dst-port=53 action=accept comment="DNS-OUT" disabled=yes
/ip firewall filter add chain=fwshift-forward src-address-list=fws-Server-Group protocol=udp dst-port=53 action=accept comment="DNS-OUT" disabled=yes
/ip firewall filter add chain=fwshift-forward src-address=10.10.0.0/16 protocol=icmp action=accept comment="PING-ALL"
/ip firewall filter add chain=fwshift-forward src-address=10.20.0.16-10.20.0.255 dst-address-list=fws-Updates__IPv4_ protocol=tcp dst-port=80,443 action=accept comment="UPDATES"
/ipv6 firewall filter add chain=fwshift-forward dst-address=2001:db8:20::/64 protocol=tcp dst-port=80,443 action=accept comment="V6-WEB"
/ip firewall filter add chain=fwshift-forward src-address=10.10.0.0/16 dst-address=10.20.0.16-10.20.0.255 action=reject comment="DENY-LAN-DMZ"
/ip firewall filter add chain=fwshift-forward src-address=10.10.0.0/16 dst-address=10.20.0.25 protocol=gre action=accept comment="GRE-LAB"
# FWSHIFT disabled, see the report: "TO-LAB" from any to any; source Office-LAN; destination 0.0.0.0/0; service any; action drop
# FWSHIFT disabled, see the report: "ODD" from any to any; source Office-LAN; destination 0.0.0.0/0; service Odd-Ports; action allow
/ip firewall filter add chain=fwshift-forward action=drop comment="BLOCKALL"
/ip firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ipv6 firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
