# Generated by FWShift: a Google Cloud network firewall policy (hashicorp/google), as Terraform configuration.
# Read the report first: what is not written is listed there.
#
#   terraform init
#   terraform plan -var project=...      shows what would be created
#   terraform apply -var project=...     creates the policy and its rules
#
# The policy is associated with no network: nothing changes for any traffic until you associate it (the commented
# resource at the end). It decides every connection of that network; with the network's enforcement order
# AFTER_CLASSIC_FIREWALL (the default) the VPC firewall rules decide first. A policy of the same name makes the apply fail.

terraform {
  required_version = ">= 1.3"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 5.0"
    }
  }
}

variable "project" {
  description = "The project to create the policy in"
  type        = string
}

resource "google_compute_network_firewall_policy" "policy" {
  name        = "fwshift"
  project     = var.project
  description = "Generated by FWShift; review the conversion report before associating it"
}

resource "google_compute_network_firewall_policy_rule" "r1000" {
  project         = var.project
  firewall_policy = google_compute_network_firewall_policy.policy.name
  priority        = 1000
  direction       = "INGRESS"
  action          = "deny"
  description     = "security.block-threats/egress-1"
  match {
    src_ip_ranges  = ["10.244.1.10/32", "10.244.2.10/32"]
    dest_ip_ranges = ["198.51.100.0/24", "203.0.113.64/26"]
    layer4_configs {
      ip_protocol = "all"
    }
  }
}

