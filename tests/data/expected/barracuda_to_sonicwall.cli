configure terminal
address-object ipv4 "DMZ-Servers" range 10.20.0.16 10.20.0.255 zone port1
address-object ipv4 "Mail-Server" host 10.20.0.25 zone port1
address-object ipv4 "Office-LAN" network 10.10.0.0 255.255.0.0 zone port1
address-object ipv4 "Public-Web" host 203.0.113.10 zone port1
address-object fqdn "updates.example.com" domain "updates.example.com" zone port1
address-object ipv6 "V6-Servers" network 2001:db8:20:: /64 zone port1
address-object ipv4 "Web-Server" host 10.20.0.80 zone port1
address-object fqdn "updates.example.com (IPv4)" domain "updates.example.com" zone port1
address-object ipv4 "h 10.10.5.10" host 10.10.5.10 zone port1
address-object ipv4 "h 10.10.5.11" host 10.10.5.11 zone port1
address-object ipv4 "h 192.0.2.50" host 192.0.2.50 zone port1
address-object ipv4 "n 198.51.100.0_24" network 198.51.100.0 255.255.255.0 zone port1
address-object ipv6 "n 2001:db8:bad::_48" network 2001:db8:bad:: /48 zone port1
address-group ipv4 "Admin-Hosts"
    address-object ipv4 "h 10.10.5.10"
    address-object ipv4 "h 10.10.5.11"
    address-object ipv4 "h 192.0.2.50"
    exit
address-group ipv4 "Blocked-Nets"
    address-object ipv4 "n 198.51.100.0_24"
    exit
address-group ipv6 "Blocked-Nets v6"
    address-object ipv6 "n 2001:db8:bad::_48"
    exit
address-group ipv4 "Server-Group"
    address-object ipv4 "Web-Server"
    address-object ipv4 "Mail-Server"
    exit
address-group ipv4 "Updates"
    address-object fqdn "updates.example.com"
    exit
address-group ipv6 "Updates v6"
    address-object fqdn "updates.example.com"
    exit
address-group ipv4 "Blocked-Nets (IPv4)"
    address-object ipv4 "n 198.51.100.0_24"
    exit
address-group ipv6 "Blocked-Nets (IPv6)"
    address-object ipv6 "n 2001:db8:bad::_48"
    exit
address-group ipv4 "Admin-Hosts (port2)"
    address-object ipv4 "h 10.10.5.10"
    address-object ipv4 "h 10.10.5.11"
    exit
address-group ipv4 "Admin-Hosts (port1)"
    address-object ipv4 "h 192.0.2.50"
    exit
address-group ipv4 "Updates (IPv4)"
    address-object fqdn "updates.example.com (IPv4)"
    exit
service-object "DNS tcp 53" TCP 53 53
service-object "DNS udp 53" UDP 53 53
service-group "DNS"
    service-object "DNS tcp 53"
    service-object "DNS udp 53"
    exit
service-object "HTTP+S tcp 80" TCP 80 80
service-object "HTTP+S tcp 443" TCP 443 443
service-group "HTTP+S"
    service-object "HTTP+S tcp 80"
    service-object "HTTP+S tcp 443"
    exit
service-object "SMTP" TCP 25 25
service-object "SSH 2" TCP 22 22
service-object "Web-Group entries" TCP 8080 8080
service-group "Web-Group"
    service-group "HTTP+S"
    service-object "Web-Group entries"
    exit
access-rule ipv4 from port1 to port1 action discard source address group "Blocked-Nets (IPv4)" service any destination address any
    name "BLOCK-BAD"
    priority manual 1
    exit
access-rule ipv4 from port1 to port2 action discard source address group "Blocked-Nets (IPv4)" service any destination address any
    name "BLOCK-BAD 2"
    priority manual 1
    exit
access-rule ipv4 from port2 to port1 action discard source address group "Blocked-Nets (IPv4)" service any destination address any
    name "BLOCK-BAD 3"
    priority manual 1
    exit
access-rule ipv4 from port2 to port2 action discard source address group "Blocked-Nets (IPv4)" service any destination address any
    name "BLOCK-BAD 4"
    priority manual 1
    exit
access-rule ipv6 from port1 to port1 action discard source address group "Blocked-Nets (IPv6)" service any destination address any
    name "BLOCK-BAD-V6"
    priority manual 1
    exit
access-rule ipv6 from port1 to port2 action discard source address group "Blocked-Nets (IPv6)" service any destination address any
    name "BLOCK-BAD-V6 2"
    priority manual 1
    exit
access-rule ipv6 from port2 to port1 action discard source address group "Blocked-Nets (IPv6)" service any destination address any
    name "BLOCK-BAD-V6 3"
    priority manual 1
    exit
access-rule ipv6 from port2 to port2 action discard source address group "Blocked-Nets (IPv6)" service any destination address any
    name "BLOCK-BAD-V6 4"
    priority manual 1
    exit
access-rule ipv4 from port2 to port1 action allow source address group "Admin-Hosts (port2)" service name "SSH 2" destination address name "DMZ-Servers"
    name "ADMIN-SSH (port2)"
    priority manual 2
    exit
access-rule ipv4 from port2 to port2 action allow source address group "Admin-Hosts (port2)" service name "SSH 2" destination address name "DMZ-Servers"
