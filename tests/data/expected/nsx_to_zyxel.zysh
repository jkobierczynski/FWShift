# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
address-object FWS_nothing 0.0.0.0
service-object FWS_DNS tcp eq 53
service-object FWS_DNS-UDP udp eq 53
object-group service FWS_DNS_to_resolvers_svc
 service-object FWS_DNS
 service-object FWS_DNS-UDP
exit
address-object FWS_10_10_0_0_16 10.10.0.0/16
object-group address FWS_LAN
 address-object FWS_10_10_0_0_16
exit
address-object FWS_192_0_2_53 192.0.2.53
service-object FWS_NTP_services udp eq 123
address-object FWS_192_0_2_123 192.0.2.123
address-object FWS_10_10_200_0_24 10.10.200.0/24
object-group address FWS_Guests
 address-object FWS_10_10_200_0_24
exit
address-object FWS_10_0_0_0_8 10.0.0.0/8
service-object FWS_SSH tcp eq 22
service-object FWS_HTTPS tcp eq 443
service-object FWS_app-8443 tcp eq 8443
object-group service FWS_Web_all
 service-object FWS_HTTPS
 service-object FWS_app-8443
exit
address-object FWS_10_20_0_10 10.20.0.10
address-object FWS_10_20_0_11 10.20.0.11
object-group address FWS_Web_servers
 address-object FWS_10_20_0_10
 address-object FWS_10_20_0_11
exit
address-object FWS_10_20_1_0_24 10.20.1.0/24
object-group address FWS_App_servers
 address-object FWS_10_20_1_0_24
exit
service-object FWS_MySQL tcp eq 3306
address-object FWS_10_20_2_0_24 10.20.2.0/24
object-group address FWS_DB_servers
 address-object FWS_10_20_2_0_24
exit
address-object FWS_10_10_5_10-10_10_5_20 10.10.5.10-10.10.5.20
object-group address FWS_Admins
 address-object FWS_10_10_5_10-10_10_5_20
exit
object-group address FWS_DMZ
 object-group FWS_Web_servers
 object-group FWS_App_servers
exit
address-object FWS_not_Admins_1 0.0.0.0-10.10.5.9
address-object FWS_not_Admins_2 10.10.5.21-255.255.255.255
object-group address FWS_not_Admins
 address-object FWS_not_Admins_1
 address-object FWS_not_Admins_2
exit
service-object FWS_Modbus tcp eq 502
address-object FWS_10_10_7_15 10.10.7.15
address-object FWS_10_30_1_0_24 10.30.1.0/24
object-group address FWS_OT_cell
 address-object FWS_10_30_1_0_24
exit
service-object FWS_FTP tcp eq 21
address-object FWS_198_51_100_40 198.51.100.40
service-object FWS_protocol_1 protocol 1
service-object FWS_protocol_58 protocol 58
object-group service FWS_ICMP-ALL
 service-object FWS_protocol_1
 service-object FWS_protocol_58
exit
secure-policy insert 1
 name FWS_Block_quarantined
 no activate
 sourceip FWS_nothing
 action deny
 log
exit
secure-policy insert 2
 name FWS_DNS_to_resolvers
 no activate
 sourceip FWS_LAN
 destinationip FWS_192_0_2_53
 service FWS_DNS_to_resolvers_svc
 action allow
 no log
 activate
exit
secure-policy insert 3
 name FWS_NTP
 no activate
 destinationip FWS_192_0_2_123
 service FWS_NTP_services
 action allow
 no log
 activate
exit
secure-policy insert 4
 name FWS_Guests_stay_out
 no activate
 sourceip FWS_Guests
 destinationip FWS_10_0_0_0_8
 action deny
 no log
 activate
exit
secure-policy insert 5
 name FWS_LAN_block_the_rest
 no activate
 sourceip FWS_LAN
 service FWS_SSH
 action deny
 no log
exit
secure-policy insert 6
 name FWS_Inbound_web
 no activate
 destinationip FWS_Web_servers
 service FWS_Web_all
 action allow
 log
 activate
exit
secure-policy insert 7
 name FWS_Web_to_app
 no activate
 sourceip FWS_Web_servers
 destinationip FWS_App_servers
 service FWS_app-8443
 action allow
 no log
 activate
exit
secure-policy insert 8
 name FWS_App_to_DB
 no activate
 sourceip FWS_App_servers
 destinationip FWS_DB_servers
 service FWS_MySQL
 action allow
 no log
exit
secure-policy insert 9
 name FWS_Admins_SSH
 no activate
 sourceip FWS_Admins
 destinationip FWS_DMZ
 service FWS_SSH
 action allow
 no log
 activate
exit
secure-policy insert 10
 name FWS_Others_no_SSH
 no activate
 sourceip FWS_not_Admins
 destinationip FWS_DMZ
 service FWS_SSH
 action deny
 no log
 activate
exit
secure-policy insert 11
 name FWS_Engineering_to_PLCs
 no activate
 sourceip FWS_10_10_7_15
 destinationip FWS_OT_cell
 service FWS_Modbus
 action allow
 no log
 activate
exit
secure-policy insert 12
 name FWS_FTP_to_partner
 no activate
 sourceip FWS_LAN
 destinationip FWS_198_51_100_40
 service FWS_FTP
 action allow
 no log
 activate
exit
secure-policy insert 13
 name FWS_TLS_out
 no activate
 sourceip FWS_LAN
 service FWS_HTTPS
 action allow
 no log
exit
secure-policy6 insert 1
 name FWS_Ping_over_IPv6
 no activate
 service FWS_ICMP-ALL
 action allow
 no log
 activate
exit
secure-policy insert 14
 name FWS_Old_rule
 no activate
 sourceip FWS_LAN
 destinationip FWS_DB_servers
 service FWS_MySQL
 action allow
 no log
exit
exit
# Put the interfaces in their zones (this changes traffic at once):
# Written inactive:
#   Block quarantined: references 'Quarantine': dynamic address group, members are not known statically
#   LAN block the rest: not converted: follows a conditional jump to the application rules (rule 'LAN to the application rules'), which cannot be expressed
#   App to DB: not converted: direction IN only: NSX checks the other end of the connection against the rules below it, which one rule cannot say
#   TLS out: not converted: context profile SSL (layer 7: applications, domain names), which the model has no place for
