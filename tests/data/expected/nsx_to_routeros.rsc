/ip firewall filter add chain=fwshift-forward src-address-list=fws-Web_servers dst-address=10.20.1.0/24 protocol=tcp dst-port=8443 action=accept comment="Web to app"
# FWSHIFT disabled, see the report: "App to DB" from any to any; source App servers; destination DB servers; service MySQL; action allow
