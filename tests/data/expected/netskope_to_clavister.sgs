add IPRule Index=6 Name=fws_Admins_to_jump_hosts__app-rdp-gw_ Action=Allow SourceInterface=Client SourceNetwork=fws_10.99.0.0_24 DestinationInterface=egress DestinationNetwork=fws_app-rdp-gw Service=fws_app-rdp-gw_2 LogEnabled=Yes
