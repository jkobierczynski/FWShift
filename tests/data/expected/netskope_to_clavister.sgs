add IPRule Index=1 Name=fws_Block_known_bad_ranges Action=Drop SourceInterface=fws_if_Client_GRE_IPSec SourceNetwork=all-nets DestinationInterface=egress DestinationNetwork=fws_dp-blocked-ranges Service=all_services LogEnabled=Yes
