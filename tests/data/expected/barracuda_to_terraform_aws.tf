# Generated by FWShift: AWS EC2 security groups for one VPC (hashicorp/aws), as Terraform configuration.
# Read the report first: what is not written is listed there.
#
#   terraform init
#   terraform plan -var vpc_id=vpc-...      shows what would be created
#   terraform apply -var vpc_id=vpc-...     creates the groups and their rules
#
# The groups are created WITHOUT members: nothing changes for any traffic until they are attached. Attach each
# group to the network interfaces whose private addresses are listed above it (# attach ...): an interface gets
# every group whose list holds one of its addresses, and then no other groups. A group of the same name in the
# VPC makes the apply fail; nothing that exists is changed. Terraform takes away the outbound rule AWS gives a
# new group: a group allows outbound what its egress rules below allow, and nothing else.

terraform {
  required_version = ">= 1.3"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0"
    }
  }
}

variable "vpc_id" {
  description = "The VPC to create the security groups in (vpc-...)"
  type        = string
}

# attach fwshift-addresses: 0.0.0.0-10.9.255.255 10.11.0.0-10.20.0.15 10.20.1.0-255.255.255.255
resource "aws_security_group" "g1" {
  name        = "fwshift-addresses"
  description = "FWShift: for the interfaces of 0.0.0.0-10.9.255.255 10.11.0.0-10.20.0.15 10.20.1.0-255.255.255.255"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

# attach fwshift-Office-LAN: 10.10.0.0/16
resource "aws_security_group" "g2" {
  name        = "fwshift-Office-LAN"
  description = "FWShift: for the interfaces of 10.10.0.0/16"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

# attach fwshift-DMZ-Servers: 10.20.0.16-10.20.0.255
resource "aws_security_group" "g3" {
  name        = "fwshift-DMZ-Servers"
  description = "FWShift: for the interfaces of 10.20.0.16-10.20.0.255"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

# attach fwshift-addresses-ipv6: ::-2001:db8:1f:ffff:ffff:ffff:ffff:ffff 2001:db8:20:1::-2001:db8:bac:ffff:ffff:ffff:ffff:ffff 2001:db8:bae::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
resource "aws_security_group" "g4" {
  name        = "fwshift-addresses-ipv6"
  description = "FWShift: for the interfaces of ::-2001:db8:1f:ffff:ffff:ffff:ffff:ffff 2001:db8:20:1::-2001:db8:bac:ffff:ffff:ffff:ffff:ffff 2001:db8:bae::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

# attach fwshift-V6-Servers-ipv6: 2001:db8:20::/64
resource "aws_security_group" "g5" {
  name        = "fwshift-V6-Servers-ipv6"
  description = "FWShift: for the interfaces of 2001:db8:20::/64"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

# attach fwshift-no-rules: 2001:db8:bad::/48
resource "aws_security_group" "g6" {
  name        = "fwshift-no-rules"
  description = "FWShift: for the interfaces of 2001:db8:bad::/48"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

