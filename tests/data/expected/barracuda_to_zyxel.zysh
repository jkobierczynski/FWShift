# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
address-object FWS_198_51_100_0_24 198.51.100.0/24
object-group address FWS_Blocked-Nets__IPv4_
 address-object FWS_198_51_100_0_24
exit
address6-object FWS_2001_db8_bad___48 2001:db8:bad::/48
object-group address6 FWS_Blocked-Nets__IPv6_
 address6-object FWS_2001_db8_bad___48
exit
service-object FWS_SSH tcp eq 22
address-object FWS_10_10_5_10 10.10.5.10
address-object FWS_10_10_5_11 10.10.5.11
object-group address FWS_Admin-Hosts__port2_
 address-object FWS_10_10_5_10
 address-object FWS_10_10_5_11
exit
address-object FWS_DMZ-Servers 10.20.0.16-10.20.0.255
address-object FWS_192_0_2_50 192.0.2.50
object-group address FWS_Admin-Hosts__port1_
 address-object FWS_192_0_2_50
exit
service-object FWS_tcp_80 tcp eq 80
service-object FWS_tcp_443 tcp eq 443
object-group service FWS_HTTP_S
 service-object FWS_tcp_80
 service-object FWS_tcp_443
exit
address-object FWS_Office-LAN 10.10.0.0/16
address-object FWS_Public-Web 203.0.113.10
service-object FWS_Web-Group_entries tcp eq 8080
object-group service FWS_Web-Group
 object-group FWS_HTTP_S
 service-object FWS_Web-Group_entries
exit
service-object FWS_tcp_53 tcp eq 53
service-object FWS_udp_53 udp eq 53
object-group service FWS_DNS
 service-object FWS_tcp_53
 service-object FWS_udp_53
exit
address-object FWS_10_20_0_80 10.20.0.80
address-object FWS_10_20_0_25 10.20.0.25
object-group address FWS_Server-Group
 address-object FWS_10_20_0_80
 address-object FWS_10_20_0_25
exit
service-object FWS_Ping protocol 1
address-object FWS_nothing 0.0.0.0
address6-object FWS_V6-Servers 2001:db8:20::/64
service-object FWS_GRE protocol 47
service-object FWS_Odd-Ports_dst tcp range 1000 2000
zone FWS_port1
exit
zone FWS_port2
exit
secure-policy insert 1
 name FWS_BLOCK-BAD
 no activate
 description "known bad networks"
 sourceip FWS_Blocked-Nets__IPv4_
 action deny
 log
 activate
exit
secure-policy6 insert 1
 name FWS_BLOCK-BAD-V6
 no activate
 sourceip6 FWS_Blocked-Nets__IPv6_
 action deny
 log
 activate
exit
secure-policy insert 2
 name FWS_ADMIN-SSH__port2_
 no activate
 from FWS_port2
 sourceip FWS_Admin-Hosts__port2_
 destinationip FWS_DMZ-Servers
 service FWS_SSH
 action allow
 log
 activate
exit
secure-policy insert 3
 name FWS_ADMIN-SSH__port1_
 no activate
 from FWS_port1
 sourceip FWS_Admin-Hosts__port1_
 destinationip FWS_DMZ-Servers
 service FWS_SSH
 action allow
 log
 activate
exit
secure-policy insert 4
 name FWS_LAN-2-INTERNET
 no activate
 sourceip FWS_Office-LAN
 service FWS_HTTP_S
 action allow
 log
 activate
exit
secure-policy insert 5
 name FWS_WEB-IN
 no activate
 destinationip FWS_Public-Web
 service FWS_HTTP_S
 action allow
 log
exit
secure-policy insert 6
 name FWS_SERVER-SYNC
 no activate
 sourceip FWS_DMZ-Servers
 destinationip FWS_Office-LAN
 service FWS_Web-Group
 action allow
 log
 activate
exit
secure-policy insert 7
 name FWS_SERVER-SYNC__back_
 no activate
 sourceip FWS_Office-LAN
 destinationip FWS_DMZ-Servers
 service FWS_Web-Group
 action allow
 log
 activate
exit
secure-policy insert 8
 name FWS_DNS-OUT
 no activate
 sourceip FWS_Server-Group
 service FWS_DNS
 action allow
 log
exit
secure-policy insert 9
 name FWS_PING-ALL
 no activate
 sourceip FWS_Office-LAN
 service FWS_Ping
 action allow
 log
 activate
exit
secure-policy insert 10
 name FWS_UPDATES
 no activate
 sourceip FWS_DMZ-Servers
 destinationip FWS_nothing
 service FWS_HTTP_S
 action allow
 log
exit
secure-policy6 insert 2
 name FWS_V6-WEB
 no activate
 destinationip6 FWS_V6-Servers
 service FWS_HTTP_S
 action allow
 log
 activate
exit
secure-policy insert 11
 name FWS_DENY-LAN-DMZ
 no activate
 sourceip FWS_Office-LAN
 destinationip FWS_DMZ-Servers
 action reject
 log
 activate
exit
secure-policy insert 12
 name FWS_GRE-LAB
 no activate
 sourceip FWS_Office-LAN
 destinationip FWS_10_20_0_25
 service FWS_GRE
 action allow
 log
 activate
exit
secure-policy insert 13
 name FWS_TO-LAB
 no activate
 sourceip FWS_Office-LAN
 action deny
 log
exit
secure-policy insert 14
 name FWS_ODD
 no activate
 sourceip FWS_Office-LAN
 service FWS_Odd-Ports_dst
 sourceport tcp range 1024 65535
 action allow
 log
exit
secure-policy insert 15
 name FWS_BLOCKALL
 no activate
 action deny
 log
 activate
exit
secure-policy6 insert 3
 name FWS_default_1
 no activate
 description "FWShift default port1 to port1"
 from FWS_port1
 to FWS_port1
 action deny
 no log
 activate
exit
secure-policy6 insert 4
 name FWS_default_2
 no activate
 description "FWShift default port1 to port2"
 from FWS_port1
 to FWS_port2
 action deny
 no log
 activate
exit
secure-policy6 insert 5
 name FWS_default_3
 no activate
 description "FWShift default port2 to port1"
 from FWS_port2
 to FWS_port1
 action deny
 no log
 activate
exit
secure-policy6 insert 6
 name FWS_default_4
 no activate
 description "FWShift default port2 to port2"
 from FWS_port2
 to FWS_port2
 action deny
 no log
 activate
exit
exit
# Put the interfaces in their zones (this changes traffic at once):
#   zone FWS_port1 / interface port1
#   zone FWS_port2 / interface port2
# Written inactive:
#   WEB-IN: not converted: action Dst NAT: how the API spells its target list is not known, so the translation is not read
#   UPDATES: 'Updates (IPv4)' holds members only its platform knows
#   TO-LAB: not converted: action Cascade: the rules of the rule list it hands traffic to are not read, and they decide that traffic
#   ODD: schedule '{ type :  recurring ,  name :  Work-Hours }' is not converted; the rule would apply at all times
