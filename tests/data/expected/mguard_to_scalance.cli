configure terminal
firewall
service name FWS_tcp-8443 proto tcp src all dst port 8443
service name FWS_udp-47808 proto udp src all dst port 47808
service name FWS_tcp-502 proto tcp src all dst port 502
proto name FWS_icmp num 1
service name FWS_tcp_80 proto tcp src all dst port 80
service name FWS_tcp_443 proto tcp src all dst port 443
service name FWS_udp-161 proto udp src all dst port 161
service name FWS_tcp-22 proto tcp src all dst port 22
service name FWS_tcp_102 proto tcp src all dst port 102
service name FWS_tcp_20000-20010 proto tcp src all dst range 20000 - 20010
proto name FWS_gre num 47
service name FWS_tcp-8000-8080-from-1024-6553 proto tcp src range 1024 - 65535 dst range 8000 - 8080
service name FWS_udp-53 proto udp src all dst port 53
service name FWS_tcp-1433 proto tcp src all dst port 1433
ipv4rule from external to internal srcip 0.0.0.0/0 dstip 203.0.113.2 action acc service FWS_tcp-8443 log info prior 1
ipv4rule from external to dmz srcip 198.51.100.64/27 dstip 203.0.113.3 action acc service FWS_udp-47808 log no prior 2
ipv4rule from external to internal srcip 198.51.100.0/24 dstip 192.168.10.0/24 action acc service FWS_icmp log no prior 2
ipv4rule from external to internal srcip 0.0.0.0/0 dstip 192.168.10.0/24 action drop service FWS_tcp_80 log info prior 3
ipv4rule from external to internal srcip 0.0.0.0/0 dstip 192.168.10.0/24 action drop service FWS_tcp_443 log info prior 3
ipv4rule from external to internal srcip 0.0.0.0/0 dstip 0.0.0.0/0 action rej service FWS_udp-161 log no prior 4
ipv4rule from external to internal srcip 198.51.100.64/27 dstip 192.168.10.0/24 action acc service FWS_tcp_102 log no prior 5
ipv4rule from external to internal srcip 198.51.100.64/27 dstip 192.168.10.0/24 action acc service FWS_tcp_20000-20010 log no prior 5
ipv4rule from external to internal srcip 198.51.100.64/27 dstip 0.0.0.0/0 action drop log info prior 6
ipv4rule from external to internal srcip 198.51.100.7 dstip 192.168.10.5 action acc service FWS_gre log no prior 7
ipv4rule from external to internal srcip 198.51.100.0/24 dstip 192.168.10.50 action acc service FWS_tcp-8000-8080-from-1024-6553 log no prior 7
ipv4rule from internal to external srcip 192.168.10.20-192.168.10.29 dstip 0.0.0.0/0 action drop log info prior 8
ipv4rule from internal to external srcip 192.168.10.40 dstip 0.0.0.0/0 action drop log info prior 8
ipv4rule from internal to external srcip 192.168.10.0/24 dstip 192.168.10.1 action acc service FWS_udp-53 log no prior 9
ipv4rule from internal to external srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_tcp_80 log no prior 9
ipv4rule from internal to external srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_tcp_443 log no prior 9
ipv4rule from internal to external srcip 192.168.20.0/24 dstip 192.168.10.0/24 action acc service FWS_tcp_102 log no prior 9
ipv4rule from external to dmz srcip 0.0.0.0/0 dstip 172.16.30.10 action acc service FWS_tcp_80 log no prior 9
ipv4rule from external to dmz srcip 0.0.0.0/0 dstip 172.16.30.10 action acc service FWS_tcp_443 log no prior 9
ipv4rule from dmz to internal srcip 172.16.30.10 dstip 192.168.10.60 action acc service FWS_tcp-1433 log no prior 9
ipv4rule from internal to dmz srcip 0.0.0.0/0 dstip 0.0.0.0/0 action acc log no prior 9
ipv4rule from internal to external srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 10
ipv4rule from internal to dmz srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 10
ipv4rule from external to internal srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 10
ipv4rule from external to dmz srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 10
ipv4rule from dmz to internal srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 10
ipv4rule from dmz to external srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 10
exit
firewallnat
netmap source srcint internal dstint external type ipv4 srcip 192.168.10.48/29 dstip 0.0.0.0/0 transip 203.0.113.8/29
netmap destination srcint external dstint internal type ipv4 srcip 0.0.0.0/0 dstip 203.0.113.8/29 transip 192.168.10.48/29
src-nat srcint internal dstint external type ipv4 srcip 192.168.10.0/24 dstip 0.0.0.0/0 transip auto
src-nat srcint dmz dstint external type ipv4 srcip 192.168.10.0/24 dstip 0.0.0.0/0 transip auto
src-nat srcint external dstint internal type ipv4 srcip 172.16.30.0/24 dstip 0.0.0.0/0 transip auto
src-nat srcint dmz dstint internal type ipv4 srcip 172.16.30.0/24 dstip 0.0.0.0/0 transip auto
exit
end
