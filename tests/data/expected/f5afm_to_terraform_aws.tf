# Generated by FWShift: AWS EC2 security groups for one VPC (hashicorp/aws), as Terraform configuration.
# Read the report first: what is not written is listed there.
#
#   terraform init
#   terraform plan -var vpc_id=vpc-...      shows what would be created
#   terraform apply -var vpc_id=vpc-...     creates the groups and their rules
#
# The groups are created WITHOUT members: nothing changes for any traffic until they are attached. Attach each
# group to the network interfaces whose private addresses are listed above it (# attach ...): an interface gets
# every group whose list holds one of its addresses, and then no other groups. A group of the same name in the
# VPC makes the apply fail; nothing that exists is changed. Terraform takes away the outbound rule AWS gives a
# new group: a group allows outbound what its egress rules below allow, and nothing else.

terraform {
  required_version = ">= 1.3"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0"
    }
  }
}

variable "vpc_id" {
  description = "The VPC to create the security groups in (vpc-...)"
  type        = string
}

# attach fwshift-addresses: 192.0.2.0/24
resource "aws_security_group" "g1" {
  name        = "fwshift-addresses"
  description = "FWShift: for the interfaces of 192.0.2.0/24"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

# attach fwshift-addresses-2: 203.0.113.53
resource "aws_security_group" "g2" {
  name        = "fwshift-addresses-2"
  description = "FWShift: for the interfaces of 203.0.113.53"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

# attach fwshift-no-rules: 0.0.0.0-192.0.1.255 192.0.3.0-203.0.113.52 203.0.113.54-255.255.255.255 ::/0
resource "aws_security_group" "g3" {
  name        = "fwshift-no-rules"
  description = "FWShift: for the interfaces of 0.0.0.0-192.0.1.255 192.0.3.0-203.0.113.52 203.0.113.54-255.255.255.255 ::/0"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

resource "aws_vpc_security_group_egress_rule" "g1_out_1" {
  security_group_id = aws_security_group.g1.id
  ip_protocol       = "udp"
  from_port         = 53
  to_port           = 53
  cidr_ipv4         = "203.0.113.53/32"
  description       = "FWShift: vs_dns/dns_from_partners"
}

resource "aws_vpc_security_group_ingress_rule" "g2_in_1" {
  security_group_id = aws_security_group.g2.id
  ip_protocol       = "udp"
  from_port         = 53
  to_port           = 53
  cidr_ipv4         = "192.0.2.0/24"
  description       = "FWShift: vs_dns/dns_from_partners"
}

output "fwshift_attach" {
  description = "Each security group, with the private addresses of the network interfaces to attach it to"
  value = {
    "fwshift-addresses" = {
      id        = aws_security_group.g1.id
      addresses = ["192.0.2.0/24"]
    }
    "fwshift-addresses-2" = {
      id        = aws_security_group.g2.id
      addresses = ["203.0.113.53"]
    }
    "fwshift-no-rules" = {
      id        = aws_security_group.g3.id
      addresses = ["0.0.0.0-192.0.1.255", "192.0.3.0-203.0.113.52", "203.0.113.54-255.255.255.255", "::/0"]
    }
  }
}

