CONFIG FILTER RULE INSERT type=filter index=9 state=off action=block srctarget=any dsttarget=any dstif=wan1 comment="Block geo: not converted (references 'geo-blocked': FortiOS address type 'geography'; 'geo-blocked' holds members only its platform knows)"
CONFIG FILTER RULE INSERT type=filter index=9 state=off action=pass dstport=fws_tcp_443 srctarget=fws_dmz-servers srcif=dmz dsttarget=any dstif=wan1 comment="DMZ out via pool: not converted (host name object updates.example.com: written with addresses only)"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_tcp_502 srctarget=fws_scada-server srcif=lan dsttarget=fws_plc-net dstif=ot comment="Engineering access to the controllers"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=block srctarget=fws_0.0.0.0_0 srcif=ot dsttarget=any dstif=wan1 comment="OT no internet"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass ipproto=gre srctarget=fws_lan-net srcif=lan dsttarget=fws_10.99.0.0_16 dstif=wan1 comment="Partner tunnel"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass ipproto=udp srcport=fws_udp_1024-65535 dstport=fws_udp_514 srctarget=fws_lan-net srcif=lan dsttarget=fws_10.99.0.0_16 dstif=wan1 comment="Partner tunnel"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_tcp_443 srctarget=fws_lan6-net srcif=lan dsttarget=any dstif=wan1 comment="LAN v6 out"
CONFIG FILTER RULE INSERT type=filter index=9 state=off action=pass dstport=fws_tcp_80 srctarget=fws_lan-net srcif=lan dsttarget=fws_web-1 dstif=dmz comment="policy-12: not converted (schedule 'office-hours' is not converted; the rule would apply at all times; schedule office-hours is not converted)"
CONFIG FILTER RULE INSERT type=filter index=9 state=off action=pass srctarget=fws_web-1 srcif=dmz dsttarget=any dstif=wan1 comment="Not web: not converted (every service but some: the target writes it only for one service)"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass ipproto=icmp icmptype=13 srctarget=fws_admin-range srcif=lan dsttarget=fws_dmz-servers dstif=dmz comment="Timestamp probes"
CONFIG FILTER RULE INSERT type=nat index=9 state=on action=nat srctarget=any srcif=wan1 dsttarget=fws_vip-web dstif=wan1 dstport=fws_tcp_443 natdsttarget=fws_web-1 natdstarp=on natdstport=fws_tcp_8443 comment=vip-web
CONFIG FILTER RULE INSERT type=nat index=9 state=on action=nat srctarget=any srcif=wan1 dsttarget=fws_vip-mail dstif=wan1 natdsttarget=fws_10.20.0.25 natdstarp=on comment=vip-mail
CONFIG FILTER RULE INSERT type=nat index=9 state=on action=nat srctarget=fws_lan-net srcif=lan dsttarget=any dstif=wan1 natsrctarget=Firewall_wan1 natsrcport=ephemeral_fw natsrcportlb=random comment=snat-1
CONFIG FILTER RULE INSERT type=nat index=9 state=on action=nat srctarget=any srcif=lan dsttarget=any dstif=wan1 natsrctarget=Firewall_wan1 natsrcport=ephemeral_fw natsrcportlb=random comment=snat-2
CONFIG FILTER ACTIVATE
CONFIG SLOT UPDATE type=filter slot=9 name=FWShift comment="written by FWShift"
