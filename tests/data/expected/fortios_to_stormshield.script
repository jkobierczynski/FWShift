CONFIG OBJECT ACTIVATE
CONFIG FILTER RULE REMOVE type=filter index=9 position=all
CONFIG FILTER RULE REMOVE type=nat index=9 position=all
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_tcp_80,fws_tcp_443,fws_tcp_53,fws_udp_53 srctarget=fws_lan-net srcif=lan dsttarget=any dstif=wan1 comment="LAN to Internet"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_tcp_53,fws_udp_53 srctarget=fws_0.0.0.0_0 srcif=lan dsttarget=any dstif=wan1 comment="LAN basics"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass ipproto=icmp icmptype=8 srctarget=fws_0.0.0.0_0 srcif=lan dsttarget=any dstif=wan1 comment="LAN basics"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass loglevel=log dstport=fws_tcp_8080,fws_tcp_8443,fws_tcp_9000-9010 srctarget=any srcif=wan1 dsttarget=fws_vip-web dstif=dmz comment="Inbound web"
