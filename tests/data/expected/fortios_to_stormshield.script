CONFIG OBJECT HOST NEW name=fws_10.20.0.25 ip=10.20.0.25 resolve=static update=1
CONFIG OBJECT GROUP NEW name=fws_admin-range update=1
CONFIG OBJECT GROUP ADDTO group=fws_admin-range node=fws_admin-range_1
CONFIG OBJECT GROUP ADDTO group=fws_admin-range node=fws_admin-range_2
CONFIG OBJECT GROUP ADDTO group=fws_admin-range node=fws_admin-range_3
CONFIG OBJECT GROUP ADDTO group=fws_admin-range node=fws_admin-range_4
