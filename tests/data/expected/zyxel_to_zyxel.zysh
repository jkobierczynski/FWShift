# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
address-object FWS_LAN1_SUBNET 10.10.0.0/24
address-object FWS_LAN2_SUBNET 10.20.0.0/24
address-object FWS_WEB_SRV 10.30.0.10
address-object FWS_MAIL_SRV 10.30.0.25
object-group address FWS_SERVERS
 address-object FWS_WEB_SRV
 address-object FWS_MAIL_SRV
exit
object-group address FWS_ALL_INTERNAL
 address-object FWS_LAN1_SUBNET
 address-object FWS_LAN2_SUBNET
 object-group FWS_SERVERS
exit
service-object FWS_SSH tcp eq 22
address-object FWS_PARTNER_NET 203.0.113.0/25
service-object FWS_HTTP tcp eq 80
service-object FWS_HTTPS tcp eq 443
service-object FWS_WEB_ALT tcp range 8080 8089
service-object FWS_HTTPS_8443 tcp eq 8443
object-group service FWS_WEB
 service-object FWS_HTTP
 service-object FWS_HTTPS
 service-object FWS_WEB_ALT
 service-object FWS_HTTPS_8443
exit
service-object FWS_SMTP tcp eq 25
object-group service FWS_MGMT
 service-object FWS_SSH
 object-group FWS_WEB
exit
address-object FWS_ADMIN_PCS 10.10.0.50-10.10.0.59
service-object FWS_PING icmp 8
address-object FWS_MONITOR 192.0.2.0/24
service-object FWS_GRE protocol 47
service-object FWS_DNS-sourceport-1024-_dst udp eq 53
address-object FWS_nothing 0.0.0.0
service-object FWS_ESP protocol 50
address-object FWS_INSIDE_RANGE 10.30.0.20/30
address6-object FWS_V6_LAN 2001:db8:10::/64
address6-object FWS_V6_ADMIN 2001:db8:10::50-2001:db8:10::59
object-group address6 FWS_V6_ADMINS
 address6-object FWS_V6_ADMIN
exit
address6-object FWS_V6_DMZ_WEB 2001:db8:30::10
service-object FWS_PING6 icmpv6 128
address-object FWS_PUBLIC_RANGE 198.51.100.20/30
zone FWS_LAB
exit
