ipv4rule from eth3 to eth2 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 5
exit
firewallnat
napt srcint eth0 proto tcp type ipv4 dstip 203.0.113.10 transip 10.20.0.10 dstport 443 transport 8443
src-nat srcint eth1 dstint eth0 type ipv4 srcip 10.10.0.0/16 dstip 0.0.0.0/0 transip auto
src-nat srcint eth2 dstint eth0 type ipv4 srcip 10.10.0.0/16 dstip 0.0.0.0/0 transip auto
src-nat srcint eth3 dstint eth0 type ipv4 srcip 10.10.0.0/16 dstip 0.0.0.0/0 transip auto
exit
end
