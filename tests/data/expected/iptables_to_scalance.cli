ipv4rule from eth3 to eth2 srcip 198.51.100.66 dstip 0.0.0.0/0 action drop log no prior 1
ipv4rule from eth1 to eth0 srcip 10.10.200.0/24 dstip 0.0.0.0/0 action drop log no prior 1
ipv4rule from eth1 to eth0 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action acc service FWS_tcp_80 log no prior 2
ipv4rule from eth1 to eth0 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action acc service FWS_tcp_443 log no prior 2
ipv4rule from eth1 to eth0 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action acc service FWS_udp-53 log no prior 2
ipv4rule from eth1 to eth0 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action acc service FWS_tcp-53 log no prior 2
ipv4rule from eth0 to eth2 srcip 0.0.0.0/0 dstip 10.20.0.10 action acc service FWS_tcp-8443 log no prior 2
ipv4rule from eth0 to eth2 srcip 0.0.0.0/0 dstip 10.20.0.25 action acc service FWS_tcp-25 log no prior 2
ipv4rule from eth0 to eth2 srcip 0.0.0.0/0 dstip 203.0.113.25 action acc service FWS_tcp-25 log no prior 2
ipv4rule from eth1 to eth2 srcip 10.10.5.10-10.10.5.20 dstip 10.20.0.0/24 action acc service FWS_tcp-22 log no prior 2
ipv4rule from eth1 to eth2 srcip 10.10.5.10-10.10.5.20 dstip 10.20.0.0/24 action acc service FWS_tcp-3389 log no prior 2
ipv4rule from eth1 to eth3 srcip 10.10.7.15 dstip 10.30.1.0/24 action acc service FWS_tcp-502 log no prior 2
ipv4rule from eth3 to eth0 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log info prior 3
ipv4rule from eth2 to eth0 srcip 0.0.0.0/0 dstip 0.0.0.0-9.255.255.255 action acc service FWS_tcp_80 log no prior 4
