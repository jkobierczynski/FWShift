service name FWS_tcp-22 proto tcp src all dst port 22
service name FWS_tcp-3389 proto tcp src all dst port 3389
service name FWS_tcp-502 proto tcp src all dst port 502
icmp name FWS_icmp-8 type 8 code 0 ver ipv4
proto name FWS_ip-47 num 47
ipv4rule from eth1 to eth0 srcip 198.51.100.66 dstip 0.0.0.0/0 action drop log no prior 1
ipv4rule from eth1 to eth2 srcip 198.51.100.66 dstip 0.0.0.0/0 action drop log no prior 1
