{
  "apiVersion": "projectcalico.org/v3",
  "kind": "GlobalNetworkPolicy",
  "metadata": {
    "name": "fwshift",
    "annotations": {
      "fwshift/generated": "FWShift - review the conversion report before applying this",
      "fwshift/not-written": "Banned by fail2ban (not written, see the report); LAN web (not written, see the report); LAN DNS (not written, see the report); Rate limited mail (not written, see the report); Partner tunnel (not written, see the report); Admins (not written, see the report); Ping the DMZ (not written, see the report); SCADA to PLCs (not written, see the report); Inbound web (not written, see the report); Inbound mail (not written, see the report); Inbound IPv6 (not written, see the report); DMZ updates (not written, see the report)"
    }
  },
  "spec": {
    "tier": "default",
    "order": 100,
    "selector": "fwshift/policy == 'fwshift'",
    "types": [
      "Ingress",
      "Egress"
    ],
    "ingress": [
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "192.0.2.128/25",
            "198.51.100.66/32"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Block bad hosts"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "10.10.200.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Guests stay in"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "OT no internet"
          }
        }
      },
      {
        "action": "Allow",
        "ipVersion": 6,
        "protocol": "ICMPv6",
        "icmp": {
          "type": 128
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "ICMPv6 basics"
          }
        }
      },
      {
        "action": "Allow",
        "ipVersion": 6,
        "protocol": "ICMPv6",
        "icmp": {
          "type": 135
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "ICMPv6 basics"
          }
        }
      },
      {
        "action": "Allow",
        "ipVersion": 6,
        "protocol": "ICMPv6",
        "icmp": {
          "type": 136
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "ICMPv6 basics"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
        }
      }
    ],
    "egress": [
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "192.0.2.128/25",
            "198.51.100.66/32"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Block bad hosts"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "10.10.200.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "Guests stay in"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "OT no internet"
          }
        }
      },
      {
        "action": "Allow",
        "ipVersion": 6,
        "protocol": "ICMPv6",
        "icmp": {
          "type": 128
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "ICMPv6 basics"
          }
        }
      },
      {
        "action": "Allow",
        "ipVersion": 6,
        "protocol": "ICMPv6",
        "icmp": {
          "type": 135
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "ICMPv6 basics"
          }
        }
      },
      {
        "action": "Allow",
        "ipVersion": 6,
        "protocol": "ICMPv6",
        "icmp": {
          "type": 136
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "ICMPv6 basics"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
        }
      }
    ]
  }
}
