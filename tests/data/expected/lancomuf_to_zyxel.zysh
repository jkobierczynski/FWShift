# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
service-object FWS_internet_http tcp eq 80
address-object FWS_LAN 192.168.10.0/24
service-object FWS_internet_https tcp eq 443
service-object FWS_tcp_53 tcp eq 53
service-object FWS_udp_53 udp eq 53
object-group service FWS_standard_dns
 service-object FWS_tcp_53
 service-object FWS_udp_53
exit
service-object FWS_standard_ping protocol 1
address-object FWS_Webserver 172.16.20.10
service-object FWS_standard_ssh tcp eq 22
address-object FWS_Admin-PCs 192.168.10.200-192.168.10.220
address-object FWS_Mailserver 172.16.20.25
object-group address FWS_Servers
 address-object FWS_Webserver
 address-object FWS_Mailserver
exit
service-object FWS_remote_rdp tcp eq 3389
service-object FWS_Modbus-TCP tcp eq 502
address-object FWS_192_168_10_5 192.168.10.5
object-group address FWS_Jump-Hosts__eth1_
 address-object FWS_192_168_10_5
exit
address-object FWS_OT-Cell 10.30.0.0/24
address-object FWS_10_30_0_5 10.30.0.5
object-group address FWS_Jump-Hosts__eth3_
 address-object FWS_10_30_0_5
exit
service-object FWS_OPC-UA tcp range 4840 4843
address-object FWS_HMI 10.30.0.50
address-object FWS_Monitoring 198.51.100.10-198.51.100.20
service-object FWS_internet_smtp tcp eq 25
service-object FWS_GRE-Tunnel protocol 47
address-object FWS_DMZ 172.16.20.0/24
service-object FWS_noservice protocol 255
object-group service FWS_Web
 service-object FWS_internet_http
 service-object FWS_internet_https
exit
service-object FWS_udp_500 udp eq 500
service-object FWS_udp_4500 udp eq 4500
service-object FWS_protocol_50 protocol 50
object-group service FWS_vpn_ipsec
 service-object FWS_udp_500
 service-object FWS_udp_4500
 service-object FWS_protocol_50
exit
address-object FWS_Internet 0.0.0.0/0
zone FWS_eth1
exit
zone FWS_eth2
exit
zone FWS_eth3
exit
zone FWS_eth4
exit
