policy insert 5
 deactivate
 description "FWShift DMZ to Internet - GRE-Tunnel (NAT)"
 interface eth2
 source FWS_DMZ
 destination FWS_Internet
 service FWS_GRE-Tunnel
 next-hop auto
 snat outgoing-interface
 no deactivate
exit
exit
# Put the interfaces in their zones (this changes traffic at once):
#   zone WAN / interface WAN
#   zone FWS_eth1 / interface eth1
#   zone FWS_eth2 / interface eth2
#   zone FWS_eth3 / interface eth3
#   zone FWS_eth4 / interface eth4
# Written inactive:
#   HMI to OT-Cell - OPC-UA: schedule 'Mon 06:00:00 - Mon 22:00:00; Tue 06:00:00 - Tue 22:00:00; Wed 06:00:00 - Wed 22:00:00; Thu 06:00:00 - Thu 22:00:00; Fri 06:00:00 - Fri 22:00:00' is not converted; the rule would apply at all times
#   OT-Cell to HMI - OPC-UA: schedule 'Mon 06:00:00 - Mon 22:00:00; Tue 06:00:00 - Tue 22:00:00; Wed 06:00:00 - Wed 22:00:00; Thu 06:00:00 - Thu 22:00:00; Fri 06:00:00 - Fri 22:00:00' is not converted; the rule would apply at all times
#   Branch Sites to LAN - remote.rdp: not converted: 'Branch Sites' is a VPN object, which is not converted
#   LAN to Lab-v6 - internet.http: not converted: desktop object 'Lab-v6' cannot be read: attribute 'ipv6', which this parser does not read
#   DMZ to Internet - Legacy-App: not converted: service 'Legacy-App' cannot be read: an entry with 'sourceport', which this parser does not read; references 'Legacy-App': an entry with 'sourceport', which this parser does not read
#   DMZ to Internet - standard.ssh: not converted: action 'drop', which is not a direction (LANCOM documents no rule that blocks)
#   Internet to   - internet.https: not converted: desktop object '0e5f1a2b-0000-4000-8000-000000000999' is not in the input
#   Printer to DMZ - internet.http: not converted: desktop object 'Printer' cannot be read: a host that names no interface
