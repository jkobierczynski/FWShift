policy insert 1
 deactivate
 description "FWShift LAN to Internet - internet.http (NAT)"
 interface eth1
 source FWS_LAN
 destination FWS_Internet
 service FWS_internet_http
 next-hop auto
 snat outgoing-interface
 no deactivate
exit
policy insert 2
 deactivate
 description "FWShift LAN to Internet - internet.https (NAT)"
 interface eth1
 source FWS_LAN
 destination FWS_Internet
 service FWS_internet_https
