add IPRule Index=13 Name=fws_dmz_in-4 Action=Allow SourceInterface=ethernet2 SourceNetwork=fws_10.20.0.10 DestinationInterface=ethernet1 DestinationNetwork=fws_10.10.0.0_16 Service=fws_tcp-445 LogEnabled=No
