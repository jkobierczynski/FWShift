cc IPRuleSet fws_snat
add IPRule Index=1 Name=fws_nat0-inside-1 Action=Allow SourceInterface=ethernet1 SourceNetwork=fws_10.10.0.0_16 DestinationInterface=any DestinationNetwork=fws_10.99.0.0_16 Service=all_services LogEnabled=No Comments="nat (inside) 0 access-list inside_nat0: not translated"
add IPRule Index=2 Name=fws_static-1_sat Action=SAT SourceInterface=ethernet2 SourceNetwork=fws_10.20.0.10 DestinationInterface=ethernet0 DestinationNetwork=all-nets Service=all_services SATTranslate=SourceIP SATTranslateToIP=fws_203.0.113.10 LogEnabled=No
