add GotoRule Index=15 Name=fws_implicit-inside-outside SourceInterface=ethernet1 SourceNetwork=all-nets DestinationInterface=ethernet0 DestinationNetwork=all-nets Service=all_services RuleSet=fws_snat LogEnabled=No Comments="PIX implicit rule: traffic to an interface of a lower security level, from what a translation covers"
add GotoRule Index=16 Name=fws_implicit-inside-dmz SourceInterface=ethernet1 SourceNetwork=fws_implicit-inside-dmz_src DestinationInterface=ethernet2 DestinationNetwork=all-nets Service=all_services RuleSet=fws_snat LogEnabled=No Comments="PIX implicit rule: traffic to an interface of a lower security level, from what a translation covers"
add GotoRule Index=17 Name=fws_implicit-inside-partner SourceInterface=ethernet1 SourceNetwork=fws_10.10.0.0_16 DestinationInterface=ethernet4 DestinationNetwork=all-nets Service=all_services RuleSet=fws_snat LogEnabled=No Comments="PIX implicit rule: traffic to an interface of a lower security level, from what a translation covers"
add IPRule Index=18 Name=fws_implicit-partner-outside Action=Allow SourceInterface=ethernet4 SourceNetwork=fws_10.30.0.0_24 DestinationInterface=ethernet0 DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="PIX implicit rule: traffic to an interface of a lower security level, from what a translation covers"
set IPRule 18 -disable
add IPRule Index=19 Name=fws_conduit-1 Action=Allow SourceInterface=fws_if_ethernet3_ethernet4 SourceNetwork=fws_10.30.0.0_24 DestinationInterface=ethernet1 DestinationNetwork=fws_10.10.0.60 Service=fws_tcp-3389 LogEnabled=No
add IPRule Index=20 Name=fws_conduit-2 Action=Allow SourceInterface=ethernet3 SourceNetwork=all-nets DestinationInterface=ethernet1 DestinationNetwork=all-nets Service=fws_icmp-0 LogEnabled=No
add IPRule Index=21 Name=fws_conduit-2-2 Action=Allow SourceInterface=ethernet4 SourceNetwork=all-nets DestinationInterface=fws_if_ethernet1_ethernet2_ethernet3 DestinationNetwork=all-nets Service=fws_icmp-0 LogEnabled=No
