add IPRule Index=4 Name=fws_static-2_sat Action=SAT SourceInterface=ethernet2 SourceNetwork=fws_10.20.0.25 DestinationInterface=ethernet0 DestinationNetwork=all-nets Service=all_services SATTranslate=SourceIP SATTranslateToIP=fws_203.0.113.25 LogEnabled=No
add IPRule Index=5 Name=fws_static-2 Action=Allow SourceInterface=ethernet2 SourceNetwork=fws_10.20.0.25 DestinationInterface=ethernet0 DestinationNetwork=all-nets Service=all_services LogEnabled=No
add IPRule Index=6 Name=fws_static-4 Action=Allow SourceInterface=ethernet1 SourceNetwork=fws_10.10.0.50 DestinationInterface=ethernet2 DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="static (inside,dmz) 10.10.0.50 10.10.0.50: not translated"
add IPRule Index=7 Name=fws_static-5 Action=Allow SourceInterface=ethernet1 SourceNetwork=fws_10.10.0.0_16 DestinationInterface=ethernet4 DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="static (inside,partner) 10.10.0.0/16 10.10.0.0/16: not translated"
add IPRule Index=8 Name=fws_nat3-inside-1 Action=NAT SourceInterface=ethernet1 SourceNetwork=fws_10.10.20.0_24 DestinationInterface=ethernet0 DestinationNetwork=fws_198.51.100.0_24 Service=all_services NATAction=UseSenderAddress NATSenderAddress=fws_203.0.113.200 LogEnabled=No Comments="nat (inside) 3 access-list partner_nat"
add IPRule Index=9 Name=fws_nat1-inside-outside Action=NAT SourceInterface=ethernet1 SourceNetwork=all-nets DestinationInterface=ethernet0 DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="nat (inside) 1 with global (outside) 1"
add IPRule Index=10 Name=fws_nat1-inside-dmz Action=NAT SourceInterface=ethernet1 SourceNetwork=all-nets DestinationInterface=ethernet2 DestinationNetwork=all-nets Service=all_services NATAction=UseSenderAddress NATSenderAddress=fws_10.20.0.200 LogEnabled=No Comments="nat (inside) 1 with global (dmz) 1"
add IPRule Index=11 Name=fws_nat1-partner Action=NAT SourceInterface=ethernet4 SourceNetwork=fws_10.30.0.0_24 DestinationInterface=ethernet0 DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="nat (partner) 1 with global (outside) 1"
add IPRule Index=12 Name=fws_snat_allow Action=Allow SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
add IPRule Index=13 Name=fws_snat_allow_v6 Action=Allow SourceInterface=any SourceNetwork=all-nets6 DestinationInterface=any DestinationNetwork=all-nets6 Service=all_services LogEnabled=No
cc
cc IPRuleSet fws_d_static-3
add IPRule Index=1 Name=fws_static-3_outside_in-3 Action=Allow SourceInterface=ethernet0 SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_outside-interface Service=fws_tcp-8443 LogEnabled=No
add IPRule Index=2 Name=fws_static-3_outside_in-5 Action=Drop SourceInterface=ethernet0 SourceNetwork=fws_192.0.2.66 DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=Yes
add IPRule Index=3 Name=fws_static-3_outside_in-7 Action=Drop SourceInterface=ethernet0 SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=Yes
add IPRule Index=4 Name=fws_static-3_default Action=Drop SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
cc
cc IPRuleSet fws_rules
add IPRule Index=1 Name=fws_static-3_sat Action=SAT SourceInterface=ethernet0 SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_outside-interface Service=fws_tcp-8443 SATTranslate=DestinationIP SATTranslateToIP=fws_10.20.0.30 SATTranslateToPort=443 LogEnabled=No
add GotoRule Index=2 Name=fws_static-3_goto SourceInterface=ethernet0 SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_outside-interface Service=fws_tcp-8443 RuleSet=fws_d_static-3 LogEnabled=No
add IPRule Index=3 Name=fws_outside_in-1 Action=Allow SourceInterface=ethernet0 SourceNetwork=all-nets DestinationInterface=ethernet2 DestinationNetwork=fws_203.0.113.10 Service=fws_web-ports LogEnabled=No Comments="Published servers, by their global addresses"
