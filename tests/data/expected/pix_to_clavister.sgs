add GotoRule Index=10 Name=fws_dmz_in-1 SourceInterface=ethernet2 SourceNetwork=fws_dmz-servers DestinationInterface=fws_if_ethernet0_ethernet1_ethernet3_ethernet4 DestinationNetwork=all-nets Service=fws_udp-53 RuleSet=fws_snat LogEnabled=No
add GotoRule Index=11 Name=fws_dmz_in-2 SourceInterface=ethernet2 SourceNetwork=fws_10.20.0.25 DestinationInterface=fws_if_ethernet0_ethernet1_ethernet3_ethernet4 DestinationNetwork=all-nets Service=fws_tcp-25 RuleSet=fws_snat LogEnabled=No
