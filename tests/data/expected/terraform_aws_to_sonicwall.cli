    address-object ipv4 "n 10.30.0.0_16"
    exit
address-group ipv6 "shop v6"
    address-object ipv6 "n 2001:db8:30::_56"
    exit
address-group ipv4 "shop-app members"
    address-object ipv4 "n 10.30.2.20_31"
    exit
address-group ipv4 "shop-db members"
    address-object ipv4 "h 10.30.3.30"
    exit
address-group ipv4 "corp-offices"
    address-object ipv4 "n 198.51.100.0_25"
    address-object ipv4 "n 203.0.113.64_26"
    exit
