service-object "shop-db-in-1" TCP 1 65535
service-object "shop-db-in-2" TCP 1024 65535
service-object "tcp-8080" TCP 8080 8080
service-object "tcp-22" TCP 22 22
service-object "tcp-5432" TCP 5432 5432
service-object "udp-53" UDP 53 53
service-object "tcp-443" TCP 443 443
service-object "tcp-80" TCP 80 80
nat-policy inbound any outbound any source name "h 10.30.1.10" translated-source name "h 192.0.2.10" destination any translated-destination original service any translated-service original
    name "public-192.0.2.10"
    comment "public address of eni-0a1b2c3d4e"
    exit
nat-policy inbound any outbound any source any translated-source original destination name "h 192.0.2.10" translated-destination name "h 10.30.1.10" service any translated-service original
    name "public-192.0.2.10 in"
    comment "inbound of public-192.0.2.10"
    exit
nat-policy inbound any outbound any source name "h 10.30.9.5" translated-source name "h 192.0.2.5" destination any translated-destination original service any translated-service original
    name "public-192.0.2.5"
    comment "public address of eni-0a1b2c3d4e"
    exit
nat-policy inbound any outbound any source any translated-source original destination name "h 192.0.2.5" translated-destination name "h 10.30.9.5" service any translated-service original
    name "public-192.0.2.5 in"
    comment "inbound of public-192.0.2.5"
    exit
commit
