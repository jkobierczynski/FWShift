address-object ipv4 "h 192.0.2.10" host 192.0.2.10 zone LAN
address-object ipv4 "h 192.0.2.5" host 192.0.2.5 zone LAN
address-group ipv4 "shop-web"
    address-object ipv4 "h 10.30.1.10"
    exit
address-group ipv6 "shop-web v6"
    address-object ipv6 "h 2001:db8:30:1::10"
    exit
