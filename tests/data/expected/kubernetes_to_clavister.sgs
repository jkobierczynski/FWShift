cc IPRuleSet fws_rules
add IPRule Index=1 Name=fws_node_10.0.0.11_to_its_pods Action=Allow SourceInterface=any SourceNetwork=fws_10.0.0.11 DestinationInterface=any DestinationNetwork=fws_pods_on_node_10.0.0.11 Service=all_services LogEnabled=No Comments="traffic between a pod and the node it runs on is always allowed"
add IPRule Index=2 Name=fws_pods_from_node_10.0.0.11 Action=Allow SourceInterface=any SourceNetwork=fws_pods_on_node_10.0.0.11 DestinationInterface=any DestinationNetwork=fws_10.0.0.11 Service=all_services LogEnabled=No Comments="traffic between a pod and the node it runs on is always allowed"
add IPRule Index=3 Name=fws_node_10.0.0.12_to_its_pods Action=Allow SourceInterface=any SourceNetwork=fws_10.0.0.12 DestinationInterface=any DestinationNetwork=fws_pods_on_node_10.0.0.12 Service=all_services LogEnabled=No Comments="traffic between a pod and the node it runs on is always allowed"
add IPRule Index=4 Name=fws_pods_from_node_10.0.0.12 Action=Allow SourceInterface=any SourceNetwork=fws_pods_on_node_10.0.0.12 DestinationInterface=any DestinationNetwork=fws_10.0.0.12 Service=all_services LogEnabled=No Comments="traffic between a pod and the node it runs on is always allowed"
add IPRule Index=5 Name=fws_shop_web-egress_egress-1___shop_web-to-cart_ingress-1 Action=Allow SourceInterface=any SourceNetwork=fws_shop_web-egress_egress-1___shop_web-to-cart_ingress-1_src DestinationInterface=any DestinationNetwork=fws_shop_app_cart Service=fws_tcp-50051 LogEnabled=No Comments="shop/web-egress egress rule: shop/app=cart (from shop/app=web); shop/web-to-cart ingress rule: shop/app=web"
add IPRule Index=6 Name=fws_shop_web-egress_egress-2 Action=Allow SourceInterface=any SourceNetwork=fws_shop_web-egress_egress-2_src DestinationInterface=any DestinationNetwork=fws_ns-kube-system Service=fws_tcp-53_udp-53 LogEnabled=No Comments="shop/web-egress egress rule: namespaces kubernetes.io/metadata.name=kube-system pods k8s-app=kube-dns (from shop/app=web), to what no ingress policy isolates"
add IPRule Index=7 Name=fws_shop_web-egress_egress-3 Action=Allow SourceInterface=any SourceNetwork=fws_shop_web-egress_egress-3_src DestinationInterface=any DestinationNetwork=fws_2001_db8_ffff___48 Service=fws_tcp-443 LogEnabled=No Comments="shop/web-egress egress rule: ipBlock 2001:db8:ffff::/48 (from shop/app=web), to what no ingress policy isolates"
add IPRule Index=8 Name=fws_isolated_egress Action=Drop SourceInterface=any SourceNetwork=fws_shop_app_web DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="the pods are isolated for egress: what no policy allows is denied (from shop/app=web)"
add IPRule Index=9 Name=fws_isolated_egress_v6 Action=Drop SourceInterface=any SourceNetwork=fws_shop_app_web_v6 DestinationInterface=any DestinationNetwork=all-nets6 Service=all_services LogEnabled=No Comments="the pods are isolated for egress: what no policy allows is denied (from shop/app=web)"
add IPRule Index=10 Name=fws_shop_cart-egress_egress-1___shop_cart-to-db_ingress-1 Action=Allow SourceInterface=any SourceNetwork=fws_shop_app_cart DestinationInterface=any DestinationNetwork=fws_shop_app_db Service=fws_tcp-5432 LogEnabled=No Comments="shop/cart-egress egress rule: shop/app=db (from shop/app=cart); shop/cart-to-db ingress rule: shop/app=cart"
add IPRule Index=11 Name=fws_shop_cart-egress_egress-2 Action=Allow SourceInterface=any SourceNetwork=fws_shop_app_cart DestinationInterface=any DestinationNetwork=fws_ns-kube-system Service=fws_udp-53 LogEnabled=No Comments="shop/cart-egress egress rule: namespaces all pods k8s-app=kube-dns (from shop/app=cart), to what no ingress policy isolates"
add IPRule Index=12 Name=fws_isolated_egress-2 Action=Drop SourceInterface=any SourceNetwork=fws_shop_app_cart DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="the pods are isolated for egress: what no policy allows is denied (from shop/app=cart)"
