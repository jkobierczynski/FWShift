  }

  security_rule {
    name                       = "Reject-the-rest-from-LAN-out-3"
    priority                   = 120
    direction                  = "Outbound"
    access                     = "Deny"
    protocol                   = "Ah"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "0.0.0.0/0"
    destination_address_prefix = "*"
    description                = "Reject the rest from LAN"
  }

  security_rule {
    name                       = "fwshift-default-out"
    priority                   = 130
    direction                  = "Outbound"
