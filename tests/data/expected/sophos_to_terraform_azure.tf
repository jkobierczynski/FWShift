# Generated by FWShift: Azure network security groups (hashicorp/azurerm), as Terraform configuration.
# Read the report first: what is not written is listed there.
#
#   terraform init
#   terraform plan -var resource_group_name=...     shows what would be created (with -var subscription_id=...,
#                                                   or ARM_SUBSCRIPTION_ID in the environment, for azurerm 4 and later)
#   terraform apply -var resource_group_name=...    creates the groups and their rules
#
# The groups are associated with nothing: associate each with the subnets of the networks listed above it
# (azurerm_subnet_network_security_group_association). A group of the same name in the resource group makes the
# apply fail; nothing that exists is changed. Each list ends in the default of the source, before Azure's own.

terraform {
  required_version = ">= 1.3"
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = ">= 3.0"
    }
  }
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}

variable "subscription_id" {
  description = "The subscription (azurerm 4 and later need it here or in ARM_SUBSCRIPTION_ID)"
  type        = string
  default     = null
}

variable "resource_group_name" {
  description = "The resource group to create the groups in"
  type        = string
}

variable "location" {
  description = "Their location; the resource group's when not given"
  type        = string
  default     = null
}

data "azurerm_resource_group" "target" {
  name = var.resource_group_name
}

resource "azurerm_network_security_group" "nsg_FWShift" {
  name                = "FWShift"
  location            = coalesce(var.location, data.azurerm_resource_group.target.location)
  resource_group_name = var.resource_group_name
  tags = {
    generator = "FWShift"
  }

  security_rule {
    name                       = "Reject-the-rest-from-LAN-in"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "0.0.0.0/0"
    destination_address_prefix = "*"
    description                = "Reject the rest from LAN"
  }

  security_rule {
    name                       = "Reject-the-rest-from-LAN-in-2"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "Esp"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "0.0.0.0/0"
    destination_address_prefix = "*"
    description                = "Reject the rest from LAN"
  }

  security_rule {
    name                       = "Reject-the-rest-from-LAN-in-3"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "Ah"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "0.0.0.0/0"
    destination_address_prefix = "*"
    description                = "Reject the rest from LAN"
  }

  security_rule {
    name                       = "fwshift-default-in"
    priority                   = 130
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
    description                = "fwshift-default: the default of the source for what no rule matches: deny"
  }

  security_rule {
    name                       = "fwshift-default-in-2"
    priority                   = 140
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "Esp"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
    description                = "fwshift-default: the default of the source for what no rule matches: deny"
  }

  security_rule {
    name                       = "fwshift-default-in-3"
    priority                   = 4096
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "Ah"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
    description                = "fwshift-default: the default of the source for what no rule matches: deny"
  }

  security_rule {
    name                       = "Reject-the-rest-from-LAN-out"
    priority                   = 100
    direction                  = "Outbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "0.0.0.0/0"
    destination_address_prefix = "*"
    description                = "Reject the rest from LAN"
  }

  security_rule {
    name                       = "Reject-the-rest-from-LAN-out-2"
    priority                   = 110
    direction                  = "Outbound"
    access                     = "Deny"
    protocol                   = "Esp"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "0.0.0.0/0"
    destination_address_prefix = "*"
