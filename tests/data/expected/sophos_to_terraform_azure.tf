}

output "fwshift_networks" {
  description = "Each network security group, with the networks of the subnets to associate it with"
  value = {
    "FWShift" = {
      id       = azurerm_network_security_group.nsg_FWShift.id
      networks = []
    }
  }
}

# Not written:
#   Block countries: references 'Blocked countries': country group
#   LAN to Internet web: the rule is for zone LAN, WAN, and a security rule names no zone: give the networks behind it with --zone-network
#   LAN web again: the rule is for zone LAN, WAN, and a security rule names no zone: give the networks behind it with --zone-network
#   Admins to DMZ: the rule is for zone LAN, DMZ, and a security rule names no zone: give the networks behind it with --zone-network
#   LAN to DMZ web not mail: the rule is for zone LAN, DMZ, and a security rule names no zone: give the networks behind it with --zone-network
#   LAN SSH out: the rule is for zone LAN, OT, and a security rule names no zone: give the networks behind it with --zone-network
#   LAN SSH out-2: the rule is for zone LAN, DMZ, OT, and a security rule names no zone: give the networks behind it with --zone-network
#   Internet to web: the rule is for zone WAN, DMZ, and a security rule names no zone: give the networks behind it with --zone-network
#   Internet to mail: the rule is for zone WAN, DMZ, and a security rule names no zone: give the networks behind it with --zone-network
#   OT to SCADA: the rule is for zone OT, LAN, and a security rule names no zone: give the networks behind it with --zone-network
#   DMZ updates: host name object mirror.example.net, updates.example.com: a security rule names addresses; the rule is for zone DMZ, WAN, and a security rule names no zone: give the networks behind it with --zone-network
#   Finance to app: source user match Finance is not converted; the rule is for zone LAN, DMZ, and a security rule names no zone: give the networks behind it with --zone-network
#   DNS in office hours: schedule 'Work hours (5 Day week)' is not converted; the rule would apply at all times; the rule is for zone OT, LAN, and a security rule names no zone: give the networks behind it with --zone-network
#   Old test rule: disabled in the source
#   LAN6 to Internet: the rule is for zone LAN, WAN, and a security rule names no zone: give the networks behind it with --zone-network
