set address internet ip-netmask 0.0.0.0/0
set address internet6 ip-netmask ::/0
set address internal-network ip-netmask 192.168.10.0/24
set address internal-network description "the networks of interface eth1"
set address internal-interface ip-netmask 192.168.10.1
set address internal-interface description "the address of interface eth1"
set address external-interface ip-netmask 203.0.113.2
set address external-interface description "the address of interface eth0"
set address dmz1-network ip-netmask 172.16.20.0/24
set address dmz1-network description "the networks of interface eth2"
set address public-mail ip-netmask 203.0.113.5/32
set address webserver ip-netmask 172.16.20.10/32
set address mailserver ip-netmask 172.16.20.25/32
set address admin-pc ip-netmask 192.168.10.50/32
set address printers ip-range 192.168.10.200-192.168.10.220
set address lan6 ip-netmask 2001:db8:10::/64
set address partner-net ip-netmask 10.20.0.0/16
set address update-host fqdn updates.example.com
set address blocked-region ip-netmask 0.0.0.0/32
set address blocked-region description "FWSHIFT PLACEHOLDER, matches nothing: address 'geoip:XX' is not a form FWShift reads"
set address-group servers static [ webserver mailserver ]
set address-group admins-and-partner static [ admin-pc partner-net ]
set service http protocol tcp port 80
set service https protocol tcp port 443
set service extern-https protocol tcp port 8443
set service smtp protocol tcp port 25
set service domain-udp protocol udp port 53
set service ntp-client protocol udp port 123
set service ntp-client protocol udp source-port 1024-65535
set service app-ports protocol tcp port 8000-8010
set service ftp protocol tcp port 21
set service ftp description "connection tracking helper ftp"
set service ssh protocol tcp port 22
set service ssh description "a service the UTM comes with"
set service-group web members [ http https ]
set service-group default-internet members [ http https domain-udp ftp ]
