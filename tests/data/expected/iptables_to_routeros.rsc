# Generated by FWShift - review the conversion report before loading this.
# A script for /import on RouterOS 6 or 7: /import file-name=FILE verbose=yes
# Nothing in it changes traffic until the disabled jump rules at its end are enabled (in Safe Mode).
:if ([:len [/ip firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
/interface list add name=fws-eth0 comment="fwshift"
/interface list member add list=fws-eth0 interface="eth0" comment="fwshift"
/interface list add name=fws-eth1 comment="fwshift"
/interface list member add list=fws-eth1 interface="eth1" comment="fwshift"
/interface list add name=fws-eth2 comment="fwshift"
/interface list member add list=fws-eth2 interface="eth2" comment="fwshift"
/interface list add name=fws-eth3 comment="fwshift"
/interface list member add list=fws-eth3 interface="eth3" comment="fwshift"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward src-address=198.51.100.66 action=drop comment="Block bad host"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-eth0 src-address=10.10.200.0/24 action=drop comment="Guests stay in"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-eth0 protocol=tcp dst-port=80,443 action=accept comment="LAN web"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-eth0 protocol=udp dst-port=53 action=accept comment="LAN DNS"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-eth0 protocol=tcp dst-port=53 action=accept comment="LAN DNS-2"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth0 out-interface-list=fws-eth2 dst-address=10.20.0.10 protocol=tcp dst-port=8443 action=accept comment="Inbound web"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth0 out-interface-list=fws-eth2 dst-address=10.20.0.25 protocol=tcp dst-port=25 action=accept comment="Inbound mail"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-eth2 src-address=10.10.5.10-10.10.5.20 dst-address=10.20.0.0/24 protocol=tcp dst-port=22 action=accept comment="Admins SSH"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-eth2 src-address=10.10.5.10-10.10.5.20 dst-address=10.20.0.0/24 protocol=tcp dst-port=3389 action=accept comment="Admins RDP"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-eth3 src-address=10.10.7.15 dst-address=10.30.1.0/24 protocol=tcp dst-port=502 action=accept comment="SCADA to PLCs"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth3 out-interface-list=fws-eth0 action=reject log=yes log-prefix="OT no internet" comment="OT no internet"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth2 out-interface-list=fws-eth0 dst-address=!10.0.0.0/8 protocol=tcp dst-port=80,443 action=accept comment="DMZ updates"
# FWSHIFT disabled, see the report: "Rate limited mail" from eth1 to eth0; source 0.0.0.0/0; destination any; service tcp-25; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-eth2 protocol=icmp icmp-options=8:0-255 action=accept comment="Ping the DMZ"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1 out-interface-list=fws-eth0 protocol=gre action=accept comment="Partner tunnel"
/ip firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-eth0 dst-address=203.0.113.10 protocol=tcp dst-port=443 action=dst-nat to-addresses=10.20.0.10 to-ports=8443 comment="Web DNAT"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-eth0 dst-address=203.0.113.25 action=dst-nat to-addresses=10.20.0.25 comment="Mail DNAT"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-eth0 src-address=10.10.0.0/16 dst-address=10.99.0.0/16 action=accept comment="No NAT to partner"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-eth0 src-address=10.20.0.0/24 action=src-nat to-addresses=198.51.100.20-198.51.100.23 comment="DMZ out"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-eth0 src-address=10.10.0.0/16 action=masquerade comment="LAN out"
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=dstnat action=jump jump-target=fwshift-dstnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
/ip firewall nat add chain=srcnat action=jump jump-target=fwshift-srcnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
