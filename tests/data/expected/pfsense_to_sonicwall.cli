    address-object ipv4 "h 192.168.20.25"
    address-object ipv4 "WAN address"
    address-object ipv4 "h 198.51.100.11"
    exit
address-group ipv4 "src Block private networks from"
    address-object ipv4 "n 10.0.0.0_8"
    address-object ipv4 "n 127.0.0.0_8"
    address-object ipv4 "n 172.16.0.0_12"
    address-object ipv4 "n 192.168.0.0_16"
    exit
address-group ipv4 "dst NAT Web server HTTPS"
    address-object ipv4 "h 192.168.20.10"
    address-object ipv4 "h 198.51.100.10"
    exit
address-group ipv4 "dst Mail in"
    address-object ipv4 "h 192.168.20.25"
    address-object ipv4 "h 198.51.100.11"
    exit
address-group ipv4 "dst Users to the web servers"
    address-group ipv4 "WebServers"
    address-object ipv4 "h 198.51.100.10"
    exit
address-group ipv4 "dst No other private network fro"
    address-group ipv4 "Private"
    address-object ipv4 "h 198.51.100.10"
    exit
address-group ipv4 "dst Mail out, not to the inside"
    address-object ipv4 "r 0.0.0.0-9.255.255.255"
    address-object ipv4 "r 11.0.0.0-172.15.255.255"
    address-object ipv4 "r 172.32.0.0-192.167.255.255"
    address-object ipv4 "r 192.169.0.0-255.255.255.255"
    exit
address-group ipv4 "dst Guests reach nothing private"
    address-group ipv4 "Private"
    address-object ipv4 "h 198.51.100.10"
    exit
address-group ipv4 "nat sou 24"
    address-object ipv4 "LAN net"
    address-object ipv4 "DMZ net"
    address-object ipv4 "GUEST net"
    address-object ipv4 "n 10.50.0.0_16"
    exit
