    address-object ipv4 "WAN address"
    address-object ipv4 "h 198.51.100.10"
    address-object ipv4 "h 198.51.100.11"
    address-object ipv4 "h 192.168.10.1"
    address-object ipv4 "h 192.168.20.1"
    address-object ipv4 "h 192.168.30.1"
