  project         = var.project
  firewall_policy = google_compute_network_firewall_policy.policy.name
  priority        = 1020
  direction       = "INGRESS"
  action          = "deny"
  enable_logging  = true
  description     = "Reject the rest from LAN"
  match {
    src_ip_ranges  = ["0.0.0.0/0"]
