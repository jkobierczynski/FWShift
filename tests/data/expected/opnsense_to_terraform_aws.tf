# Generated by FWShift: AWS EC2 security groups for one VPC (hashicorp/aws), as Terraform configuration.
# Read the report first: what is not written is listed there.
#
#   terraform init
#   terraform plan -var vpc_id=vpc-...      shows what would be created
#   terraform apply -var vpc_id=vpc-...     creates the groups and their rules
#
# The groups are created WITHOUT members: nothing changes for any traffic until they are attached. Attach each
# group to the network interfaces whose private addresses are listed above it (# attach ...): an interface gets
# every group whose list holds one of its addresses, and then no other groups. A group of the same name in the
# VPC makes the apply fail; nothing that exists is changed. Terraform takes away the outbound rule AWS gives a
# new group: a group allows outbound what its egress rules below allow, and nothing else.

terraform {
  required_version = ">= 1.3"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0"
    }
  }
}

variable "vpc_id" {
  description = "The VPC to create the security groups in (vpc-...)"
  type        = string
}

# attach fwshift-no-rules: 0.0.0.0/0 ::/0
resource "aws_security_group" "g1" {
  name        = "fwshift-no-rules"
  description = "FWShift: for the interfaces of 0.0.0.0/0 ::/0"
  vpc_id      = var.vpc_id
  tags = {
    fwshift = "generated"
  }
}

output "fwshift_attach" {
  description = "Each security group, with the private addresses of the network interfaces to attach it to"
  value = {
    "fwshift-no-rules" = {
      id        = aws_security_group.g1.id
      addresses = ["0.0.0.0/0", "::/0"]
    }
  }
}

# Not written:
#   rule Never to the blocklist (floating) 2: not written, see the report
#   rule Guests never to the blocklist: not written, see the report
#   rule Voice from the partner - pass: not written, see the report
#   rule VPN users to the web servers: not written, see the report
#   rule Inside may ping (old kind): not written, see the report
#   rule Default allow LAN to any rule: not written, see the report
#   rule Web publishing: not written, see the report
#   rule DMZ anywhere but LAN (disabled): disabled in the source, not written
#   rule DMZ ICMPv6: not written, see the report
#   rule Servers fetch updates: not written, see the report
#   rule Servers fetch updates 2: not written, see the report
#   rule Servers fetch updates 3: not written, see the report
#   rule Servers fetch updates 4: not written, see the report
#   rule Guests to the portal (no protocol, both IP versions): not written, see the report
#   rule DMZ anywhere but LAN (disabled) 2: disabled in the source, not written
#   rule Guests interactive (tos): not written, see the report
#   rule VPN users to LAN web (old kind): not written, see the report
#   rule SSH to bastion (rule the port forward registers): not written, see the report
#   rule Time for everyone (floating, not quick): not written, see the report
