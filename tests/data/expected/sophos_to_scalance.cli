configure terminal
firewall
service name FWS_tcp_80 proto tcp src all dst port 80
service name FWS_tcp_443 proto tcp src all dst port 443
service name FWS_tcp_53 proto tcp src all dst port 53
service name FWS_udp_53 proto udp src all dst port 53
service name FWS_SSH proto tcp src all dst port 22
icmp name FWS_PING type 8 code 0 ver ipv4
service name FWS_tcp-25 proto tcp src all dst port 25
service name FWS_MODBUS proto tcp src all dst port 502
service name FWS_syslog-from-high proto udp src range 1024 - 65535 dst port 514
service name FWS_tcp_8080 proto tcp src all dst port 8080
service name FWS_tcp_8443 proto tcp src all dst port 8443
service name FWS_tcp_9000-9010 proto tcp src all dst range 9000 - 9010
icmp name FWS_PING6 type 128 code 0 ver ipv6
ipv4rule from LAN to WAN srcip 10.10.0.0/15 dstip 0.0.0.0/0 action acc service FWS_tcp_80 log info prior 1
ipv4rule from LAN to WAN srcip 10.10.0.0/15 dstip 0.0.0.0/0 action acc service FWS_tcp_443 log info prior 1
ipv4rule from LAN to WAN srcip 10.10.0.0/15 dstip 0.0.0.0/0 action acc service FWS_tcp_53 log info prior 1
ipv4rule from LAN to WAN srcip 10.10.0.0/15 dstip 0.0.0.0/0 action acc service FWS_udp_53 log info prior 1
ipv4rule from LAN to WAN srcip 10.10.0.0/15 dstip 0.0.0.0/0 action acc service FWS_tcp_80 log no prior 2
ipv4rule from LAN to DMZ srcip 10.10.5.10-10.10.5.20 dstip 10.20.0.10 action acc service FWS_SSH log info prior 3
ipv4rule from LAN to DMZ srcip 10.10.5.10-10.10.5.20 dstip 10.20.0.10 action acc service FWS_PING log info prior 3
ipv4rule from LAN to DMZ srcip 10.10.5.10-10.10.5.20 dstip 10.20.0.25 action acc service FWS_SSH log info prior 3
ipv4rule from LAN to DMZ srcip 10.10.5.10-10.10.5.20 dstip 10.20.0.25 action acc service FWS_PING log info prior 3
ipv4rule from LAN to DMZ srcip 10.10.0.0/15 dstip 0.0.0.0-10.20.0.24 action acc service FWS_tcp_80 log info prior 3
ipv4rule from LAN to DMZ srcip 10.10.0.0/15 dstip 0.0.0.0-10.20.0.24 action acc service FWS_tcp_443 log info prior 3
ipv4rule from LAN to DMZ srcip 10.10.0.0/15 dstip 10.20.0.26-255.255.255.255 action acc service FWS_tcp_80 log info prior 3
ipv4rule from LAN to DMZ srcip 10.10.0.0/15 dstip 10.20.0.26-255.255.255.255 action acc service FWS_tcp_443 log info prior 3
ipv4rule from LAN to OT srcip 10.10.0.0/15 dstip 0.0.0.0/0 action acc service FWS_SSH log info prior 3
ipv4rule from LAN to DMZ srcip 10.10.0.0-10.10.5.9 dstip 0.0.0.0/0 action acc service FWS_SSH log info prior 3
ipv4rule from LAN to DMZ srcip 10.10.5.21-10.11.255.255 dstip 0.0.0.0/0 action acc service FWS_SSH log info prior 3
ipv4rule from LAN to OT srcip 10.10.0.0-10.10.5.9 dstip 0.0.0.0/0 action acc service FWS_SSH log info prior 3
ipv4rule from LAN to OT srcip 10.10.5.21-10.11.255.255 dstip 0.0.0.0/0 action acc service FWS_SSH log info prior 3
ipv4rule from WAN to DMZ srcip 0.0.0.0/0 dstip 10.20.0.10 action acc service FWS_tcp_443 log info prior 3
ipv4rule from WAN to DMZ srcip 0.0.0.0/0 dstip 10.20.0.25 action acc service FWS_tcp-25 log info prior 3
ipv4rule from OT to LAN srcip 10.30.1.0/24 dstip 10.10.7.15 action acc service FWS_MODBUS log no prior 4
ipv4rule from OT to LAN srcip 10.30.1.0/24 dstip 10.10.7.15 action acc service FWS_syslog-from-high log no prior 4
ipv4rule from LAN to WAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action rej log info prior 5
ipv4rule from LAN to DMZ srcip 0.0.0.0/0 dstip 0.0.0.0/0 action rej log info prior 5
ipv4rule from LAN to OT srcip 0.0.0.0/0 dstip 0.0.0.0/0 action rej log info prior 5
ipv4rule from LAN to VPN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action rej log info prior 5
ipv6rule from LAN to WAN srcip 2001:db8:10::/48 dstip ::/0 action acc service FWS_tcp_80 log info prior 6
ipv6rule from LAN to WAN srcip 2001:db8:10::/48 dstip ::/0 action acc service FWS_tcp_443 log info prior 6
ipv6rule from LAN to WAN srcip 2001:db8:10::/48 dstip ::/0 action acc service FWS_PING6 log info prior 6
ipv4rule from LAN to WAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from LAN to WAN srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from LAN to DMZ srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from LAN to DMZ srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from LAN to OT srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from LAN to OT srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from LAN to VPN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from LAN to VPN srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from WAN to LAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from WAN to LAN srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from WAN to DMZ srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from WAN to DMZ srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from WAN to OT srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from WAN to OT srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from WAN to VPN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from WAN to VPN srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from DMZ to LAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from DMZ to LAN srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from DMZ to WAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from DMZ to WAN srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from DMZ to OT srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from DMZ to OT srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from DMZ to VPN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from DMZ to VPN srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from OT to LAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from OT to LAN srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from OT to WAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from OT to WAN srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from OT to DMZ srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from OT to DMZ srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from OT to VPN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from OT to VPN srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from VPN to LAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from VPN to LAN srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from VPN to WAN srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from VPN to WAN srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from VPN to DMZ srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from VPN to DMZ srcip ::/0 dstip ::/0 action drop log no prior 7
ipv4rule from VPN to OT srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 7
ipv6rule from VPN to OT srcip ::/0 dstip ::/0 action drop log no prior 7
exit
firewallnat
napt srcint WAN proto tcp type ipv4 dstip 198.51.100.10 transip 10.20.0.10 dstport 443 transport 443
napt srcint WAN proto tcp type ipv4 dstip 198.51.100.25 transip 10.20.0.25 dstport 2525 transport 25
netmap source srcint LAN dstint WAN type ipv4 srcip 10.20.0.25 dstip 0.0.0.0/0 transip 198.51.100.25/32
netmap source srcint DMZ dstint WAN type ipv4 srcip 10.20.0.25 dstip 0.0.0.0/0 transip 198.51.100.25/32
netmap source srcint OT dstint WAN type ipv4 srcip 10.20.0.25 dstip 0.0.0.0/0 transip 198.51.100.25/32
netmap source srcint VPN dstint WAN type ipv4 srcip 10.20.0.25 dstip 0.0.0.0/0 transip 198.51.100.25/32
masquerading WAN
exit
end
