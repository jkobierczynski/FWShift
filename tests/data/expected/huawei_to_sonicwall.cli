    exit
access-rule ipv6 from lab to lab action allow source address any service any destination address any
    name "intrazone default 4"
    priority manual 2
    exit
access-rule ipv4 from trust to trust action allow source address any service any destination address any
    name "intrazone default 5"
    priority manual 1
    exit
access-rule ipv6 from trust to trust action allow source address any service any destination address any
    name "intrazone default 6"
    priority manual 1
    exit
access-rule ipv4 from untrust to untrust action allow source address any service any destination address any
    name "intrazone default 7"
    priority manual 2
    exit
access-rule ipv6 from untrust to untrust action allow source address any service any destination address any
    name "intrazone default 8"
    priority manual 1
    exit
