-A FORWARD -i LAN -o WAN -p tcp -m tcp --dport 25 -m comment --comment "no outbound mail" -j REJECT
-A FORWARD -i GUEST -m comment --comment "spoofed inside sources" -j FWS1
-A FORWARD -i LAN -m comment --comment "spoofed inside sources" -j FWS1
-A FWS1 -s 192.168.10.0/24 -j RETURN
-A FWS1 -s 192.168.20.0/24 -j RETURN
