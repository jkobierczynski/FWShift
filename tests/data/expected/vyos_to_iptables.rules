-A POSTROUTING -o WAN -s 192.168.20.0/24 -m comment --comment "source-100" -j MASQUERADE
-A POSTROUTING -o WAN -s 192.168.30.0/24 -m comment --comment "dmz servers leave as one address" -j SNAT --to-source 203.0.113.20
-A POSTROUTING -o VPN -d 10.99.0.0/24 -m comment --comment "source-120" -j ACCEPT
