{
  "apiVersion": "projectcalico.org/v3",
  "kind": "GlobalNetworkPolicy",
  "metadata": {
    "name": "fwshift",
    "annotations": {
      "fwshift/generated": "FWShift - review the conversion report before applying this",
      "fwshift/not-written": "inside a VLAN (not written, see the report); office to servers web (not written, see the report); historian (not written, see the report); eng ws to plc (not written, see the report); block update site (not written, see the report); dns to servers (not written, see the report); ping servers (not written, see the report); office ipv6 out (not written, see the report); passive ftp (not written, see the report); bad ports (not written, see the report); Default rule (not written, see the report); vpn-portal (not written, see the report); mail (1) (not written, see the report); mail (2) (not written, see the report); scada-view (not written, see the report)"
    }
  },
  "spec": {
    "tier": "default",
    "order": 100,
    "selector": "fwshift/policy == 'fwshift'",
    "types": [
      "Ingress",
      "Egress"
    ],
    "ingress": [
      {
        "action": "Deny",
        "protocol": "TCP",
        "destination": {
          "ports": [
            23
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "layer 7 rule 2"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": "UDP",
        "destination": {
          "ports": [
            23
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "layer 7 rule 2"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "destination": {
          "nets": [
            "198.51.100.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "layer 7 rule 3"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "destination": {
          "nets": [
            "10.10.30.0/24",
            "172.16.40.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "ot cell isolated"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "10.10.30.0/24",
            "172.16.40.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "ot no internet"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
        }
      }
    ],
    "egress": [
      {
        "action": "Deny",
        "protocol": "TCP",
        "destination": {
          "ports": [
            23
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "layer 7 rule 2"
          }
        }
      },
      {
        "action": "Deny",
        "protocol": "UDP",
        "destination": {
          "ports": [
            23
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "layer 7 rule 2"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "destination": {
          "nets": [
            "198.51.100.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "layer 7 rule 3"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "destination": {
          "nets": [
            "10.10.30.0/24",
            "172.16.40.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "ot cell isolated"
          }
        }
      },
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "10.10.30.0/24",
            "172.16.40.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "ot no internet"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
        }
      }
    ]
  }
}
