# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
address-object FWS_nothing 0.0.0.0
service-object FWS_HTTP tcp eq 80
service-object FWS_HTTPS tcp eq 443
object-group service FWS_Web_Access
 service-object FWS_HTTP
 service-object FWS_HTTPS
exit
service-object FWS_tcp_53 tcp eq 53
service-object FWS_udp_53 udp eq 53
object-group service FWS_DNS
 service-object FWS_tcp_53
 service-object FWS_udp_53
exit
object-group service FWS_LAN_to_Internet_web_svc
 object-group FWS_Web_Access
 object-group FWS_DNS
exit
address-object FWS_lan-net 10.10.0.0/15
service-object FWS_SSH tcp eq 22
service-object FWS_PING icmp 8
object-group service FWS_Admins_to_DMZ_svc
 service-object FWS_SSH
 service-object FWS_PING
exit
address-object FWS_admin-range 10.10.5.10-10.10.5.20
address-object FWS_web-1 10.20.0.10
address-object FWS_mail-1 10.20.0.25
object-group address FWS_dmz-servers
 address-object FWS_web-1
 address-object FWS_mail-1
exit
address-object FWS_not_mail-1_1 0.0.0.0-10.20.0.24
address-object FWS_not_mail-1_2 10.20.0.26-255.255.255.255
object-group address FWS_not_mail-1
 address-object FWS_not_mail-1_1
 address-object FWS_not_mail-1_2
exit
address-object FWS_10_10_0_0-10_10_5_9 10.10.0.0-10.10.5.9
address-object FWS_10_10_5_21-10_11_255_255 10.10.5.21-10.11.255.255
object-group address FWS_LAN_SSH_out-2_src
 address-object FWS_10_10_0_0-10_10_5_9
 address-object FWS_10_10_5_21-10_11_255_255
exit
service-object FWS_tcp-25 tcp eq 25
service-object FWS_MODBUS tcp eq 502
address-object FWS_plc-net 10.30.1.0/24
address-object FWS_scada-server 10.10.7.15
service-object FWS_noservice protocol 255
service-object FWS_tcp_8080 tcp eq 8080
service-object FWS_tcp_8443 tcp eq 8443
service-object FWS_tcp_9000_9010 tcp range 9000 9010
object-group service FWS_app-ports
 service-object FWS_tcp_8080
 service-object FWS_tcp_8443
 service-object FWS_tcp_9000_9010
exit
object-group service FWS_basic-net
 object-group FWS_DNS
 service-object FWS_PING
exit
address-object FWS_10_10_0_53 10.10.0.53
address-object FWS_10_11_0_53 10.11.0.53
object-group address FWS_dns-servers
 address-object FWS_10_10_0_53
 address-object FWS_10_11_0_53
exit
service-object FWS_GRE protocol 47
service-object FWS_TIMESTAMP icmp 13
object-group service FWS_Old_test_rule_svc
 service-object FWS_GRE
 service-object FWS_TIMESTAMP
exit
service-object FWS_PING6 icmpv6 128
object-group service FWS_LAN6_to_Internet_svc
 object-group FWS_Web_Access
 service-object FWS_PING6
exit
address6-object FWS_lan6-net 2001:db8:10::/48
address-object FWS_mail-public 198.51.100.25
address-object FWS_partner-net 10.99.0.0/16
object-group service FWS_NAT_of_LAN_to_Internet_web_
 object-group FWS_Web_Access
 object-group FWS_DNS
exit
zone FWS_OT
exit
zone FWS_VPN
exit
secure-policy insert 1
 name FWS_Block_countries
 no activate
 description "Geo block"
 from WAN
 sourceip FWS_nothing
 action deny
 log
exit
secure-policy insert 2
 name FWS_LAN_to_Internet_web
 no activate
 description "Browsing, with a linked NAT rule"
 from LAN
 to WAN
 sourceip FWS_lan-net
 service FWS_LAN_to_Internet_web_svc
 action allow
 log
 activate
exit
secure-policy insert 3
 name FWS_LAN_web_again
 no activate
 description "Never matches: the rule above takes it"
 from LAN
 to WAN
 sourceip FWS_lan-net
 service FWS_HTTP
 action allow
 no log
 activate
exit
