ip virtual-server FWS_Publish_web interface Port2 original-ip 198.51.100.10 map-to 10.20.0.10 map-type port protocol tcp original-port 443 mapped-port 443
ip virtual-server FWS_Publish_mail interface Port2 original-ip 198.51.100.25 map-to 10.20.0.25 map-type port protocol tcp original-port 2525 mapped-port 25
policy insert 1
 deactivate
 description "FWShift Mail server out"
 source FWS_mail-1
 destination any
 service any
 next-hop auto
 snat pool FWS_mail-public
 no deactivate
exit
policy insert 2
 deactivate
 description "FWShift No NAT to partner"
 source FWS_lan-net
 destination FWS_partner-net
 service any
 next-hop auto
 no deactivate
exit
policy insert 3
 deactivate
 description "FWShift NAT of LAN to Internet web"
 interface Port1
 source FWS_lan-net
 destination any
 service FWS_NAT_of_LAN_to_Internet_web_
 next-hop auto
 snat outgoing-interface
 no deactivate
exit
policy insert 4
 deactivate
 description "FWShift NAT of LAN to Internet web"
 interface Port3
 source FWS_lan-net
 destination any
 service FWS_NAT_of_LAN_to_Internet_web_
 next-hop auto
 snat outgoing-interface
 no deactivate
exit
policy insert 5
 deactivate
 description "FWShift Default SNAT IPv4"
 source any
 destination any
 service any
 next-hop auto
 snat outgoing-interface
 no deactivate
exit
exit
# Put the interfaces in their zones (this changes traffic at once):
#   zone LAN / interface Port1
#   zone LAN / interface Port3
#   zone WAN / interface Port2
#   zone DMZ / interface Port4
#   zone FWS_OT / interface Port5
#   zone FWS_VPN: no interface is known
# Written inactive:
#   Block countries: references 'Blocked countries': country group
#   OT to SCADA: service syslog-from-high: source ports, an ICMP code, SCTP ports or protocol 0, which a service object cannot say
#   DMZ updates: 'update-sites' holds members only its platform knows
#   Finance to app: source user match Finance is not converted
#   DNS in office hours: schedule 'Work hours (5 Day week)' is not converted; the rule would apply at all times
