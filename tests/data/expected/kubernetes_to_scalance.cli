configure terminal
firewall
service name FWS_tcp-50051 proto tcp src all dst port 50051
service name FWS_tcp_53 proto tcp src all dst port 53
service name FWS_udp_53 proto udp src all dst port 53
service name FWS_tcp-443 proto tcp src all dst port 443
service name FWS_tcp-5432 proto tcp src all dst port 5432
service name FWS_tcp-8080 proto tcp src all dst port 8080
service name FWS_tcp-8081 proto tcp src all dst port 8081
service name FWS_tcp-9100 proto tcp src all dst port 9100
service name FWS_tcp_8443 proto tcp src all dst port 8443
service name FWS_tcp_9000-9010 proto tcp src all dst range 9000 - 9010
service name FWS_tcp-9090 proto tcp src all dst port 9090
exit
end
