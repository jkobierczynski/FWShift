# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
address-object FWS_Bad_Net_One 203.0.113.0/25
address-object FWS_Bad_Host 192.0.2.66
object-group address FWS_Bad_Networks
 address-object FWS_Bad_Net_One
 address-object FWS_Bad_Host
exit
service-object FWS_SSH tcp eq 22
address-object FWS_Admin_PCs 10.10.5.10-10.10.5.20
service-object FWS_HTTP tcp eq 80
service-object FWS_HTTPS tcp eq 443
service-object FWS_HTTPS_Alt tcp eq 8443
object-group service FWS_Web_Services
 service-object FWS_HTTP
 service-object FWS_HTTPS
 service-object FWS_HTTPS_Alt
exit
service-object FWS_GRE_Tunnel protocol 47
address-object FWS_Web_Public 198.51.100.10
service-object FWS_SMTP_Alt tcp eq 2525
address-object FWS_Partner_Net 192.0.2.128/26
object-group address FWS_Partners
 address-object FWS_Partner_Net
 object-group FWS_Bad_Networks
exit
address-object FWS_Mail_Public 198.51.100.11
service-object FWS_Media udp range 16384 16484
address-object FWS_Web_Server 10.20.0.10
address-object FWS_Database 10.30.0.5
address-object FWS_Mail_Server 10.20.0.25
service-object FWS_noservice protocol 255
address-object FWS_nothing 0.0.0.0
address-object FWS_X0_Subnet 10.10.0.0/16
address-object FWS_Server_Range 10.30.0.0/28
address-object FWS_Server_Public 198.51.100.32/28
zone FWS_Servers
exit
zone FWS_VPN
exit
secure-policy insert 1
 name FWS_LAN_to_WAN__1
 no activate
 description "nothing to the bad networks"
 from LAN
 to WAN
 destinationip FWS_Bad_Networks
 action deny
 log
 activate
exit
