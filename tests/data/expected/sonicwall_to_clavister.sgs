add GotoRule Index=25 Name=fws_default_Servers_to_WAN SourceInterface=X3 SourceNetwork=all-nets DestinationInterface=fws_if_X1_X4 DestinationNetwork=all-nets Service=all_services RuleSet=fws_snat LogEnabled=No Comments="the default access rule of SonicOS from Servers to WAN"
