add IPRule Index=2 Name=fws_Mail_on_another_port_sat Action=SAT SourceInterface=fws_if_X1_X4 SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_Mail_Public Service=fws_SMTP_Alt SATTranslate=DestinationIP SATTranslateToIP=fws_Mail_Server SATTranslateToPort=25 LogEnabled=No Comments="Mail on another port"
