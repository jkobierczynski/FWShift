cc IPRuleSet fws_snat
add IPRule Index=1 Name=fws_Default_NAT Action=NAT SourceInterface=fws_zones SourceNetwork=fws_X0_Subnet DestinationInterface=fws_if_X1_X4 DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="Default NAT"
add IPRule Index=2 Name=fws_Servers_one_to_one_sat Action=SAT SourceInterface=fws_zones SourceNetwork=fws_Server_Range DestinationInterface=fws_if_X1_X4 DestinationNetwork=all-nets Service=all_services SATTranslate=SourceIP SATTranslateToIP=fws_Servers_one_to_one_base LogEnabled=No
add IPRule Index=3 Name=fws_Servers_one_to_one Action=Allow SourceInterface=fws_zones SourceNetwork=fws_Server_Range DestinationInterface=fws_if_X1_X4 DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="Servers one to one"
add IPRule Index=4 Name=fws_Old_admin_NAT Action=NAT SourceInterface=fws_zones SourceNetwork=fws_Admin_PCs DestinationInterface=fws_if_X1_X4 DestinationNetwork=all-nets Service=all_services NATAction=UseSenderAddress NATSenderAddress=fws_Web_Public LogEnabled=No Comments="Old admin NAT"
set IPRule 4 -disable
add IPRule Index=5 Name=fws_snat_allow Action=Allow SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
add IPRule Index=6 Name=fws_snat_allow_v6 Action=Allow SourceInterface=any SourceNetwork=all-nets6 DestinationInterface=any DestinationNetwork=all-nets6 Service=all_services LogEnabled=No
cc
