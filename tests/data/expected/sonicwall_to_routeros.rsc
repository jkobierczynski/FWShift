/interface list member add list=fws-Servers interface="X3" comment="fwshift"
/interface list add name=fws-VPN comment="fwshift"
/interface list member add list=fws-VPN interface="VPN" comment="fwshift"
/ip firewall address-list add list=fws-Bad_Networks address="203.0.113.0/25"
/ip firewall address-list add list=fws-Bad_Networks address="192.0.2.66"
/ip firewall address-list add list=fws-Partners address="192.0.2.128/26"
/ip firewall address-list add list=fws-Partners address="203.0.113.0/25"
/ip firewall address-list add list=fws-Partners address="192.0.2.66"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-WAN dst-address-list=fws-Bad_Networks action=reject comment="LAN to WAN #1"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-WAN src-address=10.10.5.10-10.10.5.20 protocol=tcp dst-port=22 action=accept comment="Admins out by SSH"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-WAN protocol=tcp dst-port=80,443,8443 action=accept comment="LAN to WAN #3"
# disabled in the source: "LAN to WAN #4" from LAN to WAN; source 0.0.0.0/0; destination 0.0.0.0/0; service GRE Tunnel; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-WAN protocol=gre action=accept comment="LAN to WAN #4" disabled=yes
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-WAN action=accept comment="LAN to WAN #5"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-WAN out-interface-list=fws-DMZ dst-address=10.20.0.10 protocol=tcp dst-port=443 action=accept comment="Web server from the internet"
