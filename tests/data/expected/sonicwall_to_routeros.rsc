# FWSHIFT disabled, see the report: "Administrators to the DMZ" from LAN to DMZ; source 0.0.0.0/0; destination 0.0.0.0/0; service any; action allow
# FWSHIFT disabled, see the report: "Updates in working hours" from Servers to WAN; source 0.0.0.0/0; destination Update Site; service HTTPS; action allow
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-WAN action=accept comment="IPv6 out"
