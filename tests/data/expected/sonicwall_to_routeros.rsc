/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-WAN src-address=10.10.0.0/16 action=masquerade comment="Default NAT"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-WAN dst-address=198.51.100.10 protocol=tcp dst-port=443 action=dst-nat to-addresses=10.20.0.10 comment="Web server"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-WAN dst-address=198.51.100.11 protocol=tcp dst-port=2525 action=dst-nat to-addresses=10.20.0.25 to-ports=25 comment="Mail on another port"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-WAN src-address=10.30.0.0/28 action=src-nat to-addresses=198.51.100.32-198.51.100.47 comment="Servers one to one"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-WAN dst-address=198.51.100.32/28 action=dst-nat to-addresses=10.30.0.0-10.30.0.15 comment="Servers one to one (reflexive)"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-WAN src-address=10.10.5.10-10.10.5.20 action=src-nat to-addresses=198.51.100.10 comment="Old admin NAT" disabled=yes
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=dstnat action=jump jump-target=fwshift-dstnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
/ip firewall nat add chain=srcnat action=jump jump-target=fwshift-srcnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
