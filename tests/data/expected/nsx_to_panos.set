set address Quarantine ip-netmask 0.0.0.0/32
set address Quarantine description "FWSHIFT PLACEHOLDER, matches nothing: dynamic address group, members are not known statically"
set address n-10.10.0.0_16 ip-netmask 10.10.0.0/16
set address-group LAN static n-10.10.0.0_16
set address n-10.10.200.0_24 ip-netmask 10.10.200.0/24
set address-group Guests static n-10.10.200.0_24
set address h-10.20.0.10 ip-netmask 10.20.0.10
set address h-10.20.0.11 ip-netmask 10.20.0.11
set address-group "Web servers" static [ h-10.20.0.10 h-10.20.0.11 ]
set address n-10.20.1.0_24 ip-netmask 10.20.1.0/24
set address-group "App servers" static n-10.20.1.0_24
set address-group DMZ static [ "Web servers" "App servers" ]
set address n-10.20.2.0_24 ip-netmask 10.20.2.0/24
set address n-2001_db8_20_2___64 ip-netmask 2001:db8:20:2::/64
set address-group "DB servers" static [ n-10.20.2.0_24 n-2001_db8_20_2___64 ]
set address r-10.10.5.10-10.10.5.20 ip-range 10.10.5.10-10.10.5.20
set address-group Admins static r-10.10.5.10-10.10.5.20
set address n-10.30.1.0_24 ip-netmask 10.30.1.0/24
set address-group "OT cell" static n-10.30.1.0_24
set service DNS protocol tcp port 53
set service DNS-UDP protocol udp port 53
set service NTP.services protocol udp port 123
set service SSH protocol tcp port 22
set service HTTPS protocol tcp port 443
set service app-8443 protocol tcp port 8443
set service MySQL protocol tcp port 3306
set service Modbus protocol tcp port 502
set service FTP protocol tcp port 21
set service-group "Web all" members [ HTTPS app-8443 ]
