# Generated by FWShift - review the conversion report before loading this.
# A script for /import on RouterOS 6 or 7: /import file-name=FILE verbose=yes
# Nothing in it changes traffic until the disabled jump rules at its end are enabled (in Safe Mode).
:if ([:len [/ip firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
:if ([:len [/ipv6 firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
/interface list add name=fws-WAN comment="fwshift"
/interface list member add list=fws-WAN interface="ether1" comment="fwshift"
/interface list add name=fws-DMZ comment="fwshift"
/interface list member add list=fws-DMZ interface="vlan20-dmz" comment="fwshift"
/interface list add name=fws-LAN comment="fwshift"
/interface list member add list=fws-LAN interface="bridge-lan" comment="fwshift"
/interface list add name=fws-GUEST comment="fwshift"
/interface list member add list=fws-GUEST interface="vlan30-guest" comment="fwshift"
/ip firewall address-list add list=fws-dmz-web address="172.16.20.10"
/ip firewall address-list add list=fws-dmz-web address="172.16.20.11"
/ip firewall address-list add list=fws-mirrors address="192.0.2.80"
/ip firewall address-list add list=fws-mirrors address="updates.example.com"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
# FWSHIFT disabled, see the report: "defconf: accept in ipsec policy" from any to any; source 0.0.0.0/0; destination any; service any; action allow
# FWSHIFT disabled, see the report: "banned scanners" from any to any; source 0.0.0.0/0; destination any; service any; action drop
/ip firewall filter add chain=fwshift-forward out-interface-list=fws-DMZ src-address=192.168.10.50-192.168.10.59 dst-address-list=fws-dmz-web protocol=tcp dst-port=22 action=accept comment="ssh from the admins"
/ip firewall filter add chain=fwshift-forward out-interface-list=fws-DMZ src-address=192.168.10.50-192.168.10.59 dst-address-list=fws-dmz-web protocol=tcp dst-port=80,443,8000-8080 action=accept comment="web for everyone"
/ip firewall filter add chain=fwshift-forward out-interface-list=fws-DMZ src-address=!192.168.10.50-192.168.10.59 dst-address-list=fws-dmz-web protocol=tcp dst-port=80,443,8000-8080 action=accept comment="web for everyone-2"
/ip firewall filter add chain=fwshift-forward out-interface-list=fws-DMZ src-address=192.168.10.50-192.168.10.59 protocol=icmp icmp-options=8:0 action=accept comment="ping \"echo\" only"
/ip firewall filter add chain=fwshift-forward out-interface-list=fws-DMZ src-address=!192.168.10.50-192.168.10.59 protocol=icmp icmp-options=8:0 action=accept comment="ping \"echo\" only-2"
# disabled in the source: "old partner access" from any to DMZ; source partners; destination any; service not tcp-any; action allow
/ip firewall filter add chain=fwshift-forward out-interface-list=fws-DMZ src-address=198.51.100.0/24 action=jump jump-target=fwshift-r1 comment="old partner access" disabled=yes
/ip firewall filter add chain=fwshift-r1 protocol=tcp action=return
/ip firewall filter add chain=fwshift-r1 action=accept comment="old partner access"
# disabled in the source: "old partner access-2" from any to DMZ; source partners; destination any; service tcp-0-21,23-65535; action allow
/ip firewall filter add chain=fwshift-forward out-interface-list=fws-DMZ src-address=198.51.100.0/24 protocol=tcp dst-port=0-21,23-65535 action=accept comment="old partner access-2" disabled=yes
/ip firewall filter add chain=fwshift-forward out-interface-list=fws-DMZ src-address=192.168.10.50-192.168.10.59 action=jump jump-target=fwshift-r2 comment="nothing but TCP"
/ip firewall filter add chain=fwshift-r2 protocol=tcp action=return
/ip firewall filter add chain=fwshift-r2 action=reject comment="nothing but TCP"
/ip firewall filter add chain=fwshift-forward out-interface-list=fws-DMZ src-address=!192.168.10.50-192.168.10.59 action=jump jump-target=fwshift-r3 comment="nothing but TCP-2"
/ip firewall filter add chain=fwshift-r3 protocol=tcp action=return
/ip firewall filter add chain=fwshift-r3 action=reject comment="nothing but TCP-2"
# FWSHIFT disabled, see the report: "rest of the DMZ" from any to DMZ; source admins; destination not 172.16.20.0/25; service any; action drop
# FWSHIFT disabled, see the report: "rest of the DMZ-2" from any to DMZ; source 0.0.0.0-192.168.10.49,192.168.10.60-255.255.255.255; destination not 172.16.20.0/25; service not tcp-any; action drop
# FWSHIFT disabled, see the report: "rest of the DMZ-3" from any to DMZ; source 0.0.0.0-192.168.10.49,192.168.10.60-255.255.255.255; destination not 172.16.20.0/25; service tcp-0-21,23-65535; action drop
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN dst-address-list=fws-mirrors protocol=tcp dst-port=80,443 action=accept comment="LAN to the package mirrors"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-GUEST protocol=tcp dst-port=80,443 action=reject reject-with=tcp-reset comment="no other web from guests"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-GUEST out-interface-list=fws-WAN protocol=udp dst-port=53 action=accept comment="guest DNS, either port"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-GUEST out-interface-list=fws-WAN protocol=udp src-port=53 action=accept comment="guest DNS, either port-2"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-GUEST out-interface-list=fws-WAN action=accept log=yes log-prefix="guests to the internet" comment="guests to the internet"
# FWSHIFT disabled, see the report: "office hours for staff" from LAN to WAN; source 192.168.10.0/25; destination any; service any; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-GUEST action=drop log=yes log-prefix="no guests elsewhere" comment="no guests elsewhere"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-WAN dst-address=203.0.113.3 protocol=tcp dst-port=8443 action=accept comment="defconf: drop all from WAN not DSTNATed (allows publish web)"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-WAN dst-address=203.0.113.4 protocol=tcp dst-port=25 action=accept comment="defconf: drop all from WAN not DSTNATed (allows publish mail)"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-WAN action=drop comment="defconf: drop all from WAN not DSTNATed"
/ipv6 firewall filter add chain=fwshift-forward protocol=icmpv6 icmp-options=128:0-255 action=accept comment="ICMPv6 echo"
/ipv6 firewall filter add chain=fwshift-forward src-address=2001:db8:99::/48 dst-address=2001:db8:10::/64 protocol=tcp dst-port=443 action=accept comment="the partners reach the web servers of the LAN by HTTPS and nothing else"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-DMZ action=drop comment="drop everything else not coming from LAN"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-GUEST action=drop comment="drop everything else not coming from LAN"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-WAN action=drop comment="drop everything else not coming from LAN"
/ip firewall filter add chain=fwshift-forward action=accept comment="fwshift: default"
/ipv6 firewall filter add chain=fwshift-forward action=accept comment="fwshift: default"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-WAN dst-address=203.0.113.3 protocol=tcp dst-port=8443 action=dst-nat to-addresses=172.16.20.10 to-ports=443 comment="publish web"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-WAN dst-address=203.0.113.4 protocol=tcp dst-port=25 action=dst-nat to-addresses=172.16.20.11 comment="publish mail"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-WAN action=masquerade comment="defconf: masquerade"
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=dstnat action=jump jump-target=fwshift-dstnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
/ip firewall nat add chain=srcnat action=jump jump-target=fwshift-srcnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
