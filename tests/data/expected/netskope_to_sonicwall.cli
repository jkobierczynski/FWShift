address-group ipv4 "src Not from the server networks"
    address-object ipv4 "r 0.0.0.0-10.20.9.255"
    address-object ipv4 "r 10.20.11.128-255.255.255.255"
    exit
service-object "HTTPS 2" TCP 443 443
service-object "DNS tcp 53" TCP 53 53
service-object "DNS udp 53" UDP 53 53
service-group "DNS"
    service-object "DNS tcp 53"
    service-object "DNS udp 53"
    exit
service-object "svc-mail tcp 587" TCP 587 587
service-object "svc-mail tcp 993" TCP 993 993
