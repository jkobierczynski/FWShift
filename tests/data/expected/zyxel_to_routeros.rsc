/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-DMZ out-interface-list=fws-DMZ action=drop comment="block intra-zone DMZ"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN1 out-interface-list=fws-WAN src-address-list=fws-ALL_INTERNAL action=accept comment="LAN1_Outgoing"
