/ip firewall filter add chain=fwshift-forward in-interface-list=fws-WAN out-interface-list=fws-DMZ dst-address=10.30.0.25 protocol=tcp dst-port=25 action=accept comment="WAN_to_Mail"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN1 out-interface-list=fws-DMZ src-address=10.10.0.50-10.10.0.59 dst-address-list=fws-SERVERS protocol=tcp dst-port=22,80,443,8080-8089,8443 action=accept comment="Admin_Mgmt"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN1 out-interface-list=fws-DMZ action=reject comment="LAN1_to_DMZ_Reject"
/ip firewall filter add chain=fwshift-forward src-address=192.0.2.0/24 protocol=icmp icmp-options=8:0-255 action=accept comment="Monitor_Ping"
# disabled in the source: "Old_Rule" from LAN1 to LAB; source 0.0.0.0/0; destination 0.0.0.0/0; service GRE; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN1 out-interface-list=fws-LAB protocol=gre action=accept comment="Old_Rule" disabled=yes
# FWSHIFT disabled, see the report: "Alice_Workhours" from LAN1 to WAN; source 0.0.0.0/0; destination 0.0.0.0/0; service HTTPS; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN1 out-interface-list=fws-WAN protocol=udp dst-port=53 src-port=1024-65535 action=accept comment="DNS_From_Port"
# FWSHIFT disabled, see the report: "Country_Block" from WAN to any; source COUNTRY_X; destination 0.0.0.0/0; service any; action drop
