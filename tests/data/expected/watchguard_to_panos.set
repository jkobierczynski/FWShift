set address Web-Server.1.alm ip-netmask 10.20.0.10
set address Mail-Server.1.alm ip-netmask 10.20.0.25
set address Admins.1.alm ip-range 10.10.5.10-10.10.5.20
set address Bad-Nets.1.alm ip-netmask 203.0.113.0/25
set address Bad-Nets.2.alm ip-netmask 192.0.2.66
set address "Update-Site.1.alm updates.example.com" fqdn updates.example.com
set address Web-Public.1.snat ip-netmask 198.51.100.10
set address Web-Public.2.snat ip-netmask 10.20.0.10
set address Mail-Public.1.snat ip-netmask 198.51.100.11
set address Mail-Public.2.snat ip-netmask 10.20.0.25
set address-group Update-Site.1.alm static "Update-Site.1.alm updates.example.com"
set address h-198.51.100.2 ip-netmask 198.51.100.2
set address h-10.10.0.1 ip-netmask 10.10.0.1
set address h-10.20.0.1 ip-netmask 10.20.0.1
set address h-10.30.0.1 ip-netmask 10.30.0.1
set address h-10.40.0.1 ip-netmask 10.40.0.1
set address-group Firebox static [ h-198.51.100.2 h-10.10.0.1 h-10.20.0.1 h-10.30.0.1 h-10.40.0.1 ]
set address-group Firebox description "the addresses of the interfaces of the Firebox"
set service SSH protocol tcp port 22
set service "Web Out" protocol tcp port 80,443,8000-8010
set service HTTPS protocol tcp port 443
set service SMTP protocol tcp port 25
set service "Staff Only" protocol tcp port 3389
set service DNS-tcp protocol tcp port 53
set service DNS-udp protocol udp port 53
set service-group DNS members [ DNS-tcp DNS-udp ]
set rulebase security rules "Block Bad" from [ Trusted Guests ]
set rulebase security rules "Block Bad" to any
set rulebase security rules "Block Bad" source any
set rulebase security rules "Block Bad" destination [ Bad-Nets.1.alm Bad-Nets.2.alm ]
