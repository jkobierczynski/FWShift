# Generated by FWShift - review the conversion report before loading this.
# FORWARD chain and nat table for iptables-restore.
# It does not contain INPUT or OUTPUT: load it with --noflush, or merge it into your ruleset.
*filter
:FORWARD DROP [0:0]
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
# FWSHIFT disabled, see the report: "Banned by fail2ban" from any to any; source 0.0.0.0/0; destination any; service any; action drop
-A FORWARD -s 192.0.2.128/25 -m comment --comment "Block bad hosts" -j DROP
-A FORWARD -s 198.51.100.66/32 -m comment --comment "Block bad hosts" -j DROP
-A FORWARD -i eth1 -o eth0 -s 10.10.200.0/24 -m comment --comment "Guests stay in" -j DROP
-A FORWARD -i eth1 -o eth0 -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -m comment --comment "LAN web" -j ACCEPT
-A FORWARD -i eth1 -o eth0 -p tcp -m tcp --dport 53 -m conntrack --ctstate NEW -m comment --comment "LAN DNS" -j ACCEPT
-A FORWARD -i eth1 -o eth0 -p udp -m udp --dport 53 -m conntrack --ctstate NEW -m comment --comment "LAN DNS" -j ACCEPT
# FWSHIFT disabled, see the report: "Rate limited mail" from eth1 to eth0; source any; destination any; service tcp-25; action allow
-A FORWARD -i eth1 -o eth0 -p 47 -m conntrack --ctstate NEW -m comment --comment "Partner tunnel" -j ACCEPT
-A FORWARD -i eth1 -o eth2 -m iprange --src-range 10.10.5.10-10.10.5.20 -d 10.20.0.0/24 -p tcp -m multiport --dports 22,3389 -m conntrack --ctstate NEW -m comment --comment "Admins" -j ACCEPT
-A FORWARD -i eth1 -o eth2 -p icmp -m icmp --icmp-type 8 -m conntrack --ctstate NEW -m comment --comment "Ping the DMZ" -j ACCEPT
-A FORWARD -i eth1 -o eth3 -s 10.10.7.15/32 -d 10.30.1.0/24 -p tcp -m tcp --dport 502 -m conntrack --ctstate NEW -m comment --comment "SCADA to PLCs" -j ACCEPT
-A FORWARD -i eth3 -o eth0 -m comment --comment "OT no internet" -j REJECT
-A FORWARD -i eth0 -o eth2 -d 10.20.0.10/32 -p tcp -m tcp --dport 8443 -m conntrack --ctstate NEW -m comment --comment "Inbound web" -j ACCEPT
-A FORWARD -i eth0 -o eth2 -d 10.20.0.25/32 -p tcp -m tcp --dport 25 -m conntrack --ctstate NEW -m comment --comment "Inbound mail" -j ACCEPT
-A FORWARD -i eth2 -o eth0 ! -d 10.0.0.0/8 -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -m comment --comment "DMZ updates" -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i eth0 -d 203.0.113.10/32 -p tcp -m tcp --dport 443 -m comment --comment "Web DNAT" -j DNAT --to-destination 10.20.0.10:8443
-A PREROUTING -i eth0 -d 203.0.113.25/32 -m comment --comment "Mail DNAT" -j DNAT --to-destination 10.20.0.25
-A POSTROUTING -o eth0 -s 10.10.0.0/16 -d 10.99.0.0/16 -m comment --comment "No NAT to partner" -j ACCEPT
-A POSTROUTING -o eth0 -s 10.20.0.0/24 -m comment --comment "DMZ out" -j SNAT --to-source 198.51.100.20-198.51.100.23
-A POSTROUTING -o eth0 -s 10.10.0.0/16 -m comment --comment "LAN out" -j MASQUERADE
COMMIT
