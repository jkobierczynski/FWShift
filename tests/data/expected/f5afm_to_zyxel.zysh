# Put the interfaces in their zones (this changes traffic at once):
#   zone FWS_external / interface external
#   zone FWS_internal / interface internal
#   zone FWS_dmz / interface dmz
# Written inactive:
#   global/office_ssh@vs_outbound: schedule 'office_hours' is not converted; the rule would apply at all times
#   global/partners_in@vs_web6: references 'partners': contains 'geo:NL' (the geolocation NL (a country or region), which FWShift cannot write as addresses)
#   global/partners_in@vs_web: references 'partners': contains 'geo:NL' (the geolocation NL (a country or region), which FWShift cannot write as addresses)
#   global/partners_in@vs_web_http: references 'partners': contains 'geo:NL' (the geolocation NL (a country or region), which FWShift cannot write as addresses)
#   global/partners_in@vs_inbound_dmz: references 'partners': contains 'geo:NL' (the geolocation NL (a country or region), which FWShift cannot write as addresses)
#   global/partners_in@vs_outbound: references 'partners': contains 'geo:NL' (the geolocation NL (a country or region), which FWShift cannot write as addresses)
