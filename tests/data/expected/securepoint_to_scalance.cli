configure terminal
firewall
service name FWS_tcp_80 proto tcp src all dst port 80
service name FWS_tcp_443 proto tcp src all dst port 443
service name FWS_udp_53 proto udp src all dst port 53
icmp name FWS_icmp_8_0 type 8 code 0 ver ipv4
service name FWS_tcp_21 proto tcp src all dst port 21
service name FWS_ntp-client proto udp src range 1024 - 65535 dst port 123
icmp name FWS_icmpv6-echo type 128 code 0 ver ipv6
service name FWS_extern-https proto tcp src all dst port 8443
service name FWS_smtp proto tcp src all dst port 25
service name FWS_ssh proto tcp src all dst port 22
service name FWS_app-ports proto tcp src all dst range 8000 - 8010
proto name FWS_gre num 47
ipv4rule from internal to external srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_tcp_80 log info prior 1
ipv4rule from internal to external srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_tcp_443 log info prior 1
ipv4rule from internal to external srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_udp_53 log info prior 1
ipv4rule from internal to external srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_icmp_8_0 log info prior 1
ipv4rule from internal to external srcip 192.168.10.0/24 dstip 0.0.0.0/0 action acc service FWS_tcp_21 log info prior 1
ipv6rule from internal to external srcip 2001:db8:10::/64 dstip ::/0 action acc service FWS_tcp_80 log no prior 2
ipv6rule from internal to external srcip 2001:db8:10::/64 dstip ::/0 action acc service FWS_tcp_443 log no prior 2
ipv4rule from vpn-ipsec to internal srcip 10.20.0.0/16 dstip 192.168.10.0/24 action acc log no prior 2
ipv4rule from internal to external srcip 192.168.10.50 dstip 0.0.0.0/0 action acc service FWS_icmp_8_0 log no prior 2
ipv4rule from internal to dmz1 srcip 192.168.10.50 dstip 0.0.0.0/0 action acc service FWS_icmp_8_0 log no prior 2
ipv4rule from internal to vpn-ipsec srcip 192.168.10.50 dstip 0.0.0.0/0 action acc service FWS_icmp_8_0 log no prior 2
ipv6rule from internal to external srcip 2001:db8:10::/64 dstip ::/0 action acc service FWS_icmpv6-echo log no prior 2
ipv4rule from external to dmz1 srcip 0.0.0.0/0 dstip 172.16.20.10 action drop service FWS_tcp_443 log no prior 3
ipv4rule from external to dmz1 srcip 0.0.0.0/0 dstip 203.0.113.2 action drop service FWS_tcp_443 log no prior 3
ipv4rule from external to dmz1 srcip 0.0.0.0/0 dstip 203.0.113.2 action acc service FWS_extern-https log info prior 4
ipv4rule from external to dmz1 srcip 0.0.0.0/0 dstip 203.0.113.5 action acc service FWS_smtp log no prior 5
ipv4rule from internal to dmz1 srcip 192.168.10.50 dstip 172.16.20.10 action acc service FWS_ssh log info prior 6
ipv4rule from internal to dmz1 srcip 192.168.10.50 dstip 172.16.20.25 action acc service FWS_ssh log info prior 6
ipv4rule from vpn-ipsec to dmz1 srcip 10.20.0.0/16 dstip 172.16.20.10 action acc service FWS_ssh log info prior 6
ipv4rule from vpn-ipsec to dmz1 srcip 10.20.0.0/16 dstip 172.16.20.25 action acc service FWS_ssh log info prior 6
ipv4rule from dmz1 to external srcip 172.16.20.0/24 dstip 0.0.0.0/0 action acc log no prior 7
ipv4rule from internal to dmz1 srcip 192.168.10.0/24 dstip 172.16.20.0/24 action acc service FWS_app-ports log no prior 7
ipv4rule from internal to external srcip 192.168.10.200-192.168.10.220 dstip 0.0.0.0/0 action drop log no prior 8
ipv4rule from internal to dmz1 srcip 192.168.10.0/24 dstip 172.16.20.25 action drop service FWS_smtp log no prior 8
ipv4rule from external to internal srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from external to internal srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from external to dmz1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from external to dmz1 srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from external to vpn-ipsec srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from external to vpn-ipsec srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from internal to external srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from internal to external srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from internal to dmz1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from internal to dmz1 srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from internal to vpn-ipsec srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from internal to vpn-ipsec srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from dmz1 to external srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from dmz1 to external srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from dmz1 to internal srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from dmz1 to internal srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from dmz1 to vpn-ipsec srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from dmz1 to vpn-ipsec srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from vpn-ipsec to external srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from vpn-ipsec to external srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from vpn-ipsec to internal srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from vpn-ipsec to internal srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from vpn-ipsec to dmz1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from vpn-ipsec to dmz1 srcip ::/0 dstip ::/0 action drop log no prior 8
exit
firewallnat
src-nat srcint dmz1 dstint external type ipv4 srcip 172.16.20.0/24 dstip 0.0.0.0/0 transip auto
exit
end
