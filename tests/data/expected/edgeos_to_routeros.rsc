# Generated by FWShift - review the conversion report before loading this.
# A script for /import on RouterOS 6 or 7: /import file-name=FILE verbose=yes
# Nothing in it changes traffic until the disabled jump rules at its end are enabled (in Safe Mode).
:if ([:len [/ip firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
:if ([:len [/ipv6 firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
/interface list add name=fws-pppoe0 comment="fwshift"
/interface list member add list=fws-pppoe0 interface="pppoe0" comment="fwshift"
/interface list add name=fws-eth1 comment="fwshift"
/interface list member add list=fws-eth1 interface="eth1" comment="fwshift"
/interface list add name=fws-eth1.10 comment="fwshift"
/interface list member add list=fws-eth1.10 interface="eth1.10" comment="fwshift"
/ip firewall address-list add list=fws-NAS address="192.168.1.20"
/ip firewall address-list add list=fws-NAS address="192.168.1.21"
/ip firewall address-list add list=fws-TRUSTED address="192.168.1.0/25"
/ip firewall address-list add list=fws-TRUSTED address="10.8.0.0/24"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-pppoe0 out-interface-list=fws-eth1 src-address=192.168.10.0/24 dst-address=192.168.1.30 protocol=tcp dst-port=32400 action=reject comment="no media from the guests"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-pppoe0 dst-address=192.168.1.30 protocol=tcp dst-port=32400 action=accept comment="plex to the media box"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-pppoe0 dst-address-list=fws-NAS protocol=icmp icmp-options=8:0-255 action=accept comment="ping the nas"
# disabled in the source: "old rule" from pppoe0 to any; source any; destination 192.168.1.40; service tcp-any; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-pppoe0 dst-address=192.168.1.40 protocol=tcp action=accept comment="old rule" disabled=yes
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-pppoe0 dst-address=192.168.1.25 protocol=tcp dst-port=25 action=accept comment="syn to the mail server"
# FWSHIFT disabled, see the report: "no media from the guests-2" from pppoe0 to eth1; source 192.168.10.0/24; destination any; service tcp-8096-8097,32400+udp-8096-8097,32400; action deny
# FWSHIFT disabled, see the report: "sessions of the voip box" from pppoe0 to any; source 0.0.0.0/0; destination any; service any; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-pppoe0 action=drop comment="forward-5.default"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1.10 dst-address-list=fws-TRUSTED action=drop log=yes log-prefix="no way into the LAN" comment="no way into the LAN"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1.10 protocol=tcp dst-port=0-52,54-79,81-442,444-65535 action=drop comment="only web and dns out"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-eth1.10 protocol=udp dst-port=0-52,54-79,81-442,444-65535 action=drop comment="only web and dns out"
/ip firewall filter add chain=fwshift-forward out-interface-list=fws-eth1 src-address=192.168.10.0/24 protocol=tcp dst-port=8096-8097,32400 action=reject comment="no media from the guests-3"
/ip firewall filter add chain=fwshift-forward out-interface-list=fws-eth1 src-address=192.168.10.0/24 protocol=udp dst-port=8096-8097,32400 action=reject comment="no media from the guests-3"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-pppoe0 protocol=icmpv6 icmp-options=128:0-255 action=accept comment="Allow IPv6 ping"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-pppoe0 action=drop comment="ipv6-forward-5.default"
/ip firewall filter add chain=fwshift-forward action=accept comment="fwshift: default"
/ipv6 firewall filter add chain=fwshift-forward action=accept comment="fwshift: default"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-pppoe0 protocol=tcp dst-port=32400 action=dst-nat to-addresses=192.168.1.30 comment="plex from outside"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-pppoe0 dst-address=198.51.100.7 protocol=tcp dst-port=8443 action=dst-nat to-addresses=192.168.1.20 to-ports=443 comment="web on 8443 to the nas"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-pppoe0 src-address=192.168.1.20 action=src-nat to-addresses=198.51.100.7 comment="nas leaves as its own address"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-pppoe0 action=masquerade comment="masquerade for WAN"
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=dstnat action=jump jump-target=fwshift-dstnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
/ip firewall nat add chain=srcnat action=jump jump-target=fwshift-srcnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
