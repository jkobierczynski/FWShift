configure terminal
address-object ipv4 "LAN1_SUBNET" network 10.10.0.0 255.255.255.0 zone LAN1
address-object ipv4 "LAN2_SUBNET" network 10.20.0.0 255.255.255.0 zone LAN1
address-object ipv4 "LAB_SUBNET" host 192.0.0.8 zone LAB
address-object ipv4 "WAN_IP" host 198.51.100.2 zone DMZ
address-object ipv4 "WEB_SRV" host 10.30.0.10 zone LAN1
address-object ipv4 "MAIL_SRV" host 10.30.0.25 zone LAN1
address-object ipv4 "ADMIN_PCS" range 10.10.0.50 10.10.0.59 zone LAN1
address-object ipv4 "PARTNER_NET" network 203.0.113.0 255.255.255.128 zone WAN
address-object ipv4 "MONITOR" network 192.0.2.0 255.255.255.0 zone DMZ
address-object ipv4 "PUBLIC_WEB" host 198.51.100.10 zone DMZ
address-object ipv4 "PUBLIC_RANGE" range 198.51.100.20 198.51.100.23 zone DMZ
address-object ipv4 "INSIDE_RANGE" range 10.30.0.20 10.30.0.23 zone DMZ
address-object fqdn "PORTAL" domain "portal.example.com" zone WAN
address-object ipv4 "COUNTRY_X" host 192.0.0.8 zone WAN
address-object ipv6 "V6_LAN" network 2001:db8:10:: /64 zone LAN1
address-object ipv6 "V6_DMZ_WEB" host 2001:db8:30::10 zone DMZ
address-object ipv6 "V6_ADMIN" range 2001:db8:10::50 2001:db8:10::59 zone LAN1
address-object ipv4 "n 0.0.0.0_1" network 0.0.0.0 128.0.0.0 zone DMZ
address-object ipv4 "n 128.0.0.0_1" network 128.0.0.0 128.0.0.0 zone DMZ
address-object ipv6 "n ::_1" network :: /1 zone DMZ
address-object ipv6 "n 8000::_1" network 8000:: /1 zone DMZ
address-object ipv4 "h 198.51.100.11" host 198.51.100.11 zone DMZ
address-object ipv4 "h 10.30.0.12" host 10.30.0.12 zone DMZ
address-object ipv4 "h 10.30.0.30" host 10.30.0.30 zone DMZ
address-object ipv4 "h 198.51.100.30" host 198.51.100.30 zone DMZ
address-object ipv4 "h 198.51.100.40" host 198.51.100.40 zone DMZ
address-object ipv4 "h 10.30.0.40" host 10.30.0.40 zone DMZ
address-group ipv4 "SERVERS"
    address-object ipv4 "WEB_SRV"
    address-object ipv4 "MAIL_SRV"
    exit
address-group ipv4 "ALL_INTERNAL"
    address-object ipv4 "LAN1_SUBNET"
    address-object ipv4 "LAN2_SUBNET"
    address-object ipv4 "WEB_SRV"
    address-object ipv4 "MAIL_SRV"
    exit
address-group ipv6 "V6_ADMINS"
    address-object ipv6 "V6_ADMIN"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
address-group ipv4 "dst WAN_to_Web"
    address-object ipv4 "WEB_SRV"
    address-object ipv4 "PUBLIC_WEB"
    exit
address-group ipv4 "dst WAN_to_Mail"
    address-object ipv4 "MAIL_SRV"
    address-object ipv4 "h 198.51.100.11"
    exit
service-object "HTTP 2" TCP 80 80
service-object "HTTPS 2" TCP 443 443
service-object "SSH 2" TCP 22 22
service-object "DNS_UDP" UDP 53 53
service-object "DNS_TCP" TCP 53 53
service-object "SMTP" TCP 25 25
service-object "WEB_ALT" TCP 8080 8089
service-object "HTTPS_8443" TCP 8443 8443
service-object "Any_TCP" TCP 1 65535
service-object "udp-5060" UDP 5060 5060
service-object "tcp 8443" TCP 8443 8443
service-group "DNS"
    service-object "DNS_UDP"
    service-object "DNS_TCP"
    exit
service-group "WEB"
    service-object "HTTP 2"
    service-object "HTTPS 2"
    service-object "WEB_ALT"
    service-object "HTTPS_8443"
    exit
service-group "MGMT"
    service-object "SSH 2"
    service-group "WEB"
    exit
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "PUBLIC_WEB" translated-destination name "WEB_SRV" service name "HTTPS 2" translated-service name "tcp 8443"
    name "virtual-server WEB_VS"
    comment "ip virtual-server WEB_VS interfa"
    priority manual 1
    exit
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "h 198.51.100.11" translated-destination name "MAIL_SRV" service name "SMTP" translated-service original
    name "virtual-server MAIL_VS"
    comment "ip virtual-server MAIL_VS interf"
    priority manual 2
    exit
nat-policy ipv4 inbound any outbound any source any translated-source original destination any translated-destination name "h 10.30.0.12" service name "WEB_ALT" translated-service original
    name "virtual-server ALT_VS"
    comment "ip virtual-server ALT_VS interfa"
    priority manual 3
    exit
nat-policy ipv4 inbound any outbound any source name "h 10.30.0.30" translated-source name "h 198.51.100.30" destination any translated-destination original service any translated-service original
    name "virtual-server ONE2ONE"
    comment "ip virtual-server ONE2ONE interf"
    priority manual 4
    exit
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "h 198.51.100.30" translated-destination name "h 10.30.0.30" service any translated-service original
    name "virtual-server ONE2ONE in"
    comment "inbound of virtual-server ONE2ON"
    priority manual 5
    exit
nat-policy ipv4 inbound any outbound any source name "INSIDE_RANGE" translated-source name "PUBLIC_RANGE" destination any translated-destination original service any translated-service original
    name "virtual-server MANY2ONE"
    comment "ip virtual-server MANY2ONE inter"
    priority manual 6
    exit
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "PUBLIC_RANGE" translated-destination name "INSIDE_RANGE" service any translated-service original
    name "virtual-server MANY2ONE in"
    comment "inbound of virtual-server MANY2O"
    priority manual 7
    exit
nat-policy ipv4 inbound any outbound any source any translated-source original destination name "h 198.51.100.40" translated-destination name "h 10.30.0.40" service name "udp-5060" translated-service original
    name "virtual-server OLD_VS"
    comment "ip virtual-server OLD_VS interfa"
    priority manual 8
    no enable
    exit
nat-policy ipv4 inbound any outbound any source group "SERVERS" translated-source name "PUBLIC_RANGE" destination any translated-destination original service any translated-service original
    name "policy-route 3"
    comment "DMZ out with a pool"
    priority manual 9
    exit
access-rule ipv4 from DMZ to DMZ action discard source address group "FWSHIFT all IPv4" service any destination address any
    name "block intra-zone DMZ"
    priority manual 1
    exit
access-rule ipv4 from LAN1 to WAN action allow source address group "ALL_INTERNAL" service any destination address any
    name "LAN1_Outgoing"
    priority manual 2
    exit
