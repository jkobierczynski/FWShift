# FORWARD chain and nat table for iptables-restore.
# It does not contain INPUT or OUTPUT: load it with --noflush, or merge it into your ruleset.
*filter
:FORWARD DROP [0:0]
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
-A FORWARD -i Trusted -d 203.0.113.0/25 -m comment --comment "Block Bad" -j REJECT
-A FORWARD -i Trusted -d 192.0.2.66/32 -m comment --comment "Block Bad" -j REJECT
-A FORWARD -i Guests -d 203.0.113.0/25 -m comment --comment "Block Bad" -j REJECT
-A FORWARD -i Guests -d 192.0.2.66/32 -m comment --comment "Block Bad" -j REJECT
-A FORWARD -i Trusted -o External -m iprange --src-range 10.10.5.10-10.10.5.20 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "Admin SSH" -j ACCEPT
-A FORWARD -i Trusted -o External -p tcp -m multiport --dports 80,443,8000:8010 -m conntrack --ctstate NEW -m comment --comment "Web Out" -j ACCEPT
-A FORWARD -i Guests -o External -p tcp -m multiport --dports 80,443,8000:8010 -m conntrack --ctstate NEW -m comment --comment "Web Out" -j ACCEPT
-A FORWARD -i DMZ -o External -p tcp -m multiport --dports 80,443,8000:8010 -m conntrack --ctstate NEW -m comment --comment "Web Out" -j ACCEPT
-A FORWARD -i External -d 10.20.0.10/32 -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -m comment --comment "Web In" -j ACCEPT
-A FORWARD -i External -d 10.20.0.25/32 -p tcp -m tcp --dport 2525 -m conntrack --ctstate NEW -m comment --comment "Mail In" -j ACCEPT
# FWSHIFT disabled, see the report: "DMZ Updates" from DMZ to any; source any; destination Update-Site.1.alm; service HTTPS; action allow
# disabled in the source: "Guests Out" from Guests to External; source any; destination any; service DNS; action allow
# FWSHIFT disabled, see the report: "Staff Only" from Trusted to any; source any; destination Web-Server.1.alm; service Staff Only; action allow
-A FORWARD -i Trusted -p icmp -m icmp --icmp-type 8 -m conntrack --ctstate NEW -m comment --comment "Ping" -j ACCEPT
-A FORWARD -i Guests -p icmp -m icmp --icmp-type 8 -m conntrack --ctstate NEW -m comment --comment "Ping" -j ACCEPT
-A FORWARD -i Lab -o External -p 47 -m conntrack --ctstate NEW -m comment --comment "Lab Tunnel" -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i External -d 198.51.100.10/32 -p tcp -m tcp --dport 443 -m comment --comment "Web-Public (Web In)" -j DNAT --to-destination 10.20.0.10
-A PREROUTING -i External -d 198.51.100.11/32 -p tcp -m tcp --dport 25 -m comment --comment "Mail-Public (Mail In)" -j DNAT --to-destination 10.20.0.25:2525
COMMIT
