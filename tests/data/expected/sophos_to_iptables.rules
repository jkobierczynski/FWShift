# Generated by FWShift - review the conversion report before loading this.
# FORWARD chain and nat table for iptables-restore.
# It does not contain INPUT or OUTPUT: load it with --noflush, or merge it into your ruleset.
*filter
:FORWARD DROP [0:0]
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
# FWSHIFT disabled, see the report: "Block countries" from WAN to any; source Blocked countries; destination 0.0.0.0/0; service any; action drop
-A FORWARD -i LAN -o WAN -s 10.10.0.0/15 -p tcp -m multiport --dports 80,443,53 -m conntrack --ctstate NEW -m comment --comment "LAN to Internet web" -j ACCEPT
-A FORWARD -i LAN -o WAN -s 10.10.0.0/15 -p udp -m udp --dport 53 -m conntrack --ctstate NEW -m comment --comment "LAN to Internet web" -j ACCEPT
-A FORWARD -i LAN -o WAN -s 10.10.0.0/15 -p tcp -m tcp --dport 80 -m conntrack --ctstate NEW -m comment --comment "LAN web again" -j ACCEPT
-A FORWARD -i LAN -o DMZ -m iprange --src-range 10.10.5.10-10.10.5.20 -d 10.20.0.10/32 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "Admins to DMZ" -j ACCEPT
-A FORWARD -i LAN -o DMZ -m iprange --src-range 10.10.5.10-10.10.5.20 -d 10.20.0.10/32 -p icmp -m icmp --icmp-type 8 -m conntrack --ctstate NEW -m comment --comment "Admins to DMZ" -j ACCEPT
-A FORWARD -i LAN -o DMZ -m iprange --src-range 10.10.5.10-10.10.5.20 -d 10.20.0.25/32 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "Admins to DMZ" -j ACCEPT
-A FORWARD -i LAN -o DMZ -m iprange --src-range 10.10.5.10-10.10.5.20 -d 10.20.0.25/32 -p icmp -m icmp --icmp-type 8 -m conntrack --ctstate NEW -m comment --comment "Admins to DMZ" -j ACCEPT
-A FORWARD -i LAN -o DMZ -s 10.10.0.0/15 ! -d 10.20.0.25/32 -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -m comment --comment "LAN to DMZ web not mail" -j ACCEPT
-A FORWARD -i LAN -o OT -s 10.10.0.0/15 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "LAN SSH out" -j ACCEPT
-A FORWARD -i LAN -o DMZ -m iprange --src-range 10.10.0.0-10.10.5.9 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "LAN SSH out-2" -j ACCEPT
-A FORWARD -i LAN -o DMZ -m iprange --src-range 10.10.5.21-10.11.255.255 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "LAN SSH out-2" -j ACCEPT
-A FORWARD -i LAN -o OT -m iprange --src-range 10.10.0.0-10.10.5.9 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "LAN SSH out-2" -j ACCEPT
-A FORWARD -i LAN -o OT -m iprange --src-range 10.10.5.21-10.11.255.255 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "LAN SSH out-2" -j ACCEPT
-A FORWARD -i WAN -o DMZ -d 10.20.0.10/32 -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -m comment --comment "Internet to web" -j ACCEPT
-A FORWARD -i WAN -o DMZ -d 10.20.0.25/32 -p tcp -m tcp --dport 2525 -m conntrack --ctstate NEW -m comment --comment "Internet to mail" -j ACCEPT
-A FORWARD -i OT -o LAN -s 10.30.1.0/24 -d 10.10.7.15/32 -p tcp -m tcp --dport 502 -m conntrack --ctstate NEW -m comment --comment "OT to SCADA" -j ACCEPT
-A FORWARD -i OT -o LAN -s 10.30.1.0/24 -d 10.10.7.15/32 -p udp -m udp --dport 514 -m udp --sport 1024:65535 -m conntrack --ctstate NEW -m comment --comment "OT to SCADA" -j ACCEPT
-A FORWARD -i DMZ -o WAN -s 10.20.0.10/32 -d mirror.example.net -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -m comment --comment "DMZ updates" -j ACCEPT
-A FORWARD -i DMZ -o WAN -s 10.20.0.10/32 -d updates.example.com -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -m comment --comment "DMZ updates" -j ACCEPT
-A FORWARD -i DMZ -o WAN -s 10.20.0.25/32 -d mirror.example.net -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -m comment --comment "DMZ updates" -j ACCEPT
-A FORWARD -i DMZ -o WAN -s 10.20.0.25/32 -d updates.example.com -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -m comment --comment "DMZ updates" -j ACCEPT
# FWSHIFT disabled, see the report: "Finance to app" from LAN to DMZ; source 0.0.0.0/0; destination web-1; service app-ports; action allow
# FWSHIFT disabled, see the report: "DNS in office hours" from OT to LAN; source 0.0.0.0/0; destination dns-servers; service basic-net; action allow
# disabled in the source: "Old test rule" from any to any; source 0.0.0.0/0; destination any; service GRE,TIMESTAMP; action allow
-A FORWARD -i LAN -m comment --comment "Reject the rest from LAN" -j REJECT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i WAN -d 198.51.100.10/32 -p tcp -m tcp --dport 443 -m comment --comment "Publish web" -j DNAT --to-destination 10.20.0.10
-A PREROUTING -i WAN -d 198.51.100.25/32 -p tcp -m tcp --dport 2525 -m comment --comment "Publish mail" -j DNAT --to-destination 10.20.0.25:25
-A POSTROUTING -o WAN -s 10.20.0.25/32 -m comment --comment "Mail server out" -j SNAT --to-source 198.51.100.25
-A POSTROUTING -s 10.10.0.0/15 -d 10.99.0.0/16 -m comment --comment "No NAT to partner" -j ACCEPT
-A POSTROUTING -o WAN -s 10.10.0.0/15 -p tcp -m multiport --dports 80,443,53 -m comment --comment "NAT of LAN to Internet web" -j MASQUERADE
-A POSTROUTING -o WAN -s 10.10.0.0/15 -p udp -m udp --dport 53 -m comment --comment "NAT of LAN to Internet web" -j MASQUERADE
-A POSTROUTING -o WAN -m comment --comment "Default SNAT IPv4" -j MASQUERADE
COMMIT
