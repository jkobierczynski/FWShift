    address-object ipv4 "h 10.10.0.60"
    exit
address-group ipv6 "dual_ws v6"
    address-object ipv6 "h 2001:db8:10::60"
    exit
address-group ipv4 "dmz_servers"
    address-object ipv4 "web_srv"
    address-object ipv4 "mail_srv"
    exit
address-group ipv4 "admins"
    address-object ipv4 "admin_ws"
    address-object ipv4 "h 10.10.0.60"
    exit
address-group ipv6 "admins v6"
    address-object ipv6 "h 2001:db8:10::60"
    exit
address-group ipv4 "firewall_all"
    address-object ipv4 "Firewall_out"
    address-object ipv4 "Firewall_in"
    address-object ipv4 "Firewall_dmz1"
    address-object ipv4 "Firewall_lab"
    address-object ipv4 "Firewall_labbridge"
    exit
address-group ipv4 "Network_internals"
    address-object ipv4 "Network_in"
    address-object ipv4 "Network_dmz1"
    address-object ipv4 "Network_lab"
    address-object ipv4 "Network_labbridge"
    exit
address-group ipv4 "Internet"
    address-object ipv4 "r 0.0.0.0-10.9.255.255"
    address-object ipv4 "r 10.10.1.0-10.19.255.255"
    address-object ipv4 "r 10.20.1.0-10.29.255.255"
    address-object ipv4 "r 10.30.1.0-255.255.255.255"
    exit
address-group ipv4 "dst local 4"
    address-object ipv4 "r 0.0.0.0-10.9.255.255"
    address-object ipv4 "r 10.10.1.0-10.19.255.255"
    address-object ipv4 "r 10.20.1.0-10.29.255.255"
    address-object ipv4 "r 10.30.1.0-255.255.255.255"
    exit
address-group ipv4 "src local 13"
    address-object ipv4 "r 0.0.0.0-10.9.255.255"
    address-object ipv4 "r 10.10.1.0-255.255.255.255"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
service-object "http 2" TCP 80 80
service-object "https 2" TCP 443 443
service-object "ssh 2" TCP 22 22
service-object "dns_udp" UDP 53 53
service-object "smtp" TCP 25 25
service-object "ident" TCP 113 113
service-object "web_alt" TCP 8080 8090
service-object "syslog 2" UDP 514 514
service-object "lab_tools tcp 5000-5010" TCP 5000 5010
service-object "lab_tools udp 5000-5010" UDP 5000 5010
service-group "lab_tools"
    service-object "lab_tools tcp 5000-5010"
    service-object "lab_tools udp 5000-5010"
    exit
service-object "x(rule) dns_udp-udp" UDP 53 53
service-group "web_ports"
    service-object "http 2"
    service-object "https 2"
    service-object "web_alt"
    exit
