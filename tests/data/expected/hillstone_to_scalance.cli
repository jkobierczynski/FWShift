exit
firewallnat
napt srcint trust proto tcp type ipv4 dstip 203.0.113.10 transip 10.20.0.10 dstport 80 transport 8080
napt srcint untrust proto tcp type ipv4 dstip 203.0.113.10 transip 10.20.0.10 dstport 80 transport 8080
napt srcint dmz proto tcp type ipv4 dstip 203.0.113.10 transip 10.20.0.10 dstport 80 transport 8080
napt srcint lab proto tcp type ipv4 dstip 203.0.113.10 transip 10.20.0.10 dstport 80 transport 8080
src-nat srcint trust dstint untrust type ipv4 srcip 10.10.0.0/24 dstip 0.0.0.0/0 transip auto
src-nat srcint dmz dstint untrust type ipv4 srcip 10.10.0.0/24 dstip 0.0.0.0/0 transip auto
src-nat srcint lab dstint untrust type ipv4 srcip 10.10.0.0/24 dstip 0.0.0.0/0 transip auto
exit
end
