service name FWS_tcp_8000-8010_from_1024-6553 proto tcp src range 1024 - 65535 dst range 8000 - 8010
service name FWS_udp_5000-5001 proto udp src all dst range 5000 - 5001
proto name FWS_gre-tunnel num 47
