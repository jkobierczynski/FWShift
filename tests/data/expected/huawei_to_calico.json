{
  "apiVersion": "projectcalico.org/v3",
  "kind": "GlobalNetworkPolicy",
  "metadata": {
    "name": "fwshift",
    "annotations": {
      "fwshift/generated": "FWShift - review the conversion report before applying this",
      "fwshift/not-written": "web-in (not written, see the report); mail-in (not written, see the report); office-out (not written, see the report); office-dmz (not written, see the report); admin-ssh (not written, see the report); dmz-syslog (not written, see the report); lab-tools (not written, see the report); lab-out (not written, see the report); ping-dmz (not written, see the report); ipv6-out (not written, see the report); video (not written, see the report); old-ftp (disabled in the source); intrazone default (not written, see the report)"
    }
  },
  "spec": {
    "tier": "default",
    "order": 100,
    "selector": "fwshift/policy == 'fwshift'",
    "types": [
      "Ingress",
      "Egress"
    ],
    "ingress": [
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "198.51.100.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "block-bad-nets"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "lab-deny"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
        }
      }
    ],
    "egress": [
      {
        "action": "Deny",
        "ipVersion": 4,
        "source": {
          "nets": [
            "198.51.100.0/24"
          ]
        },
        "metadata": {
          "annotations": {
            "fwshift/rule": "block-bad-nets"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "lab-deny"
          }
        }
      },
      {
        "action": "Deny",
        "metadata": {
          "annotations": {
            "fwshift/rule": "(default of the source policy)"
          }
        }
      }
    ]
  }
}
