configure terminal
address-object ipv4 "Webserver" host 172.16.20.10 zone eth2
address-object ipv4 "Mailserver" host 172.16.20.25 zone eth2
address-object ipv4 "HMI" host 10.30.0.50 zone eth3
address-object ipv4 "Printer" host 192.0.0.8 zone WAN
address-object ipv4 "LAN" network 192.168.10.0 255.255.255.0 zone eth1
address-object ipv4 "DMZ" network 172.16.20.0 255.255.255.0 zone eth2
address-object ipv4 "OT-Cell" network 10.30.0.0 255.255.255.0 zone eth3
address-object ipv4 "Lab-v6" host 192.0.0.8 zone WAN
address-object ipv4 "Admin-PCs" range 192.168.10.200 192.168.10.220 zone eth1
address-object ipv4 "Monitoring" range 198.51.100.10 198.51.100.20 zone WAN
address-object ipv4 "h 192.168.10.5" host 192.168.10.5 zone WAN
address-object ipv4 "h 10.30.0.5" host 10.30.0.5 zone WAN
address-object ipv4 "n 0.0.0.0_1" network 0.0.0.0 128.0.0.0 zone WAN
address-object ipv4 "n 128.0.0.0_1" network 128.0.0.0 128.0.0.0 zone WAN
address-object ipv6 "n ::_1" network :: /1 zone WAN
address-object ipv6 "n 8000::_1" network 8000:: /1 zone WAN
address-group ipv4 "Servers"
    address-object ipv4 "Webserver"
    address-object ipv4 "Mailserver"
    exit
address-group ipv4 "Jump-Hosts"
    address-object ipv4 "h 192.168.10.5"
    address-object ipv4 "h 10.30.0.5"
    exit
address-group ipv4 "Jump-Hosts (eth1)"
    address-object ipv4 "h 192.168.10.5"
    exit
address-group ipv4 "Jump-Hosts (eth3)"
    address-object ipv4 "h 10.30.0.5"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
service-object "internet.http" TCP 80 80
service-object "internet.https" TCP 443 443
service-object "standard.dns tcp 53" TCP 53 53
service-object "standard.dns udp 53" UDP 53 53
service-group "standard.dns"
    service-object "standard.dns tcp 53"
    service-object "standard.dns udp 53"
    exit
service-object "standard.ssh" TCP 22 22
service-object "remote.rdp" TCP 3389 3389
service-object "internet.smtp" TCP 25 25
service-object "Modbus-TCP" TCP 502 502
service-object "OPC-UA" TCP 4840 4843
service-group "Web"
    service-object "internet.http"
    service-object "internet.https"
    exit
access-rule ipv4 from eth1 to WAN action allow source address name "LAN" service name "internet.http" destination address any
    name "LAN to Internet - internet.http"
    priority manual 1
    exit
access-rule ipv4 from eth1 to WAN action allow source address name "LAN" service name "internet.https" destination address any
    name "LAN to Internet - internet.https"
    priority manual 2
    exit
access-rule ipv4 from eth1 to WAN action allow source address name "LAN" service group "standard.dns" destination address any
    name "LAN to Internet - standard.dns"
    priority manual 3
    exit
access-rule ipv4 from eth1 to WAN action allow source address name "LAN" service any destination address any
    name "LAN to Internet - standard.ping"
    priority manual 4
    no enable
    exit
access-rule ipv4 from WAN to eth2 action allow source address any service name "internet.https" destination address name "Webserver"
    name "Internet to Webserver - internet"
    priority manual 5
    exit
access-rule ipv4 from eth1 to eth2 action allow source address name "Admin-PCs" service name "standard.ssh" destination address group "Servers"
    name "Admin-PCs to Servers - standard."
    priority manual 6
    exit
access-rule ipv4 from eth1 to eth2 action allow source address name "Admin-PCs" service name "remote.rdp" destination address group "Servers"
    name "Admin-PCs to Servers - remote.rd"
    priority manual 7
    exit
access-rule ipv4 from eth2 to eth1 action allow source address group "Servers" service name "remote.rdp" destination address name "Admin-PCs"
    name "Servers to Admin-PCs - remote.rd"
    priority manual 8
    exit
access-rule ipv4 from eth1 to eth3 action allow source address group "Jump-Hosts (eth1)" service name "Modbus-TCP" destination address name "OT-Cell"
    name "Jump-Hosts to OT-Cell - Modbus-T"
    priority manual 9
    exit
access-rule ipv4 from eth3 to eth3 action allow source address group "Jump-Hosts (eth3)" service name "Modbus-TCP" destination address name "OT-Cell"
    name "Jump-Hosts to OT-Cell - Modbus 2"
    priority manual 10
    exit
access-rule ipv4 from eth3 to eth3 action allow source address name "HMI" service name "OPC-UA" destination address name "OT-Cell"
    name "HMI to OT-Cell - OPC-UA"
    priority manual 11
    no enable
    exit
