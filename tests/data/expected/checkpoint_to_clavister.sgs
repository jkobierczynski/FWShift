set IPRule 14 -disable
add IPRule Index=15 Name=fws_DMZ_users Action=Allow SourceInterface=fws_zones SourceNetwork=fws_dmz-net DestinationInterface=fws_zones DestinationNetwork=all-nets Service=fws_https LogEnabled=Yes
set IPRule 15 -disable
add IPRule Index=16 Name=fws_Updates Action=Allow SourceInterface=any SourceNetwork=fws_nothing DestinationInterface=any DestinationNetwork=fws_nothing Service=all_services LogEnabled=Yes
set IPRule 16 -disable
add IPRule Index=17 Name=fws_Old_rule Action=Allow SourceInterface=any SourceNetwork=fws_nothing DestinationInterface=any DestinationNetwork=fws_nothing Service=all_services LogEnabled=Yes
set IPRule 17 -disable
add IPRule Index=18 Name=fws_Partners Action=Allow SourceInterface=fws_zones SourceNetwork=fws_lan-net DestinationInterface=fws_zones DestinationNetwork=fws_plc-net Service=all_services LogEnabled=Yes
set IPRule 18 -disable
add IPRule Index=19 Name=fws_IPv6_out Action=Allow SourceInterface=fws_zones SourceNetwork=fws_lan6-net DestinationInterface=fws_zones DestinationNetwork=all-nets6 Service=fws_https LogEnabled=No
add GotoRule Index=20 Name=fws_Public_web SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=fws_Public_web_dst Service=fws_https RuleSet=fws_snat LogEnabled=Yes Comments="web-1 has automatic static NAT"
add GotoRule Index=21 Name=fws_DMZ_access___Web_in SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=fws_10.20.0.10_32 Service=fws_app-ports_grp RuleSet=fws_snat LogEnabled=Yes
add GotoRule Index=22 Name=fws_DMZ_access___Mail_in SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=fws_mail-1 Service=fws_smtp RuleSet=fws_snat LogEnabled=Yes
add GotoRule Index=23 Name=fws_DMZ_access___Ping_from_LAN SourceInterface=fws_zones SourceNetwork=fws_lan-net DestinationInterface=fws_zones DestinationNetwork=fws_dmz-net Service=fws_echo-request RuleSet=fws_snat LogEnabled=No
add IPRule Index=24 Name=fws_DMZ_access__cleanup_of_DMZ-Layer_ Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=fws_dmz-net Service=all_services LogEnabled=No Comments="implicit cleanup of inline layer DMZ-Layer"
add GotoRule Index=25 Name=fws_Tunnels SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=fws_gw-edge Service=fws_gre RuleSet=fws_snat LogEnabled=Yes
add IPRule Index=26 Name=fws_No_ident Action=Reject SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=all-nets Service=fws_ident LogEnabled=Yes
add IPRule Index=27 Name=fws_No_ident_v6 Action=Reject SourceInterface=fws_zones SourceNetwork=all-nets6 DestinationInterface=fws_zones DestinationNetwork=all-nets6 Service=fws_ident LogEnabled=Yes
add IPRule Index=28 Name=fws_Cleanup_rule Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=all-nets Service=all_services LogEnabled=Yes
