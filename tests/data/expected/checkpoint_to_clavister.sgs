add Address IP4Group fws_Guests_stay_out_dst_not Members=fws_Guests_stay_out_dst_not_1,fws_Guests_stay_out_dst_not_2
add Address IP6Group fws_Guests_stay_out_dst_not_3 Members=fws_Guests_stay_out_dst_not_1_2,fws_Guests_stay_out_dst_not_2_2
add Service ServiceGroup fws_PLC_access_svc Members=fws_https,fws_ssh
add Service ServiceGroup fws_PLC_access__plc-operators__svc Members=fws_https,fws_ssh
