add Service ServiceGroup fws_app-ports_grp Members=fws_app-ports_1,fws_app-ports_2
add IPRuleSet fws_rules Comments="Written by FWShift"
add IPRuleSet fws_snat Comments="Written by FWShift"
add IPRuleSet fws_d_nat-2 Comments="Written by FWShift"
add IPRuleSet fws_d_nat-6 Comments="Written by FWShift"
cc IPRuleSet fws_snat
add IPRule Index=1 Name=fws_nat-1_sat Action=SAT SourceInterface=fws_zones SourceNetwork=fws_web-1 DestinationInterface=any DestinationNetwork=all-nets Service=all_services SATTranslate=SourceIP SATTranslateToIP=fws_web-1_valid_address LogEnabled=No
add IPRule Index=2 Name=fws_nat-1 Action=Allow SourceInterface=fws_zones SourceNetwork=fws_web-1 DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="automatic NAT rule"
add IPRule Index=3 Name=fws_nat-3 Action=Allow SourceInterface=fws_zones SourceNetwork=fws_plc-net DestinationInterface=any DestinationNetwork=fws_plc-net Service=all_services LogEnabled=No Comments="automatic NAT rule"
add IPRule Index=4 Name=fws_nat-4 Action=NAT SourceInterface=fws_zones SourceNetwork=fws_plc-net DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="automatic NAT rule"
add IPRule Index=5 Name=fws_nat-5 Action=Allow SourceInterface=fws_zones SourceNetwork=fws_lan-net DestinationInterface=any DestinationNetwork=fws_dmz-net Service=all_services LogEnabled=No Comments="No NAT towards the DMZ"
add IPRule Index=6 Name=fws_nat-7 Action=NAT SourceInterface=fws_zones SourceNetwork=fws_dmz-net DestinationInterface=any DestinationNetwork=all-nets Service=all_services NATAction=UseSenderAddress NATSenderAddress=fws_nat-out LogEnabled=No
add IPRule Index=7 Name=fws_nat-8 Action=NAT SourceInterface=fws_zones SourceNetwork=fws_lan-net DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No Comments="Hide behind the gateway"
add IPRule Index=8 Name=fws_nat-9 Action=NAT SourceInterface=fws_zones SourceNetwork=fws_guest-net DestinationInterface=any DestinationNetwork=all-nets Service=all_services NATAction=UseSenderAddress NATSenderAddress=fws_nat-out LogEnabled=No
set IPRule 8 -disable
add IPRule Index=9 Name=fws_snat_allow Action=Allow SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
add IPRule Index=10 Name=fws_snat_allow_v6 Action=Allow SourceInterface=any SourceNetwork=all-nets6 DestinationInterface=any DestinationNetwork=all-nets6 Service=all_services LogEnabled=No
cc
cc IPRuleSet fws_d_nat-2
add IPRule Index=1 Name=fws_nat-2_rule-2 Action=Allow SourceInterface=fws_zones SourceNetwork=fws_admin-range DestinationInterface=any DestinationNetwork=fws_dmz-servers Service=fws_ssh LogEnabled=Yes
add IPRule Index=2 Name=fws_nat-2_Guests_stay_out Action=Drop SourceInterface=fws_zones SourceNetwork=fws_guest-net DestinationInterface=any DestinationNetwork=fws_Guests_stay_out_dst_not Service=all_services LogEnabled=Yes
add IPRule Index=3 Name=fws_nat-2_Public_web Action=Allow SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_Public_web_dst Service=fws_https LogEnabled=Yes Comments="web-1 has automatic static NAT"
add IPRule Index=4 Name=fws_nat-2_No_ident Action=Reject SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=fws_ident LogEnabled=Yes
add IPRule Index=5 Name=fws_nat-2_Cleanup_rule Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=Yes
add IPRule Index=6 Name=fws_nat-2_default Action=Drop SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
cc
cc IPRuleSet fws_d_nat-6
add IPRule Index=1 Name=fws_nat-6_Guests_stay_out Action=Drop SourceInterface=fws_zones SourceNetwork=fws_guest-net DestinationInterface=any DestinationNetwork=fws_Guests_stay_out_dst_not Service=all_services LogEnabled=Yes
add IPRule Index=2 Name=fws_nat-6_Cleanup_rule Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=Yes
add IPRule Index=3 Name=fws_nat-6_default Action=Drop SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
cc
cc IPRuleSet fws_rules
add IPRule Index=1 Name=fws_nat-2_sat Action=SAT SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_web-1_valid_address Service=all_services SATTranslate=DestinationIP SATTranslateToIP=fws_web-1 LogEnabled=No Comments="automatic NAT rule"
add IPRule Index=2 Name=fws_nat-6_sat Action=SAT SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_mail-public Service=fws_tcp-2525 SATTranslate=DestinationIP SATTranslateToIP=fws_mail-1 SATTranslateToPort=25 LogEnabled=No Comments="Mail on an alternative port"
add GotoRule Index=3 Name=fws_nat-2_goto SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_web-1_valid_address Service=all_services RuleSet=fws_d_nat-2 LogEnabled=No
add GotoRule Index=4 Name=fws_nat-6_goto SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_mail-public Service=fws_tcp-2525 RuleSet=fws_d_nat-6 LogEnabled=No
add GotoRule Index=5 Name=fws_DNS SourceInterface=fws_zones SourceNetwork=fws_DNS_src DestinationInterface=fws_zones DestinationNetwork=fws_dns-servers Service=fws_DNS_svc RuleSet=fws_snat LogEnabled=Yes Comments="Name resolution"
add GotoRule Index=6 Name=fws_rule-2 SourceInterface=fws_zones SourceNetwork=fws_admin-range DestinationInterface=fws_zones DestinationNetwork=fws_dmz-servers Service=fws_ssh RuleSet=fws_snat LogEnabled=Yes
add GotoRule Index=7 Name=fws_Web_out SourceInterface=InternalZone SourceNetwork=all-nets DestinationInterface=ExternalZone DestinationNetwork=all-nets Service=fws_Web_out_svc RuleSet=fws_snat LogEnabled=Yes
add IPRule Index=8 Name=fws_Web_out_v6 Action=Allow SourceInterface=InternalZone SourceNetwork=all-nets6 DestinationInterface=ExternalZone DestinationNetwork=all-nets6 Service=fws_Web_out_svc LogEnabled=Yes
add IPRule Index=9 Name=fws_Guests_stay_out Action=Drop SourceInterface=fws_zones SourceNetwork=fws_guest-net DestinationInterface=fws_zones DestinationNetwork=fws_Guests_stay_out_dst_not Service=all_services LogEnabled=Yes
add IPRule Index=10 Name=fws_Social Action=Allow SourceInterface=any SourceNetwork=fws_nothing DestinationInterface=any DestinationNetwork=fws_nothing Service=all_services LogEnabled=Yes
set IPRule 10 -disable
add IPRule Index=11 Name=fws_Admins Action=Allow SourceInterface=any SourceNetwork=fws_nothing DestinationInterface=any DestinationNetwork=fws_nothing Service=all_services LogEnabled=Yes
set IPRule 11 -disable
add GotoRule Index=12 Name=fws_PLC_access SourceInterface=fws_zones SourceNetwork=fws_admin-range DestinationInterface=fws_zones DestinationNetwork=fws_plc-net Service=fws_PLC_access_svc RuleSet=fws_snat LogEnabled=Yes Comments="Operators from the office, vendor support from anywhere"
add IPRule Index=13 Name=fws_PLC_access__plc-operators_ Action=Allow SourceInterface=fws_zones SourceNetwork=fws_lan-net DestinationInterface=fws_zones DestinationNetwork=fws_plc-net Service=fws_PLC_access__plc-operators__svc LogEnabled=Yes Comments="Operators from the office, vendor support from anywhere"
set IPRule 13 -disable
