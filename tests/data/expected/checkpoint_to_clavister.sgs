add Service ServiceIPProto fws_gre IPProto=47
add Service ServiceTCPUDP fws_ident Type=TCP DestinationPorts=113
add Address IP4Address fws_nat-out Address=198.51.100.20
add Address IP4Address fws_nothing Address=0.0.0.0
add InterfaceGroup fws_zones Members=InternalZone,ExternalZone
