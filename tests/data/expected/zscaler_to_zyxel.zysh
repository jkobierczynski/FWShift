exit
address-object FWS_192_0_2_10-192_0_2_20 192.0.2.10-192.0.2.20
service-object FWS_NTP udp eq 123
service-object FWS_ICMP_ANY protocol 1
object-group service FWS_Infra
 object-group FWS_DNS
 service-object FWS_NTP
 service-object FWS_ICMP_ANY
exit
service-object FWS_GRE_PROTOCOL protocol 47
service-object FWS_ESP_PROTOCOL protocol 50
object-group service FWS_Block_GRE_and_ESP_svc
 service-object FWS_GRE_PROTOCOL
 service-object FWS_ESP_PROTOCOL
exit
service-object FWS_TCP_ANY tcp range 1 65535
service-object FWS_UDP_ANY udp range 1 65535
object-group service FWS_Evaluate_apps_svc
 service-object FWS_TCP_ANY
 service-object FWS_UDP_ANY
exit
