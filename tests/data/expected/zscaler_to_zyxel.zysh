address-object FWS_10_20_1_1-10_20_1_50 10.20.1.1-10.20.1.50
object-group address FWS_Engineering-Nets
 address-object FWS_10_10_0_0_16
 address-object FWS_10_20_1_1-10_20_1_50
exit
address-object FWS_198_51_100_53 198.51.100.53
service-object FWS_SSH tcp eq 22
service-object FWS_tcp_8443 tcp eq 8443
service-object FWS_tcp_8000_8010 tcp range 8000 8010
object-group service FWS_App-8443
 service-object FWS_tcp_8443
 service-object FWS_tcp_8000_8010
exit
