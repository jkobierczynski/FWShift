CONFIG OBJECT NETWORK NEW name=fws_Admins_1 ip=10.10.5.10 mask=255.255.255.254 update=1
CONFIG OBJECT NETWORK NEW name=fws_Admins_2 ip=10.10.5.12 mask=255.255.255.252 update=1
CONFIG OBJECT NETWORK NEW name=fws_Admins_3 ip=10.10.5.16 mask=255.255.255.252 update=1
CONFIG OBJECT HOST NEW name=fws_Admins_4 ip=10.10.5.20 resolve=static update=1
CONFIG OBJECT NETWORK NEW name=fws_DMZ_1 ip=10.20.0.10 mask=255.255.255.254 update=1
CONFIG OBJECT NETWORK NEW name=fws_DMZ_2 ip=10.20.1.0 mask=255.255.255.0 update=1
