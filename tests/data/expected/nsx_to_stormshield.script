CONFIG OBJECT SERVICE NEW name=fws_tcp_502 port=502 proto=tcp update=1
CONFIG OBJECT HOST NEW name=fws_198.51.100.40 ip=198.51.100.40 resolve=static update=1
CONFIG OBJECT SERVICE NEW name=fws_tcp_21 port=21 proto=tcp update=1
CONFIG OBJECT NETWORK NEW name=fws____0 ipv6=:: prefixlenv6=0 update=1
CONFIG OBJECT PROTOCOL NEW name=fws_proto_58 protonumber=58 update=1
CONFIG OBJECT GROUP NEW name=fws_DB_servers update=1
CONFIG OBJECT GROUP ADDTO group=fws_DB_servers node=fws_DB_servers_1
CONFIG OBJECT GROUP ADDTO group=fws_DB_servers node=fws_DB_servers_2
CONFIG OBJECT GROUP NEW name=fws_Admins update=1
CONFIG OBJECT GROUP ADDTO group=fws_Admins node=fws_Admins_1
CONFIG OBJECT GROUP ADDTO group=fws_Admins node=fws_Admins_2
CONFIG OBJECT GROUP ADDTO group=fws_Admins node=fws_Admins_3
CONFIG OBJECT GROUP ADDTO group=fws_Admins node=fws_Admins_4
CONFIG OBJECT GROUP NEW name=fws_DMZ update=1
CONFIG OBJECT GROUP ADDTO group=fws_DMZ node=fws_DMZ_1
CONFIG OBJECT GROUP ADDTO group=fws_DMZ node=fws_DMZ_2
CONFIG OBJECT ACTIVATE
CONFIG FILTER RULE REMOVE type=filter index=9 position=all
CONFIG FILTER RULE REMOVE type=nat index=9 position=all
CONFIG FILTER RULE INSERT type=filter index=9 state=off action=block loglevel=log srctarget=any dsttarget=any comment="Block quarantined: not converted (references 'Quarantine': dynamic address group, members are not known statically; 'Quarantine' holds members only its platform knows)"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_tcp_53,fws_udp_53 srctarget=fws_LAN dsttarget=fws_192.0.2.53 comment="DNS to resolvers"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_udp_123 srctarget=any dsttarget=fws_192.0.2.123 comment=NTP
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=block srctarget=fws_Guests dsttarget=fws_10.0.0.0_8 comment="Guests stay out"
CONFIG FILTER RULE INSERT type=filter index=9 state=off action=block dstport=fws_tcp_22 srctarget=fws_LAN dsttarget=any comment="LAN block the rest: not converted (not converted: follows a conditional jump to the application rules (rule 'LAN to the application rules'), which cannot be expressed)"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass loglevel=log dstport=fws_tcp_443,fws_tcp_8443 srctarget=any dsttarget=fws_Web_servers comment="Inbound web"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_tcp_8443 srctarget=fws_Web_servers dsttarget=fws_App_servers comment="Web to app"
CONFIG FILTER RULE INSERT type=filter index=9 state=off action=pass dstport=fws_tcp_3306 srctarget=fws_App_servers dsttarget=fws_DB_servers comment="App to DB: not converted (not converted: direction IN only: NSX checks the other end of the connection against the rules below it, which one rule cannot say)"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_tcp_22 srctarget=fws_Admins dsttarget=fws_DMZ comment="Admins SSH"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=block dstport=fws_tcp_22 srctarget=!fws_Admins dsttarget=fws_DMZ comment="Others no SSH"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_tcp_502 srctarget=fws_10.10.7.15 dsttarget=fws_OT_cell comment="Engineering to PLCs"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_tcp_21 srctarget=fws_LAN dsttarget=fws_198.51.100.40 comment="FTP to partner"
CONFIG FILTER RULE INSERT type=filter index=9 state=off action=pass dstport=fws_tcp_443 srctarget=fws_LAN dsttarget=any comment="TLS out: not converted (not converted: context profile SSL (layer 7: applications, domain names), which the model has no place for)"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass ipproto=icmp srctarget=fws____0 dsttarget=any comment="Ping over IPv6"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass ipproto=fws_proto_58 srctarget=fws____0 dsttarget=any comment="Ping over IPv6"
CONFIG FILTER RULE INSERT type=filter index=9 state=off action=pass dstport=fws_tcp_3306 srctarget=fws_LAN dsttarget=fws_DB_servers comment="Old rule"
CONFIG FILTER ACTIVATE
CONFIG SLOT UPDATE type=filter slot=9 name=FWShift comment="written by FWShift"
# CONFIG SLOT ACTIVATE type=filter slot=9     <- when the slot has been checked
# Written off (state=off):
#   Block quarantined: references 'Quarantine': dynamic address group, members are not known statically; 'Quarantine' holds members only its platform knows
#   LAN block the rest: not converted: follows a conditional jump to the application rules (rule 'LAN to the application rules'), which cannot be expressed
#   App to DB: not converted: direction IN only: NSX checks the other end of the connection against the rules below it, which one rule cannot say
#   TLS out: not converted: context profile SSL (layer 7: applications, domain names), which the model has no place for
