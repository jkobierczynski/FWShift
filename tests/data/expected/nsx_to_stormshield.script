CONFIG OBJECT NETWORK NEW name=fws_Web_servers ip=10.20.0.10 mask=255.255.255.254 update=1
CONFIG OBJECT SERVICE NEW name=fws_tcp_443 port=443 proto=tcp update=1
CONFIG OBJECT SERVICE NEW name=fws_tcp_8443 port=8443 proto=tcp update=1
CONFIG OBJECT NETWORK NEW name=fws_App_servers ip=10.20.1.0 mask=255.255.255.0 update=1
CONFIG OBJECT NETWORK NEW name=fws_DB_servers_1 ip=10.20.2.0 mask=255.255.255.0 update=1
