configure terminal
address-object ipv4 "fileserver" host 10.20.0.10 zone Antwerp-DC
address-object ipv4 "erp-db" host 10.20.0.20 zone Antwerp-DC
address-object ipv4 "historian" host 10.30.0.50 zone Ghent-Plant
address-object ipv4 "Ghent Plant _ LAN" network 10.30.0.0 255.255.255.0 zone Ghent-Plant
address-object ipv4 "Antwerp DC _ Routed lab" network 10.20.30.0 255.255.255.0 zone Antwerp-DC
address-object ipv4 "Partner net" network 192.0.2.0 255.255.255.128 zone Brussels-HQ
address-object ipv4 "Monitoring" range 198.51.100.10 198.51.100.20 zone Brussels-HQ
address-object ipv4 "host lab-printer" host 192.0.0.8 zone Brussels-HQ
address-object fqdn "fqdn updates.example.com" domain "updates.example.com" zone internet
address-object fqdn "fqdn ftp.example.net" domain "ftp.example.net" zone internet
address-object ipv4 "n 10.10.0.0_24" network 10.10.0.0 255.255.255.0 zone Antwerp-DC
address-object ipv4 "n 10.10.20.0_24" network 10.10.20.0 255.255.255.0 zone Antwerp-DC
address-object ipv4 "n 10.20.0.0_24" network 10.20.0.0 255.255.255.0 zone Antwerp-DC
address-object ipv4 "n 10.40.0.0_24" network 10.40.0.0 255.255.255.0 zone Antwerp-DC
address-object ipv4 "n 0.0.0.0_1" network 0.0.0.0 128.0.0.0 zone Antwerp-DC
address-object ipv4 "n 128.0.0.0_1" network 128.0.0.0 128.0.0.0 zone Antwerp-DC
address-object ipv6 "n ::_1" network :: /1 zone Antwerp-DC
address-object ipv6 "n 8000::_1" network 8000:: /1 zone Antwerp-DC
address-object ipv4 "r 0.0.0.0-10.20.0.19" range 0.0.0.0 10.20.0.19 zone Antwerp-DC
address-object ipv4 "r 10.20.0.21-255.255.255.255" range 10.20.0.21 255.255.255.255 zone Antwerp-DC
address-object ipv4 "h 10.20.0.99" host 10.20.0.99 zone Antwerp-DC
address-object ipv4 "r 10.10.20.100-10.10.20.120" range 10.10.20.100 10.10.20.120 zone Antwerp-DC
address-object ipv4 "h 10.30.0.5" host 10.30.0.5 zone Antwerp-DC
address-object ipv4 "h 198.51.100.66" host 198.51.100.66 zone Antwerp-DC
address-object ipv4 "n 203.0.113.0_24" network 203.0.113.0 255.255.255.0 zone Antwerp-DC
address-group ipv4 "dst Allow HQ to DC servers"
    address-object ipv4 "fileserver"
    address-object ipv4 "erp-db"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
address-group ipv4 "dst Remote users to DC"
    address-object ipv4 "r 0.0.0.0-10.20.0.19"
    address-object ipv4 "r 10.20.0.21-255.255.255.255"
    exit
address-group ipv4 "src Modbus to the plant (2)"
    address-object ipv4 "h 10.20.0.99"
    address-object ipv4 "r 10.10.20.100-10.10.20.120"
    exit
address-group ipv4 "dst Block bad networks"
    address-object ipv4 "h 198.51.100.66"
    address-object ipv4 "n 203.0.113.0_24"
    exit
service-object "HTTPS 2" TCP 443 443
service-object "tcp/8443" TCP 8443 8443
service-object "tcp/1433" TCP 1433 1433
service-object "udp/5000-5010" UDP 5000 5010
service-object "tcp-udp/53 tcp 53" TCP 53 53
service-object "tcp-udp/53 udp 53" UDP 53 53
service-group "tcp-udp/53"
    service-object "tcp-udp/53 tcp 53"
    service-object "tcp-udp/53 udp 53"
    exit
service-object "tcp/502" TCP 502 502
service-object "tcp/5432" TCP 5432 5432
service-object "SSH 2" TCP 22 22
service-object "RDP" TCP 3389 3389
service-object "tcp/9100" TCP 9100 9100
service-object "FTP 2" TCP 21 21
service-object "SMB" TCP 445 445
service-group "svc Allow HQ to DC servers"
    service-object "HTTPS 2"
    service-object "tcp/8443"
    exit
service-group "svc Allow HQ to DC servers (2)"
    service-object "HTTPS 2"
    service-object "tcp/8443"
    exit
service-group "svc Historian both ways"
    service-object "tcp/1433"
    service-object "udp/5000-5010"
    exit
service-group "svc Historian both ways (2)"
    service-object "tcp/1433"
    service-object "udp/5000-5010"
    exit
