cc IPRuleSet fws_d_Web-Public__Web_In_
add IPRule Index=1 Name=fws_Web-Public__Web_In__Web_In Action=Allow SourceInterface=External SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_Web-Public.1.snat Service=fws_HTTPS LogEnabled=Yes
add IPRule Index=2 Name=fws_Web-Public__Web_In__default Action=Drop SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
cc
cc IPRuleSet fws_d_Mail-Public__Mail_In_
