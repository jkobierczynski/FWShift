cc
cc IPRuleSet fws_rules
add IPRule Index=1 Name=fws_Web-Public__Web_In__sat Action=SAT SourceInterface=External SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_Web-Public.1.snat Service=fws_HTTPS SATTranslate=DestinationIP SATTranslateToIP=fws_Web-Public.2.snat LogEnabled=No Comments="static NAT action Web-Public of policy Web In"
add IPRule Index=2 Name=fws_Mail-Public__Mail_In__sat Action=SAT SourceInterface=External SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_Mail-Public.1.snat Service=fws_SMTP SATTranslate=DestinationIP SATTranslateToIP=fws_Mail-Public.2.snat SATTranslateToPort=2525 LogEnabled=No Comments="static NAT action Mail-Public of policy Mail In"
add GotoRule Index=3 Name=fws_Web-Public__Web_In__goto SourceInterface=External SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_Web-Public.1.snat Service=fws_HTTPS RuleSet=fws_d_Web-Public__Web_In_ LogEnabled=No
add GotoRule Index=4 Name=fws_Mail-Public__Mail_In__goto SourceInterface=External SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_Mail-Public.1.snat Service=fws_SMTP RuleSet=fws_d_Mail-Public__Mail_In_ LogEnabled=No
add IPRule Index=5 Name=fws_Block_Bad Action=Drop SourceInterface=fws_if_Guests_Trusted SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=fws_Block_Bad_dst Service=all_services LogEnabled=Yes
add IPRule Index=6 Name=fws_Admin_SSH Action=Allow SourceInterface=Trusted SourceNetwork=fws_Admins.1.alm DestinationInterface=External DestinationNetwork=all-nets Service=fws_SSH LogEnabled=Yes
