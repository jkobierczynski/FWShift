add IPRule Index=16 Name=fws_Ping_v6 Action=Allow SourceInterface=fws_if_Guests_Trusted SourceNetwork=all-nets6 DestinationInterface=fws_zones DestinationNetwork=all-nets6 Service=fws_Ping LogEnabled=Yes
