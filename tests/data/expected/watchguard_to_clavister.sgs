add IPRule Index=8 Name=fws_Web_Out_v6 Action=Allow SourceInterface=fws_if_DMZ_Guests_Trusted SourceNetwork=all-nets6 DestinationInterface=External DestinationNetwork=all-nets6 Service=fws_Web_Out_grp LogEnabled=Yes
add IPRule Index=9 Name=fws_Web_In Action=Allow SourceInterface=External SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=fws_Web-Public.1.snat Service=fws_HTTPS LogEnabled=Yes
add IPRule Index=10 Name=fws_Mail_In Action=Allow SourceInterface=External SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=fws_Mail-Public.1.snat Service=fws_SMTP LogEnabled=Yes
