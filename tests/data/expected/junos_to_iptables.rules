# FORWARD chain and nat table for iptables-restore.
# It does not contain INPUT or OUTPUT: load it with --noflush, or merge it into your ruleset.
*filter
:FORWARD DROP [0:0]
:FWS1 - [0:0]
:FWS1-1 - [0:0]
:FWS1-2 - [0:0]
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
-A FORWARD -i trust -o untrust -d 198.51.100.0/24 -m comment --comment "block-bad" -j DROP
-A FORWARD -i trust -o untrust -d 192.0.2.66/32 -m comment --comment "block-bad" -j DROP
-A FORWARD -i trust -o untrust -s 10.10.0.0/16 -p tcp -m multiport --dports 80,443,8080:8081 -m conntrack --ctstate NEW -m comment --comment "web-out" -j ACCEPT
-A FORWARD -i trust -o untrust -s 10.10.0.0/16 -d updates.example.com -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -m comment --comment "updates" -j ACCEPT
-A FORWARD -i trust -o untrust -p icmp -m icmp --icmp-type 8 -m conntrack --ctstate NEW -m comment --comment "ping-out" -j ACCEPT
-A FORWARD -i untrust -o dmz -d 10.20.0.80/32 -p tcp -m tcp --dport 8080:8081 -m conntrack --ctstate NEW -m comment --comment "web-in" -j ACCEPT
-A FORWARD -i untrust -o dmz -d 10.20.0.25/32 -p tcp -m multiport --dports 25,587,465 -m conntrack --ctstate NEW -m comment --comment "mail-in" -j ACCEPT
-A FORWARD -i trust -o dmz -m iprange --src-range 10.10.5.10-10.10.5.20 -d 10.20.0.0/24 -p tcp -m tcp --dport 22 -m conntrack --ctstate NEW -m comment --comment "admin" -j ACCEPT
-A FORWARD -i trust -o dmz -m conntrack --ctstate NEW -m comment --comment "not-servers" -j FWS1
-A FWS1 -s 10.20.0.80/32 -j RETURN
-A FWS1 -s 10.20.0.25/32 -j RETURN
-A FWS1 -j FWS1-1
-A FWS1-1 -d 10.20.0.64/26 -j FWS1-2
-A FWS1-2 -p 47 -j ACCEPT
# disabled in the source: "dmz-out" from dmz to untrust; source dmz-net (dmz-book); destination any; service junos-dns-udp,app-ntp; action allow
# FWSHIFT disabled, see the report: "guest-web" from guest to untrust; source any; destination 0.0.0.0/0; service junos-http; action allow
# FWSHIFT disabled, see the report: "guest-ping" from guest to untrust; source any; destination any; service junos-ping; action allow
-A FORWARD -i trust -o trust -m conntrack --ctstate NEW -m comment --comment "intra" -j ACCEPT
-A FORWARD -s 198.51.100.0/24 -m comment --comment "global-block" -j REJECT
-A FORWARD -s 192.0.2.66/32 -m comment --comment "global-block" -j REJECT
-A FORWARD -i trust -o untrust -p udp -m udp --dport 123 -m conntrack --ctstate NEW -m comment --comment "global-ntp" -j ACCEPT
-A FORWARD -i trust -o untrust -p tcp -m tcp --dport 1000:2000 -m tcp --sport 1024:65535 -m conntrack --ctstate NEW -m comment --comment "global-ntp" -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i untrust -d 203.0.113.25/32 -m comment --comment "inbound static-mail" -j DNAT --to-destination 10.20.0.25
-A PREROUTING -i untrust -d 203.0.113.10/32 -p tcp -m tcp --dport 80 -m comment --comment "from-internet dnat-web" -j DNAT --to-destination 10.20.0.80:8080
-A PREROUTING -i untrust -d 203.0.113.10/32 -p udp -m udp --dport 80 -m comment --comment "from-internet dnat-web" -j DNAT --to-destination 10.20.0.80:8080
-A POSTROUTING -s 10.20.0.25/32 -m comment --comment "inbound static-mail (outbound)" -j SNAT --to-source 203.0.113.25
-A POSTROUTING -o untrust -s 10.10.0.0/16 -m comment --comment "trust-out snat-lan" -j MASQUERADE
-A POSTROUTING -o untrust -s 10.20.0.0/24 -m comment --comment "dmz-out snat-dmz" -j SNAT --to-source 203.0.113.50-203.0.113.59
COMMIT
