set address bad-net ip-netmask 198.51.100.0/24
set address bad-host ip-netmask 192.0.2.66
set address v6-net ip-netmask 2001:db8:10::/48
set address lan-net ip-netmask 10.10.0.0/16
set address updates fqdn updates.example.com
set address web-srv ip-netmask 10.20.0.80
set address mail-srv ip-netmask 10.20.0.25
set address admin-range ip-range 10.10.5.10-10.10.5.20
set address "dmz-net _dmz-book_" ip-netmask 10.20.0.0/24
set address "lan-net _dmz-book_" ip-netmask 10.20.0.64/26
set address-group bad static [ bad-net bad-host ]
set address-group watched static [ bad v6-net ]
set address-group servers static [ web-srv mail-srv ]
set service junos-http protocol tcp port 80
set service junos-https protocol tcp port 443
set service app-web-alt protocol tcp port 8080-8081
set service junos-smtp protocol tcp port 25
set service app-mail-sub protocol tcp port 587,465
set service junos-ssh protocol tcp port 22
set service junos-dns-udp protocol udp port 53
set service app-ntp protocol udp port 123
set service junos-ping protocol tcp port 1
set service junos-ping description "FWSHIFT PLACEHOLDER, matches nothing: the predefined application junos-ping: Juniper describes it as ICMP echo, other readers of Junos as every ICMP type"
set service app-high protocol tcp port 1000-2000
set service app-high protocol tcp source-port 1024-65535
set service "NAT from-internet dnat-web-tcp" protocol tcp port 80
set service "NAT from-internet dnat-web-udp" protocol udp port 80
set service-group "NAT from-internet dnat-web" members [ "NAT from-internet dnat-web-tcp" "NAT from-internet dnat-web-udp" ]
set service-group web-all members [ junos-http junos-https app-web-alt ]
