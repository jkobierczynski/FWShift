configure terminal
address-object ipv4 "Web Server" host 10.20.0.10 zone DMZ
address-object ipv4 "Mail Server" host 10.20.0.25 zone DMZ
address-object ipv4 "Web Public" host 198.51.100.10 zone DMZ
address-object ipv4 "Mail Public" host 198.51.100.11 zone DMZ
address-object ipv4 "Server Range" network 10.30.0.0 255.255.255.240 zone LAN
address-object ipv4 "Server Public" network 198.51.100.32 255.255.255.240 zone WAN
address-object ipv4 "Database" host 10.30.0.5 zone Servers
address-object ipv4 "Admin PCs" range 10.10.5.10 10.10.5.20 zone LAN
address-object ipv4 "Bad Net One" network 203.0.113.0 255.255.255.128 zone WAN
address-object ipv4 "Bad Host" host 192.0.2.66 zone WAN
address-object ipv4 "Partner Net" network 192.0.2.128 255.255.255.192 zone WAN
address-object fqdn "Update Site" domain "updates.example.com" zone WAN
address-object ipv4 "n 0.0.0.0_1" network 0.0.0.0 128.0.0.0 zone LAN
address-object ipv4 "n 128.0.0.0_1" network 128.0.0.0 128.0.0.0 zone LAN
address-object ipv6 "n ::_1" network :: /1 zone LAN
address-object ipv6 "n 8000::_1" network 8000:: /1 zone LAN
address-group ipv4 "Bad Networks"
    address-object ipv4 "Bad Net One"
    address-object ipv4 "Bad Host"
    exit
address-group ipv4 "Partners"
    address-object ipv4 "Partner Net"
    address-object ipv4 "Bad Net One"
    address-object ipv4 "Bad Host"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
service-object "HTTPS Alt" TCP 8443 8443
service-object "SMTP Alt" TCP 2525 2525
service-object "Media" UDP 16384 16484
service-object "tcp 25" TCP 25 25
service-group "Web Services"
    service-object "HTTP"
    service-object "HTTPS"
    service-object "HTTPS Alt"
    exit
nat-policy ipv4 inbound any outbound X1 source name "X0 Subnet" translated-source name "X1 IP" destination any translated-destination original service any translated-service original
    name "Default NAT"
    comment "Default NAT"
    priority manual 1
    exit
nat-policy ipv4 inbound X1 outbound any source any translated-source original destination name "Web Public" translated-destination name "Web Server" service name "HTTPS" translated-service original
    name "Web server"
    comment "Web server"
    priority manual 2
    exit
nat-policy ipv4 inbound X4 outbound any source any translated-source original destination name "Web Public" translated-destination name "Web Server" service name "HTTPS" translated-service original
    name "Web server 2"
    comment "Web server"
