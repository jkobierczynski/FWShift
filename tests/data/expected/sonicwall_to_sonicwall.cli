    name "FWSHIFT LAN to VPN v6"
    priority manual 1
    exit
access-rule ipv4 from Servers to LAN action deny source address any service any destination address any
    name "FWSHIFT Servers to LAN"
    priority manual 1
    exit
access-rule ipv6 from Servers to LAN action deny source address any service any destination address any
    name "FWSHIFT Servers to LAN v6"
    priority manual 1
    exit
access-rule ipv4 from Servers to VPN action deny source address any service any destination address any
    name "FWSHIFT Servers to VPN"
    priority manual 1
    exit
access-rule ipv6 from Servers to VPN action deny source address any service any destination address any
    name "FWSHIFT Servers to VPN v6"
    priority manual 1
    exit
access-rule ipv4 from VPN to DMZ action deny source address any service any destination address any
    name "FWSHIFT VPN to DMZ"
    priority manual 1
    exit
access-rule ipv6 from VPN to DMZ action deny source address any service any destination address any
    name "FWSHIFT VPN to DMZ v6"
    priority manual 1
    exit
access-rule ipv4 from VPN to LAN action deny source address any service any destination address any
    name "FWSHIFT VPN to LAN"
    priority manual 1
    exit
