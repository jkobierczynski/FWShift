    name "FWSHIFT VPN to LAN v6"
    priority manual 1
    exit
access-rule ipv4 from VPN to Servers action deny source address any service any destination address any
    name "FWSHIFT VPN to Servers"
    priority manual 1
    exit
access-rule ipv6 from VPN to Servers action deny source address any service any destination address any
    name "FWSHIFT VPN to Servers v6"
    priority manual 1
    exit
access-rule ipv4 from VPN to WAN action deny source address any service any destination address any
    name "FWSHIFT VPN to WAN"
    priority manual 1
    exit
