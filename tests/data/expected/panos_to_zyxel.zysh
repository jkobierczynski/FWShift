# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
service-object FWS_tcp_80 tcp eq 80
service-object FWS_tcp_443 tcp eq 443
object-group service FWS_apps_web-browsing_ssl
 service-object FWS_tcp_80
 service-object FWS_tcp_443
exit
address-object FWS_lan-net 10.10.0.0/16
service-object FWS_tcp_53 tcp eq 53
service-object FWS_udp_53 udp eq 53
object-group service FWS_apps_dns
 service-object FWS_tcp_53
 service-object FWS_udp_53
exit
address-object FWS_dns-1 192.0.2.53
address-object FWS_dns-2 192.0.2.54
object-group address FWS_dns-servers
 address-object FWS_dns-1
 address-object FWS_dns-2
exit
service-object FWS_tcp-8443 tcp eq 8443
address-object FWS_web-1 10.20.0.10
service-object FWS_apps_smtp tcp eq 25
address-object FWS_mail-1 10.20.0.25
service-object FWS_apps_ssh tcp eq 22
address-object FWS_admin-range 10.10.5.10-10.10.5.20
object-group address FWS_dmz-servers
 address-object FWS_web-1
 address-object FWS_mail-1
exit
service-object FWS_tcp_502 tcp eq 502
service-object FWS_tcp_102 tcp eq 102
object-group service FWS_apps_modbus_siemens-s7
 service-object FWS_tcp_502
 service-object FWS_tcp_102
exit
address-object FWS_eng-station 10.10.7.15
address-object FWS_plc-net 10.30.1.0/24
service-object FWS_noservice protocol 255
address-object FWS_nothing 0.0.0.0
service-object FWS_tcp_8080 tcp eq 8080
object-group service FWS_service-http
 service-object FWS_tcp_80
 service-object FWS_tcp_8080
exit
service-object FWS_tcp_9000_9010 tcp range 9000 9010
object-group service FWS_tcp-high-web
 service-object FWS_tcp_8080
 service-object FWS_tcp-8443
 service-object FWS_tcp_9000_9010
exit
object-group service FWS_web-ports
 object-group FWS_service-http
 service-object FWS_tcp_443
 object-group FWS_tcp-high-web
exit
object-group service FWS_App-Server-Ports_svc
 object-group FWS_web-ports
 service-object FWS_tcp-8443
exit
service-object FWS_apps_ping icmp 8
address-object FWS_not_10_10_200_0_24_1 0.0.0.0-10.10.199.255
address-object FWS_not_10_10_200_0_24_2 10.10.201.0-255.255.255.255
object-group address FWS_not_10_10_200_0_24
