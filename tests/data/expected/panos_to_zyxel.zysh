exit
service-object FWS_udp-syslog-src_dst udp eq 514
address-object FWS_partner-net 10.99.0.0/16
address-object FWS_snat-pool 198.51.100.20/30
zone FWS_trust
exit
zone FWS_untrust
exit
zone FWS_dmz
exit
zone FWS_ot
exit
secure-policy insert 1
