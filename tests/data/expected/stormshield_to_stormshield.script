# Generated by FWShift: serverd commands for a Stormshield SNS firewall (v4). Read the report first: what is
# not written is listed there. Run with: snscli --host FIREWALL --user admin --script this-file
# The script EMPTIES filter slot 9 and writes the policy there; it does not make it the active slot.
# Check that slot 9 is not the active one. Every object name starts with fws_; objects of those
# names are changed (update=1), also where an active slot uses them. snscli goes on after a command that fails:
# read its output, and run CONFIG FILTER CHECK type=filter index=9 before the slot is made active.
MODIFY FORCE ON
CONFIG OBJECT NETWORK NEW name=fws_global_bad ip=192.0.2.128 mask=255.255.255.128 update=1
CONFIG OBJECT HOST NEW name=fws_admins_1 ip=10.10.0.50 resolve=static update=1
CONFIG OBJECT HOST NEW name=fws_admins_2 ip=10.10.0.60 resolve=static update=1
CONFIG OBJECT HOST NEW name=fws_admins_3 ipv6=2001:db8:10::60 resolve=static update=1
CONFIG OBJECT SERVICE NEW name=fws_tcp_22 port=22 proto=tcp update=1
CONFIG OBJECT SERVICE NEW name=fws_tcp_443 port=443 proto=tcp update=1
CONFIG OBJECT NETWORK NEW name=fws_blocked ip=198.51.100.0 mask=255.255.255.0 update=1
CONFIG OBJECT SERVICE NEW name=fws_tcp_80 port=80 proto=tcp update=1
CONFIG OBJECT SERVICE NEW name=fws_tcp_8080-8090 port=8080 toport=8090 proto=tcp update=1
CONFIG OBJECT NETWORK NEW name=fws_lan ip=10.10.0.0 mask=255.255.255.0 update=1
CONFIG OBJECT SERVICE NEW name=fws_udp_53 port=53 proto=udp update=1
CONFIG OBJECT SERVICE NEW name=fws_tcp_113 port=113 proto=tcp update=1
CONFIG OBJECT HOST NEW name=fws_web_pub ip=203.0.113.3 resolve=static update=1
CONFIG OBJECT HOST NEW name=fws_dmz_servers_1 ip=10.20.0.10 resolve=static update=1
CONFIG OBJECT HOST NEW name=fws_dmz_servers_2 ip=10.20.0.25 resolve=static update=1
CONFIG OBJECT SERVICE NEW name=fws_tcp_25 port=25 proto=tcp update=1
CONFIG OBJECT NETWORK NEW name=fws_lab_net ip=10.30.0.0 mask=255.255.255.0 update=1
CONFIG OBJECT SERVICE NEW name=fws_tcp_5000-5010 port=5000 toport=5010 proto=tcp update=1
CONFIG OBJECT SERVICE NEW name=fws_udp_5000-5010 port=5000 toport=5010 proto=udp update=1
CONFIG OBJECT PROTOCOL NEW name=fws_proto_200 protonumber=200 update=1
CONFIG OBJECT NETWORK NEW name=fws_lan6 ipv6=2001:db8:10:: prefixlenv6=64 update=1
CONFIG OBJECT GROUP NEW name=fws_admins update=1
CONFIG OBJECT GROUP ADDTO group=fws_admins node=fws_admins_1
CONFIG OBJECT GROUP ADDTO group=fws_admins node=fws_admins_2
CONFIG OBJECT GROUP ADDTO group=fws_admins node=fws_admins_3
CONFIG OBJECT GROUP NEW name=fws_dmz_servers update=1
CONFIG OBJECT GROUP ADDTO group=fws_dmz_servers node=fws_dmz_servers_1
CONFIG OBJECT GROUP ADDTO group=fws_dmz_servers node=fws_dmz_servers_2
CONFIG OBJECT ACTIVATE
CONFIG FILTER RULE REMOVE type=filter index=9 position=all
CONFIG FILTER RULE REMOVE type=nat index=9 position=all
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=block srctarget=fws_global_bad dsttarget=any comment="blocked company-wide"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_tcp_22,fws_tcp_443 srctarget=fws_admins srcif=in dsttarget=firewall_all comment="admin access"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass ipproto=icmp srctarget=Network_internals dsttarget=firewall_all comment="ping the firewall"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=block srctarget=any dsttarget=fws_blocked comment="known bad"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass loglevel=log dstport=fws_tcp_80,fws_tcp_443,fws_tcp_8080-8090 srctarget=Network_internals dsttarget=!Network_internals comment=web
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_udp_53 srctarget=fws_lan srcif=in dsttarget=any comment=dns
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=reset dstport=fws_tcp_113 srctarget=Network_internals dsttarget=any comment="local 6"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass loglevel=log dstport=fws_tcp_80,fws_tcp_443 srctarget=any srcif=out dsttarget=fws_web_pub comment="public web, as it arrives"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_tcp_25 srctarget=any srcif=out dsttarget=fws_dmz_servers comment="local 9"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass dstport=fws_tcp_5000-5010,fws_udp_5000-5010 srctarget=fws_lab_net srcif=lab dsttarget=any comment="local 10"
CONFIG FILTER RULE INSERT type=filter index=9 state=off action=pass dstport=fws_tcp_80,fws_tcp_443,fws_tcp_8080-8090 srctarget=fws_lan dsttarget=fws_dmz_servers comment="local 11: not converted (source user match staff@corp.example is not converted)"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass ipproto=fws_proto_200 srctarget=fws_lab_net dsttarget=any comment="local 12"
CONFIG FILTER RULE INSERT type=filter index=9 state=off action=pass dstport=fws_tcp_443 srctarget=!fws_lan dsttarget=any comment="local 13: not converted (host name object updates.example.com: written with addresses only)"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=pass srctarget=fws_lan6 dsttarget=any comment="local 14"
CONFIG FILTER RULE INSERT type=filter index=9 state=off action=pass dstport=fws_tcp_80,fws_tcp_8080-8090 srctarget=fws_lan dsttarget=any comment="local 15: not converted (host name object www.example.org: written with addresses only)"
CONFIG FILTER RULE INSERT type=filter index=9 state=on action=block srctarget=any dsttarget=any comment="Block all"
CONFIG FILTER ACTIVATE
CONFIG SLOT UPDATE type=filter slot=9 name=FWShift comment="written by FWShift"
# CONFIG SLOT ACTIVATE type=filter slot=9     <- when the slot has been checked
# Written off (state=off):
#   local 11: source user match staff@corp.example is not converted
#   local 13: host name object updates.example.com: written with addresses only
#   local 15: host name object www.example.org: written with addresses only
