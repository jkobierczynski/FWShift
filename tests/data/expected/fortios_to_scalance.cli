configure terminal
firewall
service name FWS_tcp_80 proto tcp src all dst port 80
service name FWS_tcp_443 proto tcp src all dst port 443
service name FWS_tcp_53 proto tcp src all dst port 53
service name FWS_udp_53 proto udp src all dst port 53
icmp name FWS_icmp_8_0 type 8 code 0 ver ipv4
service name FWS_tcp_8080 proto tcp src all dst port 8080
service name FWS_tcp_8443 proto tcp src all dst port 8443
service name FWS_tcp_9000-9010 proto tcp src all dst range 9000 - 9010
service name FWS_SMTP proto tcp src all dst port 25
service name FWS_SSH proto tcp src all dst port 22
service name FWS_MODBUS proto tcp src all dst port 502
proto name FWS_GRE num 47
service name FWS_syslog-from-high proto udp src range 1024 - 65535 dst port 514
icmp name FWS_TIMESTAMP type 13 code 0 ver ipv4
ipv4rule from lan to wan1 srcip 10.10.0.0/15 dstip 0.0.0.0/0 action acc service FWS_tcp_80 log info prior 1
ipv4rule from lan to wan1 srcip 10.10.0.0/15 dstip 0.0.0.0/0 action acc service FWS_tcp_443 log info prior 1
ipv4rule from lan to wan1 srcip 10.10.0.0/15 dstip 0.0.0.0/0 action acc service FWS_tcp_53 log info prior 1
ipv4rule from lan to wan1 srcip 10.10.0.0/15 dstip 0.0.0.0/0 action acc service FWS_udp_53 log info prior 1
ipv4rule from lan to wan1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action acc service FWS_tcp_53 log no prior 2
ipv4rule from lan to wan1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action acc service FWS_udp_53 log no prior 2
ipv4rule from lan to wan1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action acc service FWS_icmp_8_0 log no prior 2
ipv4rule from wan1 to dmz srcip 0.0.0.0/0 dstip 10.20.0.10 action acc service FWS_tcp_8080 log info prior 3
ipv4rule from wan1 to dmz srcip 0.0.0.0/0 dstip 10.20.0.10 action acc service FWS_tcp_8443 log info prior 3
ipv4rule from wan1 to dmz srcip 0.0.0.0/0 dstip 10.20.0.10 action acc service FWS_tcp_9000-9010 log info prior 3
ipv4rule from wan1 to dmz srcip 0.0.0.0/0 dstip 10.20.0.25 action acc service FWS_SMTP log no prior 4
ipv4rule from lan to ot srcip 10.10.7.15 dstip 10.30.1.0/24 action acc service FWS_MODBUS log info prior 5
ipv4rule from ot to wan1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log info prior 6
ipv4rule from lan to wan1 srcip 10.10.0.0/15 dstip 10.99.0.0/16 action acc service FWS_GRE log no prior 7
ipv4rule from lan to wan1 srcip 10.10.0.0/15 dstip 10.99.0.0/16 action acc service FWS_syslog-from-high log no prior 7
ipv6rule from lan to wan1 srcip 2001:db8:10::/48 dstip ::/0 action acc service FWS_tcp_443 log no prior 7
ipv4rule from lan to dmz srcip 10.10.5.10-10.10.5.20 dstip 10.20.0.10 action acc service FWS_TIMESTAMP log no prior 7
ipv4rule from lan to dmz srcip 10.10.5.10-10.10.5.20 dstip 10.20.0.25 action acc service FWS_TIMESTAMP log no prior 7
ipv4rule from lan to wan1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from lan to wan1 srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from lan to dmz srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from lan to dmz srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from lan to ot srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from lan to ot srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from wan1 to lan srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from wan1 to lan srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from wan1 to dmz srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from wan1 to dmz srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from wan1 to ot srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from wan1 to ot srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from dmz to lan srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from dmz to lan srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from dmz to wan1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from dmz to wan1 srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from dmz to ot srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from dmz to ot srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from ot to lan srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from ot to lan srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from ot to wan1 srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from ot to wan1 srcip ::/0 dstip ::/0 action drop log no prior 8
ipv4rule from ot to dmz srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 8
ipv6rule from ot to dmz srcip ::/0 dstip ::/0 action drop log no prior 8
exit
firewallnat
napt srcint wan1 proto tcp type ipv4 dstip 203.0.113.10 transip 10.20.0.10 dstport 443 transport 8443
netmap destination srcint wan1 dstint dmz type ipv4 srcip 0.0.0.0/0 dstip 203.0.113.25 transip 10.20.0.25
src-nat srcint lan dstint wan1 type ipv4 srcip 10.10.0.0/15 dstip 0.0.0.0/0 transip auto
src-nat srcint lan dstint wan1 type ipv4 srcip 0.0.0.0/0 dstip 0.0.0.0/0 transip auto
exit
end
