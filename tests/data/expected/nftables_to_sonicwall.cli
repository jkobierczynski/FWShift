nat-policy ipv4 inbound any outbound any source any translated-source original destination name "h 203.0.113.10" translated-destination name "h 10.20.0.10" service name "tcp-443" translated-service name "tcp 8443"
    name "Web DNAT"
    comment "Web DNAT"
    priority manual 1
    exit
