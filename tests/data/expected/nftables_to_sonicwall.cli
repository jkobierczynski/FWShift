address-object ipv4 "n 10.99.0.0_16" network 10.99.0.0 255.255.0.0 zone eth0
address-object ipv4 "n 198.51.100.20_30" network 198.51.100.20 255.255.255.252 zone eth0
address-group ipv4 "blocked"
    address-object ipv4 "n 192.0.2.128_25"
    address-object ipv4 "h 198.51.100.66"
    exit
address-group ipv4 "admins"
    address-object ipv4 "r 10.10.5.10-10.10.5.20"
    exit
address-group ipv6 "dmz_v6"
    address-object ipv6 "h 2001:db8:20::10"
    address-object ipv6 "h 2001:db8:20::25"
    exit
address-group ipv4 "FWSHIFT all IPv4"
    address-object ipv4 "n 0.0.0.0_1"
    address-object ipv4 "n 128.0.0.0_1"
    exit
address-group ipv6 "FWSHIFT all IPv6"
    address-object ipv6 "n ::_1"
    address-object ipv6 "n 8000::_1"
    exit
address-group ipv4 "dst Inbound web"
    address-object ipv4 "h 10.20.0.10"
    address-object ipv4 "h 203.0.113.10"
    exit
address-group ipv4 "dst Inbound mail"
    address-object ipv4 "h 10.20.0.25"
    address-object ipv4 "h 203.0.113.25"
    exit
address-group ipv4 "dst DMZ updates"
    address-object ipv4 "r 0.0.0.0-9.255.255.255"
    address-object ipv4 "r 11.0.0.0-255.255.255.255"
    exit
service-object "tcp-80,443 tcp 80" TCP 80 80
service-object "tcp-80,443 tcp 443" TCP 443 443
service-group "tcp-80,443"
    service-object "tcp-80,443 tcp 80"
    service-object "tcp-80,443 tcp 443"
    exit
service-object "tcp-53+udp-53 tcp 53" TCP 53 53
service-object "tcp-53+udp-53 udp 53" UDP 53 53
