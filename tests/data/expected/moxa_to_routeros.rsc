# Generated by FWShift - review the conversion report before loading this.
# A script for /import on RouterOS 6 or 7: /import file-name=FILE verbose=yes
# Nothing in it changes traffic until the disabled jump rules at its end are enabled (in Safe Mode).
:if ([:len [/ip firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
:if ([:len [/ipv6 firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
/interface list add name=fws-wan1 comment="fwshift"
/interface list member add list=fws-wan1 interface="wan1" comment="fwshift"
/interface list add name=fws-wan2 comment="fwshift"
/interface list member add list=fws-wan2 interface="wan2" comment="fwshift"
/interface list add name=fws-lan comment="fwshift"
/interface list member add list=fws-lan interface="lan" comment="fwshift"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan out-interface-list=fws-wan1 src-address=192.168.127.10-192.168.127.20 dst-address=172.16.40.5 protocol=tcp dst-port=502 action=accept comment="firewall 1"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-wan1 out-interface-list=fws-lan protocol=tcp dst-port=23 action=drop comment="firewall 2"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-wan1 out-interface-list=fws-lan src-address=198.51.100.0/24 dst-address=192.168.127.50 protocol=tcp dst-port=443 action=accept comment="firewall 3"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan out-interface-list=fws-wan2 src-address=192.168.127.30 protocol=udp dst-port=20000-20010 src-port=1024-65535 action=accept comment="firewall 4"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan protocol=icmp action=accept comment="firewall 5"
# disabled in the source: "firewall 6" from wan2 to lan; source 0.0.0.0/0; destination 0.0.0.0/0; service any; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-wan2 out-interface-list=fws-lan action=accept comment="firewall 6" disabled=yes
# FWSHIFT disabled, see the report: "firewall 7" from lan to wan1; source 0.0.0.0/0; destination 0.0.0.0/0; service any; action allow
# FWSHIFT disabled, see the report: "firewall 8" from wan2 to lan; source 0.0.0.0/0; destination 192.168.127.60-192.168.127.69; service tcp-8080-8090; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan src-address=192.168.127.200-192.168.127.250 action=drop comment="firewall 9"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-wan2 out-interface-list=fws-lan dst-address=192.168.127.60 protocol=tcp dst-port=22 action=accept comment="firewall 10"
/ip firewall filter add chain=fwshift-forward action=accept comment="fwshift: default"
/ipv6 firewall filter add chain=fwshift-forward action=accept comment="fwshift: default"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-wan1 dst-address=203.0.113.2 protocol=tcp dst-port=8443 action=dst-nat to-addresses=192.168.127.50 to-ports=443 comment="ip nat 1"
/ip firewall nat add chain=fwshift-dstnat dst-address=198.51.100.60 action=dst-nat to-addresses=192.168.127.60 comment="ip nat 2"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-wan2 src-address=192.168.127.60 action=src-nat to-addresses=198.51.100.60 comment="ip nat 2"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-wan1 src-address=192.168.127.1-192.168.127.199 action=masquerade comment="ip nat 3"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-wan1 src-address=192.168.127.200-192.168.127.250 action=masquerade comment="ip nat 4" disabled=yes
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-wan2 src-address=192.168.127.200-192.168.127.250 action=masquerade comment="ip nat 4" disabled=yes
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=dstnat action=jump jump-target=fwshift-dstnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
/ip firewall nat add chain=srcnat action=jump jump-target=fwshift-srcnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
