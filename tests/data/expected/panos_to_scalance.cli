configure terminal
firewall
service name FWS_web-browsing proto tcp src all dst port 80
service name FWS_ssl proto tcp src all dst port 443
service name FWS_tcp_53 proto tcp src all dst port 53
service name FWS_udp_53 proto udp src all dst port 53
service name FWS_tcp-8443 proto tcp src all dst port 8443
service name FWS_smtp proto tcp src all dst port 25
service name FWS_ssh proto tcp src all dst port 22
service name FWS_modbus proto tcp src all dst port 502
service name FWS_siemens-s7 proto tcp src all dst port 102
service name FWS_tcp_8080 proto tcp src all dst port 8080
service name FWS_tcp_9000-9010 proto tcp src all dst range 9000 - 9010
icmp name FWS_ping type 8 code 0 ver ipv4
ipv4rule from trust to untrust srcip 10.10.0.0/16 dstip 0.0.0.0/0 action acc service FWS_web-browsing log info prior 1
ipv4rule from trust to untrust srcip 10.10.0.0/16 dstip 0.0.0.0/0 action acc service FWS_ssl log info prior 1
ipv4rule from trust to untrust srcip 0.0.0.0/0 dstip 192.0.2.53-192.0.2.54 action acc service FWS_tcp_53 log info prior 1
ipv4rule from trust to untrust srcip 0.0.0.0/0 dstip 192.0.2.53-192.0.2.54 action acc service FWS_udp_53 log info prior 1
ipv4rule from dmz to untrust srcip 0.0.0.0/0 dstip 192.0.2.53-192.0.2.54 action acc service FWS_tcp_53 log info prior 1
ipv4rule from dmz to untrust srcip 0.0.0.0/0 dstip 192.0.2.53-192.0.2.54 action acc service FWS_udp_53 log info prior 1
ipv4rule from untrust to dmz srcip 0.0.0.0/0 dstip 10.20.0.10 action acc service FWS_tcp-8443 log info prior 1
ipv4rule from untrust to dmz srcip 0.0.0.0/0 dstip 10.20.0.25 action acc service FWS_smtp log info prior 1
ipv4rule from trust to ot srcip 10.10.7.15 dstip 10.30.1.0/24 action acc service FWS_modbus log info prior 1
ipv4rule from trust to ot srcip 10.10.7.15 dstip 10.30.1.0/24 action acc service FWS_siemens-s7 log info prior 1
ipv4rule from ot to untrust srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log info prior 2
ipv6rule from ot to untrust srcip ::/0 dstip ::/0 action drop log info prior 2
ipv4rule from trust to dmz srcip 10.10.0.0/16 dstip 10.20.0.10 action acc service FWS_web-browsing log info prior 3
ipv4rule from trust to dmz srcip 10.10.0.0/16 dstip 10.20.0.10 action acc service FWS_tcp_8080 log info prior 3
ipv4rule from trust to dmz srcip 10.10.0.0/16 dstip 10.20.0.10 action acc service FWS_ssl log info prior 3
ipv4rule from trust to dmz srcip 10.10.0.0/16 dstip 10.20.0.10 action acc service FWS_tcp-8443 log info prior 3
ipv4rule from trust to dmz srcip 10.10.0.0/16 dstip 10.20.0.10 action acc service FWS_tcp_9000-9010 log info prior 3
ipv4rule from trust to dmz srcip 0.0.0.0-10.10.199.255 dstip 10.20.0.10 action acc service FWS_ping log info prior 3
ipv4rule from trust to dmz srcip 0.0.0.0-10.10.199.255 dstip 10.20.0.25 action acc service FWS_ping log info prior 3
ipv4rule from trust to dmz srcip 0.0.0.0-10.10.199.255 dstip 192.0.2.53-192.0.2.54 action acc service FWS_ping log info prior 3
ipv4rule from trust to dmz srcip 10.10.201.0-255.255.255.255 dstip 10.20.0.10 action acc service FWS_ping log info prior 3
ipv4rule from trust to dmz srcip 10.10.201.0-255.255.255.255 dstip 10.20.0.25 action acc service FWS_ping log info prior 3
ipv4rule from trust to dmz srcip 10.10.201.0-255.255.255.255 dstip 192.0.2.53-192.0.2.54 action acc service FWS_ping log info prior 3
ipv4rule from trust to untrust srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 4
ipv6rule from trust to untrust srcip ::/0 dstip ::/0 action drop log no prior 4
ipv4rule from trust to dmz srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 4
ipv6rule from trust to dmz srcip ::/0 dstip ::/0 action drop log no prior 4
ipv4rule from trust to ot srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 4
ipv6rule from trust to ot srcip ::/0 dstip ::/0 action drop log no prior 4
ipv4rule from untrust to trust srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 4
ipv6rule from untrust to trust srcip ::/0 dstip ::/0 action drop log no prior 4
ipv4rule from untrust to dmz srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 4
ipv6rule from untrust to dmz srcip ::/0 dstip ::/0 action drop log no prior 4
ipv4rule from untrust to ot srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 4
ipv6rule from untrust to ot srcip ::/0 dstip ::/0 action drop log no prior 4
ipv4rule from dmz to trust srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 4
ipv6rule from dmz to trust srcip ::/0 dstip ::/0 action drop log no prior 4
ipv4rule from dmz to untrust srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 4
ipv6rule from dmz to untrust srcip ::/0 dstip ::/0 action drop log no prior 4
ipv4rule from dmz to ot srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 4
ipv6rule from dmz to ot srcip ::/0 dstip ::/0 action drop log no prior 4
ipv4rule from ot to trust srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 4
ipv6rule from ot to trust srcip ::/0 dstip ::/0 action drop log no prior 4
ipv4rule from ot to untrust srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 4
ipv6rule from ot to untrust srcip ::/0 dstip ::/0 action drop log no prior 4
ipv4rule from ot to dmz srcip 0.0.0.0/0 dstip 0.0.0.0/0 action drop log no prior 4
ipv6rule from ot to dmz srcip ::/0 dstip ::/0 action drop log no prior 4
exit
firewallnat
napt srcint untrust proto tcp type ipv4 dstip 203.0.113.10 transip 10.20.0.10 dstport 443 transport 8443
netmap source srcint dmz dstint untrust type ipv4 srcip 10.20.0.25 dstip 0.0.0.0/0 transip 203.0.113.25
netmap destination srcint untrust dstint dmz type ipv4 srcip 0.0.0.0/0 dstip 203.0.113.25 transip 10.20.0.25
src-nat srcint trust dstint untrust type ipv4 srcip 0.0.0.0/0 dstip 0.0.0.0/0 transip auto
exit
end
