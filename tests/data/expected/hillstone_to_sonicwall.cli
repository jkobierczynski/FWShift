    name "FWSHIFT lab to trust v6"
    exit
access-rule ipv6 from lab to untrust action deny source address group "FWSHIFT all IPv6" service any destination address any
    name "FWSHIFT lab to untrust v6"
    exit
access-rule ipv6 from trust to dmz action deny source address group "FWSHIFT all IPv6" service any destination address any
    name "FWSHIFT trust to dmz v6"
    exit
access-rule ipv6 from trust to lab action deny source address group "FWSHIFT all IPv6" service any destination address any
    name "FWSHIFT trust to lab v6"
    exit
access-rule ipv6 from trust to trust action deny source address group "FWSHIFT all IPv6" service any destination address any
    name "FWSHIFT trust to trust v6"
    exit
access-rule ipv6 from trust to untrust action deny source address group "FWSHIFT all IPv6" service any destination address any
