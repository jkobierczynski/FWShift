CONFIG FILTER RULE INSERT type=nat index=9 state=on action=nat srctarget=any srcif=WAN dsttarget=fws_web-public dstif=WAN dstport=fws_tcp_443 natdsttarget=fws_web-1 natdstarp=on comment="Publish web"
CONFIG FILTER RULE INSERT type=nat index=9 state=on action=nat srctarget=any srcif=WAN dsttarget=fws_mail-public dstif=WAN dstport=fws_tcp_2525 natdsttarget=fws_mail-1 natdstarp=on natdstport=fws_tcp_25 comment="Publish mail"
