configure terminal
firewall
service name FWS_http proto tcp src all dst port 80
service name FWS_https proto tcp src all dst port 443
service name FWS_smtp proto tcp src all dst port 25
service name FWS_tcp_53 proto tcp src all dst port 53
service name FWS_udp_53 proto udp src all dst port 53
service name FWS_ntp proto udp src all dst port 123
service name FWS_tcp_8080 proto tcp src all dst port 8080
service name FWS_tcp_8443 proto tcp src all dst port 8443
service name FWS_ssh proto tcp src all dst port 22
service name FWS_syslog proto udp src all dst port 514
service name FWS_tcp_5000-5010 proto tcp src all dst range 5000 - 5010
service name FWS_udp_6000_from_1024-65535 proto udp src range 1024 - 65535 dst port 6000
icmp name FWS_icmp_8_0 type 8 code 0 ver ipv4
proto name FWS_icmp num 1
ipv4rule from untrust to trust srcip 198.51.100.0/24 dstip 0.0.0.0/0 action drop log no prior 1
ipv4rule from untrust to dmz srcip 198.51.100.0/24 dstip 0.0.0.0/0 action drop log no prior 1
ipv4rule from untrust to lab srcip 198.51.100.0/24 dstip 0.0.0.0/0 action drop log no prior 1
