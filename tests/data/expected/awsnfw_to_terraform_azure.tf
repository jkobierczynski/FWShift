# Generated by FWShift: Azure network security groups (hashicorp/azurerm), as Terraform configuration.
# Read the report first: what is not written is listed there.
#
#   terraform init
#   terraform plan -var resource_group_name=...     shows what would be created (with -var subscription_id=...,
#                                                   or ARM_SUBSCRIPTION_ID in the environment, for azurerm 4 and later)
#   terraform apply -var resource_group_name=...    creates the groups and their rules
#
# The groups are associated with nothing: associate each with the subnets of the networks listed above it
# (azurerm_subnet_network_security_group_association). A group of the same name in the resource group makes the
# apply fail; nothing that exists is changed. Each list ends in the default of the source, before Azure's own.

terraform {
  required_version = ">= 1.3"
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = ">= 3.0"
    }
  }
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}

variable "subscription_id" {
  description = "The subscription (azurerm 4 and later need it here or in ARM_SUBSCRIPTION_ID)"
  type        = string
  default     = null
}

variable "resource_group_name" {
  description = "The resource group to create the groups in"
  type        = string
}

variable "location" {
  description = "Their location; the resource group's when not given"
  type        = string
  default     = null
}

data "azurerm_resource_group" "target" {
  name = var.resource_group_name
}

