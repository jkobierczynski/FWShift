}

output "fwshift_networks" {
  description = "Each network security group, with the networks of the subnets to associate it with"
  value = {
    "FWShift" = {
      id       = azurerm_network_security_group.nsg_FWShift.id
      networks = []
    }
  }
}

# Not written:
#   firewall 1: the rule is for zone lan, wan1, and a security rule names no zone: give the networks behind it with --zone-network
#   firewall 3: the rule is for zone wan1, lan, and a security rule names no zone: give the networks behind it with --zone-network
#   firewall 4: the rule is for zone lan, wan2, and a security rule names no zone: give the networks behind it with --zone-network
#   firewall 5: the rule is for zone lan, and a security rule names no zone: give the networks behind it with --zone-network
#   firewall 6: disabled in the source
#   firewall 7: not converted: source MAC address 00:90:e8:00:00:01, which the model cannot match; not converted: mode MAC: the policy filters by source MAC address, which the model cannot match; the rule is for zone lan, wan1, and a security rule names no zone: give the networks behind it with --zone-network
#   firewall 8: not converted: 'session-limit 50' is not converted; the rule is for zone wan2, lan, and a security rule names no zone: give the networks behind it with --zone-network
#   firewall 10: the rule is for zone wan2, lan, and a security rule names no zone: give the networks behind it with --zone-network
