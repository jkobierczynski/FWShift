    destination_address_prefix = "0.0.0.0/0"
    description                = "firewall 9"
  }

  security_rule {
    name                       = "firewall-9-in-3"
    priority                   = 130
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "Ah"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefixes    = ["192.168.127.200/29", "192.168.127.208/28", "192.168.127.224/28", "192.168.127.240/29", "192.168.127.248/31", "192.168.127.250/32"]
    destination_address_prefix = "0.0.0.0/0"
