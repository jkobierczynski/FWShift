configure terminal
address-object ipv4 "IPv4-Private-10.0.0.0-8" network 10.0.0.0 255.0.0.0 zone outside
address-object ipv4 "lan-net" network 10.10.0.0 255.255.255.0 zone inside
address-object ipv4 "dmz-net" network 10.20.0.0 255.255.255.0 zone dmz
address-object ipv4 "ot-net" network 10.30.0.0 255.255.255.0 zone inside
address-object ipv4 "partner-net" network 198.51.100.0 255.255.255.0 zone outside
address-object ipv6 "branch-v6" network 2001:db8:10:: /48 zone outside
address-object ipv4 "web-srv" host 10.20.0.10 zone dmz
address-object ipv4 "web-srv-pub" host 203.0.113.10 zone dmz
address-object ipv4 "mail-srv" host 10.20.0.25 zone dmz
address-object ipv4 "mail-srv-pub" host 203.0.113.25 zone dmz
address-object ipv4 "admin-pcs" range 10.10.0.100 10.10.0.120 zone inside
address-object ipv4 "nat-pool" range 203.0.113.100 203.0.113.110 zone dmz
address-object fqdn "updates" domain "updates.example.com" zone outside
address-object ipv4 "outside-interface" host 203.0.113.2 zone outside
address-object ipv4 "h 10.20.0.30" host 10.20.0.30 zone dmz
address-object ipv4 "r 10.10.0.200-10.10.0.250" range 10.10.0.200 10.10.0.250 zone dmz
address-object ipv4 "h 10.20.0.53" host 10.20.0.53 zone dmz
address-object ipv6 "h 2001:db8:20::10" host 2001:db8:20::10 zone dmz
address-group ipv4 "servers"
    address-object ipv4 "web-srv"
    address-object ipv4 "mail-srv"
    address-object ipv4 "h 10.20.0.30"
    exit
address-group ipv4 "internal"
    address-object ipv4 "lan-net"
    address-object ipv4 "dmz-net"
    address-object ipv4 "web-srv"
    address-object ipv4 "mail-srv"
    address-object ipv4 "h 10.20.0.30"
    exit
address-group ipv4 "dst pre-backup"
    address-object ipv4 "mail-srv"
    address-object ipv4 "mail-srv-pub"
    exit
address-group ipv4 "dst pre-partner-gre"
    address-object ipv4 "web-srv"
    address-object ipv4 "web-srv-pub"
    exit
address-group ipv4 "dst Inbound web"
    address-object ipv4 "web-srv"
    address-object ipv4 "web-srv-pub"
    exit
address-group ipv4 "dst Inbound mail"
    address-object ipv4 "mail-srv"
    address-object ipv4 "mail-srv-pub"
    exit
address-group ipv4 "dst Admin access"
    address-group ipv4 "servers"
    address-object ipv4 "mail-srv-pub"
    exit
address-group ipv4 "dst Helpdesk RDP"
    address-group ipv4 "servers"
    address-object ipv4 "mail-srv-pub"
    exit
address-group ipv4 "dst Partner service"
    address-object ipv4 "web-srv"
    address-object ipv4 "web-srv-pub"
    exit
service-object "HTTP 2" TCP 80 80
service-object "HTTPS 2" TCP 443 443
service-object "SSH 2" TCP 22 22
service-object "DNS_over_UDP" UDP 53 53
service-object "DNS_over_TCP" TCP 53 53
service-object "NTP-UDP" UDP 123 123
service-object "web-alt" TCP 8080 8081
service-object "smtp" TCP 25 25
service-object "backup" TCP 10000 10000
service-object "http-8080" TCP 8080 8080
service-object "http-8443" TCP 8443 8443
service-object "udp-3544" UDP 3544 3544
service-object "tcp-3389" TCP 3389 3389
service-object "tcp-8443" TCP 8443 8443
service-object "tcp-21" TCP 21 21
service-object "udp-53" UDP 53 53
service-object "udp-1024-65535" UDP 1024 65535
service-object "tcp 8080" TCP 8080 8080
service-group "web"
    service-object "HTTP 2"
    service-object "HTTPS 2"
    service-object "web-alt"
    exit
service-group "mgmt"
    service-object "SSH 2"
    service-object "Ping"
    exit
service-group "svc LAN DNS and NTP"
    service-object "DNS_over_UDP"
    service-object "DNS_over_TCP"
    service-object "NTP-UDP"
    exit
service-group "svc Inbound web"
    service-object "HTTP 2"
    service-object "HTTPS 2"
    exit
service-group "svc Uncategorised web"
    service-object "HTTP 2"
    service-object "HTTPS 2"
    exit
nat-policy inbound any outbound any source name "lan-net" translated-source original destination name "partner-net" translated-destination original service any translated-service original
    name "nat-1"
    comment "No NAT towards the partner"
    exit
nat-policy inbound any outbound any source any translated-source original destination name "web-srv-pub" translated-destination name "web-srv" service any translated-service original
    name "nat-2"
    comment "Web server"
    exit
nat-policy inbound any outbound any source any translated-source original destination name "outside-interface" translated-destination name "web-srv" service name "http-8443" translated-service name "tcp 8080"
    name "nat-3"
    comment "Test site on the interface addre"
    exit
nat-policy inbound any outbound any source name "lan-net" translated-source name "nat-pool" destination any translated-destination original service any translated-service original
    name "nat-4"
    comment "nat-4"
    exit
nat-policy inbound any outbound any source name "mail-srv" translated-source name "mail-srv-pub" destination any translated-destination original service any translated-service original
    name "nat-mail-srv"
    comment "nat-mail-srv"
    exit
nat-policy inbound any outbound any source any translated-source original destination name "mail-srv-pub" translated-destination name "mail-srv" service any translated-service original
    name "nat-mail-srv in"
    comment "inbound of nat-mail-srv"
    exit
access-rule ipv4 from inside to dmz action allow source address name "lan-net" service name "backup" destination address group "dst pre-backup"
    name "pre-backup"
    priority manual 1
    exit
access-rule ipv4 from outside to dmz action discard source address name "IPv4-Private-10.0.0.0-8" service any destination address any
    name "pre-spoofed"
    priority manual 1
    exit
access-rule ipv4 from outside to inside action discard source address name "IPv4-Private-10.0.0.0-8" service any destination address any
    name "pre-spoofed 2"
    priority manual 1
    exit
access-rule ipv4 from outside to outside action discard source address name "IPv4-Private-10.0.0.0-8" service any destination address any
    name "pre-spoofed 3"
    priority manual 1
    exit
