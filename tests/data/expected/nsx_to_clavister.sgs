add IPRule Index=8 Name=fws_App_to_DB Action=Allow SourceInterface=any SourceNetwork=fws_App_servers DestinationInterface=any DestinationNetwork=fws_DB_servers Service=fws_MySQL LogEnabled=No
set IPRule 8 -disable
add IPRule Index=9 Name=fws_Admins_SSH Action=Allow SourceInterface=any SourceNetwork=fws_Admins DestinationInterface=any DestinationNetwork=fws_DMZ Service=fws_SSH LogEnabled=No
add IPRule Index=10 Name=fws_Others_no_SSH Action=Drop SourceInterface=any SourceNetwork=fws_Others_no_SSH_src_not DestinationInterface=any DestinationNetwork=fws_DMZ Service=fws_SSH LogEnabled=No
add IPRule Index=11 Name=fws_Engineering_to_PLCs Action=Allow SourceInterface=any SourceNetwork=fws_10.10.7.15 DestinationInterface=any DestinationNetwork=fws_OT_cell Service=fws_Modbus LogEnabled=No
add IPRule Index=12 Name=fws_FTP_to_partner Action=Allow SourceInterface=any SourceNetwork=fws_LAN DestinationInterface=any DestinationNetwork=fws_198.51.100.40 Service=fws_FTP LogEnabled=No
add IPRule Index=13 Name=fws_TLS_out Action=Allow SourceInterface=any SourceNetwork=fws_LAN DestinationInterface=any DestinationNetwork=all-nets Service=fws_HTTPS LogEnabled=No
set IPRule 13 -disable
add IPRule Index=14 Name=fws_Ping_over_IPv6 Action=Allow SourceInterface=any SourceNetwork=all-nets6 DestinationInterface=any DestinationNetwork=all-nets6 Service=fws_ICMP-ALL_grp LogEnabled=No
add IPRule Index=15 Name=fws_Old_rule Action=Allow SourceInterface=any SourceNetwork=fws_LAN DestinationInterface=any DestinationNetwork=fws_DB_servers Service=fws_MySQL LogEnabled=No
set IPRule 15 -disable
add ReturnRule Index=16 Name=fws_return SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
add ReturnRule Index=17 Name=fws_return_v6 SourceInterface=any SourceNetwork=all-nets6 DestinationInterface=any DestinationNetwork=all-nets6 Service=all_services LogEnabled=No
cc
cc IPRuleSet main
add GotoRule Index=1 Name=fws_goto SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services RuleSet=fws_rules LogEnabled=No
add GotoRule Index=2 Name=fws_goto_v6 SourceInterface=any SourceNetwork=all-nets6 DestinationInterface=any DestinationNetwork=all-nets6 Service=all_services RuleSet=fws_rules LogEnabled=No
cc
