cc IPRuleSet fws_rules
add IPRule Index=1 Name=fws_Block_quarantined Action=Drop SourceInterface=any SourceNetwork=fws_nothing DestinationInterface=any DestinationNetwork=fws_nothing Service=all_services LogEnabled=Yes
set IPRule 1 -disable
add IPRule Index=2 Name=fws_DNS_to_resolvers Action=Allow SourceInterface=any SourceNetwork=fws_LAN DestinationInterface=any DestinationNetwork=fws_192.0.2.53 Service=fws_DNS_to_resolvers_svc LogEnabled=No
add IPRule Index=3 Name=fws_NTP Action=Allow SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_192.0.2.123 Service=fws_NTP.services LogEnabled=No
add IPRule Index=4 Name=fws_Guests_stay_out Action=Drop SourceInterface=any SourceNetwork=fws_Guests DestinationInterface=any DestinationNetwork=fws_10.0.0.0_8 Service=all_services LogEnabled=No
add IPRule Index=5 Name=fws_LAN_block_the_rest Action=Drop SourceInterface=any SourceNetwork=fws_LAN DestinationInterface=any DestinationNetwork=all-nets Service=fws_SSH LogEnabled=No
set IPRule 5 -disable
add IPRule Index=6 Name=fws_Inbound_web Action=Allow SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=fws_Web_servers Service=fws_Web_all_grp LogEnabled=Yes
