resource "google_compute_network_firewall_policy_rule" "r1040" {
  project         = var.project
  firewall_policy = google_compute_network_firewall_policy.policy.name
  priority        = 1040
  direction       = "INGRESS"
  action          = "deny"
  description     = "fwshift-default-deny"
  match {
    src_ip_ranges  = ["::/0"]
    dest_ip_ranges = ["::/0"]
