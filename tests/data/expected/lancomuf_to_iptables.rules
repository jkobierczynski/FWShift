*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A POSTROUTING -o WAN -s 192.168.10.0/24 -p tcp -m tcp --dport 80 -m comment --comment "LAN to Internet - internet.http (NAT)" -j MASQUERADE
-A POSTROUTING -o WAN -s 192.168.10.0/24 -p tcp -m tcp --dport 443 -m comment --comment "LAN to Internet - internet.https (NAT)" -j MASQUERADE
-A POSTROUTING -o WAN -s 192.168.10.0/24 -p tcp -m tcp --dport 53 -m comment --comment "LAN to Internet - standard.dns (NAT)" -j MASQUERADE
-A POSTROUTING -o WAN -s 192.168.10.0/24 -p udp -m udp --dport 53 -m comment --comment "LAN to Internet - standard.dns (NAT)" -j MASQUERADE
