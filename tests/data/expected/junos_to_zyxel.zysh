ip virtual-server FWS_inbound_static-mail interface ge-0/0/0.0 original-ip 203.0.113.25 map-to 10.20.0.25 map-type any
ip virtual-server FWS_from-internet_dnat-web interface ge-0/0/0.0 original-ip 203.0.113.10 map-to 10.20.0.80 map-type port protocol any original-port 80 mapped-port 8080
policy insert 1
 deactivate
 description "FWShift inbound static-mail (outbound)"
 source FWS_mail-srv
 destination any
 service any
 next-hop auto
 snat pool FWS_203_0_113_25
 no deactivate
exit
policy insert 2
 deactivate
 description "FWShift trust-out snat-lan"
 interface ge-0/0/1.0
 source FWS_lan-net
 destination any
 service any
 next-hop auto
 snat outgoing-interface
 no deactivate
exit
policy insert 3
 deactivate
 description "FWShift dmz-out snat-dmz"
 interface ge-0/0/2.0
 source FWS_dmz-net__dmz-book_
