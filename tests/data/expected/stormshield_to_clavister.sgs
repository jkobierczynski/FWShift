add Address IP4Group fws_local_4_dst_not Members=fws_local_4_dst_not_1,fws_local_4_dst_not_2,fws_local_4_dst_not_3,fws_local_4_dst_not_4
add Service ServiceGroup fws_web_ports_grp Members=fws_web_ports_1,fws_web_ports_2,fws_web_ports_3
add Service ServiceGroup fws_local_8_svc Members=fws_http,fws_https
add Address IP4Group fws_dmz_servers Members=fws_web_srv,fws_mail_srv
add Address IP4Group fws_local_13_src_not Members=fws_local_13_src_not_1,fws_local_13_src_not_2
add Service ServiceGroup fws_local_15_svc Members=fws_http,fws_web_alt
add IPRuleSet fws_rules Comments="Written by FWShift"
cc IPRuleSet fws_rules
add IPRule Index=1 Name=fws_global_1 Action=Drop SourceInterface=fws_zones SourceNetwork=fws_global_bad DestinationInterface=fws_zones DestinationNetwork=all-nets Service=all_services LogEnabled=Yes Comments="blocked company-wide"
add IPRule Index=2 Name=fws_local_1 Action=Allow SourceInterface=ethernet1 SourceNetwork=fws_admins DestinationInterface=fws_zones DestinationNetwork=fws_firewall_all Service=fws_local_1_svc LogEnabled=Yes Comments="admin access"
add IPRule Index=3 Name=fws_local_2 Action=Allow SourceInterface=fws_zones SourceNetwork=fws_Network_internals DestinationInterface=fws_zones DestinationNetwork=fws_firewall_all Service=fws__rule__ipproto-icmp LogEnabled=Yes Comments="ping the firewall"
add IPRule Index=4 Name=fws_local_3 Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=fws_blocked Service=all_services LogEnabled=Yes Comments="known bad"
add IPRule Index=5 Name=fws_local_4 Action=Allow SourceInterface=fws_zones SourceNetwork=fws_Network_internals DestinationInterface=fws_zones DestinationNetwork=fws_local_4_dst_not Service=fws_web_ports_grp LogEnabled=Yes Comments="web"
add IPRule Index=6 Name=fws_local_5 Action=Allow SourceInterface=ethernet1 SourceNetwork=fws_lan DestinationInterface=fws_zones DestinationNetwork=all-nets Service=fws__rule__dns_udp-udp LogEnabled=Yes Comments="dns"
add IPRule Index=7 Name=fws_local_6 Action=Reject SourceInterface=fws_zones SourceNetwork=fws_Network_internals DestinationInterface=fws_zones DestinationNetwork=all-nets Service=fws_ident LogEnabled=Yes
add IPRule Index=8 Name=fws_local_8 Action=Allow SourceInterface=ethernet0 SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=fws_web_pub Service=fws_local_8_svc LogEnabled=Yes Comments="public web, as it arrives"
add IPRule Index=9 Name=fws_local_9 Action=Allow SourceInterface=ethernet0 SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=fws_dmz_servers Service=fws_smtp LogEnabled=Yes
add IPRule Index=10 Name=fws_local_10 Action=Allow SourceInterface=ethernet3 SourceNetwork=fws_lab_net DestinationInterface=fws_zones DestinationNetwork=all-nets Service=fws_lab_tools LogEnabled=Yes
add IPRule Index=11 Name=fws_local_11 Action=Allow SourceInterface=fws_zones SourceNetwork=fws_lan DestinationInterface=fws_zones DestinationNetwork=fws_dmz_servers Service=fws_web_ports_grp LogEnabled=Yes
set IPRule 11 -disable
add IPRule Index=12 Name=fws_local_12 Action=Allow SourceInterface=fws_zones SourceNetwork=fws_lab_net DestinationInterface=fws_zones DestinationNetwork=all-nets Service=fws__rule__ipproto-proto_200 LogEnabled=Yes
add IPRule Index=13 Name=fws_local_13 Action=Allow SourceInterface=any SourceNetwork=fws_nothing DestinationInterface=any DestinationNetwork=fws_nothing Service=all_services LogEnabled=Yes
set IPRule 13 -disable
add IPRule Index=14 Name=fws_local_14 Action=Allow SourceInterface=fws_zones SourceNetwork=fws_lan6 DestinationInterface=fws_zones DestinationNetwork=all-nets6 Service=all_services LogEnabled=Yes
add IPRule Index=15 Name=fws_local_15 Action=Allow SourceInterface=any SourceNetwork=fws_nothing DestinationInterface=any DestinationNetwork=fws_nothing Service=all_services LogEnabled=Yes
set IPRule 15 -disable
add IPRule Index=16 Name=fws_local_16 Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=all-nets Service=all_services LogEnabled=Yes Comments="Block all"
add IPRule Index=17 Name=fws_local_16_v6 Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets6 DestinationInterface=fws_zones DestinationNetwork=all-nets6 Service=all_services LogEnabled=Yes Comments="Block all"
add IPRule Index=18 Name=fws_default Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=fws_zones DestinationNetwork=all-nets Service=all_services LogEnabled=No
add IPRule Index=19 Name=fws_default_v6 Action=Drop SourceInterface=fws_zones SourceNetwork=all-nets6 DestinationInterface=fws_zones DestinationNetwork=all-nets6 Service=all_services LogEnabled=No
add ReturnRule Index=20 Name=fws_return SourceInterface=any SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services LogEnabled=No
add ReturnRule Index=21 Name=fws_return_v6 SourceInterface=any SourceNetwork=all-nets6 DestinationInterface=any DestinationNetwork=all-nets6 Service=all_services LogEnabled=No
cc
cc IPRuleSet main
add GotoRule Index=1 Name=fws_goto SourceInterface=fws_zones SourceNetwork=all-nets DestinationInterface=any DestinationNetwork=all-nets Service=all_services RuleSet=fws_rules LogEnabled=No
add GotoRule Index=2 Name=fws_goto_v6 SourceInterface=fws_zones SourceNetwork=all-nets6 DestinationInterface=any DestinationNetwork=all-nets6 Service=all_services RuleSet=fws_rules LogEnabled=No
cc
