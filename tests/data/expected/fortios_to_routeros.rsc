# Generated by FWShift - review the conversion report before loading this.
# A script for /import on RouterOS 6 or 7: /import file-name=FILE verbose=yes
# Nothing in it changes traffic until the disabled jump rules at its end are enabled (in Safe Mode).
:if ([:len [/ip firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
:if ([:len [/ipv6 firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
/interface list add name=fws-wan1 comment="fwshift"
/interface list member add list=fws-wan1 interface="wan1" comment="fwshift"
/interface list add name=fws-lan comment="fwshift"
/interface list member add list=fws-lan interface="internal1" comment="fwshift"
/interface list member add list=fws-lan interface="internal2" comment="fwshift"
/interface list add name=fws-dmz comment="fwshift"
/interface list member add list=fws-dmz interface="dmz" comment="fwshift"
/interface list add name=fws-ot comment="fwshift"
/interface list member add list=fws-ot interface="ot" comment="fwshift"
/ip firewall address-list add list=fws-dmz-servers address="10.20.0.10"
/ip firewall address-list add list=fws-dmz-servers address="10.20.0.25"
/ip firewall address-list add list=fws-r7-dst address="updates.example.com"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan out-interface-list=fws-wan1 src-address=10.10.0.0/15 protocol=tcp dst-port=80,443,53 action=accept comment="LAN to Internet"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan out-interface-list=fws-wan1 src-address=10.10.0.0/15 protocol=udp dst-port=53 action=accept comment="LAN to Internet"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan out-interface-list=fws-wan1 protocol=tcp dst-port=53 action=accept comment="LAN basics"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan out-interface-list=fws-wan1 protocol=udp dst-port=53 action=accept comment="LAN basics"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan out-interface-list=fws-wan1 protocol=icmp icmp-options=8:0-255 action=accept comment="LAN basics"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-wan1 out-interface-list=fws-dmz dst-address=10.20.0.10 protocol=tcp dst-port=8080,8443,9000-9010 action=accept log=yes log-prefix="Inbound web" comment="Inbound web"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-wan1 out-interface-list=fws-dmz dst-address=10.20.0.25 protocol=tcp dst-port=25 action=accept comment="Inbound mail"
# FWSHIFT disabled, see the report: "Admins to DMZ" from lan to dmz; source admin-range; destination dmz-servers; service SSH; action allow
# FWSHIFT disabled, see the report: "Block geo" from any to wan1; source any; destination geo-blocked; service any; action drop
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-dmz out-interface-list=fws-wan1 src-address-list=fws-dmz-servers dst-address-list=fws-r7-dst protocol=tcp dst-port=443 action=accept comment="DMZ out via pool"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan out-interface-list=fws-ot src-address=10.10.7.15 dst-address=10.30.1.0/24 protocol=tcp dst-port=502 action=accept comment="SCADA to PLCs"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-ot out-interface-list=fws-wan1 action=drop comment="OT no internet"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan out-interface-list=fws-wan1 src-address=10.10.0.0/15 dst-address=10.99.0.0/16 protocol=udp dst-port=514 src-port=1024-65535 action=accept comment="Partner tunnel"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan out-interface-list=fws-wan1 src-address=10.10.0.0/15 dst-address=10.99.0.0/16 protocol=gre action=accept comment="Partner tunnel"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-lan out-interface-list=fws-wan1 src-address=2001:db8:10::/48 protocol=tcp dst-port=443 action=accept comment="LAN v6 out"
# FWSHIFT disabled, see the report: "policy-12" from lan to dmz; source lan-net; destination web-1; service HTTP; action allow
# disabled in the source: "Not web" from dmz to wan1; source web-1; destination any; service not Web Access; action allow
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-dmz out-interface-list=fws-wan1 src-address=10.20.0.10 action=jump jump-target=fwshift-r1 comment="Not web" disabled=yes
/ip firewall filter add chain=fwshift-r1 protocol=tcp dst-port=80,443 action=return
/ip firewall filter add chain=fwshift-r1 action=accept comment="Not web"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-lan out-interface-list=fws-dmz src-address=10.10.5.10-10.10.5.20 dst-address-list=fws-dmz-servers protocol=icmp icmp-options=13:0-255 action=accept comment="Timestamp probes"
/ip firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ipv6 firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-wan1 dst-address=203.0.113.10 protocol=tcp dst-port=443 action=dst-nat to-addresses=10.20.0.10 to-ports=8443 comment="vip-web"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-wan1 dst-address=203.0.113.25 action=dst-nat to-addresses=10.20.0.25 comment="vip-mail"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-wan1 src-address=10.10.0.0/15 action=masquerade comment="snat-1"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-wan1 action=masquerade comment="snat-2"
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=dstnat action=jump jump-target=fwshift-dstnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
/ip firewall nat add chain=srcnat action=jump jump-target=fwshift-srcnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
