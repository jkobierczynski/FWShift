# Generated by FWShift - review the conversion report before loading this.
# A script for /import on RouterOS 6 or 7: /import file-name=FILE verbose=yes
# Nothing in it changes traffic until the disabled jump rules at its end are enabled (in Safe Mode).
:if ([:len [/ip firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
:if ([:len [/ipv6 firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
/interface list add name=fws-WAN comment="fwshift"
/interface list member add list=fws-WAN interface="Port2" comment="fwshift"
/interface list add name=fws-LAN comment="fwshift"
/interface list member add list=fws-LAN interface="Port1" comment="fwshift"
/interface list member add list=fws-LAN interface="Port3" comment="fwshift"
/interface list add name=fws-DMZ comment="fwshift"
/interface list member add list=fws-DMZ interface="Port4" comment="fwshift"
/interface list add name=fws-OT comment="fwshift"
/interface list member add list=fws-OT interface="Port5" comment="fwshift"
/ip firewall address-list add list=fws-dmz-servers address="10.20.0.10"
/ip firewall address-list add list=fws-dmz-servers address="10.20.0.25"
/ip firewall address-list add list=fws-r7-src address="10.10.0.0-10.10.5.9"
/ip firewall address-list add list=fws-r7-src address="10.10.5.21-10.11.255.255"
/ip firewall address-list add list=fws-update-sites address="mirror.example.net"
/ip firewall address-list add list=fws-update-sites address="updates.example.com"
/ipv6 firewall address-list add list=fws-update-sites address="mirror.example.net"
/ipv6 firewall address-list add list=fws-update-sites address="updates.example.com"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
# FWSHIFT disabled, see the report: "Block countries" from WAN to any; source Blocked countries; destination 0.0.0.0/0; service any; action drop
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-WAN src-address=10.10.0.0/15 protocol=tcp dst-port=80,443,53 action=accept comment="LAN to Internet web"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-WAN src-address=10.10.0.0/15 protocol=udp dst-port=53 action=accept comment="LAN to Internet web"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-WAN src-address=10.10.0.0/15 protocol=tcp dst-port=80 action=accept comment="LAN web again"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-DMZ src-address=10.10.5.10-10.10.5.20 dst-address-list=fws-dmz-servers protocol=tcp dst-port=22 action=accept comment="Admins to DMZ"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-DMZ src-address=10.10.5.10-10.10.5.20 dst-address-list=fws-dmz-servers protocol=icmp icmp-options=8:0-255 action=accept comment="Admins to DMZ"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-DMZ src-address=10.10.0.0/15 dst-address=!10.20.0.25 protocol=tcp dst-port=80,443 action=accept comment="LAN to DMZ web not mail"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-OT src-address=10.10.0.0/15 protocol=tcp dst-port=22 action=accept comment="LAN SSH out"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-DMZ src-address-list=fws-r7-src protocol=tcp dst-port=22 action=accept comment="LAN SSH out-2"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-OT src-address-list=fws-r7-src protocol=tcp dst-port=22 action=accept comment="LAN SSH out-2"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-WAN out-interface-list=fws-DMZ dst-address=10.20.0.10 protocol=tcp dst-port=443 action=accept comment="Internet to web"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-WAN out-interface-list=fws-DMZ dst-address=10.20.0.25 protocol=tcp dst-port=2525 action=accept comment="Internet to mail"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-OT out-interface-list=fws-LAN src-address=10.30.1.0/24 dst-address=10.10.7.15 protocol=tcp dst-port=502 action=accept comment="OT to SCADA"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-OT out-interface-list=fws-LAN src-address=10.30.1.0/24 dst-address=10.10.7.15 protocol=udp dst-port=514 src-port=1024-65535 action=accept comment="OT to SCADA"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-DMZ out-interface-list=fws-WAN src-address-list=fws-dmz-servers dst-address-list=fws-update-sites protocol=tcp dst-port=443 action=accept comment="DMZ updates"
# FWSHIFT disabled, see the report: "Finance to app" from LAN to DMZ; source 0.0.0.0/0; destination web-1; service app-ports; action allow
# FWSHIFT disabled, see the report: "DNS in office hours" from OT to LAN; source 0.0.0.0/0; destination dns-servers; service basic-net; action allow
# disabled in the source: "Old test rule" from any to any; source 0.0.0.0/0; destination any; service GRE,TIMESTAMP; action allow
/ip firewall filter add chain=fwshift-forward protocol=gre action=accept comment="Old test rule" disabled=yes
/ip firewall filter add chain=fwshift-forward protocol=icmp icmp-options=13:0-255 action=accept comment="Old test rule" disabled=yes
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-LAN action=reject comment="Reject the rest from LAN"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-WAN src-address=2001:db8:10::/48 protocol=tcp dst-port=80,443 action=accept comment="LAN6 to Internet"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-LAN out-interface-list=fws-WAN src-address=2001:db8:10::/48 protocol=icmpv6 icmp-options=128:0-255 action=accept comment="LAN6 to Internet"
/ip firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ipv6 firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-WAN dst-address=198.51.100.10 protocol=tcp dst-port=443 action=dst-nat to-addresses=10.20.0.10 comment="Publish web"
/ip firewall nat add chain=fwshift-dstnat in-interface-list=fws-WAN dst-address=198.51.100.25 protocol=tcp dst-port=2525 action=dst-nat to-addresses=10.20.0.25 to-ports=25 comment="Publish mail"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-WAN src-address=10.20.0.25 action=src-nat to-addresses=198.51.100.25 comment="Mail server out"
/ip firewall nat add chain=fwshift-srcnat src-address=10.10.0.0/15 dst-address=10.99.0.0/16 action=accept comment="No NAT to partner"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-WAN src-address=10.10.0.0/15 protocol=tcp dst-port=80,443,53 action=masquerade comment="NAT of LAN to Internet web"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-WAN src-address=10.10.0.0/15 protocol=udp dst-port=53 action=masquerade comment="NAT of LAN to Internet web"
/ip firewall nat add chain=fwshift-srcnat out-interface-list=fws-WAN action=masquerade comment="Default SNAT IPv4"
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=dstnat action=jump jump-target=fwshift-dstnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
/ip firewall nat add chain=srcnat action=jump jump-target=fwshift-srcnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
