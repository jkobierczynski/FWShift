# Generated by FWShift: commands for the CLI of a Zyxel firewall with ZLD 4.x or 5.x (USG FLEX, ATP, VPN).
# Read the report first: what is not written is listed there. Nothing is deleted and nothing is saved.
# The rules are inserted from position 1 of the security policy on, each after the one before it,
# before the rules the firewall has. Every name starts with FWS_. Check, then save with write.
configure terminal
address-object FWS_Bad-Nets_1_alm 203.0.113.0/25
address-object FWS_Bad-Nets_2_alm 192.0.2.66
object-group address FWS_Block_Bad_dst
 address-object FWS_Bad-Nets_1_alm
 address-object FWS_Bad-Nets_2_alm
exit
service-object FWS_SSH tcp eq 22
address-object FWS_Admins_1_alm 10.10.5.10-10.10.5.20
service-object FWS_tcp_80 tcp eq 80
service-object FWS_tcp_443 tcp eq 443
service-object FWS_tcp_8000_8010 tcp range 8000 8010
object-group service FWS_Web_Out
 service-object FWS_tcp_80
 service-object FWS_tcp_443
 service-object FWS_tcp_8000_8010
exit
address-object FWS_Web-Public_2_snat 10.20.0.10
service-object FWS_tcp-2525 tcp eq 2525
address-object FWS_Mail-Public_2_snat 10.20.0.25
address-object FWS_nothing 0.0.0.0
address6-object FWS_nothing6 ::
service-object FWS_tcp_53 tcp eq 53
service-object FWS_udp_53 udp eq 53
object-group service FWS_DNS
 service-object FWS_tcp_53
 service-object FWS_udp_53
exit
service-object FWS_Staff_Only tcp eq 3389
service-object FWS_Ping icmp 8
service-object FWS_Lab_Tunnel protocol 47
zone FWS_External
exit
zone FWS_Trusted
exit
zone FWS_Guests
exit
zone FWS_Lab
exit
