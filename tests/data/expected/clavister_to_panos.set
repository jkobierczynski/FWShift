set address lan_ip ip-netmask 192.168.10.1/32
set address lan_net ip-netmask 192.168.10.0/24
set address dmz_ip ip-netmask 172.16.20.1/32
set address dmz_net ip-netmask 172.16.20.0/24
set address wan_ip ip-netmask 203.0.113.10/32
set address wan_net ip-netmask 203.0.113.0/24
set address guest_ip ip-netmask 10.30.0.1/32
set address guest_net ip-netmask 10.30.0.0/24
set address lan_ip6 ip-netmask 2001:db8:10::1/128
set address lan_net6 ip-netmask 2001:db8:10::/64
set address web_srv ip-netmask 172.16.20.80/32
set address web_srv description "Web server in the DMZ"
set address mail_srv ip-netmask 172.16.20.25/32
set address wan_ip2 ip-netmask 203.0.113.12/32
set address pub_pool ip-range 203.0.113.20-203.0.113.23
set address srv_base ip-netmask 172.16.20.100/32
set address admin_hosts_1 ip-netmask 192.168.10.5/32
set address admin_hosts_2 ip-netmask 192.168.10.6/32
set address admin_hosts_3 ip-netmask 192.168.10.32/28
set address v6_web ip-netmask 2001:db8:20::80/128
set address updates fqdn updates.example.com
set address-group admin_hosts static [ admin_hosts_1 admin_hosts_2 admin_hosts_3 ]
set address-group admin_hosts description "IP4Address with a list of addresses"
set address-group servers static [ web_srv mail_srv ]
set service smtp-in protocol tcp port 25
set service web-ports protocol tcp port 80,443,8080-8090
set service dns-both-tcp protocol tcp port 53
set service dns-both-udp protocol udp port 53
set service-group dns-both members [ dns-both-tcp dns-both-udp ]
set service syslog protocol udp port 514
set service syslog protocol udp source-port 1024-65535
set service ftp-alg protocol tcp port 21
set service netbios-all protocol tcp port 1
set service netbios-all description "FWSHIFT PLACEHOLDER, matches nothing: a service that is not in the script"
set service http-all protocol tcp port 80,443
set service http-all description "predefined service of cOS Core"
set service dns-all-tcp protocol tcp port 53
set service dns-all-tcp description "predefined service of cOS Core"
set service dns-all-udp protocol udp port 53
set service dns-all-udp description "predefined service of cOS Core"
set service-group dns-all members [ dns-all-tcp dns-all-udp ]
set service ssh protocol tcp port 22
set service ssh description "predefined service of cOS Core"
set service https protocol tcp port 443
set service https description "predefined service of cOS Core"
set service-group mgmt members [ ssh https ]
