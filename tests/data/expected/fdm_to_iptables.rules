*filter
:FORWARD DROP [0:0]
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
-A FORWARD -i inside_zone -o inside_zone -s 10.41.0.0/24 -d 10.40.0.0/24 -m comment --comment "Block_IoT_to_office" -j DROP
-A FORWARD -i inside_zone -o outside_zone -s 10.40.0.0/24 -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -m comment --comment "Inside_Outside_web" -j ACCEPT
-A FORWARD -i inside_zone -o outside_zone -s 10.40.0.0/24 -p udp -m udp --dport 53 -m conntrack --ctstate NEW -m comment --comment "Inside_Outside_web" -j ACCEPT
-A FORWARD -i inside_zone -o outside_zone -s 10.41.0.0/24 -d telemetry.example.net -p tcp -m tcp --dport 443 -m conntrack --ctstate NEW -m comment --comment "IoT_telemetry" -j ACCEPT
-A FORWARD -i outside_zone -o inside_zone -d 10.40.0.10/32 -p tcp -m tcp --dport 5001 -m conntrack --ctstate NEW -m comment --comment "NAS_from_Internet" -j ACCEPT
-A FORWARD -i outside_zone -o inside_zone -p udp -m udp --dport 1024:65535 -m udp --sport 53 -m conntrack --ctstate NEW -m comment --comment "DNS_answers" -j ACCEPT
