COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i outside_zone -d 192.0.2.2/32 -p tcp -m tcp --dport 8443 -m comment --comment "NAS_published" -j DNAT --to-destination 10.40.0.10:5001
-A PREROUTING -d 192.0.2.10 -m comment --comment "nas_static inbound" -j DNAT --to-destination 10.40.0.10
-A POSTROUTING -o outside_zone -s 10.40.0.10/32 -m comment --comment "nas_static" -j SNAT --to-source 192.0.2.10
-A POSTROUTING -o outside_zone -m comment --comment "InsideOutsideNatRule" -j MASQUERADE
