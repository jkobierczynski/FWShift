set address LAN1_SUBNET ip-netmask 10.10.0.0/24
set address LAN2_SUBNET ip-netmask 10.20.0.0/24
set address LAB_SUBNET ip-netmask 0.0.0.0/32
set address LAB_SUBNET description "FWSHIFT PLACEHOLDER, matches nothing: interface-subnet ge6: interface-subnet of ge6: the interface gets its address by dhcp"
set address WAN_IP ip-netmask 198.51.100.2
set address WEB_SRV ip-netmask 10.30.0.10/32
set address MAIL_SRV ip-netmask 10.30.0.25/32
set address ADMIN_PCS ip-range 10.10.0.50-10.10.0.59
set address PARTNER_NET ip-netmask 203.0.113.0/25
set address MONITOR ip-netmask 192.0.2.0/24
set address PUBLIC_WEB ip-netmask 198.51.100.10/32
set address PUBLIC_RANGE ip-range 198.51.100.20-198.51.100.23
set address INSIDE_RANGE ip-range 10.30.0.20-10.30.0.23
set address PORTAL fqdn portal.example.com
set address COUNTRY_X ip-netmask 0.0.0.0/32
set address COUNTRY_X description "FWSHIFT PLACEHOLDER, matches nothing: geography XX: not an address FWShift can read"
set address V6_LAN ip-netmask 2001:db8:10::/64
set address V6_DMZ_WEB ip-netmask 2001:db8:30::10/128
set address V6_ADMIN ip-range 2001:db8:10::50-2001:db8:10::59
set address-group SERVERS static [ WEB_SRV MAIL_SRV ]
set address-group SERVERS description "DMZ servers"
set address-group ALL_INTERNAL static [ LAN1_SUBNET LAN2_SUBNET SERVERS ]
set address-group V6_ADMINS static V6_ADMIN
set service HTTP protocol tcp port 80
set service HTTPS protocol tcp port 443
set service SSH protocol tcp port 22
set service DNS_UDP protocol udp port 53
set service DNS_TCP protocol tcp port 53
set service SMTP protocol tcp port 25
set service WEB_ALT protocol tcp port 8080-8089
set service HTTPS_8443 protocol tcp port 8443
set service Any_TCP protocol tcp port 1-65535
set service DNS-sourceport-1024-65535 protocol udp port 53
set service DNS-sourceport-1024-65535 protocol udp source-port 1024-65535
set service DNS-sourceport-1024-65535 description "the service of rule DNS_From_Port with its source port"
set service udp-5060 protocol udp port 5060
set service-group DNS members [ DNS_UDP DNS_TCP ]
set service-group WEB members [ HTTP HTTPS WEB_ALT HTTPS_8443 ]
set service-group MGMT members [ SSH WEB ]
