configure terminal
firewall
service name FWS_tcp_587 proto tcp src all dst port 587
service name FWS_tcp_993 proto tcp src all dst port 993
service name FWS_tcp_5061 proto tcp src all dst port 5061
service name FWS_udp_5060 proto udp src all dst port 5060
service name FWS_udp_10000-20000 proto udp src all dst range 10000 - 20000
service name FWS_app-ssh-jump proto tcp src all dst port 22
service name FWS_tcp_3389 proto tcp src all dst port 3389
service name FWS_udp_3389 proto udp src all dst port 3389
service name FWS_tcp_9418 proto tcp src all dst port 9418
service name FWS_svc-ntp proto udp src all dst port 123
service name FWS_HTTPS proto tcp src all dst port 443
proto name FWS_svc-ping num 1
service name FWS_tcp_53 proto tcp src all dst port 53
service name FWS_udp_53 proto udp src all dst port 53
ipv4rule from client to internet srcip 0.0.0.0/0 dstip 192.0.2.128/26 action drop log info prior 1
