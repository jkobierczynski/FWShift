# Generated by FWShift - review the conversion report before loading this.
# A script for /import on RouterOS 6 or 7: /import file-name=FILE verbose=yes
# Nothing in it changes traffic until the disabled jump rules at its end are enabled (in Safe Mode).
:if ([:len [/ip firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
:if ([:len [/ipv6 firewall filter find where chain="fwshift-forward"]] > 0) do={ :error "FWShift objects of an earlier conversion are on this router: remove them first (see the report)" }
/interface list add name=fws-InternalZone comment="fwshift"
/interface list member add list=fws-InternalZone interface="InternalZone" comment="fwshift"
/interface list add name=fws-ExternalZone comment="fwshift"
/interface list member add list=fws-ExternalZone interface="ExternalZone" comment="fwshift"
/ip firewall address-list add list=fws-r1-src address="10.10.0.0/16"
/ip firewall address-list add list=fws-r1-src address="10.20.0.0/24"
/ip firewall address-list add list=fws-dns-servers address="192.0.2.53"
/ip firewall address-list add list=fws-dns-servers address="192.0.2.54"
/ip firewall address-list add list=fws-dmz-servers address="10.20.0.10"
/ip firewall address-list add list=fws-dmz-servers address="203.0.113.10"
/ip firewall address-list add list=fws-dmz-servers address="10.20.0.25"
/ip firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ip firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ipv6 firewall filter add chain=fwshift-forward action=accept connection-state=established,related,untracked comment="fwshift: replies"
/ipv6 firewall filter add chain=fwshift-forward action=drop connection-state=invalid comment="fwshift: invalid"
/ip firewall filter add chain=fwshift-forward src-address-list=fws-r1-src dst-address-list=fws-dns-servers protocol=udp dst-port=53 action=accept comment="DNS"
/ip firewall filter add chain=fwshift-forward src-address-list=fws-r1-src dst-address-list=fws-dns-servers protocol=tcp dst-port=53 action=accept comment="DNS"
/ip firewall filter add chain=fwshift-forward src-address=10.10.5.10-10.10.5.20 dst-address-list=fws-dmz-servers protocol=tcp dst-port=22 action=accept comment="rule-2"
/ip firewall filter add chain=fwshift-forward in-interface-list=fws-InternalZone out-interface-list=fws-ExternalZone protocol=tcp dst-port=80,443 action=accept comment="Web out"
/ipv6 firewall filter add chain=fwshift-forward in-interface-list=fws-InternalZone out-interface-list=fws-ExternalZone protocol=tcp dst-port=80,443 action=accept comment="Web out"
/ip firewall filter add chain=fwshift-forward src-address=10.10.200.0/24 dst-address-list=!fws-dns-servers action=drop comment="Guests stay out"
# FWSHIFT disabled, see the report: "Social" from any to any; source lan-net; destination any; service Facebook; action allow
# FWSHIFT disabled, see the report: "Admins" from any to any; source netadmins; destination plc-net; service any; action allow
/ip firewall filter add chain=fwshift-forward src-address=10.10.5.10-10.10.5.20 dst-address=10.30.1.0/24 protocol=tcp dst-port=443,22 action=accept comment="PLC access"
# FWSHIFT disabled, see the report: "PLC access (plc-operators)" from any to any; source lan-net; destination plc-net; service https,ssh; action allow
# FWSHIFT disabled, see the report: "PLC access (vendor-support)" from any to any; source any; destination plc-net; service https,ssh; action allow
# FWSHIFT disabled, see the report: "DMZ users" from any to any; source dmz-net; destination any; service https; action allow
# FWSHIFT disabled, see the report: "Updates" from any to any; source dmz-servers; destination .updates.example.com; service https; action allow
# FWSHIFT disabled, see the report: "Old rule" from any to any; source lan-without-guests; destination any; service syslog-from-high; action allow
# FWSHIFT disabled, see the report: "Partners" from any to any; source lan-net; destination plc-net; service any; action allow
/ipv6 firewall filter add chain=fwshift-forward src-address=2001:db8:10::/48 protocol=tcp dst-port=443 action=accept comment="IPv6 out"
/ip firewall filter add chain=fwshift-forward dst-address=10.20.0.10 protocol=tcp dst-port=443 action=accept comment="Public web"
/ip firewall filter add chain=fwshift-forward dst-address=10.20.0.10 protocol=tcp dst-port=443,9000-9010 action=accept comment="DMZ access / Web in"
/ip firewall filter add chain=fwshift-forward dst-address=10.20.0.25 protocol=tcp dst-port=25 action=accept comment="DMZ access / Mail in"
/ip firewall filter add chain=fwshift-forward src-address=10.10.0.0/16 dst-address=10.20.0.0/24 protocol=icmp icmp-options=8:0-255 action=accept comment="DMZ access / Ping from LAN"
/ip firewall filter add chain=fwshift-forward dst-address=10.20.0.0/24 action=drop comment="DMZ access (cleanup of DMZ-Layer)"
/ip firewall filter add chain=fwshift-forward dst-address=198.51.100.1 protocol=gre action=accept comment="Tunnels"
/ip firewall filter add chain=fwshift-forward protocol=tcp dst-port=113 action=reject reject-with=tcp-reset comment="No ident"
/ipv6 firewall filter add chain=fwshift-forward protocol=tcp dst-port=113 action=reject reject-with=tcp-reset comment="No ident"
/ip firewall filter add chain=fwshift-forward action=drop comment="Cleanup rule"
/ipv6 firewall filter add chain=fwshift-forward action=drop comment="Cleanup rule"
/ip firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ipv6 firewall filter add chain=fwshift-forward action=drop comment="fwshift: default"
/ip firewall nat add chain=fwshift-srcnat src-address=10.20.0.10 action=src-nat to-addresses=203.0.113.10 comment="nat-1"
/ip firewall nat add chain=fwshift-dstnat dst-address=203.0.113.10 action=dst-nat to-addresses=10.20.0.10 comment="nat-2"
/ip firewall nat add chain=fwshift-srcnat src-address=10.30.1.0/24 dst-address=10.30.1.0/24 action=accept comment="nat-3"
/ip firewall nat add chain=fwshift-srcnat src-address=10.30.1.0/24 action=masquerade comment="nat-4"
/ip firewall nat add chain=fwshift-srcnat src-address=10.10.0.0/16 dst-address=10.20.0.0/24 action=accept comment="nat-5"
/ip firewall nat add chain=fwshift-dstnat dst-address=203.0.113.25 protocol=tcp dst-port=2525 action=dst-nat to-addresses=10.20.0.25 to-ports=25 comment="nat-6"
/ip firewall nat add chain=fwshift-srcnat src-address=10.20.0.0/24 action=src-nat to-addresses=198.51.100.20 comment="nat-7"
/ip firewall nat add chain=fwshift-srcnat src-address=10.10.0.0/16 action=masquerade comment="nat-8"
/ip firewall nat add chain=fwshift-srcnat src-address=10.10.200.0/24 action=src-nat to-addresses=198.51.100.20 comment="nat-9" disabled=yes
# Switch the policy on: enable these in Safe Mode, and move them to where they belong in their chains.
/ip firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ipv6 firewall filter add chain=forward action=jump jump-target=fwshift-forward disabled=yes comment="fwshift: enable to switch the policy on"
/ip firewall nat add chain=dstnat action=jump jump-target=fwshift-dstnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
/ip firewall nat add chain=srcnat action=jump jump-target=fwshift-srcnat disabled=yes comment="fwshift: enable to switch the NAT rules on"
