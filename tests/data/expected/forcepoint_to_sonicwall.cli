address-object ipv4 "net-dmz" network 192.168.10.0 255.255.255.0 zone External
address-object ipv4 "net-lan (in rules)" range 10.1.0.1 10.1.255.254 zone Internal
address-object ipv4 "admins" range 10.1.5.10 10.1.5.20 zone External
address-object ipv4 "pub-web" host 203.0.113.10 zone External
address-object fqdn "updates.example.com" domain "updates.example.com" zone External
address-object fqdn "cdn.example.com" domain "cdn.example.com" zone External
address-object ipv4 "net-lan" network 10.1.0.0 255.255.0.0 zone External
address-object ipv4 "isp-gw" host 198.51.100.1 zone External
address-object ipv6 "net-lan-v6" network 2001:db8:20:: /64 zone External
address-object ipv6 "web-01-v6" host 2001:db8:10::10 zone External
address-object ipv4 "h 192.168.10.10" host 192.168.10.10 zone External
address-object ipv4 "h 192.168.10.11" host 192.168.10.11 zone External
address-object ipv4 "n 172.16.30.0_24" network 172.16.30.0 255.255.255.0 zone External
address-object ipv6 "n 2001:db8:30::_64" network 2001:db8:30:: /64 zone External
address-object ipv4 "r 10.1.0.0-10.1.5.9" range 10.1.0.0 10.1.5.9 zone External
address-object ipv4 "r 10.1.5.21-10.1.255.255" range 10.1.5.21 10.1.255.255 zone External
address-object ipv4 "h 192.168.10.25" host 192.168.10.25 zone External
address-object ipv6 "h 2001:db8:10::25" host 2001:db8:10::25 zone External
address-object ipv4 "r 0.0.0.0-192.168.9.255" range 0.0.0.0 192.168.9.255 zone External
address-object ipv4 "r 192.168.11.0-255.255.255.255" range 192.168.11.0 255.255.255.255 zone External
address-object ipv4 "h 203.0.113.1" host 203.0.113.1 zone External
address-object ipv4 "h 203.0.113.25" host 203.0.113.25 zone External
address-group ipv4 "web-01"
    address-object ipv4 "h 192.168.10.10"
    address-object ipv4 "h 192.168.10.11"
    exit
address-group ipv4 "grp-web"
    address-object ipv4 "h 192.168.10.10"
    address-object ipv4 "h 192.168.10.11"
    address-object ipv4 "net-dmz"
    exit
address-group ipv4 "updates.example.com (names)"
    address-object fqdn "updates.example.com"
    address-object fqdn "cdn.example.com"
    exit
address-group ipv6 "updates.example.com (names) v6"
    address-object fqdn "updates.example.com"
    address-object fqdn "cdn.example.com"
    exit
address-group ipv4 "net-guest"
    address-object ipv4 "n 172.16.30.0_24"
    exit
address-group ipv6 "net-guest v6"
    address-object ipv6 "n 2001:db8:30::_64"
    exit
address-group ipv4 "grp-inside"
    address-object ipv4 "net-lan"
    address-object ipv4 "n 172.16.30.0_24"
    exit
address-group ipv6 "grp-inside v6"
    address-object ipv6 "n 2001:db8:30::_64"
    exit
address-group ipv4 "lan without admins"
    address-object ipv4 "r 10.1.0.0-10.1.5.9"
    address-object ipv4 "r 10.1.5.21-10.1.255.255"
    exit
address-group ipv4 "mail-01"
    address-object ipv4 "h 192.168.10.25"
    exit
address-group ipv6 "mail-01 v6"
    address-object ipv6 "h 2001:db8:10::25"
    exit
address-group ipv4 "mail-01 IPv4"
    address-object ipv4 "h 192.168.10.25"
    exit
address-group ipv4 "net-guest IPv4"
    address-object ipv4 "n 172.16.30.0_24"
    exit
address-group ipv4 "dst not to dmz"
    address-object ipv4 "r 0.0.0.0-192.168.9.255"
    address-object ipv4 "r 192.168.11.0-255.255.255.255"
    exit
service-object "SG Control" TCP 3020 3021
service-object "DNS (UDP)" UDP 53 53
service-object "DNS (TCP)" TCP 53 53
service-object "HTTPS 2" TCP 443 443
service-object "tcp-8443" TCP 8443 8443
service-object "tcp-8000-8010" TCP 8000 8010
service-object "SSH 2" TCP 22 22
service-object "HTTP 2" TCP 80 80
service-object "NetBIOS (UDP)" UDP 137 138
service-object "NetBIOS (TCP)" TCP 139 139
service-object "Ident" TCP 113 113
service-object "tcp 8443" TCP 8443 8443
service-group "DNS"
    service-object "DNS (UDP)"
    service-object "DNS (TCP)"
    exit
service-group "web-services"
    service-object "tcp-8443"
    service-object "tcp-8000-8010"
    exit
service-group "NetBIOS"
    service-object "NetBIOS (UDP)"
    service-object "NetBIOS (TCP)"
    exit
service-group "svc allow web"
    service-object "HTTPS 2"
    service-group "web-services"
    exit
nat-policy inbound any outbound any source any translated-source original destination name "pub-web" translated-destination name "h 192.168.10.10" service name "HTTPS 2" translated-service name "tcp 8443"
    name "publish web"
    comment "publish web"
    exit
