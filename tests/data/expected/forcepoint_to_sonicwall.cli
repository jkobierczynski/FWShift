    name "lan out"
    comment "lan out"
    exit
nat-policy inbound any outbound any source group "mail-01 IPv4" translated-source name "h 203.0.113.25" destination any translated-destination original service any translated-service original
    name "mail static"
    comment "mail static"
    exit
