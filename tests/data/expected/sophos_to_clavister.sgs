add Address IP4Address fws_10.10.0.0-10.10.5.9 Address=10.10.0.0-10.10.5.9
add Address IP4Address fws_10.10.5.21-10.11.255.255 Address=10.10.5.21-10.11.255.255
add Address IP4Address fws_plc-net Address=10.30.1.0/24
add Address IP4Address fws_scada-server Address=10.10.7.15
add Service ServiceTCPUDP fws_MODBUS Type=TCP DestinationPorts=502
add Service ServiceTCPUDP fws_syslog-from-high Type=UDP DestinationPorts=514 SourcePorts=1024-65535
add Service ServiceTCPUDP fws_app-ports_1 Type=TCP DestinationPorts=9000-9010
add Service ServiceTCPUDP fws_app-ports_2 Type=TCP DestinationPorts=8443
add Service ServiceTCPUDP fws_app-ports_3 Type=TCP DestinationPorts=8080
add Address IP4Address fws_10.10.0.53 Address=10.10.0.53
add Address IP4Address fws_10.11.0.53 Address=10.11.0.53
